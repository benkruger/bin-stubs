#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

refuse() {
  echo "bin/start: $*" >&2
  exit 1
}

if [ "$#" -ne 1 ]; then
  echo "usage: bin/start <branch>" >&2
  exit 2
fi
branch="$1"
case "$branch" in
  "" | . | .. | main | */* | -*) refuse "unsafe branch name: '$branch'" ;;
esac
git check-ref-format --branch "$branch" >/dev/null 2>&1 || refuse "unsafe branch name: '$branch'"

[ "$(git branch --show-current)" = main ] || refuse "the repo root is not on main"
[ -z "$(git status --porcelain)" ] || refuse "the repo root has uncommitted changes"
git check-ignore -q ".worktrees/$branch" || refuse ".gitignore does not ignore .worktrees/"
if git rev-parse -q --verify "refs/heads/$branch" >/dev/null; then
  refuse "branch $branch already exists"
fi
worktree=".worktrees/$branch"
[ ! -e "$worktree" ] || refuse "$worktree already exists"

if git rev-parse -q --verify '@{upstream}' >/dev/null 2>&1; then
  git pull -q --ff-only
fi
base="$(git rev-parse HEAD)"
git worktree add -q -b "$branch" "$worktree" "$base"
if [ -f .githooks/pre-commit ] && [ -z "$(git config --get core.hooksPath || true)" ]; then
  git config core.hooksPath .githooks
fi

copied=0
while IFS= read -r -d '' states; do
  rel="${states#./}"
  rel="${rel%/main}"
  dest="$worktree/$rel/$branch"
  mkdir -p "$dest"
  cp -R "$states/." "$dest/"
  rm -rf "$dest/commit-review"
  copied=$((copied + 1))
done < <(find . \( -path ./.worktrees -o -name node_modules -o -name .venv -o -name target -o -name .build \) -prune -o -type d -path '*/.flow-states/main' -print0)

exclude="$(git -C "$worktree" rev-parse --path-format=absolute --git-path info/exclude)"
mkdir -p "$(dirname "$exclude")"
touch "$exclude"
linked=0
while IFS= read -r -d '' venv; do
  rel="${venv#./}"
  mkdir -p "$(dirname "$worktree/$rel")"
  ln -s "$ROOT/$rel" "$worktree/$rel"
  grep -qxF "/$rel" "$exclude" || printf '/%s\n' "$rel" >>"$exclude"
  linked=$((linked + 1))
done < <(find . \( -path ./.worktrees -o -name node_modules \) -prune -o -type d -name .venv -print0 -prune)

cloned=0
while IFS= read -r -d '' modules; do
  rel="${modules#./}"
  mkdir -p "$(dirname "$worktree/$rel")"
  cp -cR "$modules" "$worktree/$rel" 2>/dev/null || cp -R "$modules" "$worktree/$rel"
  cloned=$((cloned + 1))
done < <(find . \( -path ./.worktrees -o -name .venv \) -prune -o -type d -name node_modules -print0 -prune)

fetched=0
while IFS= read -r -d '' build; do
  rel="${build#./}"
  found=0
  for part in checkouts repositories workspace-state.json xcode-packages; do
    [ -e "$build/$part" ] || continue
    found=1
    mkdir -p "$worktree/$rel"
    cp -cR "$build/$part" "$worktree/$rel/$part" 2>/dev/null || cp -R "$build/$part" "$worktree/$rel/$part"
  done
  fetched=$((fetched + found))
done < <(find . \( -path ./.worktrees -o -name node_modules -o -name .venv \) -prune -o -type d -name .build -print0 -prune)

echo "bin/start: $branch at $worktree from main ${base:0:12}, with main's saved passes from $copied folder(s), $linked .venv link(s), $cloned node_modules clone(s) and $fetched Swift package clone(s)"
echo "bin/start: next, run 'cd $worktree' on its own and make every edit and run every script there"
