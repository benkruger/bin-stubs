#!/usr/bin/env bash
set -euo pipefail
if [ "$#" -ne 1 ]; then
  echo 'usage: bin/query "<sql>"' >&2
  exit 2
fi
if [ "${1:0:1}" = "\\" ]; then
  echo "bin/query: takes SQL, not a psql backslash command" >&2
  exit 2
fi
if ! perl -e '
  my ($sql, $code, $i) = ($ARGV[0], "", 0);
  my $n = length $sql;
  while ($i < $n) {
    my $c = substr($sql, $i, 1);
    my $two = substr($sql, $i, 2);
    my $end;
    if ($two eq "--") {
      $end = index($sql, "\n", $i);
      $i = $end < 0 ? $n : $end;
    } elsif ($two eq "/*") {
      $end = index($sql, "*/", $i + 2);
      $i = $end < 0 ? $n : $end + 2;
    } elsif ($c eq "\x27" || $c eq "\"") {
      $end = index($sql, $c, $i + 1);
      $i = $end < 0 ? $n : $end + 1;
    } elsif (substr($sql, $i) =~ /\A(\$[A-Za-z_]*\$)/) {
      my $tag = $1;
      $end = index($sql, $tag, $i + length $tag);
      $i = $end < 0 ? $n : $end + length $tag;
    } else {
      $code .= $c;
      $i++;
      next;
    }
    $code .= " \x01 ";
  }
  $code =~ s/;\s*\z//;
  exit 1 if index($code, ";") >= 0;
  exit($code =~ /\A[\s(\x01]*(select|with|explain|show|table|values)\b/i ? 0 : 1);
' -- "$1"; then
  echo "bin/query: takes one statement that reads: SELECT, WITH, EXPLAIN, SHOW, TABLE or VALUES" >&2
  exit 2
fi
PGOPTIONS="${PGOPTIONS:+$PGOPTIONS }-c default_transaction_read_only=on"
export PGOPTIONS
writes="SELECT EXISTS (SELECT FROM pg_roles m WHERE pg_has_role(m.oid, 'MEMBER') AND (
  m.rolsuper OR m.rolcreaterole OR m.rolcreatedb OR m.rolbypassrls OR m.rolreplication
  OR m.rolname IN ('pg_execute_server_program', 'pg_write_server_files')
  OR has_database_privilege(m.oid, current_database(), 'CREATE')
  OR EXISTS (SELECT FROM pg_namespace n WHERE n.nspname NOT LIKE 'pg\\_temp\\_%'
    AND n.nspname NOT LIKE 'pg\\_toast\\_temp\\_%' AND has_schema_privilege(m.oid, n.oid, 'CREATE'))
  OR EXISTS (SELECT FROM pg_class c WHERE c.relkind IN ('r', 'p', 'v', 'm', 'f')
    AND c.relnamespace NOT IN ('pg_catalog'::regnamespace, 'information_schema'::regnamespace)
    AND (c.relowner = m.oid OR has_table_privilege(m.oid, c.oid, 'INSERT, UPDATE, DELETE, TRUNCATE, TRIGGER')
      OR has_any_column_privilege(m.oid, c.oid, 'INSERT, UPDATE')))
  OR EXISTS (SELECT FROM pg_class c WHERE c.relkind = 'S'
    AND (c.relowner = m.oid OR has_sequence_privilege(m.oid, c.oid, 'USAGE, UPDATE')))))"
can_write="$(psql --no-psqlrc --set=ON_ERROR_STOP=1 --tuples-only --no-align --command "$writes")"
if [ "$can_write" != f ]; then
  echo "bin/query: the role it connects as can change data or schema; set PGUSER to a role that can only read" >&2
  exit 1
fi
exec psql --no-psqlrc --set=ON_ERROR_STOP=1 --command "$1"
