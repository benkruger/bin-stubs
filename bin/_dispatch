#!/usr/bin/env bash
set -euo pipefail

PHASE="${1:?phase required (ci|format|lint|build|test|changed|dependencies)}"
shift

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

case "$PHASE" in
  ci | format | lint | build | test | changed | dependencies) ;;
  *)
    echo "bin/_dispatch: unknown phase: $PHASE" >&2
    exit 2
    ;;
esac

force=0
jobs=""
rest=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --force) force=1 ;;
    --jobs)
      if [ "$#" -lt 2 ] || ! [[ "$2" =~ ^[1-9][0-9]*$ ]]; then
        echo "bin/$PHASE: --jobs takes a whole number of at least 1" >&2
        exit 2
      fi
      jobs="$2"
      shift
      ;;
    *) rest+=("$1") ;;
  esac
  shift
done
if [ -z "$jobs" ]; then
  jobs=$(($(getconf _NPROCESSORS_ONLN) / 2))
  [ "$jobs" -ge 1 ] || jobs=1
  [ "$jobs" -le 4 ] || jobs=4
fi

# shellcheck source=lib/apps.sh
. "$REPO_ROOT/bin/lib/apps.sh"

leaf_of() {
  local lang
  lang="$(app_language "$1")" || return 1
  [ -x "$REPO_ROOT/bin/_$lang/$PHASE" ] || return 1
  printf '%s\n' "$REPO_ROOT/bin/_$lang/$PHASE"
}

targets=()
for d in "$REPO_ROOT"/*/; do
  [ -d "$d" ] || continue
  name="${d%/}"
  name="${name##*/}"
  case "$name" in
    bin | tests | checks | node_modules | vendor | target) continue ;;
  esac
  [[ "$name" == .* ]] && continue
  if leaf_of "${d%/}" >/dev/null; then
    targets+=("$name")
  fi
done

if [ "${#targets[@]}" -gt 0 ]; then
  sorted=()
  while IFS= read -r line; do
    sorted+=("$line")
  done < <(printf '%s\n' "${targets[@]}" | sort)
  targets=("${sorted[@]}")
fi

has_root_app=0
if leaf_of "$REPO_ROOT" >/dev/null; then
  has_root_app=1
fi

suite_leaf=""
case "$PHASE" in
  ci | test) [ -x "$REPO_ROOT/bin/_root-tests" ] && suite_leaf="bin/_root-tests" ;;
  changed) [ -x "$REPO_ROOT/bin/_root-changed" ] && suite_leaf="bin/_root-changed" ;;
  format) [ -x "$REPO_ROOT/bin/_root-format" ] && suite_leaf="bin/_root-format" ;;
esac

if [ "${#targets[@]}" -eq 0 ] && [ "$has_root_app" -eq 0 ] && [ -z "$suite_leaf" ]; then
  echo "bin/$PHASE: no app or suite to run" >&2
  exit 1
fi

is_selector() {
  local flag="$1" t
  case "$flag" in
    --root) [ "$has_root_app" -eq 1 ] && return 0 ;;
    --suite) [ -n "$suite_leaf" ] && return 0 ;;
  esac
  for t in "${targets[@]+"${targets[@]}"}"; do
    [ "$flag" = "--${t//_/-}" ] && return 0
  done
  return 1
}

picks=()
leaf_args=()
for arg in "${rest[@]+"${rest[@]}"}"; do
  if is_selector "$arg"; then
    picks+=("${arg#--}")
  else
    leaf_args+=("$arg")
  fi
done

picked() {
  local want="$1" p
  for p in "${picks[@]+"${picks[@]}"}"; do
    [ "$p" = "$want" ] && return 0
  done
  return 1
}

owner_of() {
  local path="$1" t best=""
  for t in "${targets[@]+"${targets[@]}"}"; do
    case "$path" in
      "$t" | "$t"/*) best="$t" ;;
    esac
  done
  [ -n "$best" ] || return 1
  printf '%s\n' "$best"
}

already_selected() {
  local n="$1" t
  for t in "${selected[@]+"${selected[@]}"}"; do
    [ "$t" = "$n" ] && return 0
  done
  return 1
}

named_paths() {
  local a
  for a in "${leaf_args[@]+"${leaf_args[@]}"}"; do
    case "$a" in
      -*) ;;
      *) return 0 ;;
    esac
  done
  return 1
}

is_corpus() {
  case "$1" in
    CLAUDE.md | README.md | .claude | .claude/* | tests | tests/* | checks | checks/*) return 0 ;;
  esac
  return 1
}

select_all=0
selected=()
run_root_app=0
run_suite=0

git_config_count="${GIT_CONFIG_COUNT:-0}"
export "GIT_CONFIG_KEY_$git_config_count=core.quotePath" "GIT_CONFIG_VALUE_$git_config_count=false"
export GIT_CONFIG_COUNT=$((git_config_count + 1))

collect_changed() {
  local base=HEAD
  git -C "$REPO_ROOT" rev-parse --verify HEAD >/dev/null 2>&1 ||
    base="$(git -C "$REPO_ROOT" hash-object -t tree /dev/null)"
  git -C "$REPO_ROOT" diff -z --name-only --no-renames "$base" || return 1
  git -C "$REPO_ROOT" ls-files -z --others --exclude-standard || return 1
}

if [ "${#picks[@]}" -gt 0 ]; then
  for t in "${targets[@]+"${targets[@]}"}"; do
    if picked "${t//_/-}"; then
      selected+=("$t")
    fi
  done
  if picked root; then
    run_root_app=1
  fi
  if picked suite; then
    run_suite=1
  fi
elif [ "$force" -eq 1 ] || [ "$PHASE" = "dependencies" ]; then
  select_all=1
elif [ "$PHASE" != changed ] && named_paths; then
  for a in "${leaf_args[@]}"; do
    case "$a" in
      -*) continue ;;
    esac
    owner="$(owner_of "$a" || true)"
    if [ -n "$owner" ]; then
      already_selected "$owner" || selected+=("$owner")
    elif [ "$has_root_app" -eq 1 ]; then
      run_root_app=1
    else
      select_all=1
    fi
  done
else
  changed=()
  changed_list="$(mktemp "${TMPDIR:-/tmp}/bin-dispatch.XXXXXX")"
  if ! collect_changed | sort -zu >"$changed_list"; then
    rm -f "$changed_list"
    echo "bin/$PHASE: git could not list the changed files" >&2
    exit 1
  fi
  while IFS= read -r -d '' path; do
    case "$path" in
      "" | .ci-timeout | */.ci-timeout) continue ;;
    esac
    changed+=("$path")
  done <"$changed_list"
  rm -f "$changed_list"
  if [ "${#changed[@]}" -eq 0 ]; then
    if [ "$PHASE" = "changed" ]; then
      echo "bin/changed: nothing dirty"
      exit 0
    fi
    select_all=1
  else
    for path in "${changed[@]}"; do
      if is_corpus "$path"; then
        [ -z "$suite_leaf" ] || run_suite=1
        case "$path" in
          tests/*) run_root_app="$has_root_app" ;;
        esac
        continue
      fi
      if [[ "$path" == bin/* ]]; then
        select_all=1
        break
      fi
      owner="$(owner_of "$path" || true)"
      if [ -n "$owner" ]; then
        if ! already_selected "$owner"; then
          selected+=("$owner")
        fi
      elif [ "$has_root_app" -eq 1 ]; then
        run_root_app=1
      else
        select_all=1
        break
      fi
    done
  fi
fi

if [ "$select_all" -eq 1 ]; then
  selected=("${targets[@]+"${targets[@]}"}")
  run_root_app="$has_root_app"
  if [ -n "$suite_leaf" ]; then
    run_suite=1
  fi
fi

if [ "${#picks[@]}" -eq 0 ]; then
  if [ "$PHASE" = "ci" ] || [ "$PHASE" = "test" ]; then
    if [ "${#selected[@]}" -gt 0 ] || [ "$run_root_app" -eq 1 ]; then
      if [ -n "$suite_leaf" ]; then
        run_suite=1
      fi
    fi
  fi
  if { [ "$PHASE" = "format" ] || [ "$PHASE" = "changed" ]; } && [ -n "$suite_leaf" ]; then
    run_suite=1
  fi
fi

if [ "${#selected[@]}" -eq 0 ] && [ "$run_root_app" -eq 0 ] && [ "$run_suite" -eq 0 ]; then
  echo "bin/$PHASE: nothing it checks changed"
  exit 0
fi

BRANCH="$(git symbolic-ref -q --short HEAD 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
case "$BRANCH" in
  "." | "..") BRANCH="" ;;
esac

if stat -f %Fm / >/dev/null 2>&1; then
  STAT_MTIME=(stat -f %Fm)
else
  STAT_MTIME=(stat -c %.9Y)
fi

mtime_of() {
  "${STAT_MTIME[@]}" "$1"
}

EXIT=0
NAMES=()
RESULTS=()
TIMES=()
STARTED="${EPOCHSECONDS:-$(date +%s)}"

consider_paths() {
  local name="$1"
  local a paths=0 mine=0
  FILTERED=()
  for a in "${leaf_args[@]+"${leaf_args[@]}"}"; do
    case "$a" in
      -*)
        FILTERED+=("$a")
        ;;
      "$name"/*)
        FILTERED+=("${a#"$name"/}")
        paths=$((paths + 1))
        mine=$((mine + 1))
        ;;
      *)
        local t known=0
        for t in "${targets[@]+"${targets[@]}"}"; do
          case "$a" in
            "$t" | "$t"/*)
              known=1
              paths=$((paths + 1))
              ;;
          esac
        done
        if [ "$known" -eq 0 ]; then
          paths=$((paths + 1))
          if [ "$name" = __root__ ] || [ "$has_root_app" -eq 0 ]; then
            FILTERED+=("$a")
            mine=$((mine + 1))
          fi
        fi
        ;;
    esac
  done
  if [ "$paths" -gt 0 ] && [ "$mine" -eq 0 ]; then
    return 1
  fi
  return 0
}

run_one() {
  local display="$1" folder="$2" leaf="$3" sname="${4:-ci-sentinel}"
  local sentinel="" mt_before="" rc=0 result args=() began
  FILTERED=()
  if [ "$display" = "suite" ]; then
    for a in "${leaf_args[@]+"${leaf_args[@]}"}"; do
      case "$PHASE $a" in
        "ci --clean" | "format --check") FILTERED+=("$a") ;;
      esac
    done
  elif [ "$display" = "root" ]; then
    if ! consider_paths "__root__"; then
      NAMES+=("$display")
      RESULTS+=(SKIP)
      TIMES+=("")
      return
    fi
  elif ! consider_paths "$display"; then
    NAMES+=("$display")
    RESULTS+=(SKIP)
    TIMES+=("")
    return
  fi
  if [ "$force" -eq 1 ] && [ "$PHASE" = "ci" ]; then
    args+=(--force)
  fi
  if [ "$PHASE" = "test" ] && [ "$display" = "suite" ]; then
    args+=(--force)
  fi
  args+=("${FILTERED[@]+"${FILTERED[@]}"}")
  if [ "$PHASE" = "ci" ] && [ -n "$BRANCH" ]; then
    sentinel="$folder/.flow-states/$BRANCH/$sname"
    if [ -f "$sentinel" ]; then
      mt_before="$(mtime_of "$sentinel")"
    fi
  fi
  began="${EPOCHSECONDS:-$(date +%s)}"
  (cd "$folder" && "$leaf" ${args[@]+"${args[@]}"}) || rc=$?
  if [ "$rc" -ne 0 ]; then
    result=FAIL
    EXIT=1
  elif [ -n "$mt_before" ] && [ -f "$sentinel" ] && [ "$(mtime_of "$sentinel")" = "$mt_before" ]; then
    result=SKIP
  else
    result=PASS
  fi
  NAMES+=("$display")
  RESULTS+=("$result")
  TIMES+=("$((${EPOCHSECONDS:-$(date +%s)} - began))")
}

BG_DISPLAY=()
BG_FOLDER=()
BG_PID=()
BG_LOG=()
BG_SENT=()
BG_MT=()
BG_STEPS=()
BG_GROUP=()
trap 'kill -TERM -- ${BG_GROUP[@]+"${BG_GROUP[@]}"} 2>/dev/null || true
  for log in ${BG_LOG[@]+"${BG_LOG[@]}"}; do rm -f "$log" "$log.rc"; done
  exit 130' INT TERM

if [ "$run_suite" -eq 1 ]; then
  run_one "suite" "$REPO_ROOT" "$REPO_ROOT/$suite_leaf" "root-suite-sentinel"
fi

steps_snapshot() {
  local dir="$1/.flow-states/$BRANCH" step have=() files=() times=() t i=0
  for step in format lint build test; do
    if [ -f "$dir/ci-$step-sentinel" ]; then
      have+=(1)
      files+=("$dir/ci-$step-sentinel")
    else
      have+=(0)
    fi
  done
  if [ "${#files[@]}" -gt 0 ]; then
    while IFS= read -r t; do
      times+=("$t")
    done < <("${STAT_MTIME[@]}" "${files[@]}")
  fi
  for step in 0 1 2 3; do
    if [ "${have[$step]}" -eq 1 ]; then
      printf '%s\n' "${times[$i]:-}"
      i=$((i + 1))
    else
      echo missing
    fi
  done
}

ran_every_step() {
  local before="$1" after="$2" was now
  [ "$PHASE" = ci ] && [ -n "$BRANCH" ] || return 1
  while IFS= read -r now && IFS= read -r was <&3; do
    [ "$now" != missing ] && [ "$now" != "$was" ] || return 1
  done < <(printf '%s\n' "$after") 3< <(printf '%s\n' "$before")
}

queue_one() {
  local display="$1" folder="$2" leaf="$3" sname="${4:-ci-sentinel}"
  local sentinel="" mt_before="" args=() log
  FILTERED=()
  if [ "$display" = "root" ]; then
    if ! consider_paths "__root__"; then
      NAMES+=("$display")
      RESULTS+=(SKIP)
      TIMES+=("")
      return
    fi
  elif ! consider_paths "$display"; then
    NAMES+=("$display")
    RESULTS+=(SKIP)
    TIMES+=("")
    return
  fi
  if [ "$force" -eq 1 ] && [ "$PHASE" = "ci" ]; then
    args+=(--force)
  fi
  args+=("${FILTERED[@]+"${FILTERED[@]}"}")
  if [ "$PHASE" = "ci" ] && [ -n "$BRANCH" ]; then
    sentinel="$folder/.flow-states/$BRANCH/$sname"
    if [ -f "$sentinel" ]; then
      mt_before="$(mtime_of "$sentinel")"
    fi
  fi
  log="$(mktemp "${TMPDIR:-/tmp}/bin-dispatch.XXXXXX")"
  BG_STEPS+=("$(steps_snapshot "$folder")")
  set -m
  (
    read -r -n 1 -u 3 _
    rc=0
    began="${EPOCHSECONDS:-$(date +%s)}"
    (cd "$folder" && APP_DIR="$folder" "$leaf" ${args[@]+"${args[@]}"}) >"$log" 2>&1 3>&- || rc=$?
    printf '%s %s\n' "$rc" "$((${EPOCHSECONDS:-$(date +%s)} - began))" >"$log.rc"
    printf . >&3
  ) </dev/null &
  set +m
  BG_DISPLAY+=("$display")
  BG_FOLDER+=("$folder")
  BG_PID+=("$!")
  BG_GROUP+=("-$!")
  BG_LOG+=("$log")
  BG_SENT+=("$sentinel")
  BG_MT+=("$mt_before")
}

slots="$(mktemp -d "${TMPDIR:-/tmp}/bin-dispatch.XXXXXX")"
mkfifo "$slots/fifo"
exec 3<>"$slots/fifo"
rm -rf "$slots"
for ((slot = 0; slot < jobs; slot++)); do
  printf . >&3
done

if [ "$run_root_app" -eq 1 ]; then
  queue_one "root" "$REPO_ROOT" "$(leaf_of "$REPO_ROOT")"
fi
for name in "${selected[@]+"${selected[@]}"}"; do
  queue_one "$name" "$REPO_ROOT/$name" "$(leaf_of "$REPO_ROOT/$name")"
done
i=0
while [ "$i" -lt "${#BG_PID[@]}" ]; do
  wait "${BG_PID[$i]}" || true
  rc=1
  secs=""
  if [ -f "${BG_LOG[$i]}.rc" ]; then
    read -r rc secs <"${BG_LOG[$i]}.rc"
  fi
  cat "${BG_LOG[$i]}"
  rm -f "${BG_LOG[$i]}" "${BG_LOG[$i]}.rc"
  if [ "$rc" -ne 0 ]; then
    result=FAIL
    EXIT=1
  elif [ -n "${BG_MT[$i]}" ] && [ -f "${BG_SENT[$i]}" ] && [ "$(mtime_of "${BG_SENT[$i]}")" = "${BG_MT[$i]}" ]; then
    result=SKIP
  else
    result=PASS
  fi
  folder="${BG_FOLDER[$i]}"
  if [ "$result" = PASS ] && ran_every_step "${BG_STEPS[$i]}" "$(steps_snapshot "$folder")" &&
    ! "$REPO_ROOT/bin/_ci-timeout" "${BG_DISPLAY[$i]}" "$folder/.ci-timeout" "$secs"; then
    result=FAIL
    EXIT=1
    rm -f "$folder/.flow-states/$BRANCH/ci-sentinel" "$folder/.flow-states/$BRANCH"/ci-*-sentinel
  fi
  NAMES+=("${BG_DISPLAY[$i]}")
  RESULTS+=("$result")
  TIMES+=("$secs")
  i=$((i + 1))
done

duration() {
  local secs="$1"
  if [ "$secs" -ge 60 ]; then
    printf '%dm%02ds\n' $((secs / 60)) $((secs % 60))
  else
    printf '%ds\n' "$secs"
  fi
}

time_of() {
  local n="$1" i=0 have
  for have in "${NAMES[@]+"${NAMES[@]}"}"; do
    if [ "$have" = "$n" ] && [ -n "${TIMES[$i]}" ]; then
      printf ' (%s)\n' "$(duration "${TIMES[$i]}")"
      return
    fi
    i=$((i + 1))
  done
}

result_of() {
  local n="$1" i=0 have
  for have in "${NAMES[@]+"${NAMES[@]}"}"; do
    if [ "$have" = "$n" ]; then
      printf '%s\n' "${RESULTS[$i]}"
      return
    fi
    i=$((i + 1))
  done
  printf '%s\n' SKIP
}

ORDER=()
if [ -n "$suite_leaf" ]; then
  ORDER+=(suite)
fi
if [ "$has_root_app" -eq 1 ]; then
  ORDER+=(root)
fi
for name in "${targets[@]+"${targets[@]}"}"; do
  ORDER+=("$name")
done

ran=0
failed=0
for name in "${ORDER[@]}"; do
  r="$(result_of "$name")"
  ran=$((ran + 1))
  [ "$r" = "FAIL" ] && failed=$((failed + 1))
done

echo ""
echo "═══════════════════════════════════════════════"
echo "  $PHASE summary"
echo "───────────────────────────────────────────────"
for name in "${ORDER[@]}"; do
  printf "  %-12s : %s%s\n" "$name" "$(result_of "$name")" "$(time_of "$name")"
done
echo "───────────────────────────────────────────────"
if [ "$EXIT" -eq 0 ]; then
  echo "  result   : PASSED ($ran of $ran)"
else
  echo "  result   : FAILED ($failed of $ran)"
fi
echo "  elapsed  : $(duration "$((${EPOCHSECONDS:-$(date +%s)} - STARTED))")"
echo "═══════════════════════════════════════════════"

exit "$EXIT"
