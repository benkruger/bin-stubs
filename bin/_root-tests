#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

force=0
clean=0
single=""
for arg in "$@"; do
  case "$arg" in
    --force) force=1 ;;
    --clean) clean=1 ;;
    checks/*) single="$arg" ;;
    *)
      echo "root-suite: unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

if [ -n "$single" ]; then
  exec "$ROOT/$single"
fi

branch="$(git symbolic-ref -q --short HEAD 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
case "$branch" in
  "" | "." | "..")
    echo "root-suite: refusing to build a sentinel path for unsafe branch: '$branch'" >&2
    exit 2
    ;;
esac
sentinel="$ROOT/.flow-states/$branch/root-suite-sentinel"

if [ "$clean" -eq 1 ]; then
  rm -f "$sentinel"
  echo "root-suite: cleaned sentinel for $branch"
  exit 0
fi

failed=0
for check in "$ROOT"/checks/*; do
  if [ ! -f "$check" ] || [ ! -x "$check" ]; then
    continue
  fi
  if ! "$check"; then
    echo "root-suite: checks/$(basename "$check") failed" >&2
    failed=1
  fi
done
if [ "$failed" -ne 0 ]; then
  exit 1
fi

# shellcheck source=lib/tree-sentinel.sh
. "$ROOT/bin/lib/tree-sentinel.sh"
pre_hash="$(tree_hash)"
if [ "$force" -eq 0 ] && [ -f "$sentinel" ] && [ "$(cat "$sentinel")" = "$pre_hash" ]; then
  exit 0
fi

if [ ! -x "$ROOT/tests/run" ]; then
  echo "root-suite: no executable tests/run" >&2
  exit 1
fi
if [ "$force" -eq 1 ]; then
  "$ROOT/tests/run" --force
else
  "$ROOT/tests/run"
fi

mkdir -p "$(dirname "$sentinel")"
printf '%s\n' "$pre_hash" >"$sentinel"
