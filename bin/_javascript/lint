#!/usr/bin/env bash
set -euo pipefail

UNGATED_NAMES=(.gitignore .nvmrc .ci-timeout)
UNGATED_PATHS=()
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ]; then
  toolchain_check "$root"
fi
packages_check "$PWD" || exit 1

all=0
paths=()
for arg in "$@"; do
  case "$arg" in
    --all) all=1 ;;
    *) paths+=("$arg") ;;
  esac
done

if [ "$all" -eq 1 ]; then
  listing="$(git -C "$root" ls-files -z --cached --others --exclude-standard -- . | tr '\0' '\n')"
elif [ "${#paths[@]}" -gt 0 ]; then
  listing="$(printf '%s\n' "${paths[@]}")"
else
  listing="$("$here/changed" --files)"
fi

# shellcheck source=../lib/apps.sh
. "$here/../lib/apps.sh"
root_app=0
if [ "$(pwd -P)" = "$(git rev-parse --show-toplevel)" ]; then
  root_app=1
fi

has_own_lint() {
  local top="$1"
  [ "$root_app" -eq 1 ] && is_app_dir "$root/$top"
}

files=()
while IFS= read -r path; do
  [ -z "$path" ] && continue
  [ -f "$path" ] || continue
  case "$path" in
    node_modules/* | dist/* | .flow-states/* | */node_modules/* | */.flow-states/*)
      continue
      ;;
  esac
  top="${path%%/*}"
  if [ "$top" != "$path" ] && has_own_lint "$top"; then
    continue
  fi
  files+=("$path")
done <<<"$listing"

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

is_ungated() {
  local path="$1" name entry
  name="${path##*/}"
  for entry in "${UNGATED_NAMES[@]}"; do
    [ "$name" = "$entry" ] && return 0
  done
  for entry in "${UNGATED_PATHS[@]+"${UNGATED_PATHS[@]}"}"; do
    [ "$path" = "$entry" ] && return 0
  done
  return 1
}

is_bash_script() {
  local first="" shebang='^#!(.*[^[:alnum:]_])?bash([^[:alnum:]_]|$)'
  case "$1" in
    *.sh | *.bash) return 0 ;;
  esac
  IFS= read -r first <"$1" || true
  [[ "$first" =~ $shebang ]]
}

biome_files=()
ungated=0
for path in "${files[@]}"; do
  case "$path" in
    *.md) ;;
    *.js | *.mjs | *.cjs | *.jsx | *.json | *.jsonc | *.css) biome_files+=("$path") ;;
    *)
      if [ -L "$path" ] || is_ungated "$path" || is_bash_script "$path"; then
        continue
      fi
      echo "$path: no formatter or linter (Biome)" >&2
      ungated=1
      ;;
  esac
done
logs="$(mktemp -d "${TMPDIR:-/tmp}/bin-javascript-lint.XXXXXX")"
trap 'rm -rf "$logs"' EXIT
pids=()

in_background() {
  local log="$logs/${#pids[@]}"
  "$@" >"$log.out" 2>"$log.err" &
  pids+=("$!")
}

if [ "${#biome_files[@]}" -gt 0 ]; then
  in_background "$root/node_modules/.bin/biome" check --formatter-enabled=false --error-on-warnings "${biome_files[@]}"
fi

status="$ungated"
for i in ${pids[@]+"${!pids[@]}"}; do
  wait "${pids[$i]}" || status=1
  cat "$logs/$i.out"
  cat "$logs/$i.err" >&2
done
exit "$status"
