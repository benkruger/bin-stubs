#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"

pm=npm
if [ -f pnpm-lock.yaml ]; then
  pm=pnpm
elif [ -f yarn.lock ]; then
  pm=yarn
elif [ -f bun.lock ] || [ -f bun.lockb ]; then
  pm=bun
  export PATH="${HOME}/.bun/bin:${PATH}"
fi

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ]; then
  toolchain_check "$root"
fi
packages_check "$PWD" || exit 1

if jq -e '(.scripts.build // "") != ""' package.json >/dev/null; then
  exec "$pm" run build
fi

if [ "${1:-}" = "--all" ]; then
  listing="$(git -C "$root" ls-files --cached --others --exclude-standard -- .)"
else
  listing="$("$here/changed" --files)"
fi
files=()
while IFS= read -r path; do
  [ -z "$path" ] && continue
  [ -f "$path" ] || continue
  case "$path" in
    node_modules/* | dist/* | .flow-states/* | */node_modules/* | */.flow-states/*) continue ;;
    *.js | *.mjs | *.cjs) files+=("$path") ;;
  esac
done <<<"$listing"

[ "${#files[@]}" -gt 0 ] || exit 0
checked="$(mktemp -d)"
trap 'rm -rf "$checked"' EXIT
jobs="$(getconf _NPROCESSORS_ONLN)"
check_every() {
  local i rc
  for ((i = $1; i < ${#files[@]}; i += jobs)); do
    rc=0
    node --check "${files[$i]}" >"$checked/$i.out" 2>"$checked/$i.err" || rc=$?
    printf '%s\n' "$rc" >"$checked/$i.rc"
  done
}
pids=()
for ((j = 0; j < jobs && j < ${#files[@]}; j++)); do
  check_every "$j" &
  pids+=("$!")
done
for pid in "${pids[@]}"; do
  wait "$pid"
done
for i in "${!files[@]}"; do
  read -r rc <"$checked/$i.rc"
  [ ! -s "$checked/$i.out" ] || cat "$checked/$i.out"
  [ ! -s "$checked/$i.err" ] || cat "$checked/$i.err" >&2
  [ "$rc" -eq 0 ] || exit "$rc"
done
