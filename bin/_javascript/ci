#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"

force=0
clean=0
for arg in "$@"; do
  case "$arg" in
    --force) force=1 ;;
    --clean) clean=1 ;;
    *)
      echo "bin/ci: unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

branch="$(git symbolic-ref -q --short HEAD || git rev-parse --abbrev-ref HEAD)"
case "$branch" in
  "" | "." | "..")
    echo "bin/ci: refusing to build a sentinel path for unsafe branch: '$branch'" >&2
    exit 2
    ;;
esac

sentinel="$root/.flow-states/$branch/ci-sentinel"

if [[ "$clean" -eq 1 ]]; then
  rm -f "$sentinel" "$root/.flow-states/$branch"/ci-*-sentinel
  echo "bin/ci: cleaned sentinel for $branch"
  exit 0
fi

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ] && ! toolchain_check "$root"; then
  echo "bin/ci: gate RED ($branch) — the toolchain does not match its pin (above)." >&2
  exit 1
fi

if [ "$(pwd -P)" = "$(git rev-parse --show-toplevel)" ]; then
  ROOT_APP=1
fi
# shellcheck source=../lib/tree-sentinel.sh
. "$here/../lib/tree-sentinel.sh"

pre_hash="$(tree_hash)"

if [[ "$force" -eq 0 && -f "$sentinel" && "$(cat "$sentinel")" == "$pre_hash" ]]; then
  exit 0
fi

label="$(basename "$root")"
echo ""
echo "═══ $label ════════════════════════════════════"
log="$(mktemp "${TMPDIR:-/tmp}/bin-ci.XXXXXX")"
trap 'rm -f "$log" "$log".*' EXIT

if ! packages_check "$root"; then
  echo "bin/ci: gate RED ($branch) — packages are not installed (above)." >&2
  exit 1
fi
export FLOW_CHECKED_APP="$root"

audit_log="$(mktemp "${TMPDIR:-/tmp}/bin-audit.XXXXXX")"
trap 'rm -f "$log" "$log".* "$audit_log"' EXIT
npm audit --audit-level=moderate >"$audit_log" 2>&1 &
audit_pid=$!

# shellcheck source=../lib/steps.sh
. "$here/../lib/steps.sh"
steps_init "$root/.flow-states/$branch" "$force" "$pre_hash" "$log" "$branch" \
  'npm warn|DeprecationWarning|^Warning: ' '| *100.00 | *100.00 |'
start_step format "$here/format" --check --all
start_step lint "$here/lint" --all
start_step build "$here/build" --all
start_step test "$here/test" --all
red=0
finish_steps || red=1
if ! wait "$audit_pid"; then
  cat "$audit_log" >&2
  echo "bin/ci: gate RED ($branch) — npm audit found a moderate or worse advisory (above)." >&2
  red=1
fi
[ "$red" -eq 0 ] || exit 1

tally="$(grep -E '^# pass [0-9]+|Suites: [0-9]+' "$log" | tail -n1 || true)"

mkdir -p "$(dirname "$sentinel")"
printf '%s\n' "$pre_hash" >"$sentinel"
echo "bin/ci: gate green ($branch)${tally:+ — $tally} — sentinel written."
