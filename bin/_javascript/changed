#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"

# shellcheck source=../lib/deletions.sh
. "$here/../lib/deletions.sh"
root_app=0
if [ "$(pwd -P)" = "$(git rev-parse --show-toplevel)" ]; then
  root_app=1
fi

has_own() {
  local top="$1"
  [ "$root_app" -eq 1 ] && is_app_dir "$root/$top"
}

owned_change() {
  local path="$1" top
  [ -f "$path" ] || return 1
  top="${path%%/*}"
  if [ "$top" != "$path" ] && has_own "$top"; then
    return 1
  fi
  return 0
}

changed_files() {
  local path
  while IFS= read -r path; do
    [ -z "$path" ] && continue
    case "$path" in
      node_modules/* | dist/* | .flow-states/* | */node_modules/* | */.flow-states/*)
        continue
        ;;
    esac
    owned_change "$path" || continue
    printf '%s\n' "$path"
  done < <(
    {
      git -C "$root" diff --name-only --relative "$(change_base)" -- .
      git -C "$root" ls-files --others --exclude-standard -- .
    } | sort -u
  )
}

if [ "${1:-}" = "--files" ]; then
  changed_files
  exit 0
fi

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ]; then
  toolchain_check "$root"
fi
packages_check "$PWD" || exit 1
export FLOW_CHECKED_APP="$PWD"

is_test() {
  case "$1" in
    e2e/*) return 1 ;;
    *.test.js | *.test.mjs | *.test.cjs | *.test.jsx) return 0 ;;
    *.spec.js | *.spec.mjs | *.spec.cjs | *.spec.jsx) return 0 ;;
    test-*.js | test-*.mjs | test-*.cjs | test-*.jsx) return 0 ;;
    */test-*.js | */test-*.mjs | */test-*.cjs | */test-*.jsx) return 0 ;;
    *) return 1 ;;
  esac
}

is_source() {
  case "$1" in
    */*) ;;
    *) return 1 ;;
  esac
  case "$1" in
    tests/* | e2e/* | node_modules/* | dist/* | public/* | coverage/* | */node_modules/*) return 1 ;;
  esac
  is_test "$1" && return 1
  case "$1" in
    *.js | *.mjs | *.cjs | *.jsx) return 0 ;;
    *) return 1 ;;
  esac
}

twin_names() {
  local rel="$1" dir stem strip ext
  dir="$(dirname "$rel")"
  stem="$(basename "$rel")"
  stem="${stem%.*}"
  strip="${rel#src/}"
  strip="${strip%.*}"
  for ext in js mjs cjs jsx; do
    printf '%s\n' "tests/$strip.test.$ext" "tests/$strip.spec.$ext" \
      "$dir/$stem.test.$ext" "$dir/$stem.spec.$ext" "$dir/test-$stem.$ext"
  done
}

test_for_source() {
  local c strip
  while IFS= read -r c; do
    if [ -f "$c" ]; then
      echo "$c"
      return
    fi
  done < <(twin_names "$1")
  strip="${1#src/}"
  echo "tests/${strip%.*}.test.js"
}

source_candidates() {
  local t="$1" dir base stem rel ext
  dir="."
  [ "${t%/*}" = "$t" ] || dir="${t%/*}"
  base="${t##*/}"
  case "$base" in
    test-*)
      stem="${base#test-}"
      stem="${stem%.*}"
      ;;
    *)
      stem="${base%.*}"
      stem="${stem%.test}"
      stem="${stem%.spec}"
      ;;
  esac
  rel="${dir#tests}"
  rel="${rel#/}"
  for ext in js mjs cjs jsx; do
    printf '%s\n' "$dir/$stem.$ext"
    if [ "$dir" = tests ] || [ "${dir#tests/}" != "$dir" ]; then
      printf '%s\n' "src/${rel:+$rel/}$stem.$ext" "${rel:+$rel/}$stem.$ext"
    fi
  done
}

source_for_test() {
  local s n
  while IFS= read -r s; do
    if [ -f "$s" ] && is_source "$s"; then
      while IFS= read -r n; do
        if [ "$n" = "$1" ]; then
          echo "$s"
          return
        fi
      done < <(twin_names "$s")
    fi
  done < <(source_candidates "$1")
  echo ""
}

already() {
  local n="$1" t
  for t in "${tests[@]+"${tests[@]}"}"; do
    [ "$t" = "$n" ] && return 0
  done
  return 1
}

files=()
while IFS= read -r path; do
  files+=("$path")
done < <(changed_files)
gone="$(deleted_twin_findings)"

if [ "${#files[@]}" -eq 0 ] && [ -z "$gone" ]; then
  exit 0
fi

if [ "${#files[@]}" -gt 0 ]; then
  "$here/format" "${files[@]}"
  "$here/lint" "${files[@]}"
fi

tests=()
missing_mirror=()
for path in "${files[@]+"${files[@]}"}"; do
  if is_source "$path"; then
    mirror="$(test_for_source "$path")"
    if [ ! -f "$mirror" ]; then
      missing_mirror+=("$path → $mirror")
    elif ! already "$mirror"; then
      tests+=("$mirror")
    fi
  elif is_test "$path"; then
    if ! already "$path"; then
      tests+=("$path")
    fi
  fi
done

for msg in "${missing_mirror[@]+"${missing_mirror[@]}"}"; do
  echo "bin/changed: no mirrored test for $msg" >&2
done
[ -z "$gone" ] || printf '%s\n' "$gone" >&2
if [ "${#missing_mirror[@]}" -gt 0 ] || [ -n "$gone" ]; then
  exit 1
fi

if [ "${#tests[@]}" -gt 0 ]; then
  exec "$here/test" "${tests[@]}"
fi
exit 0
