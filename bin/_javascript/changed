#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"

# shellcheck source=../lib/apps.sh
. "$here/../lib/apps.sh"
root_app=0
if [ "$(pwd -P)" = "$(git rev-parse --show-toplevel)" ]; then
  root_app=1
fi

has_own() {
  local top="$1"
  [ "$root_app" -eq 1 ] && is_app_dir "$root/$top"
}

owned_change() {
  local path="$1" top
  [ -f "$path" ] || return 1
  top="${path%%/*}"
  if [ "$top" != "$path" ] && has_own "$top"; then
    return 1
  fi
  return 0
}

changed_files() {
  local path
  while IFS= read -r path; do
    [ -z "$path" ] && continue
    case "$path" in
      node_modules/* | dist/* | .flow-states/* | */node_modules/* | */.flow-states/*)
        continue
        ;;
    esac
    owned_change "$path" || continue
    printf '%s\n' "$path"
  done < <(
    {
      git -C "$root" diff --name-only --relative HEAD -- .
      git -C "$root" ls-files --others --exclude-standard -- .
    } | sort -u
  )
}

if [ "${1:-}" = "--files" ]; then
  changed_files
  exit 0
fi

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ]; then
  toolchain_check "$root"
fi
packages_check "$PWD" || exit 1
export FLOW_CHECKED_APP="$PWD"

is_test() {
  case "$1" in
    tests/*.js | tests/*.mjs | tests/*.cjs | tests/*.jsx) return 0 ;;
    *.test.js | *.test.mjs | *.test.cjs | *.test.jsx) return 0 ;;
    *.spec.js | *.spec.mjs | *.spec.cjs | *.spec.jsx) return 0 ;;
    test-*.js | test-*.mjs | test-*.cjs | test-*.jsx) return 0 ;;
    */test-*.js | */test-*.mjs | */test-*.cjs | */test-*.jsx) return 0 ;;
    *) return 1 ;;
  esac
}

is_source() {
  case "$1" in
    */*) ;;
    *) return 1 ;;
  esac
  case "$1" in
    tests/* | node_modules/* | dist/* | public/* | coverage/* | */node_modules/*) return 1 ;;
  esac
  is_test "$1" && return 1
  case "$1" in
    *.js | *.mjs | *.cjs | *.jsx) return 0 ;;
    *) return 1 ;;
  esac
}

twin_names() {
  local rel="$1" dir stem strip ext
  dir="$(dirname "$rel")"
  stem="$(basename "$rel")"
  stem="${stem%.*}"
  strip="${rel#src/}"
  strip="${strip%.*}"
  for ext in js mjs cjs jsx; do
    printf '%s\n' "tests/$strip.test.$ext" "tests/$strip.spec.$ext" \
      "$dir/$stem.test.$ext" "$dir/$stem.spec.$ext" "$dir/test-$stem.$ext"
  done
}

test_for_source() {
  local c strip
  while IFS= read -r c; do
    if [ -f "$c" ]; then
      echo "$c"
      return
    fi
  done < <(twin_names "$1")
  strip="${1#src/}"
  echo "tests/${strip%.*}.test.js"
}

already() {
  local n="$1" t
  for t in "${tests[@]+"${tests[@]}"}"; do
    [ "$t" = "$n" ] && return 0
  done
  return 1
}

files=()
while IFS= read -r path; do
  files+=("$path")
done < <(changed_files)

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

"$here/format" "${files[@]}"
"$here/lint" "${files[@]}"

tests=()
missing_mirror=()
for path in "${files[@]}"; do
  if is_source "$path"; then
    mirror="$(test_for_source "$path")"
    if [ ! -f "$mirror" ]; then
      missing_mirror+=("$path → $mirror")
    elif ! already "$mirror"; then
      tests+=("$mirror")
    fi
  elif is_test "$path"; then
    if ! already "$path"; then
      tests+=("$path")
    fi
  fi
done

if [ "${#missing_mirror[@]}" -gt 0 ]; then
  for msg in "${missing_mirror[@]}"; do
    echo "bin/changed: no mirrored test for $msg" >&2
  done
  exit 1
fi

if [ "${#tests[@]}" -gt 0 ]; then
  exec "$here/test" "${tests[@]}"
fi
exit 0
