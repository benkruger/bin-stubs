#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ]; then
  toolchain_check "$root"
fi
packages_check "$PWD" || exit 1

covdir="$(mktemp -d)"
trap 'rm -rf "$covdir"' EXIT

rc=0
all=0
paths=()
for arg in "$@"; do
  case "$arg" in
    --all) all=1 ;;
    -*) ;;
    *) paths+=("$arg") ;;
  esac
done

# shellcheck source=../lib/apps.sh
. "$here/../lib/apps.sh"
root_app=0
if [ "$(pwd -P)" = "$(git rev-parse --show-toplevel)" ]; then
  root_app=1
fi

has_own_test() {
  local top="$1"
  [ "$root_app" -eq 1 ] && is_app_dir "$root/$top"
}

owned_change() {
  local path="$1" top
  [ -f "$path" ] || return 1
  top="${path%%/*}"
  if [ "$top" != "$path" ] && has_own_test "$top"; then
    return 1
  fi
  return 0
}

is_test() {
  case "$1" in
    tests/*.js | tests/*.mjs | tests/*.cjs | tests/*.jsx) return 0 ;;
    *.test.js | *.test.mjs | *.test.cjs | *.test.jsx) return 0 ;;
    *.spec.js | *.spec.mjs | *.spec.cjs | *.spec.jsx) return 0 ;;
    test-*.js | test-*.mjs | test-*.cjs | test-*.jsx) return 0 ;;
    */test-*.js | */test-*.mjs | */test-*.cjs | */test-*.jsx) return 0 ;;
    *) return 1 ;;
  esac
}

is_source() {
  case "$1" in
    */*) ;;
    *) return 1 ;;
  esac
  case "$1" in
    tests/* | node_modules/* | dist/* | public/* | coverage/* | */node_modules/*) return 1 ;;
  esac
  is_test "$1" && return 1
  case "$1" in
    *.js | *.mjs | *.cjs | *.jsx) return 0 ;;
    *) return 1 ;;
  esac
}

twin_names() {
  local rel="$1" dir stem strip ext
  dir="${rel%/*}"
  stem="${rel##*/}"
  stem="${stem%.*}"
  strip="${rel#src/}"
  strip="${strip%.*}"
  for ext in js mjs cjs jsx; do
    printf '%s\n' "tests/$strip.test.$ext" "tests/$strip.spec.$ext" \
      "$dir/$stem.test.$ext" "$dir/$stem.spec.$ext" "$dir/test-$stem.$ext"
  done
}

test_for_source() {
  local c strip
  while IFS= read -r c; do
    if [ -f "$c" ]; then
      echo "$c"
      return
    fi
  done < <(twin_names "$1")
  strip="${1#src/}"
  echo "tests/${strip%.*}.test.js"
}

source_candidates() {
  local t="$1" dir base stem rel ext
  dir="."
  [ "${t%/*}" = "$t" ] || dir="${t%/*}"
  base="${t##*/}"
  case "$base" in
    test-*)
      stem="${base#test-}"
      stem="${stem%.*}"
      ;;
    *)
      stem="${base%.*}"
      stem="${stem%.test}"
      stem="${stem%.spec}"
      ;;
  esac
  rel="${dir#tests}"
  rel="${rel#/}"
  for ext in js mjs cjs jsx; do
    printf '%s\n' "$dir/$stem.$ext"
    if [ "$dir" = tests ] || [ "${dir#tests/}" != "$dir" ]; then
      printf '%s\n' "src/${rel:+$rel/}$stem.$ext" "${rel:+$rel/}$stem.$ext"
    fi
  done
}

source_for_test() {
  local s n
  while IFS= read -r s; do
    if [ -f "$s" ] && is_source "$s"; then
      while IFS= read -r n; do
        if [ "$n" = "$1" ]; then
          echo "$s"
          return
        fi
      done < <(twin_names "$s")
    fi
  done < <(source_candidates "$1")
  echo ""
}

already() {
  local n="$1" t
  for t in "${required[@]+"${required[@]}"}"; do
    [ "$t" = "$n" ] && return 0
  done
  return 1
}

run=(npm run test)
targets=()
for arg in "${paths[@]+"${paths[@]}"}"; do
  arg="${arg#./}"
  if is_source "$arg"; then
    twin="$(test_for_source "$arg")"
    if [ ! -f "$twin" ]; then
      echo "bin/test: no mirrored test for $arg → $twin" >&2
      exit 1
    fi
    arg="$twin"
  fi
  targets+=("$arg")
done
if [ "${#targets[@]}" -gt 0 ]; then
  run+=(-- "${targets[@]}")
fi
"$root/node_modules/.bin/c8" --reporter=json-summary --reports-dir="$covdir" "${run[@]}" || rc=$?
covjson="$covdir/coverage-summary.json"

required=()
missing_mirror=()
orphans=()

if [ "${#paths[@]}" -gt 0 ]; then
  for arg in "${paths[@]}"; do
    arg="${arg#./}"
    if is_source "$arg"; then
      already "$arg" || required+=("$arg")
    elif is_test "$arg"; then
      src="$(source_for_test "$arg")"
      if [ -n "$src" ]; then
        already "$src" || required+=("$src")
      else
        orphans+=("$arg")
      fi
    fi
  done
else
  if [ "$all" -eq 1 ]; then
    listing="$(git -C "$root" ls-files --cached --others --exclude-standard -- .)"
  else
    listing="$("$here/changed" --files)"
  fi
  while IFS= read -r path; do
    [ -z "$path" ] && continue
    case "$path" in
      node_modules/* | dist/* | .flow-states/* | */node_modules/* | */.flow-states/*)
        continue
        ;;
    esac
    owned_change "$path" || continue
    if is_source "$path"; then
      already "$path" || required+=("$path")
      mirror="$(test_for_source "$path")"
      if [ ! -f "$mirror" ]; then
        missing_mirror+=("$path → $mirror")
      fi
    elif is_test "$path"; then
      src="$(source_for_test "$path")"
      if [ -n "$src" ]; then
        already "$src" || required+=("$src")
      else
        orphans+=("$path")
      fi
    fi
  done <<<"$listing"
fi

ratchet=0
for msg in "${missing_mirror[@]+"${missing_mirror[@]}"}"; do
  echo "bin/test: no mirrored test for $msg" >&2
  ratchet=1
done
for msg in "${orphans[@]+"${orphans[@]}"}"; do
  echo "bin/test: no source for test $msg" >&2
  ratchet=1
done

if [ "${#required[@]}" -gt 0 ] && [ ! -f "$covjson" ]; then
  echo "bin/test: missing coverage-summary.json" >&2
  exit 1
fi

file_covs() {
  jq -r --arg real "$(pwd -P)" --arg logical "$PWD" '. as $summary | $ARGS.positional[] as $want
    | first($summary | keys_unsorted[] | select(. == $real + "/" + $want or . == $logical + "/" + $want)) // null
    | if . == null then "missing"
      else $summary[.] | [.functions, .lines, .branches, .statements]
        | map(.pct * 100 | round | "\(. / 100 | floor).\(. % 100 | tostring | if length < 2 then "0" + . else . end)")
        | join(" ")
      end' "$covjson" --args "$@"
}

covs=()
if [ "${#required[@]}" -gt 0 ]; then
  rows="$(file_covs "${required[@]}")"
  while IFS= read -r row; do
    covs+=("$row")
  done <<<"$rows"
fi

i=0
for src in "${required[@]+"${required[@]}"}"; do
  cov="${covs[$i]:-}"
  i=$((i + 1))
  if [ ! -f "$src" ]; then
    echo "bin/test: $src is required at 100% but is missing" >&2
    ratchet=1
    continue
  fi
  if [ "$cov" = "missing" ]; then
    echo "bin/test: $src has no coverage row (need 100%)" >&2
    ratchet=1
    continue
  fi
  read -r funcs lines branches stmts <<<"$cov"
  if [ "$cov" != "100.00 100.00 100.00 100.00" ]; then
    echo "bin/test: $src at $funcs functions, $lines lines, $branches branches, $stmts statements (need 100% each)" >&2
    ratchet=1
  fi
done

if [ "$ratchet" -ne 0 ]; then
  exit 1
fi
[ "$rc" -eq 0 ] || exit "$rc"
if [ "$all" -eq 1 ] && [ "${#required[@]}" -eq 0 ]; then
  echo "bin/test: --all found no source to hold at 100%" >&2
  exit 1
fi
echo "bin/test: coverage bar held on ${#required[@]} source(s)"
