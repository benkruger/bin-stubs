#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"
# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
# shellcheck source=../lib/deletions.sh
. "$here/../lib/deletions.sh"
# shellcheck source=lib/files.sh
. "$here/lib/files.sh"
root_app="$(at_repo_root)"

changed_files() {
  local path listing
  listing="$(changed_listing)" || return 1
  while IFS= read -r path; do
    app_file "$path" "$root_app" || continue
    printf '%s\n' "$path"
  done <<<"$listing"
}

if [ "${1:-}" = "--files" ]; then
  changed_files || exit 1
  exit 0
fi

packages_check "$PWD" || exit 1
export FLOW_CHECKED_APP="$PWD"

listing="$(changed_files)"
deleted="$(deleted_paths)"
if [ -z "$listing" ] && [ -z "$deleted" ]; then
  exit 0
fi
files=()
while IFS= read -r path; do
  [ -z "$path" ] || files+=("$path")
done <<<"$listing"
if [ "${#files[@]}" -gt 0 ]; then
  "$here/format" "${files[@]}"
  "$here/lint" "${files[@]}"
fi
"$here/test"
