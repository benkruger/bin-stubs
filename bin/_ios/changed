#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"
# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
packages_check "$PWD" || exit 1
export FLOW_CHECKED_APP="$PWD"
# shellcheck source=../lib/deletions.sh
. "$here/../lib/deletions.sh"
# shellcheck source=lib/files.sh
. "$here/lib/files.sh"
root_app="$(at_repo_root)"

changed_files() {
  local path
  while IFS= read -r path; do
    app_file "$path" "$root_app" || continue
    printf '%s\n' "$path"
  done < <(
    {
      git diff --name-only --relative "$(change_base)" -- .
      git ls-files --others --exclude-standard -- .
    } | sort -u
  )
}

if [ "${1:-}" = "--files" ]; then
  changed_files
  exit 0
fi

if [ -z "$(changed_files)" ] && [ -z "$(deleted_paths)" ]; then
  exit 0
fi
"$here/format"
"$here/lint"
"$here/test"
