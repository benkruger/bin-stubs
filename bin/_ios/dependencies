#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"
# shellcheck source=lib/xcode.sh
. "$here/lib/xcode.sh"
if xcode_container; then
  aside="$(mktemp -d "${TMPDIR:-/tmp}/bin-ios-dependencies.XXXXXX")"
  moved=()
  restore=1
  trap 'i=0
    for file in ${moved[@]+"${moved[@]}"}; do
      [ "$restore" -eq 0 ] || [ ! -e "$aside/$i" ] || mv "$aside/$i" "$file" || true
      i=$((i + 1))
    done
    rm -rf "$aside"' EXIT
  trap 'exit 130' INT TERM HUP
  while IFS= read -r -d '' file; do
    moved+=("$file")
  done < <(find "${XCODE_ARGS[1]}" -path '*/xcshareddata/swiftpm/Package.resolved' -print0)
  state="$root/.build/xcode-packages/workspace-state.json"
  [ ! -f "$state" ] || moved+=("$state")
  i=0
  for file in ${moved[@]+"${moved[@]}"}; do
    mv "$file" "$aside/$i"
    i=$((i + 1))
  done
  if xcodebuild -resolvePackageDependencies "${XCODE_ARGS[@]}" -derivedDataPath "$root/.build/xcode-build"; then
    restore=0
    exit 0
  fi
  exit 1
fi
swift package update
