#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"
# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
packages_check "$PWD" || exit 1
all=0
paths=()
for arg in "$@"; do
  case "$arg" in
    --all) all=1 ;;
    -*)
      echo "bin/lint: unknown argument: $arg" >&2
      exit 2
      ;;
    *) paths+=("$arg") ;;
  esac
done
# shellcheck source=../lib/apps.sh
. "$here/../lib/apps.sh"
# shellcheck source=lib/files.sh
. "$here/lib/files.sh"
swift_files "$all" "$here" ${paths[@]+"${paths[@]}"}
if [ "${#SWIFT_FILES[@]}" -eq 0 ]; then
  exit 0
fi
xcrun swift-format lint --strict "${SWIFT_FILES[@]}"
