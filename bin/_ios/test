#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"
# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
packages_check "$PWD" || exit 1

args=()
for arg in "$@"; do
  case "$arg" in
    --all | *.swift | */*) ;;
    *) args+=("$arg") ;;
  esac
done
set -- ${args[@]+"${args[@]}"}
whole=0
[ "$#" -gt 0 ] || whole=1

coverage_ok() {
  local report="$1" required="${2:-}"
  REQUIRED_SOURCES="$required" python3 - "$report" "$whole" "$(pwd -P)" "$PWD" <<'PY'
import json, os, sys
report = json.load(open(sys.argv[1]))
whole = sys.argv[2] == "1"
required = [s for s in os.environ.get("REQUIRED_SOURCES", "").split("\n") if s]
seen = set()
checked = 0
files = []
if "targets" in report:
    for target in report["targets"]:
        name = target.get("name", "")
        if name.endswith(".xctest"):
            continue
        files.extend(target.get("files", []))
else:
    data = report["data"][0] if "data" in report else report
    files = data.get("files", [])
roots = [r.rstrip("/") + "/" for r in sys.argv[3:5]]
bad = []
for f in files:
    name = f.get("path") or f.get("filename") or f.get("name") or ""
    rel = next((name[len(r):] for r in roots if name.startswith(r)), None)
    if rel is None or rel.startswith(("Tests/", ".build/")):
        continue
    seen.add(rel)
    summary = f.get("summary", {})
    lines = summary.get("lines", {})
    count = lines.get("count", 0)
    covered = lines.get("covered", 0)
    pct = f.get("lineCoverage")
    if pct is None and count:
        pct = covered / count
    if pct is None:
        continue
    checked += 1
    if pct < 1:
        bad.append(f"{name}: {int(float(pct) * 100)}%")
bad.extend(f"{s}: no coverage row; no test target links it" for s in required if s not in seen)
if bad:
    print("FAIL: line coverage is under 100%")
    print("\n".join(bad))
    sys.exit(1)
if whole and checked == 0:
    print("bin/test: llvm-cov measured no source", file=sys.stderr)
    sys.exit(1)
print(f"bin/test: coverage bar held on {checked} source(s)")
PY
}

xcode_test() {
  local destination bundle
  destination="$(xcode_destination)"
  results="$(mktemp -d "${TMPDIR:-/tmp}/bin-xcresult.XXXXXX")"
  trap 'rm -rf "$results"' EXIT
  bundle="$results/Result.xcresult"
  xcodebuild test "${XCODE_ARGS[@]}" -disableAutomaticPackageResolution -destination "$destination" \
    -derivedDataPath "$root/.build/xcode-test" -enableCodeCoverage YES -resultBundlePath "$bundle" "$@"
  xcrun xccov view --report --json "$bundle" >"$bundle.json"
  coverage_ok "$bundle.json"
}

# shellcheck source=lib/xcode.sh
. "$here/lib/xcode.sh"
if xcode_container; then
  xcode_test "$@"
  exit 0
fi

if [ ! -f Package.swift ]; then
  echo "bin/test: no xcodeproj, workspace, or Package.swift" >&2
  exit 1
fi

swift test --disable-automatic-resolution --enable-code-coverage -Xswiftc -warnings-as-errors -Xcc -Werror "$@"
prof="$(find .build -name 'default.profdata' | head -n 1)"
binaries=()
while IFS= read -r binary; do
  binaries+=("$binary")
done < <(find .build/debug/ -type f -path '*.xctest/Contents/MacOS/*' ! -path '*.dSYM/*' | sort)
if [ -z "$prof" ] || [ "${#binaries[@]}" -eq 0 ]; then
  echo "bin/test: swift test left no coverage data to check" >&2
  exit 1
fi
objects=()
for binary in "${binaries[@]:1}"; do
  objects+=(-object "$binary")
done
for binary in "${binaries[@]}"; do
  [ ! -d "$binary.dSYM" ] || mv "$binary.dSYM" "$binary.dSYM.aside"
done
cov_rc=0
roots="$(perl -e 'print join "|", map { quotemeta } @ARGV' "$(pwd -P)" "$PWD")"
xcrun llvm-cov export "${binaries[0]}" ${objects[@]+"${objects[@]}"} -instr-profile "$prof" -format=text \
  "-ignore-filename-regex=^($roots)/(Tests|\.build)/" >"$root/.coverage.json" || cov_rc=$?
for binary in "${binaries[@]}"; do
  [ ! -d "$binary.dSYM.aside" ] || mv "$binary.dSYM.aside" "$binary.dSYM"
done
if [ "$cov_rc" -ne 0 ]; then
  rm -f "$root/.coverage.json"
  echo "bin/test: llvm-cov could not export the coverage" >&2
  exit 1
fi
cov_ok=0
required=""
if [ "$whole" -eq 1 ]; then
  required="$(git ls-files --cached --others --exclude-standard -- 'Sources/*.swift')"
fi
coverage_ok "$root/.coverage.json" "$required" || cov_ok=$?
rm -f "$root/.coverage.json"
exit "$cov_ok"
