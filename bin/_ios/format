#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"
# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
packages_check "$PWD" || exit 1
check=0
all=0
paths=()
for arg in "$@"; do
  case "$arg" in
    --all) all=1 ;;
    --check) check=1 ;;
    -*)
      echo "bin/format: unknown argument: $arg" >&2
      exit 2
      ;;
    *) paths+=("$arg") ;;
  esac
done
# shellcheck source=../lib/apps.sh
. "$here/../lib/apps.sh"
# shellcheck source=lib/files.sh
. "$here/lib/files.sh"
swift_files "$all" "$here" ${paths[@]+"${paths[@]}"}
if [ "${#SWIFT_FILES[@]}" -eq 0 ]; then
  exit 0
fi
files=("${SWIFT_FILES[@]}")

mirror_check() {
  local real copy dir differ file unformatted=0
  real="$(pwd -P)"
  copy="$mirror$real"
  mkdir -p "$copy" || return 2
  dir="$real"
  while :; do
    if [ -f "$dir/.swift-format" ]; then
      { mkdir -p "$mirror$dir" && cp "$dir/.swift-format" "$mirror$dir/"; } || return 2
    fi
    [ -n "$dir" ] || break
    dir="${dir%/*}"
  done
  app_files --links '*.swift-format' || return 2
  printf '%s\0' "${files[@]}" ${APP_FILES[@]+"${APP_FILES[@]}"} |
    tar -chf - --null -T - | tar -xf - -C "$copy" || return 2
  (cd "$copy" && xcrun swift-format format --in-place --parallel "${files[@]}") 2>"$mirror/err" || return 2
  differ="$(COPY="$copy" perl -e '
    for my $file (@ARGV) {
      open my $real, "<", $file or exit 2;
      open my $formatted, "<", "$ENV{COPY}/$file" or exit 2;
      local $/;
      print "$file\n" if <$real> ne <$formatted>;
    }' "${files[@]}")" || return 2
  cat "$mirror/err" >&2
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    echo "bin/format: $file is not formatted (bin/format rewrites it)" >&2
    unformatted=1
  done <<<"$differ"
  return "$unformatted"
}

if [ "$check" -eq 1 ]; then
  mirror="$(mktemp -d "${TMPDIR:-/tmp}/bin-ios-format.XXXXXX")"
  trap 'rm -rf "$mirror" "${APP_FILES_LISTED:-}"' EXIT
  rc=0
  mirror_check || rc=$?
  [ "$rc" -eq 2 ] || exit "$rc"
  unformatted=0
  for file in "${files[@]}"; do
    if ! xcrun swift-format format "$file" | cmp -s - "$file"; then
      echo "bin/format: $file is not formatted (bin/format rewrites it)" >&2
      unformatted=1
    fi
  done
  exit "$unformatted"
fi
xcrun swift-format format --in-place --parallel "${files[@]}"
