#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ]; then
  toolchain_check "$root"
fi
packages_check "$PWD" || exit 1

STRICT_FLAGS='["alwaysStrict", "noImplicitAny", "noImplicitThis", "strictBindCallApply", "strictBuiltinIteratorReturn", "strictFunctionTypes", "strictNullChecks", "strictPropertyInitialization", "useUnknownInCatchVariables"]'
tsc="$root/node_modules/.bin/tsc"
mkdir -p "$root/.flow-states"
scratch="$(mktemp -d "$root/.flow-states/bin-typescript-build.XXXXXX")"
trap 'rm -rf "$scratch"' EXIT
config="$scratch/shown.json"
listed="$scratch/listed"

# shellcheck source=../lib/apps.sh
. "$here/../lib/apps.sh"
root_app=0
if [ "$(pwd -P)" = "$(git rev-parse --show-toplevel)" ]; then
  root_app=1
fi
siblings=()
if [ "$root_app" -eq 1 ]; then
  for dir in ./*/; do
    if [ -d "$dir" ] && is_app_dir "$dir"; then
      dir="${dir%/}"
      siblings+=("${dir#./}")
    fi
  done
fi

"$tsc" --showConfig >"$config" 2>&1 &
shown=$!
status=0
if jq -e '(.scripts.build // "") != ""' package.json >/dev/null; then
  npm run build || status=1
fi
[ "${#siblings[@]}" -gt 0 ] || "$tsc" --noEmit || status=1
if ! wait "$shown"; then
  cat "$config" >&2
  exit 1
fi
if [ "${#siblings[@]}" -gt 0 ]; then
  jq --arg base "$(pwd -P)/tsconfig.json" --arg root "$(pwd -P)" '{extends: $base, include: [],
    files: [.files[]? | sub("^\\./"; "") | select(. as $f | all($ARGS.positional[]; . as $s | $f | startswith($s + "/") | not))
      | $root + "/" + .]}' "$config" --args "${siblings[@]}" >"$scratch/tsconfig.json"
  "$tsc" --noEmit -p "$scratch/tsconfig.json" || status=1
fi

while IFS= read -r loose; do
  echo "bin/build: tsconfig turns type checking down: $loose" >&2
  status=1
done < <(jq -r --argjson flags "$STRICT_FLAGS" '.compilerOptions as $o
  | (if $o.strict == true then empty else "strict is not true" end),
    ($flags[] | select($o[.] == false) | "\(.) is false"),
    (if $o.noCheck == true then "noCheck is true" else empty end)' "$config")

git ls-files -z --cached --others --exclude-standard -- '*.ts' '*.tsx' '*.mts' '*.cts' >"$scratch/sources"
sources=()
while IFS= read -r -d '' path; do
  [ -f "$path" ] || continue
  case "$path" in
    node_modules/* | .venv/* | .flow-states/* | */node_modules/* | */.venv/* | */.flow-states/*) continue ;;
  esac
  top="${path%%/*}"
  if [ "$root_app" -eq 1 ] && [ "$top" != "$path" ] && is_app_dir "$root/$top"; then
    continue
  fi
  sources+=("$path")
done <"$scratch/sources"

jq -r '.files[]? | sub("^\\./"; "")' "$config" >"$listed"
outside=""
if [ "${#sources[@]}" -gt 0 ]; then
  outside="$(printf '%s\n' "${sources[@]}" | awk -v listed="$listed" '
    BEGIN { while ((getline line < listed) > 0) seen[line] = 1 }
    !($0 in seen)')"
fi
while IFS= read -r path; do
  [ -n "$path" ] || continue
  echo "bin/build: $path is outside tsconfig's files, so tsc never checks it" >&2
  status=1
done <<<"$outside"
if jq -e '.compilerOptions.skipLibCheck == true' "$config" >/dev/null; then
  for path in "${sources[@]+"${sources[@]}"}"; do
    if [[ "$path" =~ \.d\.[cm]?ts$ ]]; then
      echo "bin/build: skipLibCheck skips the app's own $path" >&2
      status=1
    fi
  done
fi
exit "$status"
