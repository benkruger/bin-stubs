#!/usr/bin/env bash
set -euo pipefail

all=0
args=()
for arg in "$@"; do
  case "$arg" in
    --all) all=1 ;;
    *) args+=("$arg") ;;
  esac
done
set -- ${args[@]+"${args[@]}"}
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ]; then
  toolchain_check "$root"
fi
packages_check "$PWD" || exit 1

covdir="$(mktemp -d)"
trap 'rm -rf "$covdir"' EXIT

filtered=0
for arg in "$@"; do
  case "$arg" in
    -*) ;;
    *) filtered=1 ;;
  esac
done

run=("$root/node_modules/.bin/vitest" run --coverage
  --coverage.reporter=json-summary "--coverage.reportsDirectory=$covdir")
if [ "$filtered" -eq 1 ]; then
  run+=(--coverage.thresholds.lines=0 --coverage.thresholds.branches=0
    --coverage.thresholds.functions=0 --coverage.thresholds.statements=0)
fi
rc=0
"${run[@]}" "$@" || rc=$?
if [ "$rc" -ne 0 ]; then
  exit "$rc"
fi
covjson="$covdir/coverage-summary.json"

# shellcheck source=../lib/apps.sh
. "$here/../lib/apps.sh"
root_app=0
if [ "$(pwd -P)" = "$(git rev-parse --show-toplevel)" ]; then
  root_app=1
fi

has_own_test() {
  local top="$1"
  [ "$root_app" -eq 1 ] && is_app_dir "$root/$top"
}

owned_change() {
  local path="$1" top
  [ -f "$path" ] || return 1
  top="${path%%/*}"
  if [ "$top" != "$path" ] && has_own_test "$top"; then
    return 1
  fi
  return 0
}

is_source() {
  local rest="${1#src/}"
  [ "$rest" != "$1" ] || return 1
  case "$1" in
    *.test.ts | *.test.tsx | *.test.mts | *.test.cts) return 1 ;;
    *.d.ts | *.d.mts | *.d.cts) return 1 ;;
    *.ts | *.tsx | *.mts | *.cts) return 0 ;;
    *) return 1 ;;
  esac
}

is_test() {
  local rest="${1#tests/}"
  [ "$rest" != "$1" ] || return 1
  case "$1" in
    *.test.ts | *.test.tsx | *.test.mts | *.test.cts) return 0 ;;
    *) return 1 ;;
  esac
}

test_for_source() {
  local rel="${1#src/}" ext
  rel="${rel%.*}"
  for ext in ts tsx mts cts; do
    if [ -f "tests/${rel}.test.${ext}" ]; then
      echo "tests/${rel}.test.${ext}"
      return
    fi
  done
  echo "tests/${rel}.test.${1##*.}"
}

source_for_test() {
  local rel="${1#tests/}"
  rel="${rel%.test.ts}"
  rel="${rel%.test.tsx}"
  rel="${rel%.test.mts}"
  rel="${rel%.test.cts}"
  if [ -f "src/${rel}.tsx" ]; then
    echo "src/${rel}.tsx"
  elif [ -f "src/${rel}.mts" ]; then
    echo "src/${rel}.mts"
  elif [ -f "src/${rel}.cts" ]; then
    echo "src/${rel}.cts"
  else
    echo "src/${rel}.ts"
  fi
}

file_covs() {
  jq -r '. as $summary | $ARGS.positional[] as $want
    | first($summary | keys_unsorted[] | select(. == $want or endswith("/" + $want))) // null
    | if . == null then "missing"
      else $summary[.] | [.functions, .lines, .branches, .statements]
        | map(.pct * 100 | round | "\(. / 100 | floor).\(. % 100 | tostring | if length < 2 then "0" + . else . end)")
        | join(" ")
      end' "$covjson" --args "$@"
}

already() {
  local n="$1" t
  for t in "${required[@]+"${required[@]}"}"; do
    [ "$t" = "$n" ] && return 0
  done
  return 1
}

required=()
missing_mirror=()
orphans=()

if [ "$#" -gt 0 ]; then
  for arg in "$@"; do
    case "$arg" in
      -*) continue ;;
    esac
    arg="${arg#./}"
    if is_source "$arg"; then
      already "$arg" || required+=("$arg")
    elif is_test "$arg"; then
      src="$(source_for_test "$arg")"
      if [ -f "$src" ]; then
        already "$src" || required+=("$src")
      else
        orphans+=("$arg → $src")
      fi
    fi
  done
else
  if [ "$all" -eq 1 ]; then
    listing="$(git -C "$root" ls-files --cached --others --exclude-standard -- .)"
  else
    listing="$("$here/changed" --files)"
  fi
  while IFS= read -r path; do
    [ -z "$path" ] && continue
    case "$path" in
      node_modules/* | .venv/* | .flow-states/* | */node_modules/* | */.venv/* | */.flow-states/*)
        continue
        ;;
    esac
    owned_change "$path" || continue
    if is_source "$path"; then
      already "$path" || required+=("$path")
      mirror="$(test_for_source "$path")"
      if [ ! -f "$mirror" ]; then
        missing_mirror+=("$path → $mirror")
      fi
    elif is_test "$path"; then
      src="$(source_for_test "$path")"
      if [ -f "$src" ]; then
        already "$src" || required+=("$src")
      else
        orphans+=("$path → $src")
      fi
    fi
  done <<<"$listing"
fi

ratchet=0
for msg in "${missing_mirror[@]+"${missing_mirror[@]}"}"; do
  echo "bin/test: no mirrored test for $msg" >&2
  ratchet=1
done
for msg in "${orphans[@]+"${orphans[@]}"}"; do
  echo "bin/test: no source for test $msg" >&2
  ratchet=1
done

covs=()
if [ "${#required[@]}" -gt 0 ]; then
  rows="$(file_covs "${required[@]}")"
  while IFS= read -r row; do
    covs+=("$row")
  done <<<"$rows"
fi

i=0
for src in "${required[@]+"${required[@]}"}"; do
  cov="${covs[$i]:-}"
  i=$((i + 1))
  if [ ! -f "$src" ]; then
    echo "bin/test: $src is required at 100% but is missing" >&2
    ratchet=1
    continue
  fi
  if [ "$cov" = "missing" ]; then
    echo "bin/test: $src has no coverage row (need 100%)" >&2
    ratchet=1
    continue
  fi
  read -r funcs lines branches stmts <<<"$cov"
  if [ "$cov" != "100.00 100.00 100.00 100.00" ]; then
    echo "bin/test: $src at $funcs functions, $lines lines, $branches branches, $stmts statements (need 100% each)" >&2
    ratchet=1
  fi
done

if [ "$ratchet" -ne 0 ]; then
  exit 1
fi
if [ "$all" -eq 1 ] && [ "${#required[@]}" -eq 0 ]; then
  echo "bin/test: --all found no source to hold at 100%" >&2
  exit 1
fi
echo "bin/test: coverage bar held on ${#required[@]} source(s)"
exit "$rc"
