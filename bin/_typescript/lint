#!/usr/bin/env bash
set -euo pipefail

UNGATED_NAMES=(.gitignore .nvmrc package-lock.json .ci-timeout)
UNGATED_PATHS=()
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ]; then
  toolchain_check "$root"
fi
packages_check "$PWD" || exit 1

all=0
paths=()
for arg in "$@"; do
  case "$arg" in
    --all) all=1 ;;
    *) paths+=("$arg") ;;
  esac
done

if [ "$all" -eq 1 ]; then
  listing="$(git -C "$root" ls-files --cached --others --exclude-standard -- .)"
elif [ "${#paths[@]}" -gt 0 ]; then
  listing="$(printf '%s\n' "${paths[@]}")"
else
  listing="$("$here/changed" --files)"
fi

# shellcheck source=../lib/apps.sh
. "$here/../lib/apps.sh"
root_app=0
if [ "$(pwd -P)" = "$(git rev-parse --show-toplevel)" ]; then
  root_app=1
fi

has_own_lint() {
  local top="$1"
  [ "$root_app" -eq 1 ] && is_app_dir "$root/$top"
}

files=()
while IFS= read -r path; do
  [ -z "$path" ] && continue
  [ -f "$path" ] || continue
  case "$path" in
    node_modules/* | .venv/* | .flow-states/* | */node_modules/* | */.venv/* | */.flow-states/*)
      continue
      ;;
  esac
  top="${path%%/*}"
  if [ "$top" != "$path" ] && has_own_lint "$top"; then
    continue
  fi
  files+=("$path")
done <<<"$listing"

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

is_ungated() {
  local path="$1" name entry
  name="${path##*/}"
  for entry in "${UNGATED_NAMES[@]}"; do
    [ "$name" = "$entry" ] && return 0
  done
  for entry in "${UNGATED_PATHS[@]+"${UNGATED_PATHS[@]}"}"; do
    [ "$path" = "$entry" ] && return 0
  done
  return 1
}

is_bash_script() {
  local first="" shebang='^#!(.*[^[:alnum:]_])?bash([^[:alnum:]_]|$)'
  case "$1" in
    *.sh | *.bash) return 0 ;;
  esac
  IFS= read -r first <"$1" || true
  [[ "$first" =~ $shebang ]]
}

gated=()
for path in "${files[@]}"; do
  case "$path" in
    *.md) continue ;;
  esac
  if [ -L "$path" ] || is_ungated "$path" || is_bash_script "$path"; then
    continue
  fi
  gated+=("$path")
done

logs="$(mktemp -d "${TMPDIR:-/tmp}/bin-typescript-lint.XXXXXX")"
trap 'rm -rf "$logs"' EXIT
pids=()

in_background() {
  local log="$logs/${#pids[@]}"
  "$@" >"$log.out" 2>"$log.err" 3>"$log.pre" &
  pids+=("$!")
}

if [ "${#gated[@]}" -gt 0 ]; then
  in_background node --input-type=module -e '
    import { readFileSync, writeSync } from "node:fs";
    import { extname } from "node:path";
    import { inspect } from "node:util";
    const { ESLint } = await import("eslint");
    const prettier = await import("prettier");
    const files = process.argv.slice(1);
    const eslint = new ESLint();
    const kinds = [
      { name: "@eslint/js", exts: ["js", "mjs", "cjs", "jsx", "ts", "tsx", "mts", "cts"], configs: (js) => [js.configs.recommended] },
      { name: "typescript-eslint", exts: ["ts", "tsx", "mts", "cts"], configs: (ts) => ts.configs.recommended },
      { name: "@eslint/json", exts: ["json", "jsonc", "json5"], family: true, configs: (json) => [{ ...json.configs.recommended, language: "json/json" }] },
      { name: "@eslint/css", exts: ["css"], family: true, configs: (css) => [{ ...css.configs.recommended, language: "css/css" }] },
    ];
    for (const kind of kinds) {
      kind.plugin = (await import(kind.name).catch(() => ({}))).default;
    }
    const baseline = new ESLint({
      overrideConfigFile: true,
      overrideConfig: kinds
        .filter((kind) => kind.plugin)
        .flatMap((kind) => kind.configs(kind.plugin).map((config) => ({ ...config, files: kind.exts.map((ext) => "**/*." + ext) }))),
    });
    let failed = false;
    const report = (line) => {
      writeSync(3, line + "\n");
      failed = true;
    };
    try {
      for (const file of files) {
        const info = await prettier.getFileInfo(file, { resolveConfig: true });
        const options = await prettier.resolveConfig(file);
        if (info.ignored || info.inferredParser === null || options?.requirePragma || options?.checkIgnorePragma) {
          report(file + ": no formatter (Prettier)");
        }
        const ignored = await eslint.isPathIgnored(file);
        const config = ignored ? undefined : await eslint.calculateConfigForFile(file);
        if (Object.keys(config?.rules ?? {}).length === 0) {
          report(file + ": no linter (no ESLint rules apply)");
        }
        if (config?.processor) {
          report(file + ": ESLint runs a processor on it");
        }
        const needs = kinds.filter((kind) => kind.exts.includes(extname(file).slice(1)));
        for (const kind of needs.filter((need) => !need.plugin)) {
          report(file + ": ESLint needs " + kind.name + " for its recommended rules");
        }
        if (config && needs.length > 0 && needs.every((need) => need.plugin)) {
          const base = await baseline.calculateConfigForFile(file);
          const rules = config.rules ?? {};
          const off = Object.entries(base?.rules ?? {})
            .filter(([id, [level]]) => level > 0 && !(rules[id]?.[0] > 0) && !(rules["@typescript-eslint/" + id]?.[0] > 0))
            .map(([id]) => id);
          if (off.length > 0) {
            report(file + ": recommended ESLint rules not on: " + off.join(", "));
          }
          const languages = needs.flatMap((need) => (need.family ? Object.values(need.plugin.languages ?? {}) : []));
          if (![base?.language, ...languages].includes(config.language)) {
            report(file + ": ESLint parses it as another language");
          }
        }
      }
    } catch (error) {
      writeSync(3, inspect(error) + "\n");
      failed = true;
    }
    process.on("exit", () => {
      if (failed && !process.exitCode) process.exitCode = 1;
    });
    const manifest = new URL(import.meta.resolve("eslint/package.json"));
    const { bin } = JSON.parse(readFileSync(manifest, "utf8"));
    process.argv = [process.argv[0], "eslint", "--max-warnings=0", ...files];
    await import(new URL(typeof bin === "string" ? bin : bin.eslint, manifest));
  ' "${gated[@]}"
fi

status=0
for i in ${pids[@]+"${!pids[@]}"}; do
  wait "${pids[$i]}" || status=1
  cat "$logs/$i.pre" >&2
  cat "$logs/$i.out"
  cat "$logs/$i.err" >&2
done
exit "$status"
