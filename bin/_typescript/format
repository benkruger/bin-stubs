#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ]; then
  toolchain_check "$root"
fi
packages_check "$PWD" || exit 1

# shellcheck source=../lib/apps.sh
. "$here/../lib/apps.sh"
root_app=0
if [ "$(pwd -P)" = "$(git rev-parse --show-toplevel)" ]; then
  root_app=1
fi

has_own_format() {
  local top="$1"
  [ "$root_app" -eq 1 ] && is_app_dir "$root/$top"
}

all=0
check=0
paths=()
for arg in "$@"; do
  case "$arg" in
    --all) all=1 ;;
    --check) check=1 ;;
    -*)
      echo "bin/format: unknown argument: $arg" >&2
      exit 2
      ;;
    *) paths+=("$arg") ;;
  esac
done

if [ "$all" -eq 1 ]; then
  listing="$(git -C "$root" ls-files -z --cached --others --exclude-standard -- . | tr '\0' '\n')"
elif [ "${#paths[@]}" -gt 0 ]; then
  listing="$(named_files "${paths[@]}")"
else
  listing="$("$here/changed" --files)"
fi

files=()
while IFS= read -r path; do
  [ -z "$path" ] && continue
  [ -f "$path" ] && [ ! -L "$path" ] || continue
  case "$path" in
    node_modules/* | .venv/* | .flow-states/* | */node_modules/* | */.venv/* | */.flow-states/*)
      continue
      ;;
    *.md) continue ;;
  esac
  top="${path%%/*}"
  if [ "$top" != "$path" ] && has_own_format "$top"; then
    continue
  fi
  files+=("$path")
done <<<"$listing"

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

if [ "$check" -eq 1 ]; then
  exec "$root/node_modules/.bin/prettier" --check --ignore-unknown --log-level=warn "${files[@]}"
fi
exec "$root/node_modules/.bin/prettier" --write --ignore-unknown --log-level=warn "${files[@]}"
