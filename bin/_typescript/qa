#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ]; then
  toolchain_check "$root"
fi

packages_check "$root" || exit 1
playwright="$root/node_modules/.bin/playwright"
if [ ! -x "$playwright" ]; then
  echo "bin/qa: this app has no Playwright; add @playwright/test as a dev dependency" >&2
  exit 1
fi
"$playwright" install chromium

out="$(mktemp -d "${TMPDIR:-/tmp}/bin-typescript-qa.XXXXXX")"
keep=0
trap '[ "$keep" -eq 1 ] || rm -rf "$out"' EXIT
config=()
if ! compgen -G "$root/playwright.config.*" >/dev/null; then
  jq -n -r --arg dir "$root/e2e" '"export default { testDir: \($dir | tojson) };"' >"$out/playwright.config.mjs"
  config=(--config "$out/playwright.config.mjs")
fi
rc=0
PLAYWRIGHT_HTML_OUTPUT_DIR="$out/playwright-report" PLAYWRIGHT_BLOB_OUTPUT_DIR="$out/blob-report" \
  "$playwright" test --output "$out/test-results" ${config[@]+"${config[@]}"} "$@" 2>&1 | tee "$out/qa.log" || rc=$?
if [ "$rc" -ne 0 ]; then
  keep=1
  echo "bin/qa: an end-to-end test failed; Playwright's results and report are in $out" >&2
  exit "$rc"
fi
if grep -qiE 'npm warn|DeprecationWarning|^Warning: ' "$out/qa.log"; then
  echo "bin/qa: the run printed a warning (above)" >&2
  exit 1
fi
