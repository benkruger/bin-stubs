#!/usr/bin/env bash
set -euo pipefail
export PATH="${HOME}/.local/bin:${PATH}"
export UV_NO_SYNC=1

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"

force=0
clean=0
for arg in "$@"; do
  case "$arg" in
    --force) force=1 ;;
    --clean) clean=1 ;;
    *)
      echo "bin/ci: unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

branch="$(git rev-parse --abbrev-ref HEAD)"
case "$branch" in
  "" | "." | "..")
    echo "bin/ci: refusing to build a sentinel path for unsafe branch: '$branch'" >&2
    exit 2
    ;;
esac

sentinel="$root/.flow-states/$branch/ci-sentinel"

if [[ "$clean" -eq 1 ]]; then
  rm -f "$sentinel" "$root/.flow-states/$branch"/ci-*-sentinel
  echo "bin/ci: cleaned sentinel for $branch"
  exit 0
fi

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ] && ! toolchain_check "$root"; then
  echo "bin/ci: gate RED ($branch) — the toolchain does not match its pin (above)." >&2
  exit 1
fi

if [ "$(pwd -P)" = "$(git rev-parse --show-toplevel)" ]; then
  ROOT_APP=1
fi
# shellcheck source=../lib/tree-sentinel.sh
. "$here/../lib/tree-sentinel.sh"

pre_hash="$(tree_hash)"

if [[ "$force" -eq 0 && -f "$sentinel" && "$(cat "$sentinel")" == "$pre_hash" ]]; then
  exit 0
fi

label="$(basename "$root")"
echo ""
echo "═══ $label ════════════════════════════════════"
log="$(mktemp)"
trap 'rm -f "$log"' EXIT

if ! packages_check "$root"; then
  echo "bin/ci: gate RED ($branch) — packages are not installed (above)." >&2
  exit 1
fi

spin() {
  local spin_label="$1" i=0 frames="|/-\\"
  while :; do
    printf '\rbin/ci: %s %s ' "$spin_label" "${frames:i++%4:1}"
    sleep 0.1
  done
}

step=0
run_step() {
  local name="$1"
  shift
  step=$((step + 1))
  local step_label="[$step/4] $name"
  local step_sentinel="$root/.flow-states/$branch/ci-$name-sentinel"
  if [ "$force" -eq 0 ] && [ -f "$step_sentinel" ] && [ "$(cat "$step_sentinel")" = "$pre_hash" ]; then
    echo "bin/ci: $step_label ✓ (unchanged since it passed)"
    return 0
  fi
  local rc=0
  if [ -t 1 ]; then
    spin "$step_label" &
    local sp=$!
    "$@" >>"$log" 2>&1 || rc=$?
    kill "$sp" 2>/dev/null || true
    wait "$sp" 2>/dev/null || true
    local mark="✓"
    [ "$rc" -eq 0 ] || mark="✗"
    printf '\rbin/ci: %s %s\033[K\n' "$step_label" "$mark"
  else
    "$@" >>"$log" 2>&1 || rc=$?
    local mark="✓"
    [ "$rc" -eq 0 ] || mark="✗"
    echo "bin/ci: $step_label $mark"
  fi
  if [ "$rc" -ne 0 ]; then
    grep -v '| *100.00 | *100.00 |' "$log" >&2 || true
    echo "bin/ci: gate RED ($branch) — step '$name' failed (above; 100%-covered rows elided)." >&2
    exit "$rc"
  fi
  mkdir -p "$(dirname "$step_sentinel")"
  printf '%s\n' "$pre_hash" >"$step_sentinel"
}

run_step format "$here/format" --check --all
run_step lint "$here/lint" --all
run_step build "$here/build"
run_step test "$here/test" --all

tally="$(grep -E '[0-9]+ passed' "$log" | tail -n1 || true)"

mkdir -p "$(dirname "$sentinel")"
tree_hash >"$sentinel"
echo "bin/ci: gate green ($branch)${tally:+ — $tally} — sentinel written."
