#!/usr/bin/env bash
set -euo pipefail
export PATH="${HOME}/.local/bin:${PATH}"
export UV_NO_SYNC=1
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"
# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
packages_check "$PWD" || exit 1
PYTHONPYCACHEPREFIX="$(mktemp -d "${TMPDIR:-/tmp}/bin-python-build.XXXXXX")"
export PYTHONPYCACHEPREFIX
trap 'rm -rf "$PYTHONPYCACHEPREFIX"' EXIT

# shellcheck source=../lib/apps.sh
. "$here/../lib/apps.sh"
root_app=0
if [ "$(pwd -P)" = "$(git rev-parse --show-toplevel)" ]; then
  root_app=1
fi
files=()
while IFS= read -r -d '' path; do
  [ -f "$path" ] || continue
  case "$path" in
    node_modules/* | .venv/* | .flow-states/* | */node_modules/* | */.venv/* | */.flow-states/*) continue ;;
  esac
  top="${path%%/*}"
  if [ "$root_app" -eq 1 ] && [ "$top" != "$path" ] && is_app_dir "$root/$top"; then
    continue
  fi
  files+=("$path")
done < <(git ls-files -z --cached --others --exclude-standard -- '*.py' '*.pyi')
if [ "${#files[@]}" -gt 0 ]; then
  uv run python -m compileall -q "${files[@]}"
  uv run python -m mypy --strict "${files[@]}"
fi
