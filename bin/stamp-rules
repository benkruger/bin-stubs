#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"

stamp_one() {
  f="$1"
  tmp="$(mktemp)"
  perl -0777 -pe 's/\n<!-- audited: [0-9a-f]{12} -->\s*\z/\n/; s/\s*\z/\n/' \
    "$f" >"$tmp"
  h="$(shasum -a 256 "$tmp" | cut -c1-12)"
  printf '<!-- audited: %s -->\n' "$h" >>"$tmp"
  cat "$tmp" >"$f"
  rm -f "$tmp"
}

if [ "$#" -gt 0 ]; then
  for f in "$@"; do
    stamp_one "$f"
  done
else
  while IFS= read -r -d '' f; do
    stamp_one "$f"
  done < <(find "$root/.claude/rules" -name '*.md' -print0)
fi
