#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${APP_DIR:-$HERE/../..}" && pwd)"
cd "$REPO_ROOT"
# shellcheck source=lib/toolchain.sh
. "$HERE/lib/toolchain.sh"
# shellcheck source=lib/sources.sh
. "$HERE/lib/sources.sh"
# shellcheck source=../lib/deletions.sh
. "$HERE/../lib/deletions.sh"

changed_files() {
  local path listing
  listing="$(changed_listing)" || return 1
  while IFS= read -r path; do
    [ -z "$path" ] && continue
    [ -f "$path" ] || continue
    ! in_nested_app "$path" || continue
    case "$path" in
      vendor/* | tmp/* | log/* | coverage/* | .flow-states/*) continue ;;
    esac
    printf '%s\n' "$path"
  done <<<"$listing"
}

if [ "${1:-}" = "--files" ]; then
  changed_files || exit 1
  exit 0
fi

packages_check "$PWD" || exit 1
export FLOW_CHECKED_APP="$PWD"

quietly() {
  local rc=0
  quiet_log="$(mktemp "${TMPDIR:-/tmp}/bin-rails-changed.XXXXXX")"
  trap 'rm -f "$quiet_log"' EXIT
  "$@" >"$quiet_log" 2>&1 || rc=$?
  [ "$rc" -eq 0 ] || cat "$quiet_log" >&2
  return "$rc"
}

already() {
  local n="$1" t
  for t in "${tests[@]+"${tests[@]}"}"; do
    [ "$t" = "$n" ] && return 0
  done
  return 1
}

files=()
listing="$(changed_files)"
while IFS= read -r path; do
  [ -z "$path" ] || files+=("$path")
done <<<"$listing"
gone="$(deleted_twin_findings)"

if [ "${#files[@]}" -eq 0 ] && [ -z "$gone" ]; then
  exit 0
fi

if [ "${#files[@]}" -gt 0 ]; then
  "$HERE/format" "${files[@]}"
  "$HERE/lint" "${files[@]}"
fi

tests=()
missing_mirror=()
for path in "${files[@]+"${files[@]}"}"; do
  if is_source "$path"; then
    mirror="$(test_for_source "$path")"
    if [ ! -f "$mirror" ]; then
      missing_mirror+=("$path → $mirror")
    elif ! already "$mirror"; then
      tests+=("$mirror")
    fi
  elif is_test "$path"; then
    if ! already "$path"; then
      tests+=("$path")
    fi
  fi
done

for msg in "${missing_mirror[@]+"${missing_mirror[@]}"}"; do
  echo "bin/changed: no mirrored test for $msg" >&2
done
[ -z "$gone" ] || printf '%s\n' "$gone" >&2
if [ "${#missing_mirror[@]}" -gt 0 ] || [ -n "$gone" ]; then
  exit 1
fi

if [ "${#tests[@]}" -eq 0 ]; then
  exit 0
fi

quietly "$HERE/test" "${tests[@]}"
exit 0
