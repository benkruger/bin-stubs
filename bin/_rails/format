#!/usr/bin/env bash
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${APP_DIR:-$HERE/../..}" && pwd)"
cd "$REPO_ROOT"
# shellcheck source=lib/toolchain.sh
. "$HERE/lib/toolchain.sh"
packages_check "$PWD" || exit 1
# shellcheck source=lib/sources.sh
. "$HERE/lib/sources.sh"

all=0
check=0
paths=()
for arg in "$@"; do
  case "$arg" in
    --all) all=1 ;;
    --check) check=1 ;;
    *) paths+=("$arg") ;;
  esac
done

if [ "$all" -eq 1 ]; then
  listing="$(git ls-files --cached --others --exclude-standard -- '*.md')"
elif [ "${#paths[@]}" -gt 0 ]; then
  listing="$(printf '%s\n' "${paths[@]}")"
else
  listing="$("$HERE/changed" --files)"
fi

rb_files=()
md_files=()
while IFS= read -r path; do
  [ -f "$path" ] || continue
  ! in_nested_app "$path" || continue
  case "$path" in
    *.rb) rb_files+=("$path") ;;
    *.md) md_files+=("$path") ;;
  esac
done <<<"$listing"

if [ "$all" -eq 1 ] && [ "${#NESTED_APPS[@]}" -gt 0 ]; then
  rubocop_targets || exit 1
  rb_files=(${RUBOCOP_TARGETS[@]+"${RUBOCOP_TARGETS[@]}"})
  all=0
fi

if [ "$check" -eq 1 ]; then
  rc=0
  if [ "$all" -eq 1 ]; then
    bundle exec rubocop --no-parallel --enable-pending-cops --only Layout --format quiet --display-cop-names || rc=1
  elif [ "${#rb_files[@]}" -gt 0 ]; then
    bundle exec rubocop --no-parallel --enable-pending-cops --only Layout --force-exclusion --format quiet --display-cop-names "${rb_files[@]}" || rc=1
  fi
  if [ "${#md_files[@]}" -gt 0 ]; then
    markdownlint-cli2 "${md_files[@]}" || rc=1
  fi
  exit "$rc"
fi

if [ "$all" -eq 1 ]; then
  bundle exec rubocop --no-parallel --enable-pending-cops -A --format quiet --display-cop-names || true
elif [ "${#rb_files[@]}" -gt 0 ]; then
  bundle exec rubocop --no-parallel --enable-pending-cops -A --force-exclusion --format quiet --display-cop-names "${rb_files[@]}" || true
fi
if [ "${#md_files[@]}" -gt 0 ]; then
  markdownlint-cli2 --fix "${md_files[@]}" || true
fi
