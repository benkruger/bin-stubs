#!/usr/bin/env bash
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${APP_DIR:-$HERE/../..}" && pwd)"
cd "$REPO_ROOT"
# shellcheck source=lib/toolchain.sh
. "$HERE/lib/toolchain.sh"
packages_check "$PWD" || exit 1
# shellcheck source=lib/sources.sh
. "$HERE/lib/sources.sh"

all=0
check=0
paths=()
for arg in "$@"; do
  case "$arg" in
    --all) all=1 ;;
    --check) check=1 ;;
    *) paths+=("$arg") ;;
  esac
done

rb_files=()
if [ "$all" -eq 0 ]; then
  if [ "${#paths[@]}" -gt 0 ]; then
    listing="$(printf '%s\n' "${paths[@]}")"
  else
    listing="$("$HERE/changed" --files)"
  fi
  while IFS= read -r path; do
    [ -f "$path" ] || continue
    ! in_nested_app "$path" || continue
    rb_files+=("$path")
  done <<<"$listing"
elif [ "${#NESTED_APPS[@]}" -gt 0 ]; then
  rubocop_targets || exit 1
  rb_files=(${RUBOCOP_TARGETS[@]+"${RUBOCOP_TARGETS[@]}"})
  all=0
fi

rubocop=(bundle exec rubocop --no-parallel --enable-pending-cops --format quiet --display-cop-names)
if [ "$check" -eq 1 ]; then
  rubocop+=(--only Layout)
else
  rubocop+=(-A)
fi
if [ "$all" -eq 0 ]; then
  [ "${#rb_files[@]}" -gt 0 ] || exit 0
  rubocop+=(--force-exclusion "${rb_files[@]}")
fi
if [ "$check" -eq 1 ]; then
  exec "${rubocop[@]}"
fi
rc=0
"${rubocop[@]}" || rc=$?
[ "$rc" -le 1 ] || exit "$rc"
