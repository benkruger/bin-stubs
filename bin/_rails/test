#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"
# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
packages_check "$PWD" || exit 1

# shellcheck source=_run_quiet
. "$here/_run_quiet"

export RAILS_ENV=test
export RUBYOPT="-w -r${here}/warning_filter.rb${RUBYOPT:+ $RUBYOPT}"

source_for_test() {
  local rel="${1#test/}"
  rel="${rel%_test.rb}.rb"
  case "$rel" in
    lib/*) printf '%s\n' "$rel" ;;
    *) printf 'app/%s\n' "$rel" ;;
  esac
}

tests_to_check() {
  if [ "$#" -gt 0 ]; then
    printf '%s\n' "$@"
  else
    git ls-files --cached --others --exclude-standard -- test
  fi
}

if [ -f config/database.yml ]; then
  run_quiet "rails (db:test:prepare)" bundle exec rails db:test:prepare
fi
echo "  → rails test"
bundle exec rails test "$@"

orphan=0
while IFS= read -r t; do
  t="${t#./}"
  case "$t" in
    test/integration/* | test/system/* | test/support/* | test/fixtures/*) continue ;;
    test/*_test.rb) ;;
    *) continue ;;
  esac
  src="$(source_for_test "$t")"
  if [ ! -f "$src" ]; then
    echo "bin/test: no source for test $t → $src" >&2
    orphan=1
  fi
done < <(tests_to_check "$@")
exit "$orphan"
