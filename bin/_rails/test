#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"
# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
packages_check "$PWD" || exit 1

# shellcheck source=_run_quiet
. "$here/_run_quiet"

export RAILS_ENV=test
export RUBYOPT="-w -r${here}/warning_filter.rb${RUBYOPT:+ $RUBYOPT}"

source_for_test() {
  local rel="${1#test/}"
  rel="${rel%_test.rb}.rb"
  case "$rel" in
    lib/*) printf '%s\n' "$rel" ;;
    *) printf 'app/%s\n' "$rel" ;;
  esac
}

tests_to_check() {
  if [ "$#" -gt 0 ]; then
    printf '%s\n' "$@"
  else
    git ls-files --cached --others --exclude-standard -- test
  fi
}

if [ -f config/database.yml ]; then
  run_quiet "rails (db:test:prepare)" bundle exec rails db:test:prepare
fi
resultset=coverage/.resultset.json
rm -f "$resultset"
echo "  → rails test"
bundle exec rails test "$@"
if [ ! -f "$resultset" ]; then
  echo "bin/test: SimpleCov wrote no $resultset; test/test_helper.rb starts it" >&2
  exit 1
fi
whole=0
[ "$#" -gt 0 ] || [ -n "${COVERAGE_DIRTY_FILES:-}" ] || whole=1
measured="$(jq '[.[].coverage | keys[]] | unique | length' "$resultset")"
if [ "$whole" -eq 1 ] && [ "$measured" -eq 0 ]; then
  echo "bin/test: SimpleCov measured no source" >&2
  exit 1
fi

orphan=0
while IFS= read -r t; do
  t="${t#./}"
  case "$t" in
    test/integration/* | test/system/* | test/support/* | test/fixtures/*) continue ;;
    test/*_test.rb) ;;
    *) continue ;;
  esac
  src="$(source_for_test "$t")"
  if [ ! -f "$src" ]; then
    echo "bin/test: no source for test $t → $src" >&2
    orphan=1
  fi
done < <(tests_to_check "$@")
[ "$orphan" -eq 0 ] || exit 1
[ "$whole" -eq 0 ] || echo "bin/test: coverage bar held on $measured source(s)"
