#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"
# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
packages_check "$PWD" || exit 1

# shellcheck source=_run_quiet
. "$here/_run_quiet"

export RAILS_ENV=test
export RUBYOPT="-w -r${here}/warning_filter.rb${RUBYOPT:+ $RUBYOPT}"

source_for_test() {
  local rel="${1#test/}"
  rel="${rel%_test.rb}.rb"
  case "$rel" in
    lib/*) printf '%s\n' "$rel" ;;
    *) printf 'app/%s\n' "$rel" ;;
  esac
}

tests_to_check() {
  if [ "$#" -gt 0 ]; then
    printf '%s\n' "$@"
  else
    git ls-files --cached --others --exclude-standard -- test
  fi
}

if [ -f config/database.yml ]; then
  run_quiet "rails (db:test:prepare)" bundle exec rails db:test:prepare
fi
resultset=coverage/.resultset.json
rm -f "$resultset"
echo "  → rails test"
bundle exec rails test "$@"
if [ ! -f "$resultset" ]; then
  echo "bin/test: SimpleCov wrote no $resultset; test/test_helper.rb starts it" >&2
  exit 1
fi
whole=0
sources=()
if [ -n "${COVERAGE_DIRTY_FILES:-}" ]; then
  while IFS= read -r src; do
    [ -n "$src" ] && sources+=("$src")
  done <"$COVERAGE_DIRTY_FILES"
elif [ "$#" -gt 0 ]; then
  for t in "$@"; do
    src="$(source_for_test "${t#./}")"
    [ ! -f "$src" ] || sources+=("$src")
  done
else
  whole=1
  while IFS= read -r -d '' src; do
    [ -f "$src" ] && sources+=("$src")
  done < <(git ls-files -z --cached --others --exclude-standard -- 'app/*.rb' 'lib/*.rb')
fi
if [ "$whole" -eq 1 ] && [ "${#sources[@]}" -eq 0 ]; then
  echo "bin/test: SimpleCov measured no source" >&2
  exit 1
fi
short=0
if [ "${#sources[@]}" -gt 0 ]; then
  while IFS=$'\t' read -r src lines branches; do
    if [ "$lines" = "missing" ]; then
      echo "bin/test: $src has no coverage row (need 100/100)" >&2
      short=1
    elif [ "${lines%/*}" != "${lines#*/}" ] || [ "${branches%/*}" != "${branches#*/}" ]; then
      echo "bin/test: $src at $lines lines $branches branches (need 100/100)" >&2
      short=1
    fi
  done < <(jq -r --arg real "$(pwd -P)" --arg logical "$PWD" '[.[].coverage] | add as $cov
    | $ARGS.positional[] as $src
    | ($cov[$real + "/" + $src] // $cov[$logical + "/" + $src]) as $row
    | if $row == null then "\($src)\tmissing\t" else
        ([$row.lines[]? | select(type == "number")]) as $l
        | ([($row.branches // {})[] | .[]]) as $b
        | "\($src)\t\([$l[] | select(. > 0)] | length)/\($l | length)\t\([$b[] | select(. > 0)] | length)/\($b | length)"
      end' "$resultset" --args "${sources[@]}")
fi
[ "$short" -eq 0 ] || exit 1
measured="${#sources[@]}"

orphan=0
while IFS= read -r t; do
  t="${t#./}"
  case "$t" in
    test/integration/* | test/system/* | test/support/* | test/fixtures/*) continue ;;
    test/*_test.rb) ;;
    *) continue ;;
  esac
  src="$(source_for_test "$t")"
  if [ ! -f "$src" ]; then
    echo "bin/test: no source for test $t → $src" >&2
    orphan=1
  fi
done < <(tests_to_check "$@")
[ "$orphan" -eq 0 ] || exit 1
[ "$whole" -eq 0 ] || echo "bin/test: coverage bar held on $measured source(s)"
