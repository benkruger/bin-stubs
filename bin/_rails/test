#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"
# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
packages_check "$PWD" || exit 1

# shellcheck source=_run_quiet
. "$here/_run_quiet"

export RAILS_ENV=test
quiet_dir
cat >"$QUIET_DIR/warning_filter.rb" <<'RUBY'
# frozen_string_literal: true

return if defined?(WarningFilter)

module WarningFilter
  APP = ENV.fetch('APP_DIR', Dir.pwd)
  ROOTS = [File.expand_path(APP), File.realpath(APP)].uniq.freeze

  def self.from_repo?(message)
    ROOTS.any? do |root|
      message.start_with?("#{root}/") && !message.start_with?("#{root}/vendor/")
    end
  end

  def warn(message, **)
    raise "Ruby warning (no-warnings gate):\n#{message}" if WarningFilter.from_repo?(message)

    nil
  end
end

Warning.extend(WarningFilter)
RUBY
export RUBYLIB="${QUIET_DIR}${RUBYLIB:+:$RUBYLIB}"
export RUBYOPT="-w -rwarning_filter${RUBYOPT:+ $RUBYOPT}"

# shellcheck source=lib/sources.sh
. "$here/lib/sources.sh"

tests_to_check() {
  if [ "$named" -eq 1 ]; then
    printf '%s\n' "$@"
  elif [ "$all" -eq 1 ]; then
    git ls-files --cached --others --exclude-standard -- test
  else
    printf '%s\n' ${changed_tests[@]+"${changed_tests[@]}"}
  fi
}

listed() {
  local want="$1" s
  for s in ${sources[@]+"${sources[@]}"}; do
    [ "$s" = "$want" ] && return 0
  done
  return 1
}

all=0
targets=()
named=0
for arg in "$@"; do
  case "$arg" in
    --all)
      all=1
      continue
      ;;
    -*) ;;
    *)
      named=1
      if is_source "${arg#./}"; then
        twin="$(test_for_source "${arg#./}")"
        if [ ! -f "$twin" ]; then
          echo "bin/test: no mirrored test for ${arg#./} → $twin" >&2
          exit 1
        fi
        arg="$twin"
      fi
      ;;
  esac
  targets+=("$arg")
done
set -- ${targets[@]+"${targets[@]}"}

if [ -f config/database.yml ]; then
  run_quiet "rails (db:test:prepare)" bundle exec rails db:test:prepare
fi
resultset=coverage/.resultset.json
rm -f "$resultset"
echo "  → rails test"
rc=0
bundle exec rails test "$@" || rc=$?
if [ "$rc" -ne 0 ] && { [ "$all" -eq 1 ] || [ "$rc" -ne 2 ]; }; then
  exit "$rc"
fi
if [ ! -f "$resultset" ]; then
  echo "bin/test: SimpleCov wrote no $resultset; test/test_helper.rb starts it" >&2
  exit 1
fi
sources=()
changed_tests=()
if [ "$named" -eq 1 ]; then
  for t in "$@"; do
    src="$(source_for_test "${t#./}")"
    [ ! -f "$src" ] || sources+=("$src")
  done
elif [ "$all" -eq 1 ]; then
  git ls-files -z --cached --others --exclude-standard -- 'app/*.rb' 'lib/*.rb' >"$QUIET_DIR/sources"
  while IFS= read -r -d '' src; do
    [ -f "$src" ] && sources+=("$src")
  done <"$QUIET_DIR/sources"
else
  listing="$("$here/changed" --files)"
  while IFS= read -r path; do
    [ -f "$path" ] || continue
    if is_source "$path"; then
      listed "$path" || sources+=("$path")
    elif is_test "$path"; then
      changed_tests+=("$path")
      src="$(source_for_test "$path")"
      [ ! -f "$src" ] || listed "$src" || sources+=("$src")
    fi
  done <<<"$listing"
fi
if [ "$all" -eq 1 ] && [ "${#sources[@]}" -eq 0 ]; then
  echo "bin/test: SimpleCov measured no source" >&2
  exit 1
fi
short=0
if [ "$named" -eq 0 ]; then
  for src in ${sources[@]+"${sources[@]}"}; do
    twin="$(test_for_source "$src")"
    if [ ! -f "$twin" ]; then
      echo "bin/test: no mirrored test for $src → $twin" >&2
      short=1
    fi
  done
fi
if [ "${#sources[@]}" -gt 0 ]; then
  if ! rows="$(jq -r --arg real "$(pwd -P)" --arg logical "$PWD" '[.[].coverage] | add as $cov
    | $ARGS.positional[] as $src
    | ($cov[$real + "/" + $src] // $cov[$logical + "/" + $src]) as $row
    | if $row == null then "\($src)\tmissing\t" else
        ([$row.lines[]? | select(type == "number")]) as $l
        | ([($row.branches // {})[] | .[]]) as $b
        | "\($src)\t\([$l[] | select(. > 0)] | length)/\($l | length)\t\([$b[] | select(. > 0)] | length)/\($b | length)"
      end' "$resultset" --args "${sources[@]}")"; then
    echo "bin/test: could not read $resultset" >&2
    exit 1
  fi
  while IFS=$'\t' read -r src lines branches; do
    if [ "$lines" = "missing" ]; then
      echo "bin/test: $src has no coverage row (need 100/100)" >&2
      short=1
    elif [ "${lines%/*}" != "${lines#*/}" ] || [ "${branches%/*}" != "${branches#*/}" ]; then
      echo "bin/test: $src at $lines lines $branches branches (need 100/100)" >&2
      short=1
    fi
  done <<<"$rows"
fi
[ "$short" -eq 0 ] || exit 1
measured="${#sources[@]}"

orphan=0
while IFS= read -r t; do
  t="${t#./}"
  case "$t" in
    test/integration/* | test/system/* | test/support/* | test/fixtures/*) continue ;;
    test/*_test.rb) ;;
    *) continue ;;
  esac
  src="$(source_for_test "$t")"
  if [ ! -f "$src" ]; then
    echo "bin/test: no source for test $t → $src" >&2
    orphan=1
  fi
done < <(tests_to_check "$@")
[ "$orphan" -eq 0 ] || exit 1
echo "bin/test: coverage bar held on $measured source(s)"
