#!/usr/bin/env bash
set -euo pipefail

cd "${APP_DIR:-$(dirname "$0")/../..}"

echo "  → updating gems (bundle update --all)"
bundle update --all

logs="$(mktemp -d "${TMPDIR:-/tmp}/bin-rails-dependencies.XXXXXX")"
trap 'rm -rf "$logs"' EXIT
bundle exec bundler-audit check --update >"$logs/audit" 2>&1 &
audit=$!
bundle exec brakeman --quiet --no-pager --exit-on-warn --exit-on-error >"$logs/brakeman" 2>&1 &
brakeman=$!
status=0

echo "  → rails (bundler-audit)"
wait "$audit" || status=$?
cat "$logs/audit"

echo "  → rails (brakeman)"
wait "$brakeman" || status=$?
cat "$logs/brakeman"
exit "$status"
