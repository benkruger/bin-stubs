#!/usr/bin/env bash
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${APP_DIR:-$HERE/../..}" && pwd)"
cd "$REPO_ROOT"
# shellcheck source=lib/toolchain.sh
. "$HERE/lib/toolchain.sh"
packages_check "$PWD" || exit 1
# shellcheck source=lib/sources.sh
. "$HERE/lib/sources.sh"

# shellcheck source=_run_quiet
. "$HERE/_run_quiet"

all=0
layout=()
paths=()
for arg in "$@"; do
  case "$arg" in
    --all)
      all=1
      layout=(--except Layout)
      ;;
    -*)
      echo "bin/lint: unknown argument: $arg" >&2
      exit 2
      ;;
    *) paths+=("$arg") ;;
  esac
done

rb_files=()
if [ "$all" -eq 0 ]; then
  if [ "${#paths[@]}" -gt 0 ]; then
    listing="$(named_files "${paths[@]}")"
  else
    listing="$("$HERE/changed" --files)"
  fi
  while IFS= read -r path; do
    [ -f "$path" ] || continue
    ! in_nested_app "$path" || continue
    rb_files+=("$path")
  done <<<"$listing"
elif [ "${#NESTED_APPS[@]}" -gt 0 ]; then
  rubocop_targets || exit 1
  rb_files=(${RUBOCOP_TARGETS[@]+"${RUBOCOP_TARGETS[@]}"})
  all=0
fi

if [ "$all" -eq 1 ]; then
  start_quiet "rails (rubocop)" bundle exec rubocop --no-parallel --enable-pending-cops --format quiet --display-cop-names \
    ${layout[@]+"${layout[@]}"}
elif [ "${#rb_files[@]}" -gt 0 ]; then
  start_quiet "rails (rubocop)" bundle exec rubocop --no-parallel --enable-pending-cops --force-exclusion --format quiet --display-cop-names \
    ${layout[@]+"${layout[@]}"} "${rb_files[@]}"
fi
start_quiet "rails (brakeman)" bundle exec brakeman --quiet --no-pager --exit-on-warn --exit-on-error

status=0
finish_quiet || status=$?
exit "$status"
