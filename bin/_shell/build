#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"

# shellcheck source=lib/scripts.sh
. "$here/lib/scripts.sh"

fail=0
if [ ! -x test/run ]; then
  echo "bin/build: no executable test/run" >&2
  fail=1
fi
scripts=()
listing="$(shell_listing --all)"
while IFS= read -r path; do
  scripts+=("$path")
done < <(printf '%s\n' "$listing" | shell_scripts)
[ "${#scripts[@]}" -gt 0 ] || exit "$fail"
parsed="$(mktemp -d "${TMPDIR:-/tmp}/bin-shell-build.XXXXXX")"
trap 'rm -rf "$parsed"' EXIT
jobs="$(getconf _NPROCESSORS_ONLN)"
parse_every() {
  local i
  for ((i = $1; i < ${#scripts[@]}; i += jobs)); do
    bash -n "${scripts[$i]}" >"$parsed/$i.out" 2>"$parsed/$i.err" || : >"$parsed/$i.fail"
  done
}
pids=()
for ((j = 0; j < jobs && j < ${#scripts[@]}; j++)); do
  parse_every "$j" &
  pids+=("$!")
done
for pid in "${pids[@]}"; do
  wait "$pid"
done
for i in "${!scripts[@]}"; do
  path="${scripts[$i]}"
  first=""
  IFS= read -r first <"$path" || true
  case "/$path" in
    */lib/*.sh | */tests/lib.sh | */_run_quiet) sourced=1 ;;
    *) sourced=0 ;;
  esac
  if [ "${first:0:2}" = '#!' ] && [ ! -x "$path" ] && [ "$sourced" -eq 0 ]; then
    echo "bin/build: $path has a shebang but is not executable" >&2
    fail=1
  fi
  [ ! -s "$parsed/$i.out" ] || cat "$parsed/$i.out"
  [ ! -s "$parsed/$i.err" ] || cat "$parsed/$i.err" >&2
  [ ! -e "$parsed/$i.fail" ] || fail=1
done
exit "$fail"
