#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"

# shellcheck source=lib/scripts.sh
. "$here/lib/scripts.sh"

fail=0
if [ ! -x test/run ]; then
  echo "bin/build: no executable test/run" >&2
  fail=1
fi
while IFS= read -r path; do
  if [ "$(head -c 2 "$path")" = '#!' ] && [ ! -x "$path" ]; then
    echo "bin/build: $path has a shebang but is not executable" >&2
    fail=1
  fi
  bash -n "$path" || fail=1
done < <(shell_listing --all | shell_scripts)
exit "$fail"
