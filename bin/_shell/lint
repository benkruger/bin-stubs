#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"

# shellcheck source=lib/scripts.sh
. "$here/lib/scripts.sh"

files=()
while IFS= read -r path; do
  files+=("$path")
done < <(shell_listing "$@" | shell_scripts)
if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi
exec shellcheck -x -P SCRIPTDIR "${files[@]}"
