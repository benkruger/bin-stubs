#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"
# shellcheck source=lib/scripts.sh
. "$here/lib/scripts.sh"

changed_files() {
  local path
  while IFS= read -r path; do
    [ -f "$path" ] || continue
    ! in_nested_app "$path" || continue
    printf '%s\n' "$path"
  done < <(
    {
      if git rev-parse --verify HEAD >/dev/null 2>&1; then
        git diff --name-only --relative HEAD -- .
      fi
      git ls-files --others --exclude-standard -- .
    } | { grep -v '^\.flow-states/' || true; } | sort -u
  )
}

if [ "${1:-}" = "--files" ]; then
  changed_files
  exit 0
fi

if [ -z "$(changed_files)" ]; then
  exit 0
fi
"$here/format"
"$here/lint"
exec "$here/test"
