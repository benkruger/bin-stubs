#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"
# shellcheck source=lib/scripts.sh
. "$here/lib/scripts.sh"
# shellcheck source=../lib/deletions.sh
. "$here/../lib/deletions.sh"

changed_files() {
  local path listing
  listing="$(changed_listing)" || return 1
  while IFS= read -r path; do
    [ -f "$path" ] || continue
    case "$path" in
      .flow-states/*) continue ;;
    esac
    ! in_nested_app "$path" || continue
    printf '%s\n' "$path"
  done <<<"$listing"
}

if [ "${1:-}" = "--files" ]; then
  changed_files || exit 1
  exit 0
fi

listing="$(changed_files)"
deleted="$(deleted_paths)"
if [ -z "$listing" ] && [ -z "$deleted" ]; then
  exit 0
fi
files=()
while IFS= read -r path; do
  [ -z "$path" ] || files+=("$path")
done <<<"$listing"
if [ "${#files[@]}" -gt 0 ]; then
  "$here/format" "${files[@]}"
  "$here/lint" "${files[@]}"
fi
exec "$here/test"
