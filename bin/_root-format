#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

check=0
named=()
for arg in "$@"; do
  case "$arg" in
    --check) check=1 ;;
    -*)
      echo "bin/format: unknown argument: $arg" >&2
      exit 2
      ;;
    *) named+=("$arg") ;;
  esac
done

scripts=()
markdown=()
shebang='^#!(.*[^[:alnum:]_])?bash([^[:alnum:]_]|$)'
listed="$(mktemp "${TMPDIR:-/tmp}/bin-root-format.XXXXXX")"
trap 'rm -f "$listed"' EXIT
git ls-files -z --cached --others --exclude-standard -- ${named[@]+"${named[@]}"} >"$listed"
while IFS= read -r -d '' path; do
  [ -f "$path" ] && [ ! -L "$path" ] || continue
  case "$path" in
    *.md) markdown+=("$path") ;;
    *.sh | *.bash) scripts+=("$path") ;;
    *)
      first=""
      IFS= read -r first <"$path" || true
      if [[ "$first" =~ $shebang ]]; then
        scripts+=("$path")
      fi
      ;;
  esac
done <"$listed"
rm -f "$listed"

if [ "${#scripts[@]}" -gt 0 ]; then
  if ! command -v shfmt >/dev/null 2>&1; then
    echo "bin/format: shfmt is not installed (brew install shfmt)" >&2
    exit 1
  fi
  if [ "$check" -eq 1 ]; then
    shfmt -i 2 -ci -d "${scripts[@]}"
  else
    shfmt -i 2 -ci -l -w "${scripts[@]}"
  fi
fi

if [ "${#markdown[@]}" -gt 0 ] && [ "$check" -eq 0 ]; then
  if ! command -v markdownlint-cli2 >/dev/null 2>&1; then
    echo "bin/format: markdownlint-cli2 is not installed (brew install markdownlint-cli2)" >&2
    exit 1
  fi
  out="$(mktemp "${TMPDIR:-/tmp}/bin-root-format.XXXXXX")"
  trap 'rm -f "$out"' EXIT
  rc=0
  markdownlint-cli2 --fix "${markdown[@]}" >"$out" 2>&1 || rc=$?
  if [ "$rc" -gt 1 ]; then
    cat "$out" >&2
    exit "$rc"
  fi
fi
