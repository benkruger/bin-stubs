#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"
# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
packages_check "$PWD" || exit 1
export FLOW_CHECKED_APP="$PWD"
# shellcheck source=../lib/apps.sh
. "$here/../lib/apps.sh"
root_app=0
if [ "$(pwd -P)" = "$(git rev-parse --show-toplevel)" ]; then
  root_app=1
fi

changed_files() {
  local path top
  while IFS= read -r path; do
    [ -f "$path" ] || continue
    top="${path%%/*}"
    if [ "$root_app" -eq 1 ] && [ "$top" != "$path" ] && is_app_dir "$PWD/$top"; then
      continue
    fi
    printf '%s\n' "$path"
  done < <(
    {
      if git rev-parse --verify HEAD >/dev/null 2>&1; then
        git diff --name-only --relative HEAD -- .
      fi
      git ls-files --others --exclude-standard -- .
    } | { grep -v '^\.flow-states/' || true; } | sort -u
  )
}

if [ "${1:-}" = "--files" ]; then
  changed_files
  exit 0
fi

if [ -z "$(changed_files)" ]; then
  exit 0
fi
"$here/format"
"$here/lint"
"$here/test"
