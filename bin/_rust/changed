#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"
# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
# shellcheck source=../lib/deletions.sh
. "$here/../lib/deletions.sh"
root_app=0
if [ "$(pwd -P)" = "$(git rev-parse --show-toplevel)" ]; then
  root_app=1
fi

changed_files() {
  local path top listing
  listing="$(changed_listing)" || return 1
  while IFS= read -r path; do
    [ -f "$path" ] || continue
    case "$path" in
      .flow-states/*) continue ;;
    esac
    top="${path%%/*}"
    if [ "$root_app" -eq 1 ] && [ "$top" != "$path" ] && is_app_dir "$PWD/$top"; then
      continue
    fi
    printf '%s\n' "$path"
  done <<<"$listing"
}

if [ "${1:-}" = "--files" ]; then
  changed_files || exit 1
  exit 0
fi

packages_check "$PWD" || exit 1
export FLOW_CHECKED_APP="$PWD"

listing="$(changed_files)"
deleted="$(deleted_paths)"
if [ -z "$listing" ] && [ -z "$deleted" ]; then
  exit 0
fi
"$here/format"
"$here/lint"
"$here/test"
