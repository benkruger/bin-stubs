#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"
# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
packages_check "$PWD" || exit 1
check=0
for arg in "$@"; do
  case "$arg" in
    --all) ;;
    --check) check=1 ;;
    *)
      echo "bin/format: unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done
if [ "$check" -eq 1 ]; then
  exec cargo fmt --check
fi
cargo fmt
