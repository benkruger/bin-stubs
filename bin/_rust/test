#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${APP_DIR:-$here/../..}" && pwd)"
cd "$root"
export CARGO_NET_OFFLINE=true
# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
packages_check "$PWD" || exit 1

if ! command -v rustup >/dev/null 2>&1 && [ -z "${LLVM_COV:-}" ]; then
  llvm_bin=""
  if command -v llvm-cov >/dev/null 2>&1; then
    llvm_bin="$(dirname "$(command -v llvm-cov)")"
  elif command -v brew >/dev/null 2>&1; then
    llvm_bin="$(brew --prefix llvm 2>/dev/null)/bin"
  fi
  if [ -n "$llvm_bin" ] && [ -x "$llvm_bin/llvm-cov" ] && [ -x "$llvm_bin/llvm-profdata" ]; then
    export LLVM_COV="$llvm_bin/llvm-cov" LLVM_PROFDATA="$llvm_bin/llvm-profdata"
  fi
fi

log="$(mktemp)"
trap 'rm -f "$log"' EXIT
cargo llvm-cov --workspace --fail-under-lines 100 "$@" | tee "$log"
[ "$#" -eq 0 ] || exit 0
measured="$(awk '/^-+$/ { rule++; next } rule == 1 && NF { n++ } END { print n + 0 }' "$log")"
if [ "$measured" -eq 0 ]; then
  echo "bin/test: cargo llvm-cov measured no source" >&2
  exit 1
fi
echo "bin/test: coverage bar held on $measured source(s)"
