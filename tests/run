#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
# shellcheck source=lib.sh
. "$HERE/lib.sh"
trap 'stop_spin' EXIT

force=0
for arg in "$@"; do
  case "$arg" in
    --force) force=1 ;;
    *)
      echo "usage: tests/run [--force]" >&2
      exit 2
      ;;
  esac
done

LANGUAGES=(typescript javascript python rails rust ios shell)
SHARED=(bin starter tests/lib.sh tests/lib tests/run tests/picomatch-ghsa-fc5q-39xc-vjpf.patch)
PASSES="$REPO/.flow-states/$(git -C "$REPO" rev-parse --abbrev-ref HEAD)/tests"

inputs_hash() {
  local path
  local files=()
  while IFS= read -r -d '' path; do
    [ -f "$REPO/$path" ] && files+=("$path")
  done < <(git -C "$REPO" ls-files -z --cached --others --exclude-standard -- "$@")
  {
    printf '%s\n' "${files[@]}"
    (cd "$REPO" && git hash-object -- "${files[@]}")
  } | shasum -a 256 | cut -d' ' -f1
}

part() {
  local name="$1" inputs="$2" hash pass="$PASSES/$1"
  local extra=()
  shift 2
  read -r -a extra <<<"$inputs"
  hash="$(inputs_hash "${SHARED[@]}" "${extra[@]}")"
  if [ "$force" -eq 0 ] && [ -f "$pass" ] && [ "$(cat "$pass")" = "$hash" ]; then
    printf 'bin/ci: %s unchanged since its last pass\n' "$name"
    return 0
  fi
  rm -f "$pass"
  "$@"
  mkdir -p "$PASSES"
  printf '%s\n' "$hash" >"$pass"
}

say "repo guards (starter suite on this repo)"
expect_ok "$REPO/starter/tests/run"

say "every kit script is bash"
while IFS= read -r -d '' path; do
  [ -f "$REPO/$path" ] && [ ! -L "$REPO/$path" ] || continue
  first="$(head -n 1 "$REPO/$path")"
  case "$first" in
    "#!"*) [ "$first" = "#!/usr/bin/env bash" ] || die "$path: shebang is $first" ;;
  esac
done < <(git -C "$REPO" ls-files -z --cached --others --exclude-standard)
stop_spin "✓"

part core "tests/core .claude/settings.json ${LANGUAGES[*]}" "$HERE/core"
for lang in "${LANGUAGES[@]}"; do
  part "$lang" "tests/language $lang" "$HERE/language" "$lang"
done
