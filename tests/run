#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
# shellcheck source=lib.sh
. "$HERE/lib.sh"
trap 'stop_spin' EXIT

force=0
for arg in "$@"; do
  case "$arg" in
    --force) force=1 ;;
    *)
      echo "usage: tests/run [--force]" >&2
      exit 2
      ;;
  esac
done

LANGUAGES=(typescript javascript python rails rust ios shell)
SHARED=(bin starter tests/lib.sh tests/lib tests/run tests/picomatch-ghsa-fc5q-39xc-vjpf.patch)
PASSES="$REPO/.flow-states/$(git -C "$REPO" rev-parse --abbrev-ref HEAD)/tests"

tool_versions() {
  local probe cmd=()
  for probe in "node --version" "npm --version" "uv --version" "uv python find" "ruby --version" "bundle --version" \
    "rustc --version" "cargo --version" "swift --version" "xcodebuild -version" "shellcheck --version" \
    "shfmt --version" "jq --version"; do
    read -r -a cmd <<<"$probe"
    printf '%s: %s\n' "$probe" "$("${cmd[@]}" 2>&1 || echo missing)"
  done
  printf 'markdownlint-cli2: %s\n' "$(readlink -f "$(command -v markdownlint-cli2)" 2>/dev/null || echo missing)"
}

inputs_hash() {
  local path sum
  local files=() digest=(shasum -a 256)
  ! command -v sha256sum >/dev/null 2>&1 || digest=(sha256sum)
  while IFS= read -r -d '' path; do
    [ -f "$REPO/$path" ] && files+=("$path")
  done < <(git -C "$REPO" ls-files -z --cached --others --exclude-standard -- "$@")
  sum="$({
    printf '%s\n' "${files[@]}"
    git -C "$REPO" hash-object -- "${files[@]}"
    printf '%s\n' "$TOOLS"
  } | "${digest[@]}")" || return
  printf '%s\n' "${sum%% *}"
}

part() {
  local name="$1" inputs="$2" hash saved pass="$PASSES/$1"
  local extra=()
  shift 2
  read -r -a extra <<<"$inputs"
  hash="$(inputs_hash "${SHARED[@]}" "${extra[@]}")"
  saved=""
  [ ! -f "$pass" ] || read -r saved <"$pass" || true
  if [ "$force" -eq 0 ] && [ -n "$saved" ] && [ "$saved" = "$hash" ]; then
    printf 'bin/ci: %s unchanged since its last pass\n' "$name"
    return 0
  fi
  rm -f "$pass"
  "$@"
  mkdir -p "$PASSES"
  printf '%s\n' "$hash" >"$pass"
}

say "every kit script is bash and gives mktemp a template"
while IFS= read -r -d '' path; do
  [ -f "$REPO/$path" ] && [ ! -L "$REPO/$path" ] || continue
  first=""
  IFS= read -r first <"$REPO/$path" || true
  case "$first" in
    "#!"*) [ "$first" = "#!/usr/bin/env bash" ] || die "$path: shebang is $first" ;;
    *) continue ;;
  esac
  bare="$(grep -nE '\$\(mktemp( -d)?\)' "$REPO/$path" | head -n 1 | cut -d: -f1)" || true
  [ -z "$bare" ] || die "$path:$bare: mktemp with no template ignores TMPDIR on macOS"
done < <(git -C "$REPO" ls-files -z --cached --others --exclude-standard)
stop_spin "✓"

run_part() {
  case "$1" in
    guards)
      say "repo guards (starter suite on this repo)"
      expect_ok "$REPO/starter/tests/run"
      ;;
    core) part core "tests/core .claude/settings.json ${LANGUAGES[*]}" "$HERE/core" ;;
    *) part "$1" "tests/language $1" "$HERE/language" "$1" ;;
  esac
}

TOOLS="$(tool_versions)"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/bin-stubs-run.XXXXXX")"
trap 'stop_spin; rm -rf "$WORK"' EXIT
run_all "$WORK/logs" run_part guards core "${LANGUAGES[@]}"
