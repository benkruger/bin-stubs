#!/usr/bin/env bash
# Copy each language bin into a fixture repo and run it.
# Also runs the root dispatcher against a rails + typescript fixture.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
# shellcheck source=lib.sh
. "$HERE/lib.sh"

WORK="$(mktemp -d "${TMPDIR:-/tmp}/bin-stubs-tests.XXXXXX")"
trap 'stop_spin; rm -rf "$WORK"' EXIT

new_repo() {
  local d
  d="$(mktemp -d "$WORK/repo.XXXXXX")"
  git -C "$d" init -q -b main
  git -C "$d" config user.email "bin-stubs@example.com"
  git -C "$d" config user.name "bin-stubs"
  cat >"$d/.gitignore" <<'EOF'
.flow-states/
node_modules/
.venv/
vendor/
target/
.build/
.bundle/
EOF
  git -C "$d" add .gitignore
  git -C "$d" commit -q -m init
  printf '%s\n' "$d"
}

expect_ok() {
  run_log "$@"
  assert_rc 0 "$*"
}

expect_fail() {
  run_log "$@"
  [ "${LAST_RC}" -ne 0 ] || die "expected failure: $*"
}

summary() { tail -n 20 "${LAST_LOG}"; }

test_repo_guards() {
  say "repo guards (starter suite on this repo)"
  expect_ok "$REPO/starter/tests/run"
}

test_kit_scripts_are_bash() {
  say "every kit script is bash"
  local path first
  while IFS= read -r -d '' path; do
    [ -f "$REPO/$path" ] && [ ! -L "$REPO/$path" ] || continue
    first="$(head -n 1 "$REPO/$path")"
    case "$first" in
      "#!"*) [ "$first" = "#!/usr/bin/env bash" ] || die "$path: shebang is $first" ;;
    esac
  done < <(git -C "$REPO" ls-files -z --cached --others --exclude-standard)
}

test_scan() {
  say "scan"
  local repo
  repo="$(new_repo)"
  KEEP="$repo"
  copy_dir "$REPO/bin" "$repo/bin"
  printf 'needle here\n' >"$repo/notes.txt"
  git -C "$repo" add -A
  git -C "$repo" commit -q -m "add the needle"
  expect_ok "$repo/bin/scan" refs needle
  grep -q "notes.txt:1:needle here" "${LAST_LOG}" || die "scan refs missed the match"
  grep -q "add the needle" "${LAST_LOG}" || die "scan refs missed the commit"
  expect_ok "$repo/bin/scan" log --oneline
  grep -q "add the needle" "${LAST_LOG}" || die "scan log missed the commit"
  expect_ok "$repo/bin/scan" grep needle
  grep -q "needle here" "${LAST_LOG}" || die "scan grep missed the match"
  expect_ok "$repo/bin/scan" files
  grep -qx "notes.txt" "${LAST_LOG}" || die "scan files missed the file"
  expect_fail "$repo/bin/scan" sideways
  grep -q "usage: bin/scan" "${LAST_LOG}" || die "scan printed no usage"
}

test_root_format() {
  say "repo-level format"
  local repo
  repo="$(new_repo)"
  KEEP="$repo"
  copy_dir "$REPO/bin" "$repo/bin"
  printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail' 'if true;then' 'echo   "messy"' 'fi' >"$repo/messy"
  chmod +x "$repo/messy"
  printf '%s\n' '# Notes' '' '#Heading without a space' >"$repo/notes.md"
  expect_ok "$repo/bin/format"
  assert_eq "$(row_of suite "$(summary)")" "PASS" "format runs the repo-level formatter"
  grep -qx "if true; then" "$repo/messy" || die "bin/format did not reformat the script"
  grep -qx "## Heading without a space" "$repo/notes.md" ||
    grep -qx "# Heading without a space" "$repo/notes.md" ||
    die "bin/format did not fix the Markdown"
}

make_stub() {
  cat >"$1/$2" <<'EOF'
#!/usr/bin/env bash
printf '%s %s\n' "$(basename "$0")" "$*" >>"$STUB_LOG"
EOF
  chmod +x "$1/$2"
}

test_open() {
  say "open"
  local repo stubs home log lang tool tries
  repo="$(new_repo)"
  KEEP="$repo"
  stubs="$repo/.stubs"
  home="$repo/.home"
  log="$repo/stub.log"
  mkdir -p "$stubs" "$home"
  for tool in npm bundle curl open; do
    make_stub "$stubs" "$tool"
  done
  for lang in typescript javascript rails; do
    mkdir -p "$repo/$lang/node_modules"
    copy_dir "$REPO/$lang/bin" "$repo/$lang/bin"
  done

  run_log env PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" "$repo/typescript/bin/open"
  assert_rc 0 "typescript bin/open"
  grep -qx "npm run dev -- --host 127.0.0.1 --open" "$log" || die "typescript bin/open ran the wrong command"

  : >"$log"
  run_log env PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" "$repo/javascript/bin/open"
  assert_rc 0 "javascript bin/open"
  grep -qx "npm run dev -- --host 127.0.0.1 --open" "$log" || die "javascript bin/open ran the wrong command"

  run_log env PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" PORT=4001 "$repo/rails/bin/open"
  assert_rc 0 "rails bin/open"
  grep -qx "bundle exec rails server -b 127.0.0.1 -p 4001" "$log" || die "rails bin/open ran the wrong command"
  tries=0
  until grep -qx "open http://127.0.0.1:4001" "$log"; do
    tries=$((tries + 1))
    [ "$tries" -lt 50 ] || die "rails bin/open never opened the browser"
    sleep 0.1
  done
}

hook_on() {
  LAST_LOG="$(mktemp)"
  if jq -n --arg c "$1" "{tool_input:{command:\$c}}" |
    "$REPO/starter/.claude/hooks/require-bin" >"${LAST_LOG}" 2>&1; then
    LAST_RC=0
  else
    LAST_RC=$?
  fi
}

test_hooks() {
  say "starter hooks"
  local cmd
  for cmd in "bun test" "cd app && cargo build" "bundle exec rubocop -A" \
    "RAILS_ENV=test bundle exec rails test" "npx biome check ." "uv run pytest" \
    "xcrun swift-format lint Sources" "ls; /opt/homebrew/bin/ruff check ."; do
    hook_on "$cmd"
    assert_rc 2 "require-bin should block: $cmd"
    grep -q "Blocked: call the bin/ script" "${LAST_LOG}" || die "no block message for: $cmd"
  done
  for cmd in "bin/test src/add.ts" "typescript/bin/ci" "git status" \
    "bundle exec rails runner 1" "npm test" "ls -la"; do
    hook_on "$cmd"
    assert_rc 0 "require-bin should allow: $cmd"
  done
  run_log env -u CLAUDE_CODE_REMOTE "$REPO/starter/.claude/hooks/session-start"
  assert_rc 0 "session-start outside the cloud"
  [ ! -s "${LAST_LOG}" ] || die "session-start ran something outside the cloud"
}

test_starter() {
  say "starter in a fresh repo"
  local repo lang probe token
  repo="$(new_repo)"
  KEEP="$repo"
  copy_dir "$REPO/starter" "$repo"
  copy_dir "$REPO/bin" "$repo/bin"
  for lang in typescript javascript python rails rust ios; do
    copy_dir "$REPO/$lang/.claude" "$repo/.claude"
  done
  expect_ok "$repo/tests/run"
  expect_ok "$repo/bin/ci"
  assert_eq "$(row_of suite "$(summary)")" "PASS" "starter suite through bin/ci"

  {
    printf '# Notes\n\n'
    head -c 70000 /dev/zero | tr '\0' 'a'
    printf '\n'
  } >"$repo/notes.md"
  expect_fail "$repo/tests/run"
  grep -q "notes.md: 70010 bytes, over the 65536-byte cap" "${LAST_LOG}" || die "size cap not enforced"
  rm "$repo/notes.md"

  probe="$repo/probe.py"
  token="no"
  token+="qa"
  printf 'value = 1  # %s\n' "$token" >"$probe"
  expect_fail "$repo/tests/run"
  grep -q "probe.py:1: suppression comment" "${LAST_LOG}" || die "suppression ban not enforced"
  rm "$probe"

  printf '{\n  "linter": { "%s": {} }\n}\n' "rules" >"$repo/biome.json"
  expect_fail "$repo/tests/run"
  grep -q "biome.json: turns Biome rules off" "${LAST_LOG}" || die "Biome config not checked"
  rm "$repo/biome.json"

  printf 'export default [{ rules: { "no-unused-vars": "%s" } }];\n' "off" >"$repo/eslint.config.js"
  expect_fail "$repo/tests/run"
  grep -q "eslint.config.js: turns ESLint rules off" "${LAST_LOG}" || die "ESLint config not checked"
  rm "$repo/eslint.config.js"

  {
    printf '# Long\n\n'
    for _ in $(seq 1 45); do printf -- '- line\n'; done
  } >"$repo/.claude/rules/long.md"
  expect_fail "$repo/tests/run"
  grep -q "long.md: 47 lines (cap 40)" "${LAST_LOG}" || die "rule cap not enforced"
  rm "$repo/.claude/rules/long.md"

  printf '%s\n' '#!/usr/bin/env bash' 'echo "loose"' >"$repo/bin/loose"
  chmod +x "$repo/bin/loose"
  expect_fail "$repo/tests/run"
  grep -q "bin/loose: first command is not set -euo pipefail" "${LAST_LOG}" || die "strict mode not enforced"
  rm "$repo/bin/loose"

  printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail' 'if true;then' 'echo   "messy"' 'fi' >"$repo/bin/messy"
  chmod +x "$repo/bin/messy"
  expect_fail "$repo/tests/run"
  grep -q "shfmt would reformat" "${LAST_LOG}" || die "script formatting not enforced"
  rm "$repo/bin/messy"

  printf '%s\n' '# Notes' '' '#Heading without a space' >"$repo/notes.md"
  expect_fail "$repo/tests/run"
  grep -q "notes.md:3.*MD018" "${LAST_LOG}" || die "markdownlint not enforced"
  rm "$repo/notes.md"

  cp "$repo/.claude/settings.json" "$repo/settings.json.keep"
  jq '.permissions.deny -= ["Bash(git reset *)"] | del(.hooks.SessionStart)' \
    "$repo/settings.json.keep" >"$repo/.claude/settings.json"
  expect_fail "$repo/tests/run"
  grep -q "does not deny Bash(git reset \*)" "${LAST_LOG}" || die "missing deny not caught"
  grep -q "no SessionStart hook runs" "${LAST_LOG}" || die "missing hook not caught"
  mv "$repo/settings.json.keep" "$repo/.claude/settings.json"

  sed 's/^MAX_AUTHORED_BYTES=65536$/MAX_AUTHORED_BYTES=99999/' "$repo/tests/guards" >"$repo/tests/guards.raised"
  mv "$repo/tests/guards.raised" "$repo/tests/guards"
  chmod +x "$repo/tests/guards"
  expect_fail "$repo/tests/run"
  grep -q "does not pin MAX_AUTHORED_BYTES=65536" "${LAST_LOG}" || die "raised cap not caught"
}

test_copies_match() {
  say "copied sentinel libs match"
  local lang
  for lang in ios rails typescript javascript python rust; do
    [ -x "$REPO/$lang/bin/ci" ] || die "$lang bin/ci is not executable"
    grep -qF "[\$step/4]" "$REPO/$lang/bin/ci" || die "$lang ci has no step line"
  done
}

test_changed_empty() {
  say "changed on a clean tree"
  local repo
  repo="$(new_repo)"
  KEEP="$repo"
  copy_dir "$REPO/bin" "$repo/bin"
  git -C "$repo" add bin
  git -C "$repo" commit -q -m "bin"
  expect_ok "$repo/bin/changed"
  grep -q "nothing dirty" "${LAST_LOG}" || die "missing nothing-dirty line"
}

seed_typescript() {
  local app="$1"
  mkdir -p "$app"
  node --version | sed 's/^v//' >"$app/.nvmrc"
  mkdir -p "$app/src" "$app/tests"
  cat >"$app/package.json" <<'EOF'
{
  "name": "app",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
EOF
  cat >"$app/eslint.config.js" <<'EOF'
import js from "@eslint/js";
import json from "@eslint/json";
import { defineConfig } from "eslint/config";
import tseslint from "typescript-eslint";

export default defineConfig([
  {
    files: ["**/*.ts"],
    extends: [js.configs.recommended, tseslint.configs.recommended],
  },
  {
    files: ["**/*.js"],
    extends: [js.configs.recommended],
  },
  {
    files: ["**/*.json"],
    plugins: { json },
    language: "json/json",
    extends: ["json/recommended"],
  },
]);
EOF
  cat >"$app/tsconfig.json" <<'EOF'
{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src"]
}
EOF
  cat >"$app/src/add.ts" <<'EOF'
export function add(a: number, b: number): number {
return a+b
}
EOF
  cat >"$app/tests/add.test.ts" <<'EOF'
import { expect, test } from "vitest";
import { add } from "../src/add";

test("add", () => {
  expect(add(1, 2)).toBe(3);
});
EOF
}

seed_javascript() {
  local app="$1"
  mkdir -p "$app"
  node --version | sed 's/^v//' >"$app/.nvmrc"
  mkdir -p "$app/src" "$app/tests"
  cat >"$app/package.json" <<'EOF'
{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "c8": "10.1.3"
  }
}
EOF
  cat >"$app/src/index.js" <<'EOF'
export function add(a, b) {
return a+b
}
EOF
  cat >"$app/tests/index.test.js" <<'EOF'
import assert from "node:assert/strict";
import test from "node:test";
import { add } from "../src/index.js";

test("add", () => {
  assert.equal(add(1, 2), 3);
});
EOF
}

seed_python() {
  local app="$1" python
  mkdir -p "$app"
  python="$(cd "$app" && uv python find)"
  "$python" -c 'import sys; print("%d.%d" % sys.version_info[:2])' >"$app/.python-version"
  mkdir -p "$app/src" "$app/tests"
  cat >"$app/pyproject.toml" <<'EOF'
[project]
name = "app"
version = "0.1.0"
requires-python = ">=3.12"

[dependency-groups]
dev = ["ruff>=0.8", "pytest>=8", "pytest-cov>=6"]

[tool.uv]
default-groups = ["dev"]

[tool.pytest.ini_options]
pythonpath = ["src"]
EOF
  cat >"$app/src/add.py" <<'EOF'
def add(a: int, b: int) -> int:
    return a+b
EOF
  cat >"$app/tests/test_add.py" <<'EOF'
from add import add


def test_add() -> None:
    assert add(1, 2) == 3
EOF
}

seed_rails() {
  local app="$1"
  mkdir -p "$app"
  (cd "$app" && ruby -e 'print RUBY_VERSION') >"$app/.ruby-version"
  mkdir -p "$app/app/models" "$app/config" "$app/test/models"
  cat >"$app/.gitignore" <<'EOF'
/coverage/
/log/
/tmp/
EOF
  cat >"$app/Gemfile" <<'EOF'
# frozen_string_literal: true

source 'https://rubygems.org'

gem 'brakeman'
gem 'minitest'
gem 'railties'
gem 'rubocop'
gem 'simplecov'
EOF
  cat >"$app/.rubocop.yml" <<'EOF'
AllCops:
  NewCops: enable
  SuggestExtensions: false
EOF
  cat >"$app/Rakefile" <<'EOF'
# frozen_string_literal: true

require_relative 'config/application'
Rails.application.load_tasks
EOF
  cat >"$app/bin/rails" <<'EOF'
#!/usr/bin/env ruby
# frozen_string_literal: true

APP_PATH = File.expand_path('../config/application', __dir__)
require_relative '../config/boot'
require 'rails/commands'
EOF
  chmod +x "$app/bin/rails"
  cat >"$app/config/boot.rb" <<'EOF'
# frozen_string_literal: true

ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)
require 'bundler/setup'
EOF
  cat >"$app/config/application.rb" <<'EOF'
# frozen_string_literal: true

require_relative 'boot'
require 'rails'
require 'action_controller/railtie'

module Fixture
  # The app the Rails gate runs against.
  class Application < Rails::Application
    config.load_defaults 8.1
    config.eager_load = false
  end
end
EOF
  cat >"$app/config/environment.rb" <<'EOF'
# frozen_string_literal: true

require_relative 'application'
Rails.application.initialize!
EOF
  cat >"$app/app/models/add.rb" <<'EOF'
# frozen_string_literal: true

# Adds two numbers.
module Add
  module_function

  def call(left, right)
    left+right
  end
end
EOF
  cat >"$app/test/test_helper.rb" <<'EOF'
# frozen_string_literal: true

require 'simplecov'
SimpleCov.start do
  enable_coverage :branch
  minimum_coverage line: 100, branch: 100
  skip %w[/config/ /test/]
end

require_relative '../config/environment'
require 'rails/test_help'
EOF
  cat >"$app/test/models/add_test.rb" <<'EOF'
# frozen_string_literal: true

require 'test_helper'

class AddTest < ActiveSupport::TestCase
  test 'adds two numbers' do
    assert_equal 3, Add.call(1, 2)
  end
end
EOF
}

seed_rust() {
  local app="$1"
  mkdir -p "$app"
  printf '[toolchain]\nchannel = "%s"\n' "$(rustc --version | cut -d' ' -f2)" >"$app/rust-toolchain.toml"
  mkdir -p "$app/src"
  cat >"$app/Cargo.toml" <<'EOF'
[package]
name = "app"
version = "0.1.0"
edition = "2021"
EOF
  cat >"$app/src/lib.rs" <<'EOF'
pub fn add(a: i32, b: i32) -> i32 { a+b }

#[cfg(test)]
mod tests {
    use super::add;

    #[test]
    fn adds() {
        assert_eq!(add(1, 2), 3);
    }
}
EOF
}

seed_ios() {
  local app="$1"
  mkdir -p "$app"
  xcodebuild -version | head -n 1 | cut -d' ' -f2 >"$app/.xcode-version"
  mkdir -p "$app/Sources/App" "$app/Tests/AppTests"
  cat >"$app/Package.swift" <<'EOF'
// swift-tools-version: 6.0
import PackageDescription

let package = Package(
    name: "App",
    targets: [
        .target(name: "App"),
        .testTarget(name: "AppTests", dependencies: ["App"]),
    ]
)
EOF
  cat >"$app/Sources/App/Add.swift" <<'EOF'
public func add(_ a: Int, _ b: Int) -> Int { a+b }
EOF
  cat >"$app/Tests/AppTests/AddTests.swift" <<'EOF'
import Testing
@testable import App

@Test func adds() {
    #expect(add(1, 2) == 3)
}
EOF
}

source_of() {
  case "$1" in
    typescript) printf '%s\n' src/add.ts ;;
    javascript) printf '%s\n' src/index.js ;;
    python) printf '%s\n' src/add.py ;;
    rails) printf '%s\n' app/models/add.rb ;;
    rust) printf '%s\n' src/lib.rs ;;
    ios) printf '%s\n' Sources/App/Add.swift ;;
  esac
}

seed_of() {
  case "$1" in
    typescript) seed_typescript "$2" ;;
    javascript) seed_javascript "$2" ;;
    python) seed_python "$2" ;;
    rails) seed_rails "$2" ;;
    rust) seed_rust "$2" ;;
    ios) seed_ios "$2" ;;
  esac
}

red_file() {
  local app="$1" lang="$2"
  case "$lang" in
    typescript)
      cat >"$app/tests/red.test.ts" <<'EOF'
import { expect, test } from "vitest";

test("red", () => {
  expect(1).toBe(0);
});
EOF
      ;;
    javascript)
      cat >"$app/tests/red.test.js" <<'EOF'
import assert from "node:assert/strict";
import test from "node:test";

test("red", () => {
  assert.equal(1, 0);
});
EOF
      ;;
    python)
      cat >"$app/tests/test_red.py" <<'EOF'
def test_red() -> None:
    assert 1 == 0
EOF
      ;;
    rails)
      cat >"$app/test/red_test.rb" <<'EOF'
# frozen_string_literal: true

require 'test_helper'

class RedTest < ActiveSupport::TestCase
  test 'fails' do
    assert_equal 1, 0
  end
end
EOF
      ;;
    rust)
      mkdir -p "$app/tests"
      cat >"$app/tests/red.rs" <<'EOF'
#[test]
fn red() {
    assert_eq!(1, 0);
}
EOF
      ;;
    ios)
      cat >"$app/Tests/AppTests/RedTests.swift" <<'EOF'
import Testing

@Test func red() {
    #expect(1 == 0)
}
EOF
      ;;
  esac
}

test_language() {
  local lang="$1" repo app sent hash pin
  say "$lang bin"
  repo="$(new_repo)"
  KEEP="$repo"
  app="$repo/$lang"
  mkdir -p "$app"
  copy_dir "$REPO/$lang/bin" "$app/bin"
  seed_of "$lang" "$app"
  expect_ok "$app/bin/ci"
  grep -q "bin/ci: \[1/4\] format" "${LAST_LOG}" || die "$lang did not print the format step"
  grep -q "bin/ci: \[4/4\] test" "${LAST_LOG}" || die "$lang did not print the test step"
  grep -q "sentinel written" "${LAST_LOG}" || die "$lang first run did not write a sentinel"
  if [ "$lang" = "rails" ]; then
    grep -q "left + right" "$app/$(source_of "$lang")" || die "$lang format did not rewrite the source"
  else
    grep -q "a + b" "$app/$(source_of "$lang")" || die "$lang format did not rewrite the source"
  fi
  sent="$(sentinel_file "$app")"
  [ -f "$sent" ] || die "$lang sentinel missing"
  hash="$(cat "$sent")"
  expect_ok "$app/bin/ci"
  grep -q "sentinel written" "${LAST_LOG}" && die "$lang second run rewrote the sentinel"
  assert_eq "$(cat "$sent")" "$hash" "$lang skip changed the hash"
  echo "sibling" >"$repo/NOTES.txt"
  expect_ok "$app/bin/ci"
  grep -q "sentinel written" "${LAST_LOG}" && die "$lang sibling edit rewrote the sentinel"
  assert_eq "$(cat "$sent")" "$hash" "$lang sibling edit changed the hash"
  red_file "$app" "$lang"
  expect_fail "$app/bin/ci"
  assert_eq "$(cat "$sent")" "$hash" "$lang red run replaced the certificate"
  rm -f "$app/tests/red.test.ts" "$app/tests/red.test.js" "$app/tests/test_red.py" \
    "$app/test/red_test.rb" "$app/tests/red.rs" "$app/Tests/AppTests/RedTests.swift"
  expect_ok "$app/bin/ci" --force
  grep -q "sentinel written" "${LAST_LOG}" || die "$lang --force did not write"
  expect_ok "$app/bin/ci" --clean
  [ ! -f "$sent" ] || die "$lang --clean left the sentinel"

  pin="$app/$(pin_file_of "$lang")"
  cp "$pin" "$pin.keep"
  if [ "$lang" = "rust" ]; then
    printf '[toolchain]\nchannel = "1.0.0"\n' >"$pin"
  else
    echo "1.0.0" >"$pin"
  fi
  expect_fail "$app/bin/ci" --force
  grep -q "toolchain: " "${LAST_LOG}" || die "$lang did not enforce its toolchain pin"
  mv "$pin.keep" "$pin"

  case "$lang" in
    typescript)
      echo "plain text" >"$app/notes.txt"
      printf 'a {\n  color: red;\n}\n' >"$app/styles.css"
      expect_fail "$app/bin/ci" --force
      grep -q "notes.txt: no formatter (Prettier)" "${LAST_LOG}" || die "$lang let a file with no formatter through"
      grep -q "styles.css: no linter (no ESLint rules apply)" "${LAST_LOG}" || die "$lang let a file with no linter through"
      rm "$app/notes.txt" "$app/styles.css"
      ;;
    javascript)
      echo "plain text" >"$app/notes.txt"
      expect_fail "$app/bin/ci" --force
      grep -q "notes.txt: no formatter or linter (Biome)" "${LAST_LOG}" || die "$lang let a file with no formatter through"
      rm "$app/notes.txt"
      ;;
  esac

  if branch_gap "$app" "$lang"; then
    expect_fail "$app/bin/ci" --force
    grep -qE "at 100\.00 functions, 100\.00 lines, [0-9]{1,2}\.[0-9]{2} branches" "${LAST_LOG}" ||
      die "$lang did not hold branches to 100%"
  fi
}

# Rewrites the source so its test runs every function and line but only one
# arm of a branch; a language without a branch bar returns 1.
branch_gap() {
  local app="$1" lang="$2"
  case "$lang" in
    typescript)
      printf '%s\n' 'export function add(a: number, b: number): number {' \
        '  return a > 0 ? a + b : b;' '}' >"$app/src/add.ts"
      ;;
    javascript)
      printf '%s\n' 'export function add(a, b) {' '  return a > 0 ? a + b : b;' '}' \
        >"$app/src/index.js"
      ;;
    *) return 1 ;;
  esac
}

pin_file_of() {
  case "$1" in
    typescript) printf '%s\n' .nvmrc ;;
    javascript) printf '%s\n' .nvmrc ;;
    python) printf '%s\n' .python-version ;;
    rails) printf '%s\n' .ruby-version ;;
    rust) printf '%s\n' rust-toolchain.toml ;;
    ios) printf '%s\n' .xcode-version ;;
  esac
}

test_dispatch() {
  say "dispatcher"
  local repo sent_rails
  repo="$(new_repo)"
  KEEP="$repo"
  copy_dir "$REPO/bin" "$repo/bin"
  mkdir -p "$repo/python" "$repo/typescript"
  copy_dir "$REPO/python/bin" "$repo/python/bin"
  copy_dir "$REPO/typescript/bin" "$repo/typescript/bin"
  seed_python "$repo/python"
  seed_typescript "$repo/typescript"
  expect_ok "$repo/bin/ci"
  local sum
  sum="$(summary)"
  assert_eq "$(row_of python "$sum")" "PASS" "first python"
  assert_eq "$(row_of typescript "$sum")" "PASS" "first typescript"
  assert_eq "$(row_of suite "$sum")" "PASS" "first suite"
  expect_ok "$repo/bin/ci"
  sum="$(summary)"
  assert_eq "$(row_of python "$sum")" "SKIP" "second python"
  assert_eq "$(row_of typescript "$sum")" "SKIP" "second typescript"
  if [ "$(row_of suite "$sum")" = "PASS" ]; then
    expect_ok "$repo/bin/ci"
    sum="$(summary)"
  fi
  assert_eq "$(row_of suite "$sum")" "SKIP" "suite settled"
  printf '\nexport const marker = 1\n' >>"$repo/typescript/src/add.ts"
  expect_ok "$repo/bin/ci"
  sum="$(summary)"
  assert_eq "$(row_of typescript "$sum")" "PASS" "edited typescript"
  assert_eq "$(row_of python "$sum")" "SKIP" "python untouched"
  sent_rails="$(sentinel_file "$repo/python")"
  local rails_hash
  rails_hash="$(cat "$sent_rails")"
  echo "top" >"$repo/TOP.txt"
  expect_ok "$repo/bin/ci"
  sum="$(summary)"
  assert_eq "$(row_of python "$sum")" "SKIP" "foreign file left python"
  assert_eq "$(cat "$sent_rails")" "$rails_hash" "foreign file changed rails hash"
  git -C "$repo" add -A
  git -C "$repo" commit -q -m "formatted"
  expect_ok "$repo/bin/ci"
  sum="$(summary)"
  assert_eq "$(row_of python "$sum")" "PASS" "commit re-runs python"
  expect_ok "$repo/bin/ci"
  sum="$(summary)"
  assert_eq "$(row_of python "$sum")" "SKIP" "clean tree python"
  assert_eq "$(row_of typescript "$sum")" "SKIP" "clean tree typescript"
  assert_eq "$(row_of suite "$sum")" "SKIP" "clean tree suite"
  echo "corpus" >"$repo/CLAUDE.md"
  expect_ok "$repo/bin/ci"
  sum="$(summary)"
  assert_eq "$(row_of suite "$sum")" "PASS" "corpus selects the suite"
  assert_eq "$(row_of python "$sum")" "SKIP" "corpus leaves python"
  assert_eq "$(row_of typescript "$sum")" "SKIP" "corpus leaves typescript"
  git -C "$repo" add CLAUDE.md
  git -C "$repo" commit -q -m "corpus"
  expect_ok "$repo/bin/ci"
  printf '\nexport const changed = 1\n' >>"$repo/typescript/src/add.ts"
  expect_ok "$repo/bin/changed"
  sum="$(summary)"
  assert_eq "$(row_of typescript "$sum")" "PASS" "changed typescript"
  assert_eq "$(row_of python "$sum")" "SKIP" "changed leaves python"
  assert_eq "$(row_of suite "$sum")" "SKIP" "changed leaves the suite"
  expect_ok "$repo/bin/test" typescript/tests/add.test.ts
  sum="$(summary)"
  assert_eq "$(row_of typescript "$sum")" "PASS" "filtered test"
  assert_eq "$(row_of python "$sum")" "SKIP" "filter withheld python"
}

test_root_app() {
  say "root app excludes sibling folders"
  local repo sent hash
  repo="$(new_repo)"
  KEEP="$repo"
  copy_dir "$REPO/bin" "$repo/bin"
  mkdir -p "$repo/bin/_root" "$repo/ios"
  copy_dir "$REPO/python/bin" "$repo/bin/_root"
  copy_dir "$REPO/ios/bin" "$repo/ios/bin"
  seed_python "$repo"
  mkdir -p "$repo/ios/Sources/App"
  echo "public func other() {}" >"$repo/ios/Sources/App/Other.swift"
  expect_ok "$repo/bin/_root/ci"
  sent="$(sentinel_file "$repo")"
  hash="$(cat "$sent")"
  echo "public func more() {}" >>"$repo/ios/Sources/App/Other.swift"
  expect_ok "$repo/bin/_root/ci"
  grep -q "sentinel written" "${LAST_LOG}" && die "sibling ios edit rewrote the root sentinel"
  assert_eq "$(cat "$sent")" "$hash" "root hash changed"
}

test_dependencies() {
  say "rust dependencies"
  local repo
  repo="$(new_repo)"
  KEEP="$repo"
  copy_dir "$REPO/bin" "$repo/bin"
  mkdir -p "$repo/rust"
  copy_dir "$REPO/rust/bin" "$repo/rust/bin"
  seed_rust "$repo/rust"
  expect_ok "$repo/bin/dependencies"
  local sum
  sum="$(summary)"
  assert_eq "$(row_of rust "$sum")" "PASS" "dependencies"
}

test_repo_guards
test_kit_scripts_are_bash
