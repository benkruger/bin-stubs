#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
# shellcheck source=lib.sh
. "$HERE/lib.sh"
# shellcheck source=lib/seeds.sh
. "$HERE/lib/seeds.sh"
# shellcheck source=lib/configs.sh
. "$HERE/lib/configs.sh"
start_work

test_settings() {
  say "settings"
  local gate='["Edit(/bin/**)","Edit(/tests/guards)","Edit(/tests/run)","Edit(/.claude/settings.json)","Edit(/.claude/hooks/**)","Edit(/.githooks/**)"]'
  jq -e --argjson gate "$gate" '$gate - .permissions.deny == []' "$REPO/starter/.claude/settings.json" >/dev/null ||
    die "the starter's settings do not deny editing the gate"
  jq -e --argjson gate "$gate" --slurpfile mine "$REPO/.claude/settings.json" \
    '(.permissions.deny -= $gate) == $mine[0]' "$REPO/starter/.claude/settings.json" >/dev/null ||
    die "this repo's settings are not the starter's less the gate-edit denies"
}

test_scan() {
  say "scan"
  local repo
  repo="$(new_repo)"
  KEEP="$repo"
  copy_dir "$REPO/bin" "$repo/bin"
  printf 'needle here\n' >"$repo/notes.txt"
  git -C "$repo" add -A
  git -C "$repo" commit -q -m "add the needle"
  expect_ok "$repo/bin/scan" refs needle
  grep -q "notes.txt:1:needle here" "${LAST_LOG}" || die "scan refs missed the match"
  grep -q "add the needle" "${LAST_LOG}" || die "scan refs missed the commit"
  expect_ok "$repo/bin/scan" log --oneline
  grep -q "add the needle" "${LAST_LOG}" || die "scan log missed the commit"
  expect_ok "$repo/bin/scan" grep needle
  grep -q "needle here" "${LAST_LOG}" || die "scan grep missed the match"
  expect_ok "$repo/bin/scan" files
  grep -qx "notes.txt" "${LAST_LOG}" || die "scan files missed the file"
  expect_fail "$repo/bin/scan" sideways
  grep -q "usage: bin/scan" "${LAST_LOG}" || die "scan printed no usage"
}

test_root_format() {
  say "repo-level format"
  local repo
  repo="$(new_repo)"
  KEEP="$repo"
  copy_dir "$REPO/bin" "$repo/bin"
  printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail' 'if true;then' 'echo   "messy"' 'fi' >"$repo/messy"
  chmod +x "$repo/messy"
  printf '%s\n' '# Notes' '' '#Heading without a space' >"$repo/notes.md"
  expect_ok "$repo/bin/format"
  assert_eq "$(row_of suite "$(summary)")" "PASS" "format runs the repo-level formatter"
  grep -qx "if true; then" "$repo/messy" || die "bin/format did not reformat the script"
  grep -qx "## Heading without a space" "$repo/notes.md" ||
    grep -qx "# Heading without a space" "$repo/notes.md" ||
    die "bin/format did not fix the Markdown"
}

make_stub() {
  cat >"$1/$2" <<'EOF'
#!/usr/bin/env bash
printf '%s %s\n' "$(basename "$0")" "$*" >>"$STUB_LOG"
EOF
  chmod +x "$1/$2"
}

test_open() {
  say "open"
  local repo stubs home log lang tool tries
  repo="$(new_repo)"
  KEEP="$repo"
  stubs="$repo/.stubs"
  home="$repo/.home"
  log="$repo/stub.log"
  mkdir -p "$stubs" "$home"
  for tool in npm bundle curl open; do
    make_stub "$stubs" "$tool"
  done
  copy_dir "$REPO/bin" "$repo/bin"
  for lang in typescript javascript rails; do
    mkdir -p "$repo/$lang/node_modules"
  done
  printf '{}\n' >"$repo/typescript/package.json"
  printf '{}\n' >"$repo/typescript/tsconfig.json"
  printf '{}\n' >"$repo/javascript/package.json"
  printf "source 'https://rubygems.org'\n" >"$repo/rails/Gemfile"

  run_log env CI=1 PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" "$repo/bin/open" typescript
  assert_rc 0 "typescript bin/open"
  grep -qx "npm run dev -- --host 127.0.0.1 --open" "$log" || die "typescript bin/open ran the wrong command"

  : >"$log"
  run_log env CI=1 PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" "$repo/bin/open" javascript
  assert_rc 0 "javascript bin/open"
  grep -qx "npm run dev -- --host 127.0.0.1 --open" "$log" || die "javascript bin/open ran the wrong command"

  run_log env PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" PORT=4001 "$repo/bin/open" rails
  assert_rc 0 "rails bin/open"
  grep -qx "bundle exec rails server -b 127.0.0.1 -p 4001" "$log" || die "rails bin/open ran the wrong command"
  tries=0
  until grep -qx "open http://127.0.0.1:4001" "$log"; do
    tries=$((tries + 1))
    [ "$tries" -lt 50 ] || die "rails bin/open never opened the browser"
    sleep 0.1
  done
}

test_qa() {
  say "qa"
  local repo stubs home log lang playwright
  repo="$(new_repo)"
  KEEP="$repo"
  stubs="$repo/.stubs"
  home="$repo/.home"
  log="$repo/stub.log"
  mkdir -p "$stubs" "$home"
  make_stub "$stubs" bundle
  copy_dir "$REPO/bin" "$repo/bin"
  for lang in typescript javascript; do
    mkdir -p "$repo/$lang/node_modules/.bin"
    playwright="$repo/$lang/node_modules/.bin/playwright"
    cat >"$playwright" <<'EOF'
#!/usr/bin/env bash
printf 'playwright %s\n' "$*" >>"$STUB_LOG"
[ -z "${QA_WARN:-}" ] || echo "Warning: a slow page"
EOF
    chmod +x "$playwright"
  done
  printf '{}\n' >"$repo/typescript/package.json"
  printf '{}\n' >"$repo/typescript/tsconfig.json"
  printf '{}\n' >"$repo/javascript/package.json"
  mkdir -p "$repo/rails"
  printf "source 'https://rubygems.org'\n" >"$repo/rails/Gemfile"

  for lang in typescript javascript; do
    : >"$log"
    run_log env CI=1 PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" "$repo/bin/qa" "$lang" e2e/home.spec.ts
    assert_rc 0 "$lang bin/qa"
    grep -qx "playwright install chromium" "$log" || die "$lang bin/qa did not install Chromium"
    grep -qx "playwright test e2e/home.spec.ts" "$log" || die "$lang bin/qa did not run Playwright on the spec"
  done
  run_log env CI=1 QA_WARN=1 PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" "$repo/bin/qa" javascript
  assert_rc 1 "a run that printed a warning"
  grep -q "bin/qa: the run printed a warning" "${LAST_LOG}" || die "bin/qa passed a warning"
  rm "$repo/typescript/node_modules/.bin/playwright"
  run_log env CI=1 PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" "$repo/bin/qa" typescript
  assert_rc 1 "an app with no Playwright"
  grep -q "this app has no Playwright" "${LAST_LOG}" || die "bin/qa ran with no Playwright"

  : >"$log"
  run_log env PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" "$repo/bin/qa" rails test/system/home_test.rb
  assert_rc 0 "rails bin/qa"
  grep -qx "bundle exec rails test:system test/system/home_test.rb" "$log" || die "rails bin/qa did not run the system tests"
  run_log "$repo/bin/qa"
  assert_rc 2 "bin/qa with no app"
}

test_query() {
  say "query"
  local stubs log
  stubs="$WORK/query-stubs"
  log="$WORK/query.log"
  mkdir -p "$stubs"
  cat >"$stubs/psql" <<'EOF'
#!/usr/bin/env bash
printf 'psql %s\n' "$*" >>"$STUB_LOG"
printf 'PGOPTIONS=%s\n' "$PGOPTIONS" >>"$STUB_LOG"
EOF
  chmod +x "$stubs/psql"
  run_log "$REPO/bin/query"
  assert_rc 2 "bin/query with no statement"
  run_log "$REPO/bin/query" "select 1" "select 2"
  assert_rc 2 "bin/query with two statements"
  run_log env -u PGOPTIONS PATH="$stubs:$PATH" STUB_LOG="$log" "$REPO/bin/query" "select 1"
  assert_rc 0 "bin/query"
  grep -qx "psql --no-psqlrc --set=ON_ERROR_STOP=1 --command select 1" "$log" || die "bin/query ran psql wrongly"
  grep -qx "PGOPTIONS=-c default_transaction_read_only=on" "$log" || die "bin/query was not read-only"
  : >"$log"
  run_log env PGOPTIONS="-c default_transaction_read_only=off" PATH="$stubs:$PATH" STUB_LOG="$log" "$REPO/bin/query" "select 1"
  grep -qx "PGOPTIONS=-c default_transaction_read_only=off -c default_transaction_read_only=on" "$log" ||
    die "a PGOPTIONS that turns writes on was not overridden"
}

hook_on() {
  LAST_LOG="$(mktemp "$WORK/hook.XXXXXX")"
  if jq -n --arg c "$1" "{tool_input:{command:\$c}}" |
    "$REPO/starter/.claude/hooks/require-bin" >"${LAST_LOG}" 2>&1; then
    LAST_RC=0
  else
    LAST_RC=$?
  fi
}

test_hooks() {
  say "starter hooks"
  local cmd
  for cmd in "bun test" "cd app && cargo build" "bundle exec rubocop -A" \
    "RAILS_ENV=test bundle exec rails test" "npx biome check ." "uv run pytest" \
    "xcrun swift-format lint Sources" "ls; /opt/homebrew/bin/ruff check ." \
    "env cargo test" "time cargo test" "command cargo test" "nice -n 5 cargo test" "python -m pytest" \
    "uv run python3 -m mypy src" "echo \$(cargo test)" "echo \`cargo test\`" "bin/lint & cargo test" \
    "(cargo test)" "echo \"\$(cargo test)\""; do
    hook_on "$cmd"
    assert_rc 2 "require-bin should block: $cmd"
    grep -q "Blocked: call the bin/ script" "${LAST_LOG}" || die "no block message for: $cmd"
  done
  for cmd in "git commit -m x" "cd app && git commit -am x" \
    "git -C app commit -m x" "git -c user.name=x commit" "'git' commit -m x" \
    "sh -c \"git commit -m x\"" "GIT_DIR=. /usr/bin/git commit" "env git commit -m x"; do
    hook_on "$cmd"
    assert_rc 2 "require-bin should block: $cmd"
    grep -q "Blocked: commit with bin/commit" "${LAST_LOG}" || die "no commit block message for: $cmd"
  done
  for cmd in "bin/stamp-rules .claude/rules/a.md" "./bin/stamp-rules" "cd app && bin/stamp-rules"; do
    hook_on "$cmd"
    assert_rc 2 "require-bin should block: $cmd"
    grep -q "Blocked: only bin/commit stamps rules" "${LAST_LOG}" || die "no stamp block message for: $cmd"
  done
  for cmd in "CI=1 bin/ci" "env FLOW_CHECKED_APP=x bin/lint" "export CI=1"; do
    hook_on "$cmd"
    assert_rc 2 "require-bin should block: $cmd"
    grep -q "Blocked: CI and FLOW_CHECKED_APP" "${LAST_LOG}" || die "no check-skip block message for: $cmd"
  done
  for cmd in "bin/test src/add.ts" "bin/ci --typescript" "git status" \
    "bundle exec rails runner 1" "npm test" "ls -la" "git log --grep commit" \
    "bin/commit main /tmp/flow-commit-msg.abc123" "grep -n \"a\|bun test\" README.md" "echo 'cargo test'"; do
    hook_on "$cmd"
    assert_rc 0 "require-bin should allow: $cmd"
  done
  run_log env -u CLAUDE_CODE_REMOTE "$REPO/starter/.claude/hooks/session-start"
  assert_rc 0 "session-start outside the cloud"
  [ ! -s "${LAST_LOG}" ] || die "session-start ran something outside the cloud"
}

test_starter() {
  say "starter in a fresh repo"
  local repo lang probe token
  repo="$(new_repo)"
  KEEP="$repo"
  copy_dir "$REPO/starter" "$repo"
  copy_dir "$REPO/bin" "$repo/bin"
  for lang in typescript javascript python rails rust ios shell; do
    copy_dir "$REPO/$lang/.claude" "$repo/.claude"
  done

  local check_probe="$WORK/check-probe"
  mkdir -p "$repo/checks"
  cat >"$repo/checks/probe" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[ ! -e "${PROBE_FILE:?}" ]
EOF
  chmod +x "$repo/checks/probe"
  export PROBE_FILE="$check_probe"
  expect_ok "$repo/bin/ci"
  assert_eq "$(row_of suite "$(summary)")" "PASS" "starter suite through bin/ci"
  touch "$check_probe"
  expect_fail "$repo/bin/ci"
  grep -q "checks/probe failed" "${LAST_LOG}" || die "a failing check did not fail bin/ci"
  unset PROBE_FILE
  rm -f "$check_probe"
  rm -r "$repo/checks"

  local cfg="$repo/cfg" cov="$repo/coverage-config" msg
  mkdir -p "$cov/ok/test"
  plant_ok_configs "$cfg/ok"
  printf "require 'simplecov'\nSimpleCov.start do\n  enable_coverage :branch\n  minimum_coverage line: 100, branch: 100\nend\n" >"$cov/ok/test/test_helper.rb"
  printf '{ "defaultOptions": { "codeCoverage": true } }\n' >"$cov/ok/App.xctestplan"
  printf '# Probe\n\nA probe rule.\n' >"$repo/.claude/rules/probe.md"
  expect_ok "$repo/bin/stamp-rules" "$repo/.claude/rules/probe.md"
  expect_ok "$repo/tests/run"
  rm -r "$cfg/ok" "$cov/ok"

  {
    printf '# Notes\n\n'
    head -c 70000 /dev/zero | tr '\0' 'a'
    printf '\n'
  } >"$repo/big.md"

  probe="$repo/probe.py"
  token="no"
  token+="qa"
  printf 'value = 1  # %s\n' "$token" >"$probe"

  plant_bad_configs "$cfg/bad" "$repo"

  local skips="$repo/skips" form
  mkdir -p "$skips/tests" "$skips/test" "$skips/src" "$skips/ios/Tests"
  form="test"
  form+=".only"
  printf '%s("a", () => {});\ntest("b", () => {});\n' "$form" >"$skips/a.test.ts"
  form="x"
  form+="it"
  printf '%s("a", () => {});\n' "$form" >"$skips/b.spec.js"
  form="@pytest.mark."
  form+="skip"
  printf 'import pytest\n\n\n%s\ndef test_a():\n    pass\n' "$form" >"$skips/tests/test_a.py"
  form="  sk"
  form+="ip"
  printf 'class ATest\n  def test_a\n%s\n  end\nend\n' "$form" >"$skips/test/a_test.rb"
  form="#[ign"
  form+="ore]"
  printf '%s\n#[test]\nfn a() {}\n' "$form" >"$skips/src/lib.rs"
  form="XCT"
  form+="Skip"
  printf 'func testA() throws {\n  throw %s("x")\n}\n' "$form" >"$skips/ios/Tests/ATests.swift"

  local slow="$repo/timeouts"
  mkdir -p "$slow/bin/_typescript" "$slow/tests" "$slow/ios/Tests"
  printf 'vitest run --testTimeout 60000\n' >"$slow/bin/_typescript/test"
  printf '{ "jest": { "testTimeout": 60000 } }\n' >"$slow/package.json"
  printf 'export default { test: { testTimeout: 60000 } };\n' >"$slow/vitest.config.ts"
  printf '[test]\ntimeout = 60000\n' >"$slow/bunfig.toml"
  printf '[tool.pytest.ini_options]\ntimeout = 60\n' >"$slow/pyproject.toml"
  printf 'test("a", () => {}, { timeout: 10_000 });\nvi.setConfig({ testTimeout: 60000 });\ntest("b", () => {}, { timeout: 2 * 60000 });\n' >"$slow/a.test.ts"
  printf '[pytest]\naddopts = --timeout=60\n' >"$slow/pytest.ini"
  printf 'import pytest\n\n\n@pytest.mark.timeout(10)\ndef test_a():\n    pass\n\n\n@pytest.mark.timeout(LIMIT)\ndef test_b():\n    pass\n' >"$slow/tests/test_slow.py"
  printf 'final class SlowTests: XCTestCase {\n  override func setUp() { executionTimeAllowance = 600 }\n}\n' >"$slow/ios/Tests/SlowTests.swift"
  printf '{ "defaultOptions": { "defaultTestExecutionTimeAllowance": 600 } }\n' >"$slow/App.xctestplan"

  mkdir -p "$cov/bad/test" "$cov/bad/App.xcodeproj/xcshareddata/xcschemes"
  printf "require 'simplecov'\nSimpleCov.start do\n  minimum_coverage line: 90, branch: 100\n  add_filter 'app/payments'\nend\n" >"$cov/bad/test/test_helper.rb"
  printf '{ "defaultOptions": { "codeCoverage": false } }\n' >"$cov/bad/App.xctestplan"
  printf '<TestAction onlyGenerateCoverageForSpecifiedTargets = "YES">\n' >"$cov/bad/App.xcodeproj/xcshareddata/xcschemes/App.xcscheme"

  mkdir -p "$repo/web/dist" "$repo/web/bin" "$repo/bin/_root"
  printf 'x\n' >"$repo/web/dist/app.js"
  git -C "$repo" add -f web/dist/app.js
  printf 'TN:\n' >"$repo/web/lcov.info"
  cp "$repo/.gitignore" "$repo/gitignore.keep"
  grep -vx 'coverage/' "$repo/gitignore.keep" >"$repo/.gitignore"
  rm "$repo/gitignore.keep"
  printf '#!/usr/bin/env bash\nset -euo pipefail\n' >"$repo/web/bin/ci"
  printf '#!/usr/bin/env bash\nset -euo pipefail\n' >"$repo/bin/_root/test"
  chmod +x "$repo/web/bin/ci" "$repo/bin/_root/test"

  printf 'npm install\n' >>"$repo/bin/_typescript/build"
  printf 'uv sync\n' >>"$repo/bin/_python/dependencies"
  grep -vx 'npm update' "$REPO/bin/_typescript/dependencies" >"$repo/bin/_typescript/dependencies"
  grep -v packages_check "$REPO/bin/_python/lint" >"$repo/bin/_python/lint"

  local notes="$repo/comment-plants" plant expected actual
  mkdir -p "$notes"
  cat >"$notes/a.ts" <<'EOF'
const a = 'x // y';
const b = "/* no */";
const c = `t ${[1].map((e) => `${e}//`)} // still`;
const r = /\/\/[/]x/u;
const q = 1 / 2 / 3;
// flagged
const z = 1; /* flagged */
const s = 'x\'y';
EOF
  cat >"$notes/s.sh" <<'EOF'
#!/usr/bin/env bash
# shellcheck source=lib.sh
echo "${#arr[@]} $# \#"
x=1 # flagged
cat <<'INNER'
# inside heredoc
INNER
echo 'a # b'
# flagged
echo "x <<END"
# flagged after a quoted heredoc marker
EOF
  cat >"$notes/r.rb" <<'EOF'
# frozen_string_literal: true
x = "#{y}" # flagged
# coding: not a magic comment, so flagged
=begin flagged
flagged
=end flagged
z = <<~TEXT
  # body
TEXT
a = "#"
# flagged
EOF
  cat >"$notes/p.py" <<'EOF'
s = "# not"
t = """
# inside
"""
x = 1  # flagged
# flagged
EOF
  printf '%s\n' 'a = "#"' '# flagged' 'b = 1 # flagged' >"$notes/t.toml"
  printf '%s\n' 'url: http://x#y' 'key: "a # b"' '# flagged' 'c: d # flagged' "name: Ben's app" 'e: f # flagged' >"$notes/y.yml"
  printf '%s\n' '// swift-tools-version: 6.0' 'import PackageDescription' '/// flagged' 'let s = "// no"' >"$notes/Package.swift"
  printf '%s\n' '// swift-tools-version: 6.0 flagged outside Package.swift' 'export const b = 1;' >"$notes/b.ts"
  printf '%s\n' '//! flagged' "fn f<'a>(s: &'a str) -> &'a str { s }" 'const U: &str = "http://x";' '/// flagged' \
    "fn g() -> &'static str { \"x\" } // flagged" "const C: char = '\"';" '// flagged' >"$notes/lib.rs"
  printf '%s\n' 'a { background: url(http://x); }' '/* flagged */' >"$notes/s.css"
  printf '%s\n' '# flagged' 'dist/' >"$notes/.gitignore"

  {
    printf '# Long\n\n'
    for _ in $(seq 1 45); do printf -- '- line\n'; done
  } >"$repo/.claude/rules/long.md"
  printf '# Unstamped\n\nAn unstamped rule.\n' >"$repo/.claude/rules/unstamped.md"
  perl -pi -e 's/A probe rule/A changed rule/' "$repo/.claude/rules/probe.md"

  printf '%s\n' '#!/usr/bin/env bash' 'echo "loose"' >"$repo/bin/loose"
  printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail' 'if true;then' 'echo   "messy"' 'fi' >"$repo/bin/messy"
  chmod +x "$repo/bin/loose" "$repo/bin/messy"
  printf '%s\n' '# Notes' '' '#Heading without a space' >"$repo/notes.md"

  cp "$repo/.claude/settings.json" "$repo/settings.json.keep"
  jq '.permissions.deny -= ["Bash(git reset *)", "Bash(git push * -f)"]
    | .permissions.allow += ["Bash(*/bin/*)", "Bash"] | del(.hooks.SessionStart)' \
    "$repo/settings.json.keep" >"$repo/.claude/settings.json"
  rm "$repo/settings.json.keep"

  expect_fail "$repo/tests/run"
  grep -q "big.md: 70010 bytes, over the 65536-byte cap" "${LAST_LOG}" || die "size cap not enforced"
  grep -q "probe.py:1: suppression comment" "${LAST_LOG}" || die "suppression ban not enforced"
  check_bad_configs
  for msg in a.test.ts:1 b.spec.js:1 tests/test_a.py:4 test/a_test.rb:3 src/lib.rs:1 ios/Tests/ATests.swift:2; do
    grep -qF "skips/$msg: a test that does not run" "${LAST_LOG}" || die "a test that does not run was not caught: $msg"
  done
  if grep -qF "skips/a.test.ts:2:" "${LAST_LOG}"; then
    die "a test that runs was flagged"
  fi
  for msg in bin/_typescript/test:1 package.json:1 vitest.config.ts:1 bunfig.toml:2 pyproject.toml:2 \
    pytest.ini:2 a.test.ts:2 a.test.ts:3 tests/test_slow.py:9 ios/Tests/SlowTests.swift:2 App.xctestplan:1; do
    grep -qF "timeouts/$msg: raises the test time limit" "${LAST_LOG}" || die "a raised time limit was not caught: $msg"
  done
  for msg in a.test.ts:1 tests/test_slow.py:4; do
    if grep -qF "timeouts/$msg:" "${LAST_LOG}"; then
      die "a fixed time limit on one test was flagged: $msg"
    fi
  done
  for msg in "test/test_helper.rb: starts SimpleCov without minimum_coverage line: 100, branch: 100" \
    "test/test_helper.rb:4: leaves files out of coverage" \
    "App.xctestplan:1: turns code coverage off" \
    "App.xcodeproj/xcshareddata/xcschemes/App.xcscheme:1: turns code coverage off"; do
    grep -qF "coverage-config/bad/$msg" "${LAST_LOG}" || die "narrowed coverage was not caught: $msg"
  done
  grep -qF "web/dist/app.js: build or coverage output" "${LAST_LOG}" || die "tracked build output was not caught"
  grep -qF "web/lcov.info: build or coverage output" "${LAST_LOG}" || die "a coverage report was not caught"
  grep -qF ".gitignore does not ignore coverage/" "${LAST_LOG}" || die "a missing ignore line was not caught"
  grep -qF "web/bin/ci: a gate script inside an app" "${LAST_LOG}" || die "a gate script inside an app was not caught"
  grep -qF "bin/_root/test: the root app runs from bin/_<language>/" "${LAST_LOG}" || die "a bin/_root script was not caught"
  grep -qE "bin/_typescript/build:[0-9]+: installs packages; only bin/dependencies does" "${LAST_LOG}" ||
    die "a gate script that installs was not caught"
  grep -q "bin/_python/dependencies:[0-9]*: installs packages" "${LAST_LOG}" && die "bin/dependencies was refused for installing"
  grep -qF "bin/_typescript/dependencies: installs packages without updating them first" "${LAST_LOG}" ||
    die "a bin/dependencies that only installs was not caught"
  grep -qF "bin/_python/lint: never runs packages_check" "${LAST_LOG}" ||
    die "a gate script that skips packages_check was not caught"
  for plant in a.ts b.ts s.sh r.rb p.py t.toml y.yml Package.swift lib.rs s.css .gitignore; do
    expected="$(grep -n flagged "$notes/$plant" | cut -d: -f1 | tr '\n' ' ')"
    actual="$(sed -nE "s|^guards: comment-plants/$plant:([0-9]+): a comment.*|\1|p" "${LAST_LOG}" | tr '\n' ' ')"
    assert_eq "$actual" "$expected" "comments found in $plant"
  done
  grep -q "long.md: 47 lines (cap 40)" "${LAST_LOG}" || die "rule cap not enforced"
  grep -q "unstamped.md: no audit stamp" "${LAST_LOG}" || die "missing stamp not caught"
  grep -q "probe.md: audit stamp does not match its body" "${LAST_LOG}" || die "stale stamp not caught"
  grep -q "bin/loose: first command is not set -euo pipefail" "${LAST_LOG}" || die "strict mode not enforced"
  grep -q "shfmt would reformat" "${LAST_LOG}" || die "script formatting not enforced"
  grep -q "notes.md:3.*MD018" "${LAST_LOG}" || die "markdownlint not enforced"
  grep -q "does not deny Bash(git reset \*)" "${LAST_LOG}" || die "missing deny not caught"
  grep -q "does not deny Bash(git push \* -f)" "${LAST_LOG}" || die "missing force-push deny not caught"
  grep -qF "allows every command: Bash(*/bin/*)" "${LAST_LOG}" || die "wildcard allow not caught"
  grep -qx "guards: .claude/settings.json: allows every command: Bash" "${LAST_LOG}" || die "bare Bash allow not caught"
  grep -q "no SessionStart hook runs" "${LAST_LOG}" || die "missing hook not caught"

  sed 's/^MAX_AUTHORED_BYTES=65536$/MAX_AUTHORED_BYTES=99999/' "$repo/tests/guards" >"$repo/tests/guards.raised"
  mv "$repo/tests/guards.raised" "$repo/tests/guards"
  chmod +x "$repo/tests/guards"
  expect_fail "$repo/tests/run"
  grep -q "does not pin MAX_AUTHORED_BYTES=65536" "${LAST_LOG}" || die "raised cap not caught"
  sed 's/^MAX_AUTHORED_BYTES=99999$/MAX_AUTHORED_BYTES=65536/' "$repo/tests/guards" >"$repo/tests/guards.raised"
  printf 'MAX_AUTHORED_BYTES=99999\n' >>"$repo/tests/guards.raised"
  mv "$repo/tests/guards.raised" "$repo/tests/guards"
  chmod +x "$repo/tests/guards"
  expect_fail "$repo/tests/run"
  grep -q "does not pin MAX_AUTHORED_BYTES=65536 in its one assignment" "${LAST_LOG}" || die "a second cap assignment was not caught"
}

fake_claude() {
  mkdir -p "$1"
  cat >"$1/claude" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
prompt="$(cat)"
case "$prompt" in
  *"You are the rule-fixer."*)
    echo "fix $*" >>"$FAKE_CLAUDE_LOG"
    files='[]'
    while IFS= read -r f; do
      case "${FAKE_FIX:-}" in
        good) text="$(perl -pe 's/BAD/GOOD/' "$f")" ;;
        grow) text="$(cat "$f" && for _ in $(seq 1 50); do echo "- more"; done)" ;;
        outside)
          f=notes.md
          text="replaced"
          ;;
        newfile)
          f=.claude/rules/split.md
          text="# Split"
          ;;
        *) continue ;;
      esac
      files="$(jq -c --arg p "$f" --arg c "$text"$'\n' '. + [{path: $p, content: $c}]' <<<"$files")"
    done < <(awk '/^## Files you may change$/ { on = 1; next } /^## / { on = 0 }
      on && /^- / { print substr($0, 3) }' <<<"$prompt")
    printf '{"type":"result","is_error":false,"structured_output":{"files":%s}}\n' "$files"
    ;;
  *)
    if grep -q '^audit' "$FAKE_CLAUDE_LOG"; then
      echo "verify $*" >>"$FAKE_CLAUDE_LOG"
      printf '%s\n' "$prompt" >"$FAKE_CLAUDE_LOG.recheck"
      if [ -n "${FAKE_VERIFY_SEQ:-}" ]; then
        word="$(printf '%s\n' ${FAKE_VERIFY_SEQ} | sed -n "$(grep -c '^verify' "$FAKE_CLAUDE_LOG")p")"
        if [ -n "$word" ]; then
          printf '{"type":"result","is_error":false,"structured_output":{"findings":[{"file":".claude/rules/probe.md","requirement":"r","offending":"%s","fix":"f"}]}}\n' "$word"
        else
          echo '{"type":"result","is_error":false,"structured_output":{"findings":[]}}'
        fi
      else
        printf '{"type":"result","is_error":false,"structured_output":{"findings":%s}}\n' "${FAKE_VERIFY:-[]}"
      fi
      exit 0
    fi
    echo "audit $*" >>"$FAKE_CLAUDE_LOG"
    printf '%s\n' "$prompt" >"$FAKE_CLAUDE_LOG.prompt"
    if [ "${FAKE_AUDIT:-}" = none ]; then
      echo '{"type":"result","is_error":false}'
    else
      printf '{"type":"result","is_error":false,"structured_output":{"findings":%s}}\n' "${FAKE_AUDIT:-[]}"
    fi
    ;;
esac
EOF
  chmod +x "$1/claude"
}

commit_json() { jq -r "$1" "${LAST_LOG}"; }

stand_in_ci() {
  cat >"$1/bin/ci" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
for check in checks/*; do
  [ ! -x "$check" ] || "$check"
done
EOF
