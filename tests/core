#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
# shellcheck source=lib.sh
. "$HERE/lib.sh"
# shellcheck source=lib/seeds.sh
. "$HERE/lib/seeds.sh"
# shellcheck source=lib/configs.sh
. "$HERE/lib/configs.sh"
# shellcheck source=lib/dispatch.sh
. "$HERE/lib/dispatch.sh"
# shellcheck source=lib/guards.sh
. "$HERE/lib/guards.sh"
# shellcheck source=lib/commit.sh
. "$HERE/lib/commit.sh"
# shellcheck source=lib/workflow.sh
. "$HERE/lib/workflow.sh"
start_work
export UV_CACHE_DIR="${UV_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/uv}"
export XDG_CACHE_HOME="$WORK/cache"

settings_findings() {
  local root="$1"
  local paths='["bin/**","tests/guards","tests/run",".claude/settings.json",".claude/settings.local.json",".claude/hooks/**",".githooks/**"]'
  local gate
  gate="$(jq -c '[.[] | "Edit(/\(.))", "Edit(/.worktrees/*/\(.))"]' <<<"$paths")"
  jq -e --argjson gate "$gate" '$gate - .permissions.deny == []' "$root/starter/.claude/settings.json" >/dev/null ||
    echo "the starter's settings do not deny editing the gate"
  jq -e --argjson gate "$gate" --slurpfile mine "$root/.claude/settings.json" \
    '(.permissions.deny -= $gate) == $mine[0]' "$root/starter/.claude/settings.json" >/dev/null ||
    echo "this repo's settings are not the starter's less the gate-edit denies"
}

test_settings() {
  say "settings"
  local found want plant="$WORK/settings"
  found="$(settings_findings "$REPO")"
  [ -z "$found" ] || die "$found"
  mkdir -p "$plant/starter/.claude" "$plant/.claude"
  jq '.permissions.deny -= ["Edit(/tests/guards)"]' "$REPO/starter/.claude/settings.json" >"$plant/starter/.claude/settings.json"
  jq '.permissions.allow += ["Bash(extra)"]' "$REPO/.claude/settings.json" >"$plant/.claude/settings.json"
  want=$(printf '%s\n' "the starter's settings do not deny editing the gate" \
    "this repo's settings are not the starter's less the gate-edit denies")
  assert_eq "$(settings_findings "$plant")" "$want" "planted settings"
  jq '.permissions.deny -= ["Edit(/.worktrees/*/bin/**)"]' "$REPO/starter/.claude/settings.json" >"$plant/starter/.claude/settings.json"
  cp "$REPO/.claude/settings.json" "$plant/.claude/settings.json"
  assert_eq "$(settings_findings "$plant")" "the starter's settings do not deny editing the gate" \
    "starter settings that leave a worktree's gate editable"
}

test_scan() {
  say "scan"
  local repo
  repo="$(new_repo)"
  KEEP="$repo"
  copy_dir "$REPO/bin" "$repo/bin"
  printf 'needle here\n' >"$repo/notes.txt"
  git -C "$repo" add -A
  git -C "$repo" commit -q -m "add the needle"
  expect_ok "$repo/bin/scan" refs needle
  grep -q "notes.txt:1:needle here" "${LAST_LOG}" || die "scan refs missed the match"
  grep -q "add the needle" "${LAST_LOG}" || die "scan refs missed the commit"
  expect_ok "$repo/bin/scan" log --oneline
  grep -q "add the needle" "${LAST_LOG}" || die "scan log missed the commit"
  expect_ok "$repo/bin/scan" grep needle
  grep -q "needle here" "${LAST_LOG}" || die "scan grep missed the match"
  expect_ok "$repo/bin/scan" files
  grep -qx "notes.txt" "${LAST_LOG}" || die "scan files missed the file"
  expect_fail "$repo/bin/scan" sideways
  grep -q "usage: bin/scan" "${LAST_LOG}" || die "scan printed no usage"
}

test_root_format() {
  say "repo-level format"
  local repo
  repo="$(new_repo)"
  KEEP="$repo"
  copy_dir "$REPO/bin" "$repo/bin"
  printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail' 'if true;then' 'echo   "messy"' 'fi' >"$repo/messy"
  chmod +x "$repo/messy"
  printf '%s\n' 'if true;then' 'echo   "sourced"' 'fi' >"$repo/sourced.sh"
  printf '%s\n' '# Notes' '' '#Heading without a space' >"$repo/notes.md"
  expect_fail "$repo/bin/format" --check
  assert_eq "$(row_of suite "$(summary)")" "FAIL" "format --check passed an unformatted script"
  grep -q "sourced.sh" "${LAST_LOG}" || die "format --check skipped a .sh file with no shebang"
  grep -qx "if true;then" "$repo/messy" || die "bin/format --check rewrote the script"
  grep -qx "#Heading without a space" "$repo/notes.md" || die "bin/format --check rewrote the Markdown"
  printf '{ broken\n' >"$repo/.markdownlint.jsonc"
  expect_fail "$repo/bin/format"
  assert_eq "$(row_of suite "$(summary)")" "FAIL" "format hid a markdownlint failure"
  rm "$repo/.markdownlint.jsonc"
  expect_ok "$repo/bin/format"
  assert_eq "$(row_of suite "$(summary)")" "PASS" "format runs the repo-level formatter"
  grep -qx "if true; then" "$repo/messy" || die "bin/format did not reformat the script"
  grep -qx "if true; then" "$repo/sourced.sh" || die "bin/format did not reformat a .sh file with no shebang"
  grep -qx "## Heading without a space" "$repo/notes.md" ||
    grep -qx "# Heading without a space" "$repo/notes.md" ||
    die "bin/format did not fix the Markdown"
}

make_stub() {
  cat >"$1/$2" <<'EOF'
#!/usr/bin/env bash
printf '%s %s\n' "$(basename "$0")" "$*" >>"$STUB_LOG"
EOF
  chmod +x "$1/$2"
}

test_open() {
  say "open"
  local repo stubs home log lang tool tries
  repo="$(new_repo)"
  KEEP="$repo"
  stubs="$repo/.stubs"
  home="$repo/.home"
  log="$repo/stub.log"
  mkdir -p "$stubs" "$home"
  for tool in npm bundle curl open; do
    make_stub "$stubs" "$tool"
  done
  copy_dir "$REPO/bin" "$repo/bin"
  for lang in typescript javascript rails; do
    stub_npm_install "$repo/$lang"
  done
  printf '{}\n' >"$repo/typescript/package.json"
  printf '{}\n' >"$repo/typescript/tsconfig.json"
  printf '{}\n' >"$repo/javascript/package.json"
  printf "source 'https://rubygems.org'\n" >"$repo/rails/Gemfile"

  run_log env CI=1 PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" "$repo/bin/open" typescript
  assert_rc 0 "typescript bin/open"
  grep -qx "npm run dev -- --host 127.0.0.1 --open" "$log" || die "typescript bin/open ran the wrong command"

  : >"$log"
  run_log env CI=1 PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" "$repo/bin/open" javascript
  assert_rc 0 "javascript bin/open"
  grep -qx "npm run dev -- --host 127.0.0.1 --open" "$log" || die "javascript bin/open ran the wrong command"

  run_log env PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" PORT=4001 "$repo/bin/open" rails
  assert_rc 0 "rails bin/open"
  grep -qx "bundle exec rails server -b 127.0.0.1 -p 4001" "$log" || die "rails bin/open ran the wrong command"
  tries=0
  until grep -qx "open http://127.0.0.1:4001" "$log"; do
    tries=$((tries + 1))
    [ "$tries" -lt 50 ] || die "rails bin/open never opened the browser"
    sleep 0.1
  done
}

test_qa() {
  say "qa"
  local repo stubs home log lang playwright
  repo="$(new_repo)"
  KEEP="$repo"
  stubs="$repo/.stubs"
  home="$repo/.home"
  log="$repo/stub.log"
  mkdir -p "$stubs" "$home"
  cat >"$stubs/bundle" <<'EOF'
#!/usr/bin/env bash
printf 'bundle %s\n' "$*" >>"$STUB_LOG"
[ "$1" = exec ] || exit 0
[ -z "${QA_WARN:-}" ] || echo "DEPRECATION WARNING: an old call"
[ -z "${QA_FAIL:-}" ] || exit 1
[ -z "${QA_COVERAGE:-}" ] || exit 2
EOF
  chmod +x "$stubs/bundle"
  copy_dir "$REPO/bin" "$repo/bin"
  for lang in typescript javascript; do
    stub_npm_install "$repo/$lang"
    mkdir -p "$repo/$lang/node_modules/.bin"
    playwright="$repo/$lang/node_modules/.bin/playwright"
    cat >"$playwright" <<'EOF'
#!/usr/bin/env bash
printf 'playwright %s\n' "$*" >>"$STUB_LOG"
[ -z "${QA_WARN:-}" ] || echo "Warning: a slow page"
[ -z "${QA_FAIL:-}" ] || [ "$1" != test ] || exit 1
EOF
    chmod +x "$playwright"
  done
  printf '{}\n' >"$repo/typescript/package.json"
  printf '{}\n' >"$repo/typescript/tsconfig.json"
  printf '{}\n' >"$repo/javascript/package.json"
  mkdir -p "$repo/rails"
  printf "source 'https://rubygems.org'\n" >"$repo/rails/Gemfile"

  for lang in typescript javascript; do
    : >"$log"
    run_log env CI=1 PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" "$repo/bin/qa" "$lang" e2e/home.spec.ts
    assert_rc 0 "$lang bin/qa"
    grep -qx "playwright install chromium" "$log" || die "$lang bin/qa did not install Chromium"
    grep -qx "playwright test e2e/home.spec.ts" "$log" || die "$lang bin/qa did not run Playwright on the spec"
  done
  for lang in typescript javascript; do
    run_log env CI=1 QA_WARN=1 PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" "$repo/bin/qa" "$lang"
    assert_rc 1 "$lang bin/qa on a run that printed a warning"
    grep -q "bin/qa: the run printed a warning" "${LAST_LOG}" || die "$lang bin/qa passed a warning"
    run_log env CI=1 QA_FAIL=1 PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" "$repo/bin/qa" "$lang"
    assert_rc 1 "$lang bin/qa on a failing end-to-end test"
    grep -q "bin/qa: an end-to-end test failed" "${LAST_LOG}" || die "$lang bin/qa passed a failing end-to-end test"
  done
  rm "$repo/typescript/node_modules/.bin/playwright"
  run_log env CI=1 PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" "$repo/bin/qa" typescript
  assert_rc 1 "an app with no Playwright"
  grep -q "this app has no Playwright" "${LAST_LOG}" || die "bin/qa ran with no Playwright"

  : >"$log"
  run_log env PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" "$repo/bin/qa" rails test/system/home_test.rb
  assert_rc 0 "rails bin/qa"
  grep -qx "bundle exec rails test:system test/system/home_test.rb" "$log" || die "rails bin/qa did not run the system tests"
  run_log env QA_COVERAGE=1 PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" "$repo/bin/qa" rails
  assert_rc 0 "rails bin/qa on system tests that cover less than SimpleCov's minimum"
  run_log env QA_FAIL=1 PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" "$repo/bin/qa" rails
  assert_rc 1 "rails bin/qa on a failing system test"
  grep -q "bin/qa: a system test failed" "${LAST_LOG}" || die "rails bin/qa passed a failing system test"
  run_log env QA_WARN=1 PATH="$stubs:$PATH" HOME="$home" STUB_LOG="$log" "$repo/bin/qa" rails
  assert_rc 1 "rails bin/qa on a run that printed a warning"
  grep -q "bin/qa: the run printed a warning" "${LAST_LOG}" || die "rails bin/qa passed a warning"
  run_log "$repo/bin/qa"
  assert_rc 2 "bin/qa with no app"
}

test_query() {
  say "query"
  local stubs log want
  stubs="$WORK/query-stubs"
  log="$WORK/query.log"
  mkdir -p "$stubs"
  cat >"$stubs/psql" <<'EOF'
#!/usr/bin/env bash
if [ "$3" = --tuples-only ]; then
  [ -z "${STUB_LOG:-}" ] || printf '%s\n' "$*" >"$STUB_LOG.writes"
  printf '%s\n' "$QUERY_WRITES"
  exit 0
fi
printf 'psql %s\n' "$*" >>"$STUB_LOG"
printf 'PGOPTIONS=%s\n' "$PGOPTIONS" >>"$STUB_LOG"
EOF
  chmod +x "$stubs/psql"
  run_log "$REPO/bin/query"
  assert_rc 2 "bin/query with no statement"
  run_log "$REPO/bin/query" "select 1" "select 2"
  assert_rc 2 "bin/query with two statements"
  : >"$log"
  run_log env QUERY_WRITES=f PATH="$stubs:$PATH" STUB_LOG="$log" "$REPO/bin/query" '\! touch pwned'
  assert_rc 2 "bin/query with a psql backslash command"
  grep -q "takes SQL, not a psql backslash command" "${LAST_LOG}" || die "bin/query ran a psql backslash command"
  [ ! -s "$log" ] || die "bin/query handed a backslash command to psql"
  run_log env QUERY_WRITES=t PATH="$stubs:$PATH" STUB_LOG="$log" "$REPO/bin/query" "select 1"
  assert_rc 1 "bin/query as a role that can write"
  grep -q "set PGUSER to a role that can only read" "${LAST_LOG}" || die "bin/query ran as a role that can write"
  [ ! -s "$log" ] || die "bin/query ran a statement as a role that can write"
  run_log env -u PGOPTIONS QUERY_WRITES=f PATH="$stubs:$PATH" STUB_LOG="$log" "$REPO/bin/query" "select 1"
  assert_rc 0 "bin/query"
  grep -qx "psql --no-psqlrc --set=ON_ERROR_STOP=1 --command select 1" "$log" || die "bin/query ran psql wrongly"
  grep -qx "PGOPTIONS=-c default_transaction_read_only=on" "$log" || die "bin/query was not read-only"
  grep -q "FROM pg_roles m WHERE pg_has_role(m.oid, 'MEMBER')" "$log.writes" ||
    die "bin/query judged only the role it connects as, not every role it can SET ROLE to"
  for want in "m.rolname IN ('pg_execute_server_program', 'pg_write_server_files')" \
    "has_database_privilege(m.oid, current_database(), 'CREATE')" "has_schema_privilege(m.oid, n.oid, 'CREATE')" \
    "c.relowner = m.oid" "'INSERT, UPDATE, DELETE, TRUNCATE, TRIGGER'" "has_any_column_privilege(m.oid, c.oid, 'INSERT, UPDATE')" \
    "has_sequence_privilege(m.oid, c.oid, 'USAGE, UPDATE')"; do
    grep -qF "$want" "$log.writes" || die "bin/query does not check: $want"
  done
  : >"$log"
  run_log env PGOPTIONS="-c default_transaction_read_only=off" QUERY_WRITES=f PATH="$stubs:$PATH" STUB_LOG="$log" "$REPO/bin/query" "select 1"
  grep -qx "PGOPTIONS=-c default_transaction_read_only=off -c default_transaction_read_only=on" "$log" ||
    die "a PGOPTIONS that turns writes on was not overridden"
}

hook_on() {
  LAST_LOG="$(mktemp "$WORK/hook.XXXXXX")"
  if jq -n --arg c "$1" "{tool_input:{command:\$c}}" |
    "$REPO/starter/.claude/hooks/require-bin" >"${LAST_LOG}" 2>&1; then
    LAST_RC=0
  else
    LAST_RC=$?
  fi
}

test_hooks() {
  say "starter hooks"
  local cmd
  for cmd in "bun test" "cd app && cargo build" "bundle exec rubocop -A" \
    "RAILS_ENV=test bundle exec rails test" "npx biome check ." "uv run pytest" \
    "xcrun swift-format lint Sources" "ls; /opt/homebrew/bin/ruff check ." \
    "env cargo test" "time cargo test" "command cargo test" "nice -n 5 cargo test" "python -m pytest" \
    "uv run python3 -m mypy src" "echo \$(cargo test)" "echo \`cargo test\`" "bin/lint & cargo test" \
    "(cargo test)" "echo \"\$(cargo test)\"" "if true; then cargo test; fi" "{ cargo test; }" "! cargo test" \
    "for f in a; do cargo test; done" "while cargo test; do :; done" "sh -c \"cd app && cargo test\"" \
    "bash -c 'cargo test' arg0" "sh -ec \"cargo test\"" "npx --yes vitest run" "npx @biomejs/biome check ." "npx prettier@3 --check ." \
    "npm exec -- biome check" "uv run --frozen pytest" "xcrun --sdk macosx swift build" "pnpm dlx biome check" \
    "uvx ruff check ." "timeout -s KILL 60 cargo test" "ls | xargs -n 1 cargo test" "stdbuf -oL cargo test" \
    "eval cargo test" "eval \"true; cargo test\"" ">/dev/null cargo test" "> /dev/null cargo test" \
    "2>&1 cargo test" "&>/dev/null cargo test" "</dev/null cargo test" "env -S \"cargo test\"" \
    "env -S'cargo test'" "env --split-string='cargo test'" "bash -c -- 'cargo test'" \
    "node node_modules/.bin/tsc" "node --require ./x.js node_modules/vitest/vitest.mjs run" \
    "find . -name x -exec cargo test \\;" "find . -execdir cargo test {} +"; do
    hook_on "$cmd"
    assert_rc 2 "require-bin should block: $cmd"
    grep -q "Blocked: call the bin/ script" "${LAST_LOG}" || die "no block message for: $cmd"
  done
  for cmd in "git commit -m x" "cd app && git commit -am x" \
    "git -C app commit -m x" "git -c user.name=x commit" "'git' commit -m x" \
    "sh -c \"git commit -m x\"" "GIT_DIR=. /usr/bin/git commit" "env git commit -m x" \
    "eval \"git commit -m x\"" "find . -name x -exec git commit -m x \\;" "2>/dev/null git commit -m x"; do
    hook_on "$cmd"
    assert_rc 2 "require-bin should block: $cmd"
    grep -q "Blocked: commit with bin/commit" "${LAST_LOG}" || die "no commit block message for: $cmd"
  done
  for cmd in "bin/stamp-rules .claude/rules/a.md" "./bin/stamp-rules" "cd app && bin/stamp-rules" \
    "bash bin/stamp-rules a.md" "sh -x bin/stamp-rules a.md" ". bin/stamp-rules a.md" "source bin/stamp-rules a.md" \
    "find .claude/rules -name a.md -exec bin/stamp-rules {} +" "eval bin/stamp-rules a.md"; do
    hook_on "$cmd"
    assert_rc 2 "require-bin should block: $cmd"
    grep -q "Blocked: only bin/commit stamps rules" "${LAST_LOG}" || die "no stamp block message for: $cmd"
  done
  for cmd in "CI=1 bin/ci" "env FLOW_CHECKED_APP=x bin/lint" "export CI=1" "declare -x CI=1; bin/ci" \
    "typeset -x FLOW_CHECKED_APP=x; bin/lint" "local CI=1"; do
    hook_on "$cmd"
    assert_rc 2 "require-bin should block: $cmd"
    grep -q "Blocked: CI and FLOW_CHECKED_APP" "${LAST_LOG}" || die "no check-skip block message for: $cmd"
  done
  for cmd in "bin/../../../../usr/bin/git reset --hard" "./bin/_python/../../x"; do
    hook_on "$cmd"
    assert_rc 2 "require-bin should block: $cmd"
    grep -q "Blocked: a bin/ path with .. in it" "${LAST_LOG}" || die "no climb block message for: $cmd"
  done
  for cmd in "bin/test src/add.ts" "bin/ci --typescript" "git status" \
    "bundle exec rails runner 1" "npm test" "ls -la" "git log --grep commit" \
    "bin/commit main /tmp/flow-commit-msg.abc123" "grep -n \"a\|bun test\" README.md" "echo 'cargo test'" \
    "command -v cargo" "ls >/dev/null 2>&1" "bin/ci 2>&1 | tail -n 5" "node --version" "eval echo hi" \
    "find . -name '*.md' -exec grep -l x {} +" "env -S \"ls -la\""; do
    hook_on "$cmd"
    assert_rc 0 "require-bin should allow: $cmd"
  done
  run_log env -u CLAUDE_CODE_REMOTE "$REPO/starter/.claude/hooks/session-start"
  assert_rc 0 "session-start outside the cloud"
  [ ! -s "${LAST_LOG}" ] || die "session-start ran something outside the cloud"
  local cloud="$WORK/cloud" source
  mkdir -p "$cloud/bin"
  printf '%s\n' '#!/usr/bin/env bash' 'echo "bin/ci ran"' >"$cloud/bin/ci"
  chmod +x "$cloud/bin/ci"
  for source in resume clear compact; do
    run_log env CLAUDE_CODE_REMOTE=true CLAUDE_PROJECT_DIR="$cloud" \
      "$REPO/starter/.claude/hooks/session-start" < <(printf '{"source":"%s"}\n' "$source")
    assert_rc 0 "session-start on $source"
    [ ! -s "${LAST_LOG}" ] || die "session-start ran bin/ci again on $source"
  done
  run_log env CLAUDE_CODE_REMOTE=true CLAUDE_PROJECT_DIR="$cloud" \
    "$REPO/starter/.claude/hooks/session-start" < <(printf '{"source":"startup"}\n')
  assert_rc 0 "session-start on startup"
  grep -qx "bin/ci ran" "${LAST_LOG}" || die "session-start did not run bin/ci when a cloud session started"
}

test_starter() {
  say "starter in a fresh repo"
  local repo lang probe token
  repo="$(new_repo)"
  KEEP="$repo"
  copy_dir "$REPO/starter" "$repo"
  copy_dir "$REPO/bin" "$repo/bin"
  for lang in typescript javascript python rails rust ios shell; do
    copy_dir "$REPO/$lang/.claude" "$repo/.claude"
  done

  local check_probe="$WORK/check-probe"
  mkdir -p "$repo/checks"
  cat >"$repo/checks/probe" <<EOF
#!/usr/bin/env bash
set -euo pipefail
revisit=$(date -v+30d +%F 2>/dev/null || date -d '+30 days' +%F)
[[ "\$(date +%F)" < "\$revisit" ]]
[ ! -e "\${PROBE_FILE:?}" ]
EOF
  chmod +x "$repo/checks/probe"
  export PROBE_FILE="$check_probe"
  expect_ok "$repo/bin/ci"
  assert_eq "$(row_of suite "$(summary)")" "PASS" "starter suite through bin/ci"
  touch "$check_probe"
  expect_fail "$repo/bin/ci"
  grep -q "checks/probe failed" "${LAST_LOG}" || die "a failing check did not fail bin/ci"
  unset PROBE_FILE
  rm -f "$check_probe"
  rm -r "$repo/checks"

  local cfg="$repo/cfg" cov="$repo/coverage-config" msg
  mkdir -p "$cov/ok/test"
  plant_ok_configs "$cfg/ok"
  printf "require 'simplecov'\nSimpleCov.start do\n  enable_coverage :branch\n  minimum_coverage line: 100, branch: 100\nend\n" >"$cov/ok/test/test_helper.rb"
  printf '{ "defaultOptions": { "codeCoverage": true } }\n' >"$cov/ok/App.xctestplan"
  printf '# Probe\n\nA probe rule.\n' >"$repo/.claude/rules/probe.md"
  run_log "$repo/bin/stamp-rules"
  assert_rc 2 "bin/stamp-rules with no rule file"
  grep -q "audited:" "$repo/.claude/rules/probe.md" && die "bin/stamp-rules with no rule file stamped a rule"
  expect_ok "$repo/bin/stamp-rules" "$repo/.claude/rules/probe.md"
  expect_ok "$repo/tests/run"
  local counter="$WORK/simplecov-counter" real_grep
  real_grep="$(command -v grep)"
  mkdir -p "$counter"
  cat >"$counter/grep" <<EOF
#!/usr/bin/env bash
case " \$* " in
  *"SimpleCov\\.start"*) printf 'scan\n' >>"$counter/log" ;;
esac
exec "$real_grep" "\$@"
EOF
  chmod +x "$counter/grep"
  printf 'VALUE = 1\n' >"$cov/ok/test/value.rb"
  expect_ok env PATH="$counter:$PATH" "$repo/tests/guards"
  assert_eq "$(wc -l <"$counter/log" | tr -d ' ')" 1 "the greps that looked for SimpleCov across three Ruby files"
  rm -r "$cfg/ok" "$cov/ok"

  {
    printf '# Notes\n\n'
    head -c 70000 /dev/zero | tr '\0' 'a'
    printf '\n'
  } >"$repo/big.md"

  probe="$repo/probe.py"
  token="no"
  token+="qa"
  printf 'value = 1  # %s\n' "$token" >"$probe"

  plant_bad_configs "$cfg/bad" "$repo"

  local skips="$repo/skips" form
  mkdir -p "$skips/tests" "$skips/test" "$skips/src" "$skips/ios/Tests"
  form="test"
  form+=".only"
  printf '%s("a", () => {});\ntest("b", () => {});\n' "$form" >"$skips/a.test.ts"
  form="x"
  form+="it"
  printf '%s("a", () => {});\n' "$form" >"$skips/b.spec.js"
