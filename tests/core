copies_findings() {
  local bin="$1" lang script
  for lang in ios rails typescript javascript python rust shell; do
    for script in ci changed format lint build test dependencies; do
      [ -x "$bin/_$lang/$script" ] || echo "$lang bin/$script is not executable"
    done
    grep -q '^finish_steps || ' "$bin/_$lang/ci" || echo "$lang ci does not run its steps through bin/lib/steps.sh"
  done
  for lang in typescript javascript rails; do
    [ -x "$bin/_$lang/open" ] || echo "$lang bin/open is not executable"
    [ -x "$bin/_$lang/qa" ] || echo "$lang bin/qa is not executable"
  done
  for lang in typescript javascript python rails; do
    for script in changed test; do
      grep -q '/lib/sources\.sh"$' "$bin/_$lang/$script" || echo "$lang $script does not source lib/sources.sh"
      ! grep -q '^is_source() {' "$bin/_$lang/$script" || echo "$lang $script keeps its own is_source"
    done
  done
}

test_copies_match() {
  say "every language ships its scripts"
  local found want plant="$WORK/bin"
  found="$(copies_findings "$REPO/bin")"
  [ -z "$found" ] || die "$found"
  copy_dir "$REPO/bin" "$plant"
  chmod -x "$plant/_rust/lint" "$plant/_rails/qa" "$plant/_typescript/open"
  grep -v '^finish_steps || ' "$REPO/bin/_shell/ci" >"$plant/_shell/ci"
  printf '%s\n' 'is_source() {' '  return 0' '}' >>"$plant/_javascript/changed"
  grep -v '/lib/sources\.sh"$' "$REPO/bin/_python/test" >"$plant/_python/test"
  want=$(printf '%s\n' "rust bin/lint is not executable" "shell ci does not run its steps through bin/lib/steps.sh" \
    "typescript bin/open is not executable" "rails bin/qa is not executable" \
    "javascript changed keeps its own is_source" "python test does not source lib/sources.sh")
  assert_eq "$(copies_findings "$plant")" "$want" "planted copies"
}

test_failed_writes() {
  say "a script whose write fails leaves no temp file behind"
  local dir="$WORK/failed-writes" tmp="$WORK/failed-writes-tmp"
  mkdir -p "$dir" "$tmp"
  printf '# Locked\n\nA rule.\n' >"$dir/locked.md"
  printf 'host 5\n' >"$dir/.ci-timeout"
  chmod 444 "$dir/locked.md" "$dir/.ci-timeout"
  run_log env TMPDIR="$tmp" "$REPO/bin/stamp-rules" "$dir/locked.md"
  [ "$LAST_RC" -ne 0 ] || die "bin/stamp-rules passed a rule it could not write"
  run_log env TMPDIR="$tmp" "$REPO/bin/_ci-timeout" app "$dir/.ci-timeout" 5
  [ "$LAST_RC" -ne 0 ] || die "bin/_ci-timeout passed a time file it could not write"
  [ -z "$(find "$tmp" -mindepth 1)" ] || die "a failed write left temp files: $(find "$tmp" -mindepth 1 | tr '\n' ' ')"
}

test_changed_empty() {
  say "changed on a clean tree"
  local repo
  repo="$(new_repo)"
  KEEP="$repo"
  copy_dir "$REPO/bin" "$repo/bin"
  git -C "$repo" add bin
  git -C "$repo" commit -q -m "bin"
  expect_ok "$repo/bin/changed"
  grep -q "nothing dirty" "${LAST_LOG}" || die "missing nothing-dirty line"
  mkdir -p "$repo/app"
  printf 'host 5\n' >"$repo/app/.ci-timeout"
  printf 'host 5\n' >"$repo/.ci-timeout"
  expect_ok "$repo/bin/changed"
  grep -q "nothing dirty" "${LAST_LOG}" || die "bin/changed counted a .ci-timeout as a change"
  run_log "$repo/bin/lint"
  assert_rc 1 "bin/lint with no app"
  grep -qx "bin/lint: no app or suite to run" "${LAST_LOG}" || die "bin/lint ran with no app or suite"
}

test_parts() {
  say "tests/run reruns only the parts whose inputs changed, all at once"
  local repo log run
  repo="$(new_repo)"
  KEEP="$repo"
  log="$repo/parts.log"
  run="$WORK/parts-running"
  mkdir -p "$repo/tests/lib" "$repo/starter/tests" "$repo/bin" "$repo/python" "$run"
  cp "$REPO/tests/run" "$REPO/tests/lib.sh" "$repo/tests/"
  printf '%s\n' '#!/usr/bin/env bash' "echo guards >>\"$log\"" >"$repo/starter/tests/run"
  printf '%s\n' '#!/usr/bin/env bash' "echo core >>\"$log\"" >"$repo/tests/core"
  printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail' "echo \"\$1\" >>\"$log\"" "touch \"$run/\$1\"" \
    "[ ! -e \"$run.slow\" ] || sleep 1" "ls \"$run\" | wc -l >>\"$run.counts\"" "rm \"$run/\$1\"" \
    "[ ! -e \"$run.fail-\$1\" ]" >"$repo/tests/language"
  chmod +x "$repo/starter/tests/run" "$repo/tests/core" "$repo/tests/language"
  echo "one" >"$repo/bin/tool"
  echo "one" >"$repo/python/notes.md"
  echo "one" >"$repo/README.md"
  git -C "$repo" add -A
  git -C "$repo" commit -q -m "parts"
  expect_ok "$repo/tests/run"
  assert_eq "$(sort "$log" | tr '\n' ' ')" "core guards ios javascript python rails rust shell typescript " "first run"
  : >"$log"
  expect_ok "$repo/tests/run"
  assert_eq "$(sort "$log" | tr '\n' ' ')" "guards " "unchanged run"
  : >"$log"
  echo "two" >>"$repo/README.md"
  expect_ok "$repo/tests/run"
  assert_eq "$(sort "$log" | tr '\n' ' ')" "guards " "a README edit"
  : >"$log"
  echo "two" >>"$repo/python/notes.md"
  expect_ok "$repo/tests/run"
  assert_eq "$(sort "$log" | tr '\n' ' ')" "core guards python " "a python edit"
  : >"$log"
  echo "two" >>"$repo/bin/tool"
  expect_ok "$repo/tests/run"
  assert_eq "$(sort "$log" | tr '\n' ' ')" "core guards ios javascript python rails rust shell typescript " "a bin/ edit"
  : >"$log"
  touch "$run.slow"
  expect_ok "$repo/tests/run" --force
  rm "$run.slow"
  assert_eq "$(sort "$log" | tr '\n' ' ')" "core guards ios javascript python rails rust shell typescript " "--force"
  [ "$(sort -n "$run.counts" | tail -n 1 | tr -d ' ')" -ge 2 ] || die "tests/run ran its parts one at a time"
  touch "$run.fail-rust"
  echo "three" >>"$repo/bin/tool"
  expect_fail "$repo/tests/run"
  rm "$run.fail-rust"
  : >"$log"
  expect_ok "$repo/tests/run"
  assert_eq "$(sort "$log" | tr '\n' ' ')" "guards rust " "a rerun after one part failed"
  touch "$run.fail-rust"
  expect_fail "$repo/tests/run" --force
  rm "$run.fail-rust"
  : >"$log"
  expect_ok "$repo/tests/run"
  assert_eq "$(sort "$log" | tr '\n' ' ')" "guards rust " "a rerun after a forced run failed one part on unchanged inputs"
  mkdir -p "$WORK/tool-stub"
  printf '%s\n' '#!/usr/bin/env bash' "cat \"$run.shfmt\"" >"$WORK/tool-stub/shfmt"
  chmod +x "$WORK/tool-stub/shfmt"
  echo "shfmt 1" >"$run.shfmt"
  expect_ok env PATH="$WORK/tool-stub:$PATH" "$repo/tests/run"
  : >"$log"
  expect_ok env PATH="$WORK/tool-stub:$PATH" "$repo/tests/run"
  assert_eq "$(sort "$log" | tr '\n' ' ')" "guards " "an unchanged toolchain"
  echo "shfmt 2" >"$run.shfmt"
  : >"$log"
  expect_ok env PATH="$WORK/tool-stub:$PATH" "$repo/tests/run"
  assert_eq "$(sort "$log" | tr '\n' ' ')" "core guards ios javascript python rails rust shell typescript " "a shfmt update"
  printf '#!/bin/sh\necho posix\n' >"$repo/bin/posix"
  expect_fail "$repo/tests/run"
  grep -qF "bin/posix: shebang is #!/bin/sh" "${LAST_LOG}" || die "tests/run passed a kit script that is not bash"
  rm "$repo/bin/posix"
  local maker=mktemp
  printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail' "log=\"\$($maker)\"" "rm -f \"\$log\"" >"$repo/bin/scratch"
  expect_fail "$repo/tests/run"
  grep -qF "bin/scratch:3: mktemp with no template ignores TMPDIR on macOS" "${LAST_LOG}" ||
    die "tests/run passed a kit script whose mktemp ignores TMPDIR"
}

test_shellcheck_cache() {
  say "the guards skip shellcheck on a set of scripts that already passed it"
  local repo stub calls real
  repo="$(new_repo)"
  KEEP="$repo"
  copy_dir "$REPO/starter" "$repo"
  stub="$WORK/stub"
  calls="$WORK/shellcheck-calls"
  real="$(command -v shellcheck)"
  mkdir -p "$stub"
  printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail' \
    "[ \"\${1:-}\" = --version ] || echo called >>\"$calls\"" "exec \"$real\" \"\$@\"" >"$stub/shellcheck"
  chmod +x "$stub/shellcheck"
  expect_ok env PATH="$stub:$PATH" XDG_CACHE_HOME="$WORK/cache" "$repo/tests/guards"
  [ -s "$calls" ] || die "the first guard run did not run shellcheck"
  : >"$calls"
  expect_ok env PATH="$stub:$PATH" XDG_CACHE_HOME="$WORK/cache" "$repo/tests/guards"
  [ ! -s "$calls" ] || die "the guards reran shellcheck on scripts that passed it unchanged"
  printf 'true\n' >>"$repo/tests/run"
  expect_ok env PATH="$stub:$PATH" XDG_CACHE_HOME="$WORK/cache" "$repo/tests/guards"
  [ -s "$calls" ] || die "the guards skipped shellcheck after a script changed"
  cat >"$repo/loose" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
echo $1
EOF
  chmod +x "$repo/loose"
  expect_fail env PATH="$stub:$PATH" XDG_CACHE_HOME="$WORK/cache" "$repo/tests/guards"
  expect_fail env PATH="$stub:$PATH" XDG_CACHE_HOME="$WORK/cache" "$repo/tests/guards"
  grep -q "SC2086" "${LAST_LOG}" || die "the guards cached a shellcheck finding"
}

test_rust_offline() {
  say "Rust's build, lint and test never reach the network"
  local stubs="$WORK/offline-cargo" app="$WORK/offline-app" script
  mkdir -p "$stubs" "$app"
  cat >"$stubs/cargo" <<'EOF'
#!/usr/bin/env bash
printf 'CARGO_NET_OFFLINE=%s\n' "${CARGO_NET_OFFLINE:-}"
EOF
  chmod +x "$stubs/cargo"
  for script in build lint test; do
    run_log env -u CARGO_NET_OFFLINE PATH="$stubs:$PATH" APP_DIR="$app" "$REPO/bin/_rust/$script"
    grep -qx "CARGO_NET_OFFLINE=true" "${LAST_LOG}" || die "Rust bin/$script let cargo reach the network"
    grep -qx "CARGO_NET_OFFLINE=" "${LAST_LOG}" && die "Rust bin/$script ran cargo online"
  done
  return 0
}

test_no_installs() {
  say "the gate and bin/dependencies never install a toolchain"
  local stubs="$WORK/no-install" app="$WORK/no-install-app"
  mkdir -p "$stubs" "$app"
  cat >"$stubs/cargo" <<'EOF'
#!/usr/bin/env bash
printf 'RUSTUP_AUTO_INSTALL=%s\n' "${RUSTUP_AUTO_INSTALL:-}"
EOF
  chmod +x "$stubs/cargo"
  run_log env -u RUSTUP_AUTO_INSTALL PATH="$stubs:$PATH" APP_DIR="$app" "$REPO/bin/_rust/dependencies"
  assert_rc 0 "Rust dependencies with a stand-in cargo"
  grep -qx "RUSTUP_AUTO_INSTALL=0" "${LAST_LOG}" || die "Rust bin/dependencies let rustup install a toolchain"
  (
    unset RUSTUP_AUTO_INSTALL
    # shellcheck source=/dev/null
    . "$REPO/bin/_rust/lib/toolchain.sh"
    [ "${RUSTUP_AUTO_INSTALL:-}" = 0 ]
  ) || die "the Rust scripts let rustup install a toolchain"
  cat >"$stubs/uv" <<'EOF'
#!/usr/bin/env bash
printf 'uv %s UV_PYTHON_DOWNLOADS=%s\n' "$*" "${UV_PYTHON_DOWNLOADS:-}"
[ "$1 $2" != "python find" ] || exit 1
EOF
  chmod +x "$stubs/uv"
  printf '3.99\n' >"$app/.python-version"
  run_log env -u CI -u UV_PYTHON_DOWNLOADS HOME="$app" PATH="$stubs:$PATH" APP_DIR="$app" "$REPO/bin/_python/dependencies"
  assert_rc 1 "Python dependencies with no Python that matches the pin"
  grep -q "no installed Python matches .python-version (3.99)" "${LAST_LOG}" ||
    die "Python bin/dependencies ran without the pinned Python"
  grep -q "^uv sync" "${LAST_LOG}" && die "Python bin/dependencies synced before checking the pinned Python"
  run_log env CI=1 HOME="$app" PATH="$stubs:$PATH" APP_DIR="$app" "$REPO/bin/_python/dependencies"
  assert_rc 0 "Python dependencies in CI with a stand-in uv"
  grep -q "^uv sync .* UV_PYTHON_DOWNLOADS=never$" "${LAST_LOG}" || die "Python bin/dependencies let uv download a Python"
  (
    unset UV_PYTHON_DOWNLOADS
    # shellcheck source=/dev/null
    . "$REPO/bin/_python/lib/toolchain.sh"
    [ "${UV_PYTHON_DOWNLOADS:-}" = never ]
  ) || die "the Python scripts let uv download a Python"
}

test_dependencies_once() {
  say "bin/dependencies never re-checks what its update just installed"
  local stubs="$WORK/deps-once" app="$WORK/deps-once-app"
  mkdir -p "$stubs" "$app"
  cat >"$stubs/uv" <<'EOF'
#!/usr/bin/env bash
printf 'uv %s\n' "$*"
EOF
  cat >"$stubs/bundle" <<'EOF'
#!/usr/bin/env bash
printf 'bundle %s\n' "$*"
EOF
  chmod +x "$stubs/uv" "$stubs/bundle"
  expect_ok env CI=1 HOME="$app" PATH="$stubs:$PATH" APP_DIR="$app" "$REPO/bin/_python/dependencies"
  grep -q "^uv lock" "${LAST_LOG}" && die "Python bin/dependencies checked the lock its update just wrote"
  grep -q "^uv sync --upgrade" "${LAST_LOG}" || die "Python bin/dependencies did not update"
  expect_ok env PATH="$stubs:$PATH" APP_DIR="$app" "$REPO/bin/_rails/dependencies"
  grep -q "^bundle check" "${LAST_LOG}" && die "Rails bin/dependencies checked the gems its update just installed"
  grep -q "^bundle update --all" "${LAST_LOG}" || die "Rails bin/dependencies did not update"
}

test_checked_once() {
  say "a step skips the toolchain and package checks its bin/ci or bin/changed ran"
  local lang app="$WORK/no-app"
  mkdir -p "$app"
  printf '%s\n' '.package(url: "https://example.com/dep.git", from: "1.0.0")' >"$app/Package.swift"
  for lang in typescript javascript python rails rust ios; do
    (
      # shellcheck source=/dev/null
      . "$REPO/bin/_$lang/lib/toolchain.sh"
      FLOW_CHECKED_APP="$app" PATH=/nonexistent toolchain_check "$app" &&
        FLOW_CHECKED_APP="$app" PATH=/nonexistent packages_check "$app"
    ) || die "$lang ran a check its bin/ci already ran"
    if (
      # shellcheck source=/dev/null
      . "$REPO/bin/_$lang/lib/toolchain.sh"
      toolchain_check "$app"
    ) 2>/dev/null; then
      die "$lang skipped a toolchain check nothing ran"
    fi
    if (
      # shellcheck source=/dev/null
      . "$REPO/bin/_$lang/lib/toolchain.sh"
      packages_check "$app"
    ) 2>/dev/null; then
      die "$lang skipped a package check nothing ran"
    fi
    grep -qxF "export FLOW_CHECKED_APP=\"\$root\"" "$REPO/bin/_$lang/ci" || die "$lang ci does not pass its checks to its steps"
    grep -qxF "export FLOW_CHECKED_APP=\"\$PWD\"" "$REPO/bin/_$lang/changed" ||
      die "$lang changed does not pass its checks to its steps"
  done
}

