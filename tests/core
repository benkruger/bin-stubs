test_interrupt() {
  say "Ctrl-C stops every process the dispatcher started"
  local repo name pid rc=0 tries=0 left
  repo="$(new_repo)"
  KEEP="$repo"
  copy_dir "$REPO/bin" "$repo/bin"
  for name in a b; do
    mkdir -p "$repo/$name/test"
    printf '%s\n' '#!/usr/bin/env bash' >"$repo/$name/test/run"
    chmod +x "$repo/$name/test/run"
  done
  cat >"$repo/bin/_shell/build" <<'EOF'
#!/usr/bin/env bash
sleep 60 &
printf '%s\n' "$$" "$!" >>"$PIDS"
wait
EOF
  export PIDS="$WORK/pids"
  perl -e 'setpgrp(0, 0); $SIG{INT} = "DEFAULT"; exec @ARGV' "$repo/bin/build" --jobs 2 >/dev/null 2>&1 &
  pid=$!
  until [ -f "$PIDS" ] && [ "$(wc -l <"$PIDS")" -ge 4 ]; do
    tries=$((tries + 1))
    [ "$tries" -le 100 ] || die "the apps never started"
    sleep 0.1
  done
  kill -INT -- "-$pid"
  wait "$pid" || rc=$?
  assert_eq "$rc" 130 "the dispatcher's exit after Ctrl-C"
  tries=0
  while left="$(ps -o pid= -p "$(paste -sd, - <"$PIDS")")"; do
    tries=$((tries + 1))
    [ "$tries" -le 50 ] || die "Ctrl-C left $(printf '%s' "$left" | wc -l | tr -d ' ') process(es) running"
    sleep 0.1
  done
  unset PIDS
}

