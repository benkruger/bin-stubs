#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
# shellcheck source=lib.sh
. "$HERE/lib.sh"
# shellcheck source=lib/seeds.sh
. "$HERE/lib/seeds.sh"
# shellcheck source=lib/xcode.sh
. "$HERE/lib/xcode.sh"
start_work

fresh_app() {
  repo="$(new_repo)"
  KEEP="$repo"
  app="$repo/$lang"
  mkdir -p "$app"
  copy_dir "$REPO/bin" "$repo/bin"
  seed_of "$lang" "$app"
}

committed_app() {
  local copy
  if [ -n "${TEMPLATE:-}" ]; then
    copy="$(mktemp -d "$WORK/copy.XXXXXX")"
    rmdir "$copy"
    cp -cR "${TEMPLATE%/*}" "$copy" 2>/dev/null || cp -R "${TEMPLATE%/*}" "$copy"
    repo="$copy/${TEMPLATE##*/}"
    KEEP="$repo"
    app="$repo/$lang"
    return 0
  fi
  fresh_app
  expect_ok leaf "$app" "$lang" dependencies
  expect_ok leaf "$app" "$lang" format --all
  git -C "$repo" add -A
  git -C "$repo" commit -q -m "$lang app"
}

section_installed() {
  local repo app work="$WORK"
  case "$lang" in
    typescript | javascript | rails)
      WORK="$work/template/copy"
      mkdir -p "$WORK"
      committed_app
      TEMPLATE="$repo"
      WORK="$work"
      ;;
  esac
  case "$lang" in
    typescript | javascript) run_all "$WORK/logs" run_section changed whole plants audit ;;
    python) run_all "$WORK/logs" run_section changed whole plants ;;
    rails) run_all "$WORK/logs" run_section changed whole plants audit root spaced ;;
    ios) run_all "$WORK/logs" run_section changed plants xcode ;;
    shell) run_all "$WORK/logs" run_section changed whole plants ;;
    *) run_all "$WORK/logs" run_section changed plants ;;
  esac
}

section_sentinels() {
  local repo app sent hash step mode
  fresh_app
  case "$lang" in
    rails | ios | shell) ;;
    *)
      expect_fail leaf "$app" "$lang" ci
      grep -q "run bin/dependencies" "${LAST_LOG}" || die "$lang ci ran without its packages"
      expect_fail leaf "$app" "$lang" test
      grep -q "run bin/dependencies" "${LAST_LOG}" || die "$lang test ran without its packages"
      ;;
  esac
  case "$lang" in
    javascript)
      cat >"$app/biome.json" <<'EOF'
{
  "$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
  "formatter": {
    "indentStyle": "space"
  }
}
EOF
      ;;
  esac
  expect_ok leaf "$app" "$lang" dependencies
  if [ "$lang" = javascript ] && grep -q "schemas/2.0.0" "$app/biome.json"; then
    die "javascript bin/dependencies left biome.json on an older Biome"
  fi
  expect_fail leaf "$app" "$lang" ci
  grep -q "step 'format' failed" "${LAST_LOG}" || die "$lang ci passed unformatted code"
  formatted "$app" "$lang" && die "$lang ci rewrote the source"
  expect_ok leaf "$app" "$lang" format --all
  formatted "$app" "$lang" || die "$lang format did not rewrite the source"
  expect_ok leaf "$app" "$lang" ci
  grep -q "bin/ci: \[1/4\] format" "${LAST_LOG}" || die "$lang did not print the format step"
  grep -q "bin/ci: \[4/4\] test" "${LAST_LOG}" || die "$lang did not print the test step"
  grep -q "sentinel written" "${LAST_LOG}" || die "$lang first run did not write a sentinel"
  sent="$(sentinel_file "$app")"
  [ -f "$sent" ] || die "$lang sentinel missing"
  hash="$(cat "$sent")"
  expect_ok leaf "$app" "$lang" ci
  grep -q "sentinel written" "${LAST_LOG}" && die "$lang second run rewrote the sentinel"
  assert_eq "$(cat "$sent")" "$hash" "$lang skip changed the hash"
  echo "sibling" >"$repo/NOTES.txt"
  expect_ok leaf "$app" "$lang" ci
  grep -q "sentinel written" "${LAST_LOG}" && die "$lang sibling edit rewrote the sentinel"
  assert_eq "$(cat "$sent")" "$hash" "$lang sibling edit changed the hash"
  printf '\n' >>"$repo/bin/_$lang/build"
  expect_ok leaf "$app" "$lang" ci
  grep -q "sentinel written" "${LAST_LOG}" || die "$lang kept its saved pass after its own script changed"
  hash="$(cat "$sent")"
  red_file "$app" "$lang"
  expect_fail leaf "$app" "$lang" ci
  assert_eq "$(cat "$sent")" "$hash" "$lang red run replaced the certificate"
  expect_fail leaf "$app" "$lang" ci
  for step in "1/4] format" "2/4] lint" "3/4] build"; do
    grep -qF "[$step ✓ (unchanged since it passed)" "${LAST_LOG}" || die "$lang reran [$step on the tree it passed"
  done
  grep -qF "[4/4] test ✗" "${LAST_LOG}" || die "$lang did not rerun the step that failed"
  expect_fail leaf "$app" "$lang" ci --force
  grep -qF "(unchanged since it passed)" "${LAST_LOG}" && die "$lang --force skipped a step"
  rm -f "$app/tests/red.test.ts" "$app/tests/red.test.js" "$app/tests/test_red.py" \
    "$app/test/red_test.rb" "$app/tests/red.rs" "$app/Tests/AppTests/RedTests.swift" "$app/test/red"
  if orphan_file "$app" "$lang"; then
    expect_fail leaf "$app" "$lang" ci
    grep -q "bin/test: no source for test" "${LAST_LOG}" || die "$lang passed a test with no source"
    rm -f "$app/tests/orphan.test.ts" "$app/tests/orphan.test.js" "$app/tests/test_orphan.py" \
      "$app/test/orphan_test.rb"
  fi
  mode="$(mode_file_of "$lang")"
  [ -f "$app/$mode" ] || printf 'notes\n' >"$app/$mode"
  cp "$repo/bin/_$lang/test" "$WORK/test.keep"
  awk -v m="$mode" '{ print } !done && $0 == "cd \"$root\"" { print "chmod +x " m; done = 1 }' \
    "$WORK/test.keep" >"$repo/bin/_$lang/test"
  expect_ok leaf "$app" "$lang" ci --force
  grep -q "sentinel written" "${LAST_LOG}" || die "$lang --force did not write"
  [ -x "$app/$mode" ] || die "$lang test step did not change $mode during the run"
  expect_ok leaf "$app" "$lang" ci
  grep -q "sentinel written" "${LAST_LOG}" || die "$lang saved a pass for a file its own run changed"
  cat "$WORK/test.keep" >"$repo/bin/_$lang/test"
  chmod -x "$app/$mode"
  compgen -G "${sent%/*}/ci-*-sentinel" >/dev/null || die "$lang wrote no step sentinels"
  expect_ok leaf "$app" "$lang" ci --clean
  [ ! -f "$sent" ] || die "$lang --clean left the sentinel"
  ! compgen -G "${sent%/*}/ci-*-sentinel" >/dev/null || die "$lang --clean left a step's sentinel"
  git -C "$repo" symbolic-ref HEAD refs/heads/unborn
  expect_ok leaf "$app" "$lang" ci --clean
  grep -qx "bin/ci: cleaned sentinel for unborn" "${LAST_LOG}" || die "$lang ci did not run on a branch with no commits"
  git -C "$repo" symbolic-ref HEAD refs/heads/main
}

section_changed() {
  local repo app
  committed_app
  unformat "$app" "$lang"
  expect_ok leaf "$app" "$lang" changed --files
  assert_eq "$(cat "${LAST_LOG}")" "$(source_of "$lang")" "$lang changed --files"
  expect_ok leaf "$app" "$lang" format
  formatted "$app" "$lang" || die "$lang format skipped an edited tracked file"
  unformat "$app" "$lang"
  expect_ok leaf "$app" "$lang" changed
  formatted "$app" "$lang" || die "$lang changed did not format the edited file"
  twinless "$app" "$lang"
  unformat "$app" "$lang"
  git -C "$repo" commit -q -a -m "$lang unformatted"
  expect_fail leaf "$app" "$lang" ci --force
  grep -q "step 'format' failed" "${LAST_LOG}" || die "$lang ci passed a committed unformatted file"
  formatted "$app" "$lang" && die "$lang ci rewrote a committed file"
  red_file "$app" "$lang"
  expect_fail leaf "$app" "$lang" ci --force
  grep -q "step 'format' failed" "${LAST_LOG}" || die "$lang ci did not report its format step failing"
  grep -q "step 'test' failed" "${LAST_LOG}" || die "$lang ci stopped at its first failing step"
}

section_whole() {
  local repo app
  committed_app
  whole_app "$app" "$lang"
  source_rules "$app" "$lang"
}

section_plants() {
  local repo app pin script spec warning
  committed_app
  if pin="$(pin_file_of "$lang")"; then
    pin="$app/$pin"
    cp "$pin" "$pin.keep"
    if [ "$lang" = "rust" ]; then
      printf '[toolchain]\nchannel = "1.0.0"\n' >"$pin"
    else
      echo "1.0.0" >"$pin"
    fi
    expect_fail leaf "$app" "$lang" ci --force
    grep -q "toolchain: " "${LAST_LOG}" || die "$lang did not enforce its toolchain pin"
    case "$lang" in
      typescript | javascript)
        for script in changed format lint build test dependencies open qa; do
          expect_fail leaf "$app" "$lang" "$script"
          grep -q "toolchain: " "${LAST_LOG}" || die "$lang bin/$script did not enforce its toolchain pin"
        done
        nvm_stub "$WORK/nvm"
        NVM_DIR="$WORK/nvm" expect_ok leaf "$app" "$lang" build
        ;;
    esac
    rm "$pin"
    expect_fail leaf "$app" "$lang" ci --force
    grep -q "toolchain: ${pin##*/} is missing" "${LAST_LOG}" || die "$lang ran with no toolchain pin"
    mv "$pin.keep" "$pin"
  fi

  if [ "$lang" = "shell" ]; then
    cat >"$app/loose" <<'EOF'
#!/usr/bin/env bash
echo $1
EOF
    chmod +x "$app/loose"
    expect_fail leaf "$app" "$lang" ci --force
    grep -q "SC2086" "${LAST_LOG}" || die "shell let a shellcheck finding through"
    cat >"$app/loose" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
echo "$1"
EOF
    chmod -x "$app/loose"
    expect_fail leaf "$app" "$lang" ci --force
    grep -q "loose has a shebang but is not executable" "${LAST_LOG}" || die "shell let a script that cannot run through"
    rm "$app/loose"
    mkdir -p "$app/lib"
    printf '%s\n' '#!/usr/bin/env bash' 'helper() { echo hi; }' >"$app/lib/helper.sh"
    expect_ok leaf "$app" "$lang" build
    rm -r "${app:?}/lib"
    printf '%s\n' '#!/usr/bin/env bash' 'if true; then' '  echo x' >"$app/broken"
    chmod +x "$app/broken"
    expect_fail leaf "$app" "$lang" build
    grep -q "broken: line [0-9]*: syntax error" "${LAST_LOG}" || die "shell build let a script bash cannot parse through"
    rm "$app/broken"
    mv "$app/test/run" "$WORK/run.keep"
    expect_fail leaf "$app" "$lang" build
    grep -qxF "bin/build: no executable test/run" "${LAST_LOG}" || die "shell build passed an app with no test/run"
    expect_fail leaf "$app" "$lang" test
    grep -qxF "bin/test: no executable test/run" "${LAST_LOG}" || die "shell test passed an app with no test/run"
    mv "$WORK/run.keep" "$app/test/run"
  fi

  case "$lang" in
    typescript | javascript)
      cp "$app/package.json" "$app/package.json.keep"
      (cd "$app" && npm pkg set packageManager=npm@1.0.0)
      expect_fail leaf "$app" "$lang" ci --force
      grep -q "but package.json pins 1.0.0" "${LAST_LOG}" || die "$lang did not enforce its npm pin"
      (cd "$app" && npm pkg set packageManager=pnpm@10.0.0)
      expect_fail leaf "$app" "$lang" ci --force
      grep -q "package.json pins pnpm@10.0.0; pin npm" "${LAST_LOG}" || die "$lang let a package manager other than npm through"
      (cd "$app" && npm pkg delete packageManager)
      expect_fail leaf "$app" "$lang" ci --force
      grep -q "package.json pins no packageManager; pin npm" "${LAST_LOG}" || die "$lang ran with no package manager pinned"
      mv "$app/package.json.keep" "$app/package.json"
      ;;
  esac

  case "$lang" in
    typescript)
      echo "plain text" >"$app/notes.txt"
      printf 'a {\n  color: red;\n}\n' >"$app/styles.css"
      printf '# Notes\n\n#Heading\n' >"$app/NOTES.md"
      printf '%s\n' '#!/usr/bin/env bash' 'echo deployed' >"$app/deploy"
      printf '%s\n' 'const unused = 1;' >"$app/src/unused.ts"
      expect_fail leaf "$app" "$lang" ci --force
      grep -q "notes.txt: no formatter (Prettier)" "${LAST_LOG}" || die "$lang let a file with no formatter through"
      grep -q "styles.css: no linter (no ESLint rules apply)" "${LAST_LOG}" || die "$lang let a file with no linter through"
      grep -q "'unused' is assigned a value but never used" "${LAST_LOG}" || die "$lang lint stopped at its first failing tool"
      ! grep -q "NOTES.md" "${LAST_LOG}" || die "$lang lint linted Markdown the guards lint"
      ! grep -q "deploy: no" "${LAST_LOG}" || die "$lang held a bash script to Prettier and ESLint"
      rm "$app/notes.txt" "$app/styles.css" "$app/NOTES.md" "$app/deploy" "$app/src/unused.ts"
      mv "$app/eslint.config.js" "$WORK/eslint.config.keep"
      printf '%s\n' 'export default [{ files: ["**/*.xyz"], rules: { "no-console": "error" } }];' >"$app/eslint.config.js"
      echo "export const a = 1;" >"$app/src/plain.xyz"
      expect_fail leaf "$app" "$lang" lint src/plain.xyz
      grep -q "src/plain.xyz: no formatter (Prettier)" "${LAST_LOG}" || die "$lang let a file only ESLint checks through"
      printf '%s\n' 'import js from "@eslint/js";' 'import json from "@eslint/json";' \
        'import { defineConfig } from "eslint/config";' 'import tseslint from "typescript-eslint";' '' \
        'export default defineConfig([' \
        '  { files: ["src/**/*.ts"], extends: [js.configs.recommended, tseslint.configs.recommended] },' \
        '  { files: ["src/**/*.ts"], processor: { preprocess: () => [], postprocess: () => [] } },' \
        '  { files: ["tests/**/*.ts"], plugins: { json }, language: "json/json" },' \
        '  { files: ["**/*.js"], extends: [js.configs.recommended] },' \
        '  { ...tseslint.configs.eslintRecommended, files: ["**/*.js"] },' \
        '  { files: ["**/*.json"], rules: { "no-console": "error" } },' \
        ']);' >"$app/eslint.config.js"
      expect_fail leaf "$app" "$lang" lint src/add.ts tests/add.test.ts eslint.config.js package.json
      grep -q "src/add.ts: ESLint runs a processor on it" "${LAST_LOG}" || die "$lang let an ESLint processor hide code"
      grep -q "tests/add.test.ts: ESLint parses it as another language" "${LAST_LOG}" ||
        die "$lang let ESLint parse TypeScript as another language"
      grep -q "eslint.config.js: recommended ESLint rules not on: .*no-undef" "${LAST_LOG}" ||
        die "$lang let a preset turn recommended ESLint rules off"
      grep -q "package.json: recommended ESLint rules not on: json/" "${LAST_LOG}" ||
        die "$lang let one ESLint rule stand for the recommended set"
      mv "$WORK/eslint.config.keep" "$app/eslint.config.js"
      rm "$app/src/plain.xyz"
      printf '{ bad json\n' >"$app/.prettierrc"
      echo "const unused = 1;" >"$app/src/unused.ts"
      expect_fail leaf "$app" "$lang" lint src/unused.ts
      grep -q "YAML Error in .*\.prettierrc" "${LAST_LOG}" || die "$lang hid a Prettier config it cannot read"
      grep -q "no-unused-vars" "${LAST_LOG}" || die "$lang skipped ESLint after Prettier failed"
      rm "$app/.prettierrc" "$app/src/unused.ts"
      printf '{ "requirePragma": true }\n' >"$app/.prettierrc"
      expect_fail leaf "$app" "$lang" lint src/add.ts
      grep -q "src/add.ts: no formatter (Prettier)" "${LAST_LOG}" || die "$lang let Prettier skip files without a pragma"
      printf '{ "checkIgnorePragma": true }\n' >"$app/.prettierrc"
      expect_fail leaf "$app" "$lang" lint src/add.ts
      grep -q "src/add.ts: no formatter (Prettier)" "${LAST_LOG}" || die "$lang let Prettier skip files with an ignore pragma"
      rm "$app/.prettierrc"
      cp "$app/tsconfig.json" "$app/tsconfig.app.json"
      cp "$app/tsconfig.json" "$WORK/tsconfig.keep"
      printf '{ "files": [], "references": [{ "path": "./tsconfig.app.json" }] }\n' >"$app/tsconfig.json"
      expect_fail leaf "$app" "$lang" build
      grep -q "src/add.ts is outside tsconfig's files" "${LAST_LOG}" || die "$lang let a tsconfig that lists no files through"
      mv "$WORK/tsconfig.keep" "$app/tsconfig.json"
      rm "$app/tsconfig.app.json"
      decoy_coverage "$app" ts
      cp "$app/package.json" "$WORK/package.keep"
      (cd "$app" && npm pkg set "scripts.build=echo the-build-script-ran && false")
      expect_fail leaf "$app" "$lang" build
      grep -qx "the-build-script-ran" "${LAST_LOG}" || die "$lang build skipped the package's build script"
      (cd "$app" && npm pkg set scripts.build=true)
      cp "$app/tsconfig.json" "$WORK/tsconfig.keep"
      jq '.compilerOptions += { strict: false, noImplicitAny: false, noCheck: true } | .exclude = ["tests"]' \
        "$WORK/tsconfig.keep" >"$app/tsconfig.json"
      expect_fail leaf "$app" "$lang" build
      for msg in "strict is not true" "noImplicitAny is false" "noCheck is true"; do
        grep -q "tsconfig turns type checking down: $msg" "${LAST_LOG}" || die "$lang let tsconfig turn type checking down: $msg"
      done
      grep -q "tests/add.test.ts is outside tsconfig's files" "${LAST_LOG}" || die "$lang let tsconfig leave a file unchecked"
      mv "$WORK/tsconfig.keep" "$app/tsconfig.json"
      mv "$WORK/package.keep" "$app/package.json"
      printf 'export const typed: number = "text";\n' >"$app/src/typed.ts"
      expect_fail leaf "$app" "$lang" build
      grep -q "src/typed.ts([0-9,]*): error TS2322" "${LAST_LOG}" || die "$lang build let a type error through"
      rm "$app/src/typed.ts"
      cp "$app/eslint.config.js" "$WORK/eslint.config.keep"
      perl -0pi -e 's/\]\);\n\z/  { files: ["src\/**\/*.ts"], rules: { "no-console": "warn" } },\n]);\n/' "$app/eslint.config.js"
      grep -q '"no-console": "warn"' "$app/eslint.config.js" || die "$lang ESLint warning plant did not land"
      printf '%s\n' 'export function shout(): void {' '  console.log("hi");' '}' >"$app/src/shout.ts"
      expect_fail leaf "$app" "$lang" lint src/shout.ts
      grep -q "ESLint found too many warnings (maximum: 0)" "${LAST_LOG}" || die "$lang lint let an ESLint warning through"
      mv "$WORK/eslint.config.keep" "$app/eslint.config.js"
      rm "$app/src/shout.ts"
      ln -s package.json "$app/link.json"
      expect_ok leaf "$app" "$lang" format --check --all
      expect_ok leaf "$app" "$lang" format --all
      rm "$app/link.json"
      ;;
    javascript)
      echo "plain text" >"$app/notes.txt"
      printf '# Notes\n\n#Heading\n' >"$app/NOTES.md"
      printf '%s\n' '#!/usr/bin/env bash' 'echo deployed' >"$app/deploy"
      printf '%s\n' 'export const dupe = { a: 1, a: 2 };' >"$app/src/dupe.js"
      expect_fail leaf "$app" "$lang" ci --force
      grep -q "notes.txt: no formatter or linter (Biome)" "${LAST_LOG}" || die "$lang let a file with no formatter through"
      grep -q "noDuplicateObjectKeys" "${LAST_LOG}" || die "$lang lint stopped at its first failing tool"
      ! grep -q "NOTES.md" "${LAST_LOG}" || die "$lang lint linted Markdown the guards lint"
      ! grep -q "deploy: no" "${LAST_LOG}" || die "$lang held a bash script to Biome"
      rm "$app/notes.txt" "$app/NOTES.md" "$app/deploy" "$app/src/dupe.js"
      cp "$app/package.json" "$WORK/package.keep"
      (cd "$app" && npm pkg set "scripts.build=echo the-build-script-ran")
      printf '%s\n' 'export const broken = (;' >"$app/src/broken.js"
      expect_fail leaf "$app" "$lang" build --all
      grep -qx "the-build-script-ran" "${LAST_LOG}" || die "$lang build skipped the package's build script"
      grep -q "src/broken.js:1" "${LAST_LOG}" || die "$lang build did not name the file node cannot parse"
      grep -q "SyntaxError" "${LAST_LOG}" || die "$lang build let a build script stand in for node --check"
      mv "$WORK/package.keep" "$app/package.json"
      expect_fail leaf "$app" "$lang" format src/broken.js
      grep -q "src/broken.js" "${LAST_LOG}" || die "$lang format passed a file Biome cannot parse"
      rm "$app/src/broken.js"
      printf 'const unused = 1;\nexport const kept = 2;\n' >"$app/src/warn.js"
      expect_fail leaf "$app" "$lang" lint src/warn.js
      grep -q "noUnusedVariables" "${LAST_LOG}" || die "$lang let a Biome warning through"
      rm "$app/src/warn.js"
      decoy_coverage "$app" js
      printf '{ bad json\n' >"$app/.c8rc.json"
      expect_fail leaf "$app" "$lang" test --all
      grep -qxF "bin/test: missing coverage-summary.json" "${LAST_LOG}" || die "$lang passed a run c8 wrote no coverage for"
      rm "$app/.c8rc.json"
      ;;
    ios)
      mkdir -p "$app/App"
      printf 'let Bad_Name = 1\n' >"$app/App/Bad.swift"
      printf 'let  spaced=1\n' >"$app/App/Spaced.swift"
      git -C "$app" add App
      git -C "$app" commit -q -m "committed swift plants"
      expect_ok leaf "$app" "$lang" lint
      expect_ok leaf "$app" "$lang" format --check
      expect_ok leaf "$app" "$lang" lint "$(source_of "$lang")"
      expect_fail leaf "$app" "$lang" lint App/Bad.swift
      grep -q "App/Bad.swift:1:5: error: \[AlwaysUseLowerCamelCase\]" "${LAST_LOG}" || die "$lang lint skipped a path it was given"
      expect_fail leaf "$app" "$lang" format --check App/Spaced.swift
      grep -q "App/Spaced.swift is not formatted" "${LAST_LOG}" || die "$lang format --check skipped a path it was given"
      git -C "$app" rm -rqf App
      git -C "$app" commit -q -m "committed swift plants gone"
      mkdir -p "$app/App"
      printf 'let Bad_Name = 1\n' >"$app/App/Bad.swift"
      expect_fail leaf "$app" "$lang" lint
      grep -q "App/Bad.swift:1:5: error: \[AlwaysUseLowerCamelCase\]" "${LAST_LOG}" || die "$lang lint skipped a changed file"
      expect_fail leaf "$app" "$lang" lint --all
      grep -q "App/Bad.swift:1:5: error: \[AlwaysUseLowerCamelCase\]" "${LAST_LOG}" ||
        die "$lang let a swift-format finding outside Sources through"
      rm "$app/App/Bad.swift"
      printf 'let  spaced=1\n' >"$app/App/Spaced.swift"
      expect_fail leaf "$app" "$lang" format --check --all
      grep -q "App/Spaced.swift is not formatted" "${LAST_LOG}" || die "$lang format --check skipped a file outside Sources"
      expect_ok leaf "$app" "$lang" format --all
      [ "$(cat "$app/App/Spaced.swift")" = "let spaced = 1" ] || die "$lang format skipped a file outside Sources"
      rm -r "$app/App"
      printf 'public func warned() -> Int {\n  var unused = 1\n  return 2\n}\n' >"$app/Sources/App/Warned.swift"
      expect_fail leaf "$app" "$lang" build
      grep -qE "Warned\.swift:[0-9]+:[0-9]+: .*initialization of variable 'unused' was never used" "${LAST_LOG}" || die "$lang let a compiler warning through"
      rm "$app/Sources/App/Warned.swift"
      printf '%s\n' 'import Testing' '' '@Test func warned() {' '  var unused = 1' '  #expect(true)' '}' \
        >"$app/Tests/AppTests/WarnedTests.swift"
      expect_fail leaf "$app" "$lang" test
      grep -qE "WarnedTests\.swift:[0-9]+:[0-9]+: .*initialization of variable 'unused' was never used" "${LAST_LOG}" || die "$lang let a compiler warning in a test through"
      rm "$app/Tests/AppTests/WarnedTests.swift"
      printf 'public func loadTests() -> Int {\n  1\n}\n' >"$app/Sources/App/LoadTests.swift"
      expect_fail leaf "$app" "$lang" test
      grep -q "LoadTests.swift: 0%" "${LAST_LOG}" || die "$lang let a source named like a test escape coverage"
      rm "$app/Sources/App/LoadTests.swift"
      ;;
    python)
      printf 'def untyped(a):\n    return a\n' >"$app/src/untyped.py"
      expect_fail leaf "$app" "$lang" build
      grep -q "untyped.py:1: error: Function is missing a type annotation" "${LAST_LOG}" ||
        die "$lang let an untyped function through"
      rm "$app/src/untyped.py"
      printf 'value = 0\n\n\ndef late() -> int:\n    value = 1\n    global value\n    return value\n' >"$app/src/late.py"
      expect_fail leaf "$app" "$lang" build
      grep -q "name 'value' is assigned to before global declaration" "${LAST_LOG}" ||
        die "$lang build let a file Python cannot compile through"
      rm "$app/src/late.py"
      mv "$app/src" "$app/lib"
      mkdir -p "$app/build/x"
      printf 'def (\n' >"$app/build/x/broken.py"
      expect_ok leaf "$app" "$lang" build
      rm -r "$app/build"
      mv "$app/lib" "$app/src"
      cp "$app/pyproject.toml" "$WORK/pyproject.keep"
      perl -0pi -e 's/(dev = \[)/$1"six", /' "$app/pyproject.toml"
      grep -q 'dev = \["six", ' "$app/pyproject.toml" || die "$lang dependency plant did not land"
      expect_fail leaf "$app" "$lang" build
      grep -q "does not match pyproject.toml" "${LAST_LOG}" || die "$lang ran on a lockfile its manifest has moved past"
      mv "$WORK/pyproject.keep" "$app/pyproject.toml"
      PYTEST_ADDOPTS=--no-cov expect_fail leaf "$app" "$lang" test --all
      grep -q "pytest wrote no coverage report" "${LAST_LOG}" || die "$lang passed a run that measured nothing"
      cp "$app/pyproject.toml" "$WORK/pyproject.keep"
      perl -0pi -e 's/(\[tool\.pytest\.ini_options\]\n)/$1addopts = "--no-cov"\n/' "$app/pyproject.toml"
      grep -q 'addopts = "--no-cov"' "$app/pyproject.toml" || die "$lang addopts plant did not land"
      expect_ok leaf "$app" "$lang" test --all
      grep -q "coverage bar held on 1 source(s)" "${LAST_LOG}" || die "$lang let the app's pytest options drop coverage"
      mv "$WORK/pyproject.keep" "$app/pyproject.toml"
      printf 'def helper() -> int:\n    return 1\n' >"$app/src/test_helpers.py"
      expect_fail leaf "$app" "$lang" test --all
      grep -q "no mirrored test for src/test_helpers.py" "${LAST_LOG}" || die "$lang let a source named like a test go untested"
      rm "$app/src/test_helpers.py"
      mkdir -p "$app/src/loose" "$app/tests/loose"
      printf 'def helper() -> int:\n    return 1\n' >"$app/src/loose/helper.py"
      printf 'def test_helper() -> None:\n    assert str(1) == "1"\n' >"$app/tests/loose/test_helper.py"
      expect_fail leaf "$app" "$lang" test --all
      grep -qxF "bin/test: src/loose/helper.py has no coverage row (need 100/100)" "${LAST_LOG}" ||
        die "$lang passed a source its coverage report never listed"
      rm -r "$app/src/loose" "$app/tests/loose"
      cp "$app/tests/test_add.py" "$WORK/test_add.keep"
      printf '%s\n' '' '' 'def test_warns() -> None:' '    import warnings' '' \
        '    warnings.warn("old", DeprecationWarning, stacklevel=1)' >>"$app/tests/test_add.py"
      expect_fail leaf "$app" "$lang" test --all
      grep -q "DeprecationWarning: old" "${LAST_LOG}" || die "$lang test let a warning through"
      mv "$WORK/test_add.keep" "$app/tests/test_add.py"
      ;;
    rust)
      cp "$app/Cargo.toml" "$WORK/cargo.keep"
      cp "$app/Cargo.lock" "$WORK/lock.keep"
      printf '\n[workspace]\nmembers = ["extra"]\n' >>"$app/Cargo.toml"
      mkdir -p "$app/extra/src"
      printf '[package]\nname = "extra"\nversion = "0.1.0"\nedition = "2021"\n' >"$app/extra/Cargo.toml"
      printf '%s\n' '#[must_use]' 'pub fn twice(n: i32) -> i32 {' '    return n * 2;' '}' >"$app/extra/src/lib.rs"
      expect_ok leaf "$app" "$lang" dependencies
      expect_fail leaf "$app" "$lang" lint
      grep -q "needless_return" "${LAST_LOG}" || die "$lang lint skipped a workspace member"
      expect_fail leaf "$app" "$lang" test
      grep -q "extra/src/lib.rs" "${LAST_LOG}" || die "$lang coverage skipped a workspace member"
      printf '%s\n' '#[must_use]' 'pub fn broken() -> i32 {' '    "x"' '}' >"$app/extra/src/lib.rs"
      expect_fail leaf "$app" "$lang" build
      grep -q "mismatched types" "${LAST_LOG}" || die "$lang build skipped a workspace member"
      rm -r "$app/extra"
      mv "$WORK/cargo.keep" "$app/Cargo.toml"
      mv "$WORK/lock.keep" "$app/Cargo.lock"
      ;;
    rails)
      cp "$app/.rubocop.yml" "$WORK/rubocop.keep"
      grep -v NewCops "$WORK/rubocop.keep" >"$app/.rubocop.yml"
      printf '%s\n' '# frozen_string_literal: true' '' 'class Chars' '  def self.all' "    'abc'.split('')" '  end' 'end' \
        >"$app/app/models/chars.rb"
      expect_fail leaf "$app" "$lang" lint app/models/chars.rb
      grep -q "Style/StringChars" "${LAST_LOG}" || die "$lang let a pending RuboCop cop stay off"
      rm "$app/app/models/chars.rb"
      printf '%s\n' '# frozen_string_literal: true' '' 'class Included' '  include Comparable' '  def self.all' '    1' \
        '  end' 'end' >"$app/app/models/included.rb"
      expect_fail leaf "$app" "$lang" format --check app/models/included.rb
      grep -q "Layout/EmptyLinesAfterModuleInclusion" "${LAST_LOG}" || die "$lang format --check let a pending cop stay off"
      expect_ok leaf "$app" "$lang" format app/models/included.rb
      [ -z "$(sed -n 5p "$app/app/models/included.rb")" ] || die "$lang format left a pending cop's offense"
      rm "$app/app/models/included.rb"
      mv "$WORK/rubocop.keep" "$app/.rubocop.yml"
      cp "$app/test/test_helper.rb" "$WORK/helper.keep"
      perl -0pi -e "s/(  enable_coverage :branch\n)/\$1  skip '\/app\/'\n/" "$app/test/test_helper.rb"
      expect_fail leaf "$app" "$lang" test
      grep -q "app/models/add.rb has no coverage row" "${LAST_LOG}" || die "$lang let a SimpleCov filter hide a source"
      mv "$WORK/helper.keep" "$app/test/test_helper.rb"
      brakeman_plant "$app"
      expect_fail leaf "$app" "$lang" lint app/controllers/run_controller.rb
      grep -q "✓ rails (rubocop)" "${LAST_LOG}" || die "$lang Brakeman plant tripped RuboCop"
      grep -q "Command Injection" "${LAST_LOG}" || die "$lang lint let a Brakeman warning through"
      rm -r "$app/app/controllers"
      printf '%s\n' '# frozen_string_literal: true' '' 'class Wrong' 'end' >"$app/app/models/misnamed.rb"
      expect_fail leaf "$app" "$lang" build
      grep -q "misnamed.rb to define constant Misnamed" "${LAST_LOG}" || die "$lang build let a file Zeitwerk cannot load through"
      rm "$app/app/models/misnamed.rb"
      printf '%s\n' '# frozen_string_literal: true' '' 'module Warned' '  def self.call' '    unused = 1' '    2' '  end' 'end' \
        >"$app/app/models/warned.rb"
      printf '%s\n' '# frozen_string_literal: true' '' "require 'test_helper'" '' 'class WarnedTest < ActiveSupport::TestCase' \
        "  test 'returns two' do" '    assert_equal 2, Warned.call' '  end' 'end' >"$app/test/models/warned_test.rb"
      expect_fail leaf "$app" "$lang" test
      grep -q "Ruby warning (no-warnings gate)" "${LAST_LOG}" || die "$lang test let a Ruby warning through"
      rm "$app/app/models/warned.rb" "$app/test/models/warned_test.rb"
      cp "$app/Gemfile" "$WORK/gemfile.keep"
      echo "gem 'bin-stubs-absent', '0.0.1'" >>"$app/Gemfile"
      expect_fail leaf "$app" "$lang" ci --force
      grep -q "packages: gems are missing; run bin/dependencies" "${LAST_LOG}" || die "$lang ran without a gem its Gemfile names"
      mv "$WORK/gemfile.keep" "$app/Gemfile"
      printf '%s\n' 'test:' '  adapter: sqlite3' '  database: db/test.sqlite3' >"$app/config/database.yml"
      expect_fail leaf "$app" "$lang" test
      grep -q "rails (db:test:prepare)" "${LAST_LOG}" || die "$lang tested an app with a database without preparing it"
      rm "$app/config/database.yml"
      ;;
  esac

  case "$lang" in
    typescript | javascript)
      spec="$app/tests/add.test.ts"
      [ "$lang" = typescript ] || spec="$app/tests/index.test.js"
      cp "$spec" "$WORK/spec.keep"
      printf '%s\n' '' 'test("warns", () => {' \
        '  Reflect.get(globalThis, "process").emitWarning("old", "DeprecationWarning");' '});' >>"$spec"
      expect_fail leaf "$app" "$lang" ci --force
      grep -q "step 'test' printed a warning" "${LAST_LOG}" || die "$lang passed a step that printed a warning"
      mv "$WORK/spec.keep" "$spec"
      cp "$app/package.json" "$WORK/package.warn"
      for warning in "npm warn planted" "Warning: planted"; do
        (cd "$app" && npm pkg set "scripts.build=echo $warning")
        expect_fail leaf "$app" "$lang" ci --force
        grep -q "step 'build' printed a warning" "${LAST_LOG}" || die "$lang passed a build that printed: $warning"
      done
      mv "$WORK/package.warn" "$app/package.json"
      ;;
  esac
  case "$lang" in
    typescript | javascript | python | rails)
      expect_ok leaf "$app" "$lang" test "$(source_of "$lang")"
      grep -qxF "bin/test: coverage bar held on 1 source(s)" "${LAST_LOG}" || die "$lang bin/test on a source did not run its test"
      ;;
  esac

  sourceless "$app" "$lang"
  changed_scope "$app" "$lang"
  coverage_gap "$app" "$lang"

  if [ "$lang" = "ios" ]; then
    printf '{ "version": 1, "indentation": { "spaces": 8 } }\n' >"$repo/.swift-format"
    expect_fail leaf "$app" "$lang" format --check --all
    grep -qF "bin/format: Tests/AppTests/AddTests.swift is not formatted" "${LAST_LOG}" ||
      die "ios format --check ignored the repo's .swift-format"
    mv "$repo/.swift-format" "$app/Tests/.swift-format"
    expect_fail leaf "$app" "$lang" format --check --all
    grep -qF "bin/format: Tests/AppTests/AddTests.swift is not formatted" "${LAST_LOG}" ||
      die "ios format --check ignored a .swift-format inside the app"
    rm "$app/Tests/.swift-format"
    printf 'public func broken( {\n' >"$app/Sources/App/Broken.swift"
    expect_fail leaf "$app" "$lang" format --check --all
    grep -qF "bin/format: Sources/App/Broken.swift is not formatted" "${LAST_LOG}" ||
      die "ios format --check passed a file swift-format cannot parse"
    rm "$app/Sources/App/Broken.swift"
    swift_dependency "$WORK/SwiftDep"
    cp "$app/Package.swift" "$WORK/package.keep"
    perl -0pi -e "s|( *name: \"App\",\n)|\$1  dependencies: [.package(url: \"file://$WORK/SwiftDep\", from: \"1.0.0\")],\n|" "$app/Package.swift"
    grep -q 'dependencies: \[.package(url:' "$app/Package.swift" || die "ios dependency plant did not land"
    expect_fail leaf "$app" "$lang" build
    grep -q "Package.resolved is missing" "${LAST_LOG}" || die "ios built a package whose remote packages were never resolved"
    expect_ok leaf "$app" "$lang" dependencies
    cp "$app/Package.resolved" "$WORK/resolved.keep"
    perl -pi -e 's/("revision"\s*:\s*")[0-9a-f]+/${1}0000000000000000000000000000000000000000/' "$app/Package.resolved"
    expect_fail leaf "$app" "$lang" build
    grep -q "not fetched at the versions Package.resolved pins" "${LAST_LOG}" ||
      die "ios built on checkouts Package.resolved does not pin"
    mv "$WORK/resolved.keep" "$app/Package.resolved"
    printf 'public func dep() -> Int { 1 }\n' >"$WORK/SwiftDep/Sources/Dep/Dep.swift"
    git -C "$WORK/SwiftDep" -c user.email=dep@example.com -c user.name=dep commit -q -am "dep 1.1.0"
    git -C "$WORK/SwiftDep" tag 1.1.0
    perl -pi -e 's/from: "1\.0\.0"/from: "1.1.0"/' "$app/Package.swift"
    expect_fail leaf "$app" "$lang" build
    grep -qi "resolved file" "${LAST_LOG}" || die "ios resolved packages itself during a build"
    mv "$WORK/package.keep" "$app/Package.swift"
  fi

  if [ "$lang" = "rails" ]; then
    printf '%s\n' '# frozen_string_literal: true' '' 'module Unused' '  def self.call' '    unused = 1' '    2' '  end' 'end' \
      >"$app/app/models/unused.rb"
    printf '# Notes\n\n#Heading\n' >"$app/NOTES.md"
    brakeman_plant "$app"
    expect_fail leaf "$app" "$lang" ci --force
    grep -q "step 'lint' failed" "${LAST_LOG}" || die "rails lint passed a RuboCop finding"
    grep -q "Lint/UselessAssignment" "${LAST_LOG}" || die "rails lint did not show the RuboCop finding"
    grep -q "Command Injection" "${LAST_LOG}" || die "rails lint stopped at its first failing tool"
    ! grep -q "NOTES.md" "${LAST_LOG}" || die "rails lint linted Markdown the guards lint"
    rm -r "$app/app/models/unused.rb" "$app/NOTES.md" "$app/app/controllers"
  fi
}

section_audit() {
  local repo app
  if [ "$lang" = rails ]; then
    fresh_app
    brakeman_plant "$app"
    expect_fail leaf "$app" "$lang" dependencies
    grep -q "Command Injection" "${LAST_LOG}" || die "rails bin/dependencies let a Brakeman warning through"
    rm -r "$app/app/controllers"
    echo "gem 'rake', '12.3.2'" >>"$app/Gemfile"
    : >"$WORK/advisory-db.marker"
    expect_fail leaf "$app" "$lang" dependencies
    grep -q "Name: rake" "${LAST_LOG}" || die "rails bin/dependencies let a gem with an advisory through"
    [ "${BUNDLER_AUDIT_DB:-}/.git/FETCH_HEAD" -nt "$WORK/advisory-db.marker" ] ||
      die "rails bin/dependencies updated an advisory database other sections share"
    return 0
  fi
  committed_app
  (cd "$app" && npm pkg set dependencies.lodash=4.17.20)
  rm "$app/package-lock.json"
  expect_fail leaf "$app" "$lang" ci --force
  grep -q "run bin/dependencies" "${LAST_LOG}" || die "$lang ci ran with a package missing"
  expect_ok leaf "$app" "$lang" dependencies
  expect_fail leaf "$app" "$lang" ci --force
  grep -q "npm audit found a moderate or worse advisory" "${LAST_LOG}" ||
    die "$lang let a package with an advisory through"
  grep -qE "^lodash +" "${LAST_LOG}" || die "$lang audit failed without naming lodash's advisory"
}

section_spaced() {
  local repo app
  mkdir -p "$WORK/with space"
  cp -cR "$TEMPLATE" "$WORK/with space/" 2>/dev/null || cp -R "$TEMPLATE" "$WORK/with space/"
  repo="$WORK/with space/${TEMPLATE##*/}"
  KEEP="$repo"
  app="$repo/$lang"
  expect_ok leaf "$app" "$lang" test
  grep -qxF "bin/test: coverage bar held on 1 source(s)" "${LAST_LOG}" || die "$lang test failed in a folder with a space"
}

section_root() {
  local repo app
  repo="$(new_repo)"
  KEEP="$repo"
  app="$repo"
  copy_dir "$REPO/bin" "$repo/bin"
  cp "$repo/.gitignore" "$WORK/root.gitignore"
  seed_of "$lang" "$app"
  cat "$WORK/root.gitignore" >>"$app/.gitignore"
  cp "$TEMPLATE/$lang/Gemfile.lock" "$app/Gemfile.lock"
  mkdir -p "$app/web"
  printf '{ "name": "web", "private": true }\n' >"$app/web/package.json"
  printf '%s\n' 'loose = 1' >"$app/web/loose.rb"
  printf '%s\n' '#Loose' >"$app/web/loose.md"
  run_log leaf "$app" "$lang" changed --files
  grep -q "^web/" "${LAST_LOG}" && die "a root $lang app's changed listed a sibling app's file"
  expect_ok leaf "$app" "$lang" format --all
  [ "$(cat "$app/web/loose.rb")" = "loose = 1" ] || die "a root $lang app's format rewrote a sibling app's file"
  expect_ok leaf "$app" "$lang" lint --all
  expect_ok leaf "$app" "$lang" format --check --all
  cp "$app/web/loose.rb" "$app/app/models/loose.rb"
  expect_fail leaf "$app" "$lang" lint --all
  grep -q "== app/models/loose.rb ==" "${LAST_LOG}" || die "a root $lang app's lint skipped its own file"
  grep -q "web/loose" "${LAST_LOG}" && die "a root $lang app's lint checked a sibling app's file"
  return 0
}

section_xcode() {
  local repo app leaked bare stubs="$WORK/xcodebuild-stub" calls="$WORK/xcodebuild-calls" real
  real="$(command -v xcodebuild)"
  mkdir -p "$stubs"
  cat >"$stubs/xcodebuild" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$*" >>"$calls"
exec "$real" "\$@"
EOF
  chmod +x "$stubs/xcodebuild"
  PATH="$stubs:$PATH"
  repo="$(new_repo)"
  KEEP="$repo"
  app="$repo/$lang"
  copy_dir "$REPO/bin" "$repo/bin"
  seed_xcode "$app" "$(xcode_dependency "$WORK/Dep")"
  expect_fail leaf "$app" "$lang" build
  grep -q "run bin/dependencies" "${LAST_LOG}" || die "ios built an Xcode project without its packages"
  expect_ok leaf "$app" "$lang" dependencies
  expect_ok leaf "$app" "$lang" format --all
  git -C "$repo" add -A
  git -C "$repo" commit -q -m "xcode app"
  mkdir -p "$WORK/xcode-tmp"
  TMPDIR="$WORK/xcode-tmp" expect_ok leaf "$app" "$lang" ci
  leaked="$(find "$WORK/xcode-tmp" -mindepth 1 -maxdepth 1 -name 'bin-*')"
  [ -z "$leaked" ] || die "ios ci left temp files: $(printf '%s' "$leaked" | tr '\n' ' ')"
  IOS_DESTINATION="platform=macOS,arch=$(uname -m)"
  export IOS_DESTINATION
  printf 'public func warned() -> Int {\n  var unused = 1\n  return 2\n}\n' >"$app/Sources/App/Warned.swift"
  expect_fail leaf "$app" "$lang" build
  grep -qE "Warned\.swift:[0-9]+:[0-9]+: .*initialization of variable 'unused' was never used" "${LAST_LOG}" || die "ios let a compiler warning through an Xcode project build"
  rm "$app/Sources/App/Warned.swift"
  printf 'public func untested() -> Int {\n  1\n}\n' >"$app/Sources/App/Untested.swift"
  expect_fail leaf "$app" "$lang" test
  grep -q "FAIL: line coverage is under 100%" "${LAST_LOG}" || die "ios passed an Xcode project source below its coverage bar"
  grep -q "Untested.swift: 0%" "${LAST_LOG}" || die "ios did not name the Xcode project source below its coverage bar"
  rm "$app/Sources/App/Untested.swift"
  printf '%s\n' 'import Testing' '' '@Test func warned() {' '  var unused = 1' '  #expect(true)' '}' \
    >"$app/Tests/AppTests/WarnedTests.swift"
  expect_fail leaf "$app" "$lang" test
  grep -qE "WarnedTests\.swift:[0-9]+:[0-9]+: .*initialization of variable 'unused' was never used" "${LAST_LOG}" || die "ios let a compiler warning in an Xcode project's test through"
  rm "$app/Tests/AppTests/WarnedTests.swift"
  printf '\n' >>"$WORK/Dep/Package.swift"
  git -C "$WORK/Dep" -c user.email=dep@example.com -c user.name=dep commit -q -am "dep 1.1.0"
  git -C "$WORK/Dep" tag 1.1.0
  expect_ok leaf "$app" "$lang" dependencies
  grep -q '"version" : "1.1.0"' "$app/App.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved" ||
    die "ios dependencies left an Xcode project's package on an older version"
  mkdir -p "$app/App.xcworkspace"
  printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' '<Workspace version = "1.0">' \
    '   <FileRef location = "group:App.xcodeproj"></FileRef>' '</Workspace>' >"$app/App.xcworkspace/contents.xcworkspacedata"
  expect_ok leaf "$app" "$lang" dependencies
  grep -q '"version" : "1.1.0"' "$app/App.xcworkspace/xcshareddata/swiftpm/Package.resolved" ||
    die "ios dependencies did not resolve an Xcode workspace's packages"
  rm -r "$app/App.xcworkspace"
  perl -pi -e 's/ (SWIFT|GCC)_TREAT_WARNINGS_AS_ERRORS = YES;//g' "$app/App.xcodeproj/project.pbxproj"
  expect_fail leaf "$app" "$lang" build
  grep -q "bin/build: AppTests does not set SWIFT_TREAT_WARNINGS_AS_ERRORS" "${LAST_LOG}" ||
    die "ios let an Xcode project build without treating warnings as errors"
  bare="$(grep -v -e '-derivedDataPath' -e '^-version$' "$calls" || true)"
  [ -z "$bare" ] || die "ios ran xcodebuild with no build folder: $bare"
}

own_advisory_db() {
  local shared="$HOME/.local/share/ruby-advisory-db"
  export BUNDLER_AUDIT_DB="$WORK/ruby-advisory-db"
  [ ! -d "$shared" ] || copy_dir "$shared" "$BUNDLER_AUDIT_DB"
}

run_section() {
  WORK="$WORK/$1"
  mkdir -p "$WORK"
  [ "$lang" != rails ] || own_advisory_db
  "section_$1"
}

