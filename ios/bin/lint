#!/usr/bin/env bash
# Lint Sources and Tests with swift-format.
# Usage: bin/lint [--all]
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$here")" = "_root" ]; then
  root="$(cd "$here/../.." && pwd)"
else
  root="$(cd "$here/.." && pwd)"
fi
cd "$root"
for arg in "$@"; do
  case "$arg" in
    --all) ;;
    *) echo "bin/lint: unknown argument: $arg" >&2; exit 2 ;;
  esac
done
args=()
[ -d Sources ] && args+=(Sources)
[ -d Tests ] && args+=(Tests)
if [ "${#args[@]}" -eq 0 ]; then
  exit 0
fi
xcrun swift-format lint --recursive "${args[@]}"
