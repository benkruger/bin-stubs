#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ROOT="$(git -C "$HERE" rev-parse --show-toplevel)"
SELF="${HERE#"$ROOT"/}/$(basename "${BASH_SOURCE[0]}")"
cd "$ROOT"

MAX_RULE_LINES=40
MAX_RULE_CHARS=8000
MAX_CLAUDE_LINES=400
MAX_CLAUDE_CHARS=12000
MAX_AUTHORED_BYTES=65536

GENERATED_NAMES=(
  package-lock.json bun.lock bun.lockb yarn.lock pnpm-lock.yaml
  uv.lock poetry.lock Gemfile.lock Cargo.lock Package.resolved
)
EXEMPT_PATHS=()

BANNED_SUPPRESSIONS='shellcheck[ ]disable|eslint[-](disable|enable)|@ts[-](ignore|expect-error|nocheck)|(istanbul|v8|c8)[ ]ignore|biome[-]ignore|rubocop[:](disable|todo)|:no[c]ov:|#[ ]*no[q]a|type[:][ ]*ignore|pragma[:] no cover|prettier[-]ignore|markdownlint[-]disable|#!?\[(al[l]ow|expec[t])\(|swift[-]format[-]ignore|swiftlint[:]disable'
BACKWARD_FACING='\bwe hit\b|during PR #|after the fix|\bused to\b|\bno longer\b|\b(previously|formerly)\b|in the past|removed in PR|\bport(ed)? (of|from)\b'
NARRATIVE_HEADING='^##[[:space:]]+(why|rationale|background|history|cross-references?|how to apply)\b'

failures=0
fail() {
  echo "guards: $*" >&2
  failures=$((failures + 1))
}

is_text() {
  LC_ALL=C grep -qI . "$1"
}

is_exempt() {
  local path="$1" name entry
  name="$(basename "$path")"
  for entry in "${GENERATED_NAMES[@]}"; do
    [ "$name" = "$entry" ] && return 0
  done
  for entry in "${EXEMPT_PATHS[@]+"${EXEMPT_PATHS[@]}"}"; do
    [ "$path" = "$entry" ] && return 0
  done
  return 1
}

files=()
while IFS= read -r -d '' path; do
  [ -f "$path" ] && [ ! -L "$path" ] || continue
  files+=("$path")
done < <(git ls-files -z --cached --others --exclude-standard)

for path in "${files[@]}"; do
  is_exempt "$path" && continue
  is_text "$path" || continue
  bytes="$(wc -c <"$path" | tr -d ' ')"
  [ "$bytes" -le "$MAX_AUTHORED_BYTES" ] ||
    fail "$path: $bytes bytes, over the $MAX_AUTHORED_BYTES-byte cap"
done

for path in "${files[@]}"; do
  [ "$path" = "$SELF" ] && continue
  while IFS= read -r line; do
    fail "$path:$line: suppression comment"
  done < <(grep -nIE "$BANNED_SUPPRESSIONS" "$path" | cut -d: -f1 || true)
done

for path in "${files[@]}"; do
  case "$(basename "$path")" in
    biome.json | biome.jsonc)
      if grep -qE '"(rules|overrides)"[[:space:]]*:|"enabled"[[:space:]]*:[[:space:]]*false' "$path"; then
        fail "$path: turns Biome rules off or overrides them"
      fi
      ;;
    eslint.config.js | eslint.config.mjs | eslint.config.cjs | eslint.config.ts | eslint.config.mts | eslint.config.cts)
      if grep -qE "[\"'](off|warn)[\"']|linterOptions" "$path"; then
        fail "$path: turns ESLint rules off or down to warnings"
      fi
      ;;
    .rubocop.yml)
      if grep -qE '^[[:space:]]*Enabled:[[:space:]]*false' "$path"; then
        fail "$path: disables a RuboCop cop"
      fi
      ;;
    Cargo.toml)
      if grep -qE '=[[:space:]]*"allow"|level[[:space:]]*=[[:space:]]*"allow"' "$path"; then
        fail "$path: allows a lint"
      fi
      ;;
  esac
done

is_sourced() {
  case "$1" in
    */lib/*.sh | tests/lib.sh | */_run_quiet) return 0 ;;
    *) return 1 ;;
  esac
}

first_command() {
  grep -vE '^[[:space:]]*(#|$)' "$1" | head -n 1
}

scripts=()
for path in "${files[@]}"; do
  if head -n 1 "$path" | grep -qE '^#!.*\bbash\b'; then
    scripts+=("$path")
  fi
done

if [ "${#scripts[@]}" -gt 0 ]; then
  if ! command -v shellcheck >/dev/null 2>&1; then
    fail "shellcheck is not installed (brew install shellcheck)"
  elif ! shellcheck -x -P SCRIPTDIR "${scripts[@]}" >&2; then
    fail "shellcheck reported findings (above)"
  fi
  if ! command -v shfmt >/dev/null 2>&1; then
    fail "shfmt is not installed (brew install shfmt)"
  elif ! shfmt -i 2 -ci -d "${scripts[@]}" >&2; then
    fail "shfmt would reformat the scripts above (run bin/format)"
  fi
fi

markdown=()
for path in "${files[@]}"; do
  case "$path" in
    *.md) markdown+=("$path") ;;
  esac
done

if [ "${#markdown[@]}" -gt 0 ]; then
  if ! command -v markdownlint-cli2 >/dev/null 2>&1; then
    fail "markdownlint-cli2 is not installed (brew install markdownlint-cli2)"
  elif ! markdownlint-cli2 "${markdown[@]}" >/dev/null 2>&1; then
    markdownlint-cli2 "${markdown[@]}" 2>&1 | grep -E ' (error|warning) ' >&2 || true
    fail "markdownlint reported findings (above; bin/format fixes what it can)"
  fi
fi

for path in "${scripts[@]+"${scripts[@]}"}"; do
  is_sourced "$path" && continue
  [ -x "$path" ] || fail "$path: entry point is not executable"
  [ "$(first_command "$path")" = "set -euo pipefail" ] ||
    fail "$path: first command is not set -euo pipefail"
done

check_markdown() {
  local path="$1" max_lines="$2" max_chars="$3" lines chars h1s
  lines="$(wc -l <"$path" | tr -d ' ')"
  chars="$(wc -c <"$path" | tr -d ' ')"
  [ "$lines" -le "$max_lines" ] || fail "$path: $lines lines (cap $max_lines)"
  [ "$chars" -le "$max_chars" ] || fail "$path: $chars characters (cap $max_chars)"
  [ "$(grep -vE '^[[:space:]]*$' "$path" | head -n 1 | cut -c1-2)" = "# " ] ||
    fail "$path: does not lead with an H1"
  h1s="$(grep -cE '^# ' "$path" || true)"
  [ "$h1s" -eq 1 ] || fail "$path: $h1s H1 headings (want 1)"
  if grep -qiE "$BACKWARD_FACING" "$path"; then
    fail "$path: backward-facing wording"
  fi
}

rules=()
while IFS= read -r -d '' path; do
  rules+=("$path")
done < <(find .claude/rules -name '*.md' -type f -print0 2>/dev/null | sort -z)

[ "${#rules[@]}" -gt 0 ] || fail ".claude/rules holds no rules"

for path in "${rules[@]+"${rules[@]}"}"; do
  check_markdown "$path" "$MAX_RULE_LINES" "$MAX_RULE_CHARS"
  [ "$(head -n 1 "$path")" != "---" ] || fail "$path: frontmatter"
  if grep -qiE "$NARRATIVE_HEADING" "$path"; then
    fail "$path: narrative heading"
  fi
  while IFS= read -r ref; do
    [ -f ".claude/rules/$ref" ] || [ "$ref" = "CLAUDE.md" ] || [ "$ref" = "README.md" ] ||
      fail "$path: cites missing $ref"
  done < <(grep -oE "\`[a-z0-9/_-]+\.md\`" "$path" | tr -d "\`" || true)
done

if [ ! -f CLAUDE.md ]; then
  fail "CLAUDE.md is missing"
else
  check_markdown CLAUDE.md "$MAX_CLAUDE_LINES" "$MAX_CLAUDE_CHARS"
  if grep -q '\.claude/rules' CLAUDE.md; then
    fail "CLAUDE.md: points at the rules directory"
  fi
  for path in "${rules[@]+"${rules[@]}"}"; do
    if grep -qF "$(basename "$path")" CLAUDE.md; then
      fail "CLAUDE.md: names the rule $(basename "$path")"
    fi
  done
fi

SETTINGS=.claude/settings.json
REQUIRED_ALLOW=("Bash(bin/*)")
REQUIRED_DENY=(
  "Bash(git commit *)" "Bash(git rebase *)" "Bash(git checkout *)"
  "Bash(git reset *)" "Bash(git stash *)" "Bash(git clean *)"
  "Bash(git push --force *)" "Bash(git push -f *)"
)
REQUIRED_HOOKS=(PreToolUse:require-bin SessionStart:session-start)

if [ ! -f "$SETTINGS" ]; then
  fail "$SETTINGS is missing"
elif ! command -v jq >/dev/null 2>&1; then
  fail "jq is not installed (brew install jq)"
elif ! jq empty "$SETTINGS" >/dev/null 2>&1; then
  fail "$SETTINGS is not valid JSON"
else
  for entry in "${REQUIRED_ALLOW[@]}"; do
    jq -e --arg e "$entry" ".permissions.allow // [] | index(\$e) != null" "$SETTINGS" >/dev/null ||
      fail "$SETTINGS: does not allow $entry"
  done
  for entry in "${REQUIRED_DENY[@]}"; do
    jq -e --arg e "$entry" ".permissions.deny // [] | index(\$e) != null" "$SETTINGS" >/dev/null ||
      fail "$SETTINGS: does not deny $entry"
  done
  for pair in "${REQUIRED_HOOKS[@]}"; do
    event="${pair%%:*}"
    hook="${pair#*:}"
    jq -e --arg ev "$event" --arg h ".claude/hooks/$hook" \
      "[.hooks[\$ev][]?.hooks[]?.command | select(contains(\$h))] | length > 0" "$SETTINGS" >/dev/null ||
      fail "$SETTINGS: no $event hook runs .claude/hooks/$hook"
    [ -x ".claude/hooks/$hook" ] || fail ".claude/hooks/$hook is missing or not executable"
  done
fi

if [ "$failures" -gt 0 ]; then
  echo "guards: $failures failure(s)" >&2
  exit 1
fi
echo "guards: green"
