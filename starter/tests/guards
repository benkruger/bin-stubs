#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ROOT="$(git -C "$HERE" rev-parse --show-toplevel)"
SELF="${HERE#"$ROOT"/}/$(basename "${BASH_SOURCE[0]}")"
cd "$ROOT"

MAX_RULE_LINES=40
MAX_RULE_CHARS=8000
MAX_CLAUDE_LINES=400
MAX_CLAUDE_CHARS=12000
MAX_AUTHORED_BYTES=65536

GENERATED_NAMES=(
  package-lock.json bun.lock bun.lockb yarn.lock pnpm-lock.yaml
  uv.lock poetry.lock Gemfile.lock Cargo.lock Package.resolved
)
EXEMPT_PATHS=()

BANNED_SUPPRESSIONS='shellcheck[ ]disable|eslint[-](disable|enable)|@ts[-](ignore|expect-error|nocheck)|(istanbul|v8|c8)[ ]ignore|biome[-]ignore|rubocop[:](disable|todo)|:no[c]ov:|#[ ]*no[q]a|type[:][ ]*ignore|no[_]type[_]check|pragma[:] no cover|prettier[-]ignore|markdownlint[-](disable|configure[-]file)|#!?\[(al[l]ow|expec[t])\(|swift[-]format[-]ignore|swiftlint[:]disable|[$]VERBOS[E][[:space:]]*=[[:space:]]*(nil|false)|Warning\[[^]]*\][[:space:]]*=[[:space:]]*(nil|false)'
BACKWARD_FACING='\bwe hit\b|during PR #|after the fix|\bused to\b|\bno longer\b|\b(previously|formerly)\b|in the past|removed in PR|\bport(ed)? (of|from)\b'
NARRATIVE_HEADING='^##[[:space:]]+(why|rationale|background|history|cross-references?|how to apply)\b'

failures=0
fail() {
  echo "guards: $*" >&2
  failures=$((failures + 1))
}
scan_errors="$(mktemp)"
trap 'rm -f "$scan_errors"' EXIT

is_exempt() {
  local path="$1" name entry
  name="${path##*/}"
  for entry in "${GENERATED_NAMES[@]}"; do
    [ "$name" = "$entry" ] && return 0
  done
  for entry in "${EXEMPT_PATHS[@]+"${EXEMPT_PATHS[@]}"}"; do
    [ "$path" = "$entry" ] && return 0
  done
  return 1
}

files=()
links=()
while IFS= read -r -d '' path; do
  if [ -L "$path" ]; then
    links+=("$path")
  elif [ -f "$path" ]; then
    files+=("$path")
  fi
done < <(git ls-files -z --cached --others --exclude-standard)

text_files=()
while IFS= read -r path; do
  text_files+=("$path")
done < <(printf '%s\0' "${files[@]}" | LC_ALL=C xargs -0 grep -lI . -- 2>>"$scan_errors" || true)

measured=()
for path in "${text_files[@]+"${text_files[@]}"}"; do
  is_exempt "$path" || measured+=("$path")
done
if [ "${#measured[@]}" -gt 0 ]; then
  while IFS= read -r line; do
    fail "$line"
  done < <(printf '%s\n' "${measured[@]}" |
    CAP="$MAX_AUTHORED_BYTES" perl -nle 'my $b = -s $_; print "$_: $b bytes, over the $ENV{CAP}-byte cap" if $b > $ENV{CAP}')
fi

scanned=()
for path in "${files[@]}"; do
  [ "$path" = "$SELF" ] || scanned+=("$path")
done
if [ "${#scanned[@]}" -gt 0 ]; then
  while IFS= read -r line; do
    fail "$line: suppression comment"
  done < <(printf '%s\0' "${scanned[@]}" | xargs -0 grep -nIHE "$BANNED_SUPPRESSIONS" -- 2>>"$scan_errors" | cut -d: -f1,2 || true)
fi

comment_lines() {
  perl - "$@" <<'PERL'
use strict;
use warnings;

my $magic = qr/\A#\s*(?:frozen_string_literal:\s*(?:true|false)|(?:en)?coding:\s*[\w.-]+|warn_indent:\s*(?:true|false)|shareable_constant_value:\s*(?:none|literal|experimental_everything|experimental_copy))\s*\z/;
my $preceders = '(,=:[!&|?{};+-*%<>~^';
my $keywords = qr/(?:^|[^\w\$])(?:return|typeof|case|do|else|in|of|void|yield|await)\z/;

sub kind_of {
  my ($path, $first) = @_;
  return 'slash' if $path =~ /\.(?:[cm]?[jt]sx?|jsonc?|rs|swift)\z/;
  return 'css' if $path =~ /\.css\z/;
  return 'ruby' if $path =~ /(?:\.rb|\.rake|\.ru|\.gemspec|(?:\A|\/)(?:Gemfile|Rakefile))\z/;
  return 'python' if $path =~ /\.pyi?\z/;
  return 'toml' if $path =~ /\.toml\z/;
  return 'yaml' if $path =~ /\.ya?ml\z/;
  return 'line' if $path =~ /(?:\A|\/)\.(?:gitignore|gitattributes|shellcheckrc)\z/;
  return 'shell' if $path =~ /\.(?:sh|bash)\z/;
  return 'ruby' if $first =~ /\A#!.*\bruby\b/;
  return 'python' if $first =~ /\A#!.*\bpython/;
  return 'shell' if $first =~ /\A#!.*\b(?:ba|z)?sh\b/;
  return '';
}

sub line_at {
  my ($text, $index) = @_;
  return (substr($text, 0, $index) =~ tr/\n//) + 1;
}

sub skip_quoted {
  my ($text, $start, $quote) = @_;
  my $i = $start + 1;
  while ($i < length $text) {
    my $c = substr($text, $i, 1);
    last if $c eq $quote || $c eq "\n";
    $i += $c eq '\\' ? 2 : 1;
  }
  return $i + 1;
}

sub skip_regex {
  my ($text, $start) = @_;
  my ($i, $class) = ($start + 1, 0);
  while ($i < length $text) {
    my $c = substr($text, $i, 1);
    last if $c eq "\n";
    if ($c eq '\\') {
      $i += 2;
      next;
    }
    return $i + 1 if $c eq '/' && !$class;
    $class = 1 if $c eq '[';
    $class = 0 if $c eq ']';
    $i++;
  }
  return $i;
}

sub allows_regex {
  my ($text, $i) = @_;
  my $from = $i > 64 ? $i - 64 : 0;
  my $before = substr($text, $from, $i - $from);
  $before =~ s/\s+\z//;
  return 1 if $before eq '';
  return 1 if index($preceders, substr($before, -1)) >= 0;
  return $before =~ $keywords;
}

sub slash_lines {
  my ($text, $block_only, $path) = @_;
  my @found;
  my @stack = ('code');
  my $i = 0;
  my $n = length $text;
  my $rust = $path =~ /\.rs\z/;
  my $manifest = $path =~ /(?:\A|\/)Package\.swift\z/;
  if ($text =~ /\A#!/ || ($manifest && $text =~ /\A\/\/ swift-tools-version:/)) {
    $i = index($text, "\n");
    $i = $n if $i < 0;
  }
  while ($i < $n) {
    my $c = substr($text, $i, 1);
    my $d = substr($text, $i + 1, 1);
    if ($stack[-1] eq 'template') {
      if ($c eq '\\') {
        $i += 2;
      } elsif ($c eq '`') {
        pop @stack;
        $i++;
      } elsif ($c eq '$' && $d eq '{') {
        push @stack, 'code';
        $i += 2;
      } else {
        $i++;
      }
      next;
    }
    if ($c eq '/' && $d eq '*') {
      push @found, line_at($text, $i);
      my $end = index($text, '*/', $i + 2);
      $i = $end < 0 ? $n : $end + 2;
    } elsif (!$block_only && $c eq '/' && $d eq '/') {
      push @found, line_at($text, $i);
      my $end = index($text, "\n", $i);
      $i = $end < 0 ? $n : $end;
    } elsif (!$block_only && $c eq '/' && allows_regex($text, $i)) {
      $i = skip_regex($text, $i);
    } elsif ($rust && $c eq "'") {
      my $rest = substr($text, $i, 16);
      $i += $rest =~ /\A'(?:\\(?:u\{[0-9a-fA-F]{1,6}\}|x[0-9a-fA-F]{2}|.)|[^\\'\n])'/ ? length $& : 1;
    } elsif ($c eq "'" || $c eq '"') {
      $i = skip_quoted($text, $i, $c);
    } elsif (!$block_only && $c eq '`') {
      push @stack, 'template';
      $i++;
    } elsif (!$block_only && $c eq '{') {
      push @stack, 'code';
      $i++;
    } elsif (!$block_only && $c eq '}' && @stack > 1) {
      pop @stack;
      $i++;
    } else {
      $i++;
    }
  }
  return @found;
}

sub hash_comment_at {
  my ($kind, $line, $i) = @_;
  return 1 if $i == 0;
  my $prev = substr($line, $i - 1, 1);
  return $prev =~ /[\s;|&(]/ if $kind eq 'shell';
  return $prev =~ /\s/ if $kind eq 'yaml';
  return 1;
}

sub hash_lines {
  my ($text, $kind) = @_;
  my @found;
  my ($quote, $heredoc, $block, $leading) = ('', '', 0, 1);
  my @lines = split /\n/, $text, -1;
  for my $k (0 .. $#lines) {
    my ($line, $no) = ($lines[$k], $k + 1);
    if ($kind eq 'line') {
      push @found, $no if $line =~ /\A\s*#/;
      next;
    }
    if ($heredoc ne '') {
      $heredoc = '' if $line =~ /\A\s*\Q$heredoc\E\s*\z/;
      next;
    }
    if ($kind eq 'ruby' && ($block || $line =~ /\A=begin/)) {
      push @found, $no;
      $block = $line !~ /\A=end/;
      next;
    }
    next if $no == 1 && $line =~ /\A#!/;
    $leading = 0 if $line !~ /\A\s*(?:#|\z)/;
    next if $kind eq 'ruby' && $leading && $quote eq '' && $line =~ $magic;
    next if $kind eq 'shell' && $quote eq '' && $line =~ /\A\s*# shellcheck source=\S+\s*\z/;
    my ($i, $hit, $opens) = (0, 0, '');
    while ($i < length $line) {
      my $c = substr($line, $i, 1);
      if ($quote ne '') {
        if ($c eq '\\' && $quote ne "'") {
          $i += 2;
          next;
        }
        $quote = '' if $c eq $quote;
      } elsif ($c eq '\\') {
        $i += 2;
        next;
      } elsif ((($c eq "'" || $c eq '"') && ($kind ne 'yaml' || substr($line, 0, $i) =~ /(?:\A|[:,\[{-])\s*\z/))
        || ($c eq '`' && ($kind eq 'shell' || $kind eq 'ruby'))) {
        $quote = $c;
      } elsif ($c eq '#' && hash_comment_at($kind, $line, $i)) {
        $hit = 1;
        last;
      } elsif (($kind eq 'shell' || $kind eq 'ruby') && substr($line, $i) =~ /\A<<[-~]?(['"]?)([A-Z_][A-Z0-9_]*)\1/) {
        $opens = $2;
      }
      $i++;
    }
    push @found, $no if $hit;
    $heredoc = $opens if $opens ne '';
  }
  return @found;
}

for my $path (@ARGV) {
  open my $fh, '<', $path or next;
  my $text = do { local $/; <$fh> };
  close $fh;
  my ($first) = split /\n/, $text, 2;
  $first = '' unless defined $first;
  my $kind = kind_of($path, $first);
  next if $kind eq '';
  my @lines = $kind eq 'slash' ? slash_lines($text, 0, $path)
    : $kind eq 'css' ? slash_lines($text, 1, $path)
    : hash_lines($text, $kind);
  print "$path:$_\n" for @lines;
}
PERL
}

code=()
for path in "${text_files[@]+"${text_files[@]}"}"; do
  is_exempt "$path" && continue
  case "$path" in
    *.md) continue ;;
  esac
  code+=("$path")
done

if [ "${#code[@]}" -gt 0 ]; then
  hits="$(comment_lines "${code[@]}")" || fail "the comment scan did not finish"
  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    fail "$hit: a comment; only a shebang, a Ruby magic comment, a shellcheck source= line or Swift's tools-version line may stay"
  done <<<"$hits"
fi

BIOME_KEYS="[\"\$schema\", \"vcs\", \"files\", \"formatter\", \"assist\", \"linter\"]"
BIOME_GROUPS='["a11y", "complexity", "correctness", "nursery", "performance", "security", "style", "suspicious"]'
BIOME_FILES_KEYS='["maxSize", "ignoreUnknown"]'
BIOME_FORMATTER_KEYS='["enabled", "formatWithErrors", "indentStyle", "indentWidth", "lineEnding", "lineWidth", "attributePosition", "bracketSameLine", "bracketSpacing", "expand", "useEditorconfig"]'
TOML_KEY="^[[:space:]]*(\"[^\"]*\"|'[^']*'|[A-Za-z0-9_-])[^=]*="
RUBOCOP_KEYS='plugins require AllCops'
RUBOCOP_ALLCOPS_KEYS='NewCops SuggestExtensions TargetRubyVersion'
RUFF_KEYS=' target-version line-length indent-width src '
RUFF_LINT_KEYS=' extend-select '
MYPY_KEYS=' python_version plugins '
LINT_LEVELS=' warn deny forbid '
ESLINT_PACKAGES='@eslint/js @eslint/json @eslint/markdown @eslint/css eslint/config typescript-eslint globals'
SHELLCHECKRC_KEYS='source-path|external-sources|enable'

biome_ok() {
  jq -e --argjson keys "$BIOME_KEYS" --argjson groups "$BIOME_GROUPS" \
    --argjson files "$BIOME_FILES_KEYS" --argjson formatter "$BIOME_FORMATTER_KEYS" '
    (keys - $keys | length == 0)
    and ((.files // {}) | keys - $files | length == 0)
    and ((.formatter // {}) | (keys - $formatter | length == 0)
      and ((has("enabled") | not) or .enabled == true))
    and ((.assist // {}) | (keys - ["enabled", "actions"] | length == 0)
      and ([.. | scalars] | all(. == true or . == "on")))
    and ((.linter // {}) | (keys - ["enabled", "rules"] | length == 0)
      and ((has("enabled") | not) or .enabled == true)
      and ((.rules // {}) | to_entries | all(
        (.key == "preset" and .value == "all")
        or (.key as $k | ($groups | index($k)) != null and .value == "error"))))' "$1" >/dev/null 2>&1
}

eslint_ok() {
  PACKAGES="$ESLINT_PACKAGES" perl - "$1" <<'PERL'
use strict;
use warnings;

my $text = do { local $/; <> };
my %packages = map { $_ => 1 } split ' ', $ENV{PACKAGES};
my $quote = qr/["\x27]/;
exit 1 if $text =~ /(?:\A|[^\w\$])$quote?linterOptions$quote?\s*:/;
my $any = qr/["\x27`]/;
exit 1 if $text =~ /(?:\A|[^\w\$])$quote?rules$quote?\s*:\s*+(?!\{)/;
exit 1 if $text =~ /(?:\A|[^\w\$.])rules$quote?\s*[,}]/;
exit 1 if $text =~ /\[\s*${any}rules$any\s*\]|\.\s*rules\b/;
while ($text =~ /\b(?:from|import|require)\s*\(?\s*(["\x27`])(.*?)\1/g) {
  exit 1 unless $packages{$2};
}
exit 1 if $text =~ /\b(?:import|require)\s*\(\s*[^"\x27`\s]/;
my $error = qr/(?:${quote}error$quote|2)/;
while ($text =~ /(?:\A|[^\w\$])$quote?rules$quote?\s*:\s*\{/g) {
  my $at = pos $text;
  my ($depth, $quoted, $entry) = (1, '', '');
  my @entries;
  while ($depth > 0 && $at < length $text) {
    my $c = substr($text, $at++, 1);
    if ($quoted ne '') {
      $quoted = '' if $c eq $quoted;
    } elsif ($c eq '"' || $c eq "'" || $c eq '`') {
      $quoted = $c;
    } elsif ($c =~ /[\[{(]/) {
      $depth++;
    } elsif ($c =~ /[\]})]/) {
      $depth--;
      last if $depth == 0;
    } elsif ($c eq ',' && $depth == 1) {
      push @entries, $entry;
      $entry = '';
      next;
    }
    $entry .= $c;
  }
  push @entries, $entry;
  for my $item (@entries) {
    next if $item =~ /\A\s*\z/;
    exit 1 unless $item =~ /\A\s*(?:$quote[^"\x27]*$quote|[\w\$\/@-]+)\s*:\s*$error\s*\z/;
  }
}
exit 0;
PERL
}

rubocop_ok() {
  ruby -ryaml -e '
    config = YAML.safe_load(File.read(ARGV[0])) || {}
    exit 1 unless config.is_a?(Hash)
    %w[require plugins].each do |key|
      names = Array(config[key])
      exit 1 unless names.all? { |name| name.is_a?(String) && name.match?(/\A[\w-]+\z/) }
    end
    config.each do |key, value|
      next if ARGV[1].split.include?(key)
      next if value == { "Enabled" => true }
      next if key == "Style/Documentation" && value == { "Enabled" => false }
      exit 1
    end
    all = config.fetch("AllCops", {}) || {}
    exit 1 unless all.is_a?(Hash) && (all.keys - ARGV[2].split).empty?
    exit 1 if all.key?("NewCops") && all["NewCops"] != "enable"
  ' "$1" "$RUBOCOP_KEYS" "$RUBOCOP_ALLCOPS_KEYS" 2>/dev/null
}

cargo_ok() {
  awk -v levels="$LINT_LEVELS" -v keyline="$TOML_KEY" '
    /^[[:space:]]*\[/ { section = $0; gsub(/[][[:space:]"\047]/, "", section); next }
    $0 ~ keyline {
      key = $0; sub(/[[:space:]]*=.*/, "", key); gsub(/[[:space:]"\047]/, "", key)
      value = $0; sub(/^[^=]*=/, "", value)
      full = section == "" ? key : section "." key
      if (full !~ /^(workspace\.)?lints(\.|$)/) next
      if (full ~ /^lints\.workspace$/ && value ~ /true/) next
      if (full ~ /\.priority$/ && value ~ /^[[:space:]]*-?[0-9]+[[:space:]]*$/) next
      found = 0
      while (match(value, /"[a-z]+"/)) {
        found = 1
        if (index(levels, " " substr(value, RSTART + 1, RLENGTH - 2) " ") == 0) bad = 1
        value = substr(value, RSTART + RLENGTH)
      }
      if (!found) bad = 1
    }
    END { exit bad }' "$1"
}

mypy_ok() {
  awk -v allowed="$MYPY_KEYS" -v keyline="$TOML_KEY" '
    /^[[:space:]]*\[/ { section = $0; gsub(/[][[:space:]"\047]/, "", section); next }
    $0 ~ keyline {
      key = $0; sub(/[[:space:]]*=.*/, "", key); gsub(/[[:space:]"\047]/, "", key)
      full = section == "" ? key : section "." key
      if (full == "tool.mypy") { bad = 1; next }
      if (index(full, "tool.mypy.") != 1) next
      if (index(allowed, " " substr(full, 11) " ") == 0) bad = 1
    }
    END { exit bad }' "$1"
}

ruff_ok() {
  awk -v prefix="$2" -v top="$RUFF_KEYS" -v lint="$RUFF_LINT_KEYS" -v keyline="$TOML_KEY" '
    /^[[:space:]]*\[/ { section = $0; gsub(/[][[:space:]"\047]/, "", section); next }
    $0 ~ keyline {
      key = $0; sub(/[[:space:]]*=.*/, "", key); gsub(/[[:space:]"\047]/, "", key)
      full = section == "" ? key : section "." key
      if (prefix != "") {
        if (full == prefix) { bad = 1; next }
        if (index(full, prefix ".") != 1) next
        full = substr(full, length(prefix) + 2)
      }
      if (full ~ /^format(\.|$)/) next
      if (full ~ /^lint\./) {
        rest = substr(full, 6)
        if (index(lint, " " rest " ") == 0) bad = 1
        next
      }
      if (index(top, " " full " ") == 0) bad = 1
    }
    END { exit bad }' "$1"
}

swift_format_ok() {
  jq -e '(.rules // {}) | to_entries | all(.value == true)' "$1" >/dev/null 2>&1
}

shellcheckrc_ok() {
  ! grep -vE "^[[:space:]]*(#|$)|^[[:space:]]*($SHELLCHECKRC_KEYS)=" "$1" | grep -q .
}

rustfmt_ok() {
  ! grep -qE '^[[:space:]]*(disable_all_formatting|ignore)[[:space:]]*=' "$1"
}

cargo_config_ok() {
  perl - "$1" <<'PERL'
use strict;
use warnings;

my $text = do { local $/; <> };
while ($text =~ /\brustflags\s*=\s*(\[[^\]]*\]|"[^"]*"|'[^']*')/g) {
  my $value = $1;
  my @flags = $value =~ /\A\[/ ? $value =~ /["']([^"']*)["']/g : split ' ', substr($value, 1, -1);
  for my $flag (@flags) {
    exit 1 if $flag =~ /\A(?:-A|--allow|--cap-lints)/;
  }
}
exit 0;
PERL
}

RUST_QUIET_ATTRS='\b(?:al[l]ow|expec[t])\s*\(|\brustfm[t](?:_skip)?\b|\bignor[e]\b|\bcoverag[e]\b'

rust_quiet_attrs() {
  ATTRS="$RUST_QUIET_ATTRS" perl - "$@" <<'PERL'
use strict;
use warnings;

my $quiet = qr/$ENV{ATTRS}/;
for my $path (@ARGV) {
  open my $fh, '<', $path or next;
  my $text = do { local $/; <$fh> };
  close $fh;
  while ($text =~ /#!?\s*\[/g) {
    my ($start, $at, $depth, $quoted, $body) = ($-[0], pos $text, 1, 0, '');
    while ($depth > 0 && $at < length $text) {
      my $c = substr($text, $at++, 1);
      if ($quoted) {
        if ($c eq '\\') {
          $at++;
        } elsif ($c eq '"') {
          $quoted = 0;
        }
        next;
      }
      if ($c eq '"') {
        $quoted = 1;
        next;
      }
      $depth++ if $c eq '[';
      $depth-- if $c eq ']';
      $body .= $c;
    }
    print "$path:", (substr($text, 0, $start) =~ tr/\n//) + 1, "\n" if $body =~ $quiet;
    pos($text) = $at;
  }
  while ($text =~ /\bcfg!\s*\(([^)]*)/g) {
    my ($start, $args) = ($-[0], $1);
    print "$path:", (substr($text, 0, $start) =~ tr/\n//) + 1, "\n" if $args =~ /\bcoverag[e]\b/;
  }
}
PERL
}

mypy_plugins_ok() {
  perl - "$1" <<'PERL'
use strict;
use warnings;
use File::Basename;

my $path = shift;
my $dir = dirname($path);
open my $fh, '<', $path or exit 1;
my $text = do { local $/; <$fh> };
my ($section) = $text =~ /^\[tool\.mypy\]\s*\n(.*?)(?=^\[|\z)/ms;
exit 0 unless defined $section;
my ($value) = $section =~ /^\s*plugins\s*=\s*(\[[^\]]*\]|"[^"]*"|'[^']*')/m;
exit 0 unless defined $value;
for my $name ($value =~ /["']([^"']*)["']/g) {
  exit 1 if $name =~ m{[/\\]|\.py\z};
  my ($top) = split /\./, $name;
  for my $base ($dir, "$dir/src", '.', 'src') {
    exit 1 if -e "$base/$top.py" || -d "$base/$top";
  }
}
exit 0;
PERL
}

rust_files=()
for path in "${files[@]}" ${links[@]+"${links[@]}"}; do
  case "${path##*/}" in
    biome.json | biome.jsonc)
      biome_ok "$path" ||
        fail "$path: Biome settings outside its list (\$schema, vcs, files maxSize or ignoreUnknown, formatter style keys with enabled true, assist on, linter.enabled true, linter.rules preset all or a group at error)"
      ;;
    eslint.config.js | eslint.config.mjs | eslint.config.cjs | eslint.config.ts | eslint.config.mts | eslint.config.cts)
      eslint_ok "$path" ||
        fail "$path: sets an ESLint rule to anything but a bare error, or linterOptions, sets rules other than in an object literal, or imports outside ESLINT_PACKAGES ($ESLINT_PACKAGES); a rule may only be raised to error"
      ;;
    .rubocop)
      fail "$path: RuboCop takes its options from bin/lint, so it has no options file"
      ;;
    brakeman.yml)
      fail "$path: Brakeman runs with bin/lint's options, so it has no config file"
      ;;
    clippy.toml | .clippy.toml)
      fail "$path: Clippy runs with its default settings, so it has no config file"
      ;;
    rustfmt.toml | .rustfmt.toml)
      rustfmt_ok "$path" || fail "$path: turns rustfmt off for some or all files"
      ;;
    .rubocop.yml)
      if ! command -v ruby >/dev/null 2>&1; then
        fail "$path: ruby is not installed to read it"
      elif ! rubocop_ok "$path"; then
        fail "$path: RuboCop settings outside its list ($RUBOCOP_KEYS; AllCops: $RUBOCOP_ALLCOPS_KEYS, NewCops enable; a cop only Enabled true; Style/Documentation may be Enabled false)"
      fi
      ;;
    Cargo.toml)
      cargo_ok "$path" || fail "$path: a lint level other than warn, deny or forbid"
      ;;
    pyproject.toml)
      ruff_ok "$path" tool.ruff ||
        fail "$path: Ruff settings outside its list (top:$RUFF_KEYS; lint:$RUFF_LINT_KEYS; format)"
      mypy_ok "$path" ||
        fail "$path: mypy settings outside its list ($MYPY_KEYS); bin/build runs mypy --strict"
      mypy_plugins_ok "$path" || fail "$path: loads a mypy plugin from the app's own code"
      ;;
    mypy.ini | .mypy.ini)
      fail "$path: mypy takes its settings from [tool.mypy] in pyproject.toml, so it has no config file"
      ;;
    setup.cfg)
      if grep -q '^\[mypy' "$path"; then
        fail "$path: mypy takes its settings from [tool.mypy] in pyproject.toml, so setup.cfg has no [mypy] section"
      fi
      ;;
    ruff.toml | .ruff.toml)
      ruff_ok "$path" "" ||
        fail "$path: Ruff settings outside its list (top:$RUFF_KEYS; lint:$RUFF_LINT_KEYS; format)"
      ;;
    .swift-format)
      swift_format_ok "$path" || fail "$path: turns a swift-format rule off"
      ;;
    .shellcheckrc)
      shellcheckrc_ok "$path" ||
        fail "$path: holds a directive other than source-path, external-sources or enable"
      ;;
    .markdownlint.json | .markdownlint.jsonc | .markdownlint.yaml | .markdownlint.yml | .markdownlint.cjs | .markdownlint.mjs | .markdownlintrc | .markdownlint-cli2.jsonc | .markdownlint-cli2.yaml | .markdownlint-cli2.cjs | .markdownlint-cli2.mjs)
      fail "$path: markdownlint runs with its default rules, so it has no config file"
      ;;
    brakeman.ignore)
      fail "$path: Brakeman ignores no warning"
      ;;
    .prettierignore)
      fail "$path: Prettier formats every file, so it has no ignore file"
      ;;
  esac
  case "$path" in
    .cargo/config | .cargo/config.toml | */.cargo/config | */.cargo/config.toml)
      cargo_config_ok "$path" || fail "$path: sets a lint level in rustflags; lint levels live in Cargo.toml [lints]"
      ;;
    *.rs) rust_files+=("$path") ;;
  esac
done

if [ "${#rust_files[@]}" -gt 0 ]; then
  hits="$(rust_quiet_attrs "${rust_files[@]}")" || fail "the Rust attribute scan did not finish"
  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    fail "$hit: a Rust attribute or cfg! that allows or expects a lint, ignores a test, skips rustfmt or hides code from coverage"
  done <<<"$hits"
fi

SKIP_JS="\\b(test|it|describe|suite|t|context)([[:space:]]*\\.[[:space:]]*[A-Za-z]+)*[[:space:]]*\\.[[:space:]]*(skip|only|todo|skipIf|runIf|fails|failing)\\b|\\b(xit|xtest|xdescribe|fit|fdescribe)[[:space:]]*\\(|\\b(skip|only|todo)[[:space:]]*:[[:space:]]*(true\\b|[\"'\`])"
SKIP_PY='\bmark\.(skip|skipif|xfail)\b|\bpytest\.(skip|xfail|importorskip)[[:space:]]*\(|@unittest\.(skip|skipIf|skipUnless|expectedFailure)\b|\.skipTest[[:space:]]*\(|\bcollect_ignore(_glob)?\b'
SKIP_RUBY='^[[:space:]]*(skip|skip_until|pending|xit|xdescribe|fit|fdescribe|focus)([[:space:](]|$)'
SKIP_RUST='#\[[[:space:]]*ignore[[:space:]]*[]=(]'
SKIP_SWIFT='\bXCTSkip(If|Unless)?\b|\.(disabled|enabled)[[:space:]]*\(|\bXCTExpectFailure\b|\bwithKnownIssue\b'

skip_pattern_of() {
  skip_pattern=""
  case "/$1" in
    *.rs) skip_pattern="$SKIP_RUST" ;;
    */tests/*.py | */test/*.py | */test_*.py | *_test.py | */conftest.py) skip_pattern="$SKIP_PY" ;;
    *_test.rb | *_spec.rb) skip_pattern="$SKIP_RUBY" ;;
    */Tests/*.swift | *Tests.swift) skip_pattern="$SKIP_SWIFT" ;;
    *.test.[cm][jt]s | *.test.[jt]s | *.test.[jt]sx | *.spec.[cm][jt]s | *.spec.[jt]s | *.spec.[jt]sx) skip_pattern="$SKIP_JS" ;;
    */test-*.[cm]js | */test-*.js | */test-*.jsx) skip_pattern="$SKIP_JS" ;;
    */tests/*.[cm][jt]s | */tests/*.[jt]s | */tests/*.[jt]sx | */__tests__/*.[jt]s | */__tests__/*.[jt]sx) skip_pattern="$SKIP_JS" ;;
  esac
}

test_files=()
for path in "${files[@]}"; do
  skip_pattern_of "$path"
  [ -z "$skip_pattern" ] || test_files+=("$path")
done
skip_candidates=$'\n'
if [ "${#test_files[@]}" -gt 0 ]; then
  skip_candidates+="$(printf '%s\0' "${test_files[@]}" |
    xargs -0 grep -lE "($SKIP_JS)|($SKIP_PY)|($SKIP_RUBY)|($SKIP_RUST)|($SKIP_SWIFT)" -- || true)"$'\n'
fi

for path in "${test_files[@]+"${test_files[@]}"}"; do
  case "$skip_candidates" in
    *$'\n'"$path"$'\n'*) ;;
    *) continue ;;
  esac
  skip_pattern_of "$path"
  while IFS= read -r line; do
    fail "$path:$line: a test that does not run (skipped, focused, todo or expected to fail)"
  done < <(grep -nE "$skip_pattern" "$path" | cut -d: -f1 || true)
done

TIMEOUT_FLAGS='(--test-?[tT]imeout|--timeout)\b|-(default|maximum)-test-execution-time-allowance\b|-test-timeouts-enabled\b'
TIMEOUT_JS_CONFIG='\b(testTimeout|hookTimeout|teardownTimeout)\b'
TIMEOUT_JS_CODE='\b(jest\.setTimeout|vi\.setConfig|setDefaultTimeout)[[:space:]]*\('
TIMEOUT_JS_LIMIT='\btimeout[[:space:]]*:[^,})]*'
TIMEOUT_PY_LIMIT='@pytest\.mark\.timeout[[:space:]]*\([^)]*'
TIMEOUT_SWIFT_CODE='\bexecutionTimeAllowance[[:space:]]*='
TIMEOUT_XCTESTPLAN='"(defaultTestExecutionTimeAllowance|maximumTestExecutionTimeAllowance|testTimeoutsEnabled)"'

section_key_lines() {
  awk -v want="$2" -v key="$3" '
    /^[[:space:]]*\[/ { section = $0; gsub(/[][[:space:]]/, "", section); next }
    section ~ want && $0 ~ ("^[[:space:]]*" key "[[:space:]]*=") { print NR }
  ' "$1"
}

matching_lines() {
  grep -nE "$1" "$2" | cut -d: -f1 || true
}

non_number_limits() {
  local line value
  while IFS=: read -r line value; do
    value="${value#*[:(]}"
    value="$(printf '%s' "$value" | tr -d '[:space:]')"
    [[ "$value" =~ ^[0-9][0-9_]*$ ]] || printf '%s\n' "$line"
  done < <(grep -noE "$1" "$2" || true)
}

timeout_lines() {
  case "/$1" in
    */bin/*) matching_lines "$TIMEOUT_FLAGS" "$1" ;;
    */package.json) matching_lines "$TIMEOUT_FLAGS|$TIMEOUT_JS_CONFIG" "$1" ;;
    */vitest.config.* | */vite.config.* | */vitest.workspace.* | */jest.config.*)
      matching_lines "$TIMEOUT_JS_CONFIG" "$1"
      ;;
    */bunfig.toml) section_key_lines "$1" '^test$' timeout ;;
    */pyproject.toml)
      section_key_lines "$1" '^tool\.pytest\.ini_options$' timeout
      matching_lines "$TIMEOUT_FLAGS" "$1"
      ;;
    */pytest.ini | */tox.ini | */setup.cfg)
      section_key_lines "$1" '^(pytest|tool:pytest)$' timeout
      matching_lines "$TIMEOUT_FLAGS" "$1"
      ;;
    *.xctestplan) matching_lines "$TIMEOUT_XCTESTPLAN" "$1" ;;
  esac
  skip_pattern_of "$1"
  case "$skip_pattern" in
    "$SKIP_JS")
      matching_lines "$TIMEOUT_JS_CODE" "$1"
      non_number_limits "$TIMEOUT_JS_LIMIT" "$1"
      ;;
    "$SKIP_PY") non_number_limits "$TIMEOUT_PY_LIMIT" "$1" ;;
    "$SKIP_SWIFT") matching_lines "$TIMEOUT_SWIFT_CODE" "$1" ;;
  esac
}

TIMEOUT_ANY="$TIMEOUT_FLAGS|$TIMEOUT_JS_CONFIG|$TIMEOUT_JS_CODE|$TIMEOUT_JS_LIMIT|$TIMEOUT_PY_LIMIT|$TIMEOUT_SWIFT_CODE|$TIMEOUT_XCTESTPLAN|^[[:space:]]*timeout[[:space:]]*="

while IFS= read -r path; do
  [ "$path" = "$SELF" ] && continue
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    fail "$path:$line: raises the test time limit beyond the runner's default; only a fixed number on one test is allowed"
  done < <(timeout_lines "$path")
done < <(printf '%s\0' "${files[@]}" | xargs -0 grep -lE "$TIMEOUT_ANY" -- 2>/dev/null || true)

OUTPUT_DIRS=(node_modules dist build coverage .venv target .build .flow-states)

for path in "${files[@]}"; do
  case "/$path" in
    */node_modules/* | */dist/* | */build/* | */coverage/* | */.venv/* | */target/* | */.build/* | */.flow-states/* | */vendor/bundle/* | */lcov.info | *.tsbuildinfo)
      fail "$path: build or coverage output; .gitignore keeps it out of git"
      ;;
  esac
done

if [ ! -f .gitignore ]; then
  fail ".gitignore is missing"
else
  ignored=$'\n'"$(<.gitignore)"$'\n'
  for dir in "${OUTPUT_DIRS[@]}"; do
    case "$ignored" in
      *$'\n'"$dir/"$'\n'*) ;;
      *) fail ".gitignore does not ignore $dir/" ;;
    esac
  done
fi

for path in "${files[@]}"; do
  case "$path" in
    */bin/ci | */bin/changed | */bin/format | */bin/lint | */bin/build | */bin/test | */bin/dependencies | */bin/open | */bin/qa)
      fail "$path: a gate script inside an app; the root bin/ runs every app"
      ;;
    bin/_root/*)
      fail "$path: the root app runs from bin/_<language>/, not bin/_root/"
      ;;
  esac
done

INSTALL_COMMANDS='\b(npm|pnpm|yarn|bun)[[:space:]]+(install|i|ci|add|update|upgrade)\b|\buv[[:space:]]+(sync|add|lock|pip)\b|\bbundle[[:space:]]+(install|update|add)\b|\bcargo[[:space:]]+(fetch|update|add)\b|\bswift[[:space:]]+package[[:space:]]+(update|resolve)\b'

leaf_scripts=()
for path in "${files[@]}"; do
  case "$path" in
    bin/_*/dependencies) continue ;;
    bin/_*/*/*) continue ;;
    bin/_*/*) leaf_scripts+=("$path") ;;
  esac
done
if [ "${#leaf_scripts[@]}" -gt 0 ]; then
  while IFS= read -r hit; do
    fail "$hit: installs packages; only bin/dependencies does"
  done < <(grep -nHE "$INSTALL_COMMANDS" -- "${leaf_scripts[@]}" | cut -d: -f1,2 || true)
fi

UPDATE_COMMANDS='[[:space:]](update|upgrade|--upgrade)([[:space:]]|$)'

dependency_scripts=()
for path in "${files[@]}"; do
  case "$path" in
    bin/_*/*/*) continue ;;
    bin/_*/dependencies) dependency_scripts+=("$path") ;;
  esac
done
installing=()
if [ "${#dependency_scripts[@]}" -gt 0 ]; then
  while IFS= read -r path; do
    installing+=("$path")
  done < <(grep -lE "$INSTALL_COMMANDS" -- "${dependency_scripts[@]}" || true)
fi
if [ "${#installing[@]}" -gt 0 ]; then
  while IFS= read -r path; do
    fail "$path: installs packages without updating them first"
  done < <(grep -LE "$UPDATE_COMMANDS" -- "${installing[@]}" || true)
fi

gate_scripts=()
for path in "${files[@]}"; do
  case "$path" in
    bin/_*/*/*) continue ;;
    bin/_*/ci | bin/_*/changed | bin/_*/format | bin/_*/lint | bin/_*/build | bin/_*/test | bin/_*/open | bin/_*/qa) gate_scripts+=("$path") ;;
  esac
done
if [ "${#gate_scripts[@]}" -gt 0 ]; then
  while IFS= read -r path; do
    grep -qx 'packages_check() {' "${path%/*}/lib/toolchain.sh" 2>/dev/null || continue
    fail "$path: never runs packages_check; every gate script but bin/dependencies does"
  done < <(grep -Lw packages_check -- "${gate_scripts[@]}" || true)
fi

COVERAGE_NARROWED='"codeCoverage"[[:space:]]*:[[:space:]]*(false|\{)|codeCoverageEnabled[[:space:]]*=[[:space:]]*"NO"|onlyGenerateCoverageForSpecifiedTargets[[:space:]]*=[[:space:]]*"YES"'

for path in "${files[@]}"; do
  case "$path" in
    *.rb)
      grep -q 'SimpleCov\.start' "$path" || continue
      grep -qE '^[[:space:]]*minimum_coverage line: 100, branch: 100[[:space:]]*$' "$path" ||
        fail "$path: starts SimpleCov without minimum_coverage line: 100, branch: 100"
      while IFS= read -r line; do
        fail "$path:$line: leaves files out of coverage (add_filter, skip or filters)"
      done < <(matching_lines '\b(add_filter|skip|filters)\b' "$path")
      ;;
    .simplecov | */.simplecov)
      fail "$path: SimpleCov starts in test/test_helper.rb, so it has no .simplecov file"
      ;;
    *.xctestplan | *.xcscheme)
      while IFS= read -r line; do
        fail "$path:$line: turns code coverage off or limits it to some targets"
      done < <(matching_lines "$COVERAGE_NARROWED" "$path")
      ;;
  esac
done

is_sourced() {
  case "$1" in
    */lib/*.sh | tests/lib.sh | */_run_quiet) return 0 ;;
    *) return 1 ;;
  esac
}

entry_point_findings() {
  perl - "$@" <<'PERL'
use strict;
use warnings;

for my $path (@ARGV) {
  print "$path: entry point is not executable\n" unless -x $path;
  my $first = '';
  if (open my $fh, '<', $path) {
    while (my $line = <$fh>) {
      chomp $line;
      next if $line =~ /^[[:space:]]*(?:#|$)/;
      $first = $line;
      last;
    }
  }
  print "$path: first command is not set -euo pipefail\n"
    unless $first eq 'set -euo pipefail';
}
PERL
}

scripts=()
while IFS= read -r path; do
  scripts+=("$path")
done < <(printf '%s\n' "${files[@]}" |
  perl -nle 'if (/\.(?:sh|bash)\z/) { print; next } open(my $f, "<", $_) or next; my $l = <$f>; print if defined $l && $l =~ /^#!.*\bbash\b/')

SHELLCHECK_PASSES="${XDG_CACHE_HOME:-$HOME/.cache}/flow-guards/shellcheck"

shellcheck_key() {
  local path
  {
    shellcheck --version
    for path in "${files[@]}" "$HOME/.shellcheckrc"; do
      case "$path" in
        .shellcheckrc | */.shellcheckrc) [ ! -f "$path" ] || cat "$path" ;;
      esac
    done
    shasum -a 256 "$@"
  } | shasum -a 256 | cut -d' ' -f1
}

if [ "${#scripts[@]}" -gt 0 ]; then
  if ! command -v shellcheck >/dev/null 2>&1; then
    fail "shellcheck is not installed (brew install shellcheck)"
  else
    key="$(shellcheck_key "${scripts[@]}")"
    if [ ! -e "$SHELLCHECK_PASSES/$key" ]; then
      if printf '%s\0' "${scripts[@]}" |
        xargs -0 -n 16 -P "$(getconf _NPROCESSORS_ONLN)" shellcheck -x -P SCRIPTDIR >&2; then
        { mkdir -p "$SHELLCHECK_PASSES" && : >"$SHELLCHECK_PASSES/$key"; } 2>/dev/null || true
      else
        fail "shellcheck reported findings (above)"
      fi
    fi
  fi
  if ! command -v shfmt >/dev/null 2>&1; then
    fail "shfmt is not installed (brew install shfmt)"
  elif ! shfmt -i 2 -ci -d "${scripts[@]}" >&2; then
    fail "shfmt would reformat the scripts above (run bin/format)"
  fi
fi

markdown=()
for path in "${files[@]}"; do
  case "$path" in
    *.md) markdown+=("$path") ;;
  esac
done

if [ "${#markdown[@]}" -gt 0 ]; then
  if ! command -v markdownlint-cli2 >/dev/null 2>&1; then
    fail "markdownlint-cli2 is not installed (brew install markdownlint-cli2)"
  elif ! markdownlint-cli2 "${markdown[@]}" >/dev/null 2>&1; then
    markdownlint-cli2 "${markdown[@]}" 2>&1 | grep -E ' (error|warning) ' >&2 || true
    fail "markdownlint reported findings (above; bin/format fixes what it can)"
  fi
fi

entry_points=()
for path in "${scripts[@]+"${scripts[@]}"}"; do
  is_sourced "$path" || entry_points+=("$path")
done
if [ "${#entry_points[@]}" -gt 0 ]; then
  while IFS= read -r line; do
    fail "$line"
  done < <(entry_point_findings "${entry_points[@]}")
fi

markdown_findings() {
  RULE_LINES="$MAX_RULE_LINES" RULE_CHARS="$MAX_RULE_CHARS" \
    CLAUDE_LINES="$MAX_CLAUDE_LINES" CLAUDE_CHARS="$MAX_CLAUDE_CHARS" \
    BACKWARD="$BACKWARD_FACING" NARRATIVE="$NARRATIVE_HEADING" perl - "$@" <<'PERL'
use strict;
use warnings;
use Digest::SHA qw(sha256_hex);

my $backward = qr/$ENV{BACKWARD}/i;
my $narrative = qr/$ENV{NARRATIVE}/i;
my $stamp_line = qr/\n<!-- audited: [0-9a-f]{12} -->\s*\z/;

sub read_text {
  my ($path) = @_;
  open my $fh, '<', $path or return '';
  local $/;
  my $text = <$fh>;
  return defined $text ? $text : '';
}

sub check_markdown {
  my ($path, $text, $max_lines, $max_chars) = @_;
  (my $body = $text) =~ s/$stamp_line/\n/;
  my $lines = ($body =~ tr/\n//);
  my $chars = length $body;
  my @lines = split /\n/, $text;
  print "$path: $lines lines (cap $max_lines)\n" if $lines > $max_lines;
  print "$path: $chars characters (cap $max_chars)\n" if $chars > $max_chars;
  my ($lead) = grep { !/^[[:space:]]*$/ } @lines;
  print "$path: does not lead with an H1\n"
    unless defined $lead && substr($lead, 0, 2) eq '# ';
  my $h1s = grep { /^# / } @lines;
  print "$path: $h1s H1 headings (want 1)\n" unless $h1s == 1;
  print "$path: backward-facing wording\n" if grep { /$backward/ } @lines;
  return @lines;
}

for my $path (@ARGV) {
  my $text = read_text($path);
  my @lines = check_markdown($path, $text, $ENV{RULE_LINES}, $ENV{RULE_CHARS});
  print "$path: frontmatter\n" if @lines && $lines[0] eq '---';
  print "$path: narrative heading\n" if grep { /$narrative/ } @lines;
  my ($last) = reverse grep { !/^[[:space:]]*$/ } @lines;
  my ($stamp) = defined $last
    ? $last =~ /^[[:space:]]*<!-- audited: ([0-9a-f]{12}) -->[[:space:]]*$/ : ();
  if (!defined $stamp) {
    print "$path: no audit stamp (commit it through bin/commit)\n";
  } else {
    (my $body = $text) =~ s/$stamp_line/\n/;
    $body =~ s/\s*\z/\n/;
    print "$path: audit stamp does not match its body (commit it through bin/commit)\n"
      if $stamp ne substr(sha256_hex($body), 0, 12);
  }
  for my $line (@lines) {
    while ($line =~ /`([a-z0-9\/_-]+\.md)`/g) {
      my $ref = $1;
      print "$path: cites missing $ref\n"
        unless -f ".claude/rules/$ref" || $ref eq 'CLAUDE.md' || $ref eq 'README.md';
    }
  }
}

if (-f 'CLAUDE.md') {
  my $text = read_text('CLAUDE.md');
  check_markdown('CLAUDE.md', $text, $ENV{CLAUDE_LINES}, $ENV{CLAUDE_CHARS});
  print "CLAUDE.md: points at the rules directory\n" if index($text, '.claude/rules') >= 0;
  for my $path (@ARGV) {
    (my $name = $path) =~ s{.*/}{};
    print "CLAUDE.md: names the rule $name\n" if index($text, $name) >= 0;
  }
}
PERL
}

rules=()
while IFS= read -r -d '' path; do
  rules+=("$path")
done < <(find .claude/rules -name '*.md' -type f -print0 2>/dev/null | sort -z)

[ "${#rules[@]}" -gt 0 ] || fail ".claude/rules holds no rules"

while IFS= read -r line; do
  fail "$line"
done < <(markdown_findings "${rules[@]+"${rules[@]}"}")

[ -f CLAUDE.md ] || fail "CLAUDE.md is missing"

SETTINGS=.claude/settings.json
REQUIRED_ALLOW=("Bash(bin/*)")
REQUIRED_DENY=(
  "Bash(git commit *)" "Bash(git rebase *)" "Bash(git checkout *)"
  "Bash(git reset *)" "Bash(git restore *)" "Bash(git stash *)"
  "Bash(git clean *)" "Bash(git push *--force*)" "Bash(git push -f *)"
  "Bash(git push * -f)" "Bash(git push * -f *)" "Bash(git push * +*)"
)
REQUIRED_HOOKS=(PreToolUse:require-bin SessionStart:session-start)

if [ ! -f "$SETTINGS" ]; then
  fail "$SETTINGS is missing"
elif ! command -v jq >/dev/null 2>&1; then
  fail "jq is not installed (brew install jq)"
elif ! jq empty "$SETTINGS" >/dev/null 2>&1; then
  fail "$SETTINGS is not valid JSON"
elif ! settings_checks="$(jq -r --argjson na "${#REQUIRED_ALLOW[@]}" --argjson nd "${#REQUIRED_DENY[@]}" '
  . as $s | $ARGS.positional as $p
  | ($p[0:$na][] | . as $e
    | select((try (($s.permissions.allow // []) | index($e) != null) catch false) | not)
    | "fail\tdoes not allow \($e)"),
  (try ($s.permissions.allow // [] | .[] | select(type == "string")
    | select(. == "Bash" or . == "Bash()" or startswith("Bash(*")) | "fail\tallows every command: \(.)")
    catch "fail\thas a permissions.allow that is not a list"),
  ($p[$na:$na + $nd][] | . as $e
    | select((try (($s.permissions.deny // []) | index($e) != null) catch false) | not)
    | "fail\tdoes not deny \($e)"),
  ($p[$na + $nd:][] | (split(":") | .[0]) as $ev | (sub("^[^:]*:"; "")) as $hook
    | (try ([$s.hooks[$ev][]?.hooks[]?.command | select(contains(".claude/hooks/" + $hook))] | length > 0) catch false) as $ok
    | "hook\t\($ev)\t\($hook)\t\(if $ok then 1 else 0 end)")
' "$SETTINGS" --args "${REQUIRED_ALLOW[@]}" "${REQUIRED_DENY[@]}" "${REQUIRED_HOOKS[@]}")"; then
  fail "$SETTINGS: could not be checked"
else
  while IFS=$'\t' read -r kind a b c; do
    case "$kind" in
      fail) fail "$SETTINGS: $a" ;;
      hook)
        [ "$c" = 1 ] || fail "$SETTINGS: no $a hook runs .claude/hooks/$b"
        [ -x ".claude/hooks/$b" ] || fail ".claude/hooks/$b is missing or not executable"
        ;;
    esac
  done <<<"$settings_checks"
fi

if [ -s "$scan_errors" ]; then
  fail "a scan could not read every file: $(head -n 1 "$scan_errors")"
fi

if [ "$failures" -gt 0 ]; then
  echo "guards: $failures failure(s)" >&2
  exit 1
fi
echo "guards: green"
