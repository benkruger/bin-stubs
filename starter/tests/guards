#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ROOT="$(git -C "$HERE" rev-parse --show-toplevel)"
SELF="${HERE#"$ROOT"/}/$(basename "${BASH_SOURCE[0]}")"
cd "$ROOT"

MAX_RULE_LINES=40
MAX_RULE_CHARS=8000
MAX_CLAUDE_LINES=400
MAX_CLAUDE_CHARS=12000
MAX_AUTHORED_BYTES=65536

GENERATED_NAMES=(
  package-lock.json bun.lock bun.lockb yarn.lock pnpm-lock.yaml
  uv.lock poetry.lock Gemfile.lock Cargo.lock Package.resolved
)
EXEMPT_PATHS=()

BANNED_SUPPRESSIONS='shellcheck[ ]disable|eslint[-](disable|enable)|@ts[-](ignore|expect-error|nocheck)|(istanbul|v8|c8)[ ]ignore|biome[-]ignore|rubocop[:](disable|todo)|:no[c]ov:|#[ ]*no[q]a|type[:][ ]*ignore|pragma[:] no cover|prettier[-]ignore|markdownlint[-]disable|#!?\[(al[l]ow|expec[t])\(|swift[-]format[-]ignore|swiftlint[:]disable'
BACKWARD_FACING='\bwe hit\b|during PR #|after the fix|\bused to\b|\bno longer\b|\b(previously|formerly)\b|in the past|removed in PR|\bport(ed)? (of|from)\b'
NARRATIVE_HEADING='^##[[:space:]]+(why|rationale|background|history|cross-references?|how to apply)\b'

failures=0
fail() {
  echo "guards: $*" >&2
  failures=$((failures + 1))
}

is_text() {
  LC_ALL=C grep -qI . "$1"
}

is_exempt() {
  local path="$1" name entry
  name="$(basename "$path")"
  for entry in "${GENERATED_NAMES[@]}"; do
    [ "$name" = "$entry" ] && return 0
  done
  for entry in "${EXEMPT_PATHS[@]+"${EXEMPT_PATHS[@]}"}"; do
    [ "$path" = "$entry" ] && return 0
  done
  return 1
}

files=()
while IFS= read -r -d '' path; do
  [ -f "$path" ] && [ ! -L "$path" ] || continue
  files+=("$path")
done < <(git ls-files -z --cached --others --exclude-standard)

for path in "${files[@]}"; do
  is_exempt "$path" && continue
  is_text "$path" || continue
  bytes="$(wc -c <"$path" | tr -d ' ')"
  [ "$bytes" -le "$MAX_AUTHORED_BYTES" ] ||
    fail "$path: $bytes bytes, over the $MAX_AUTHORED_BYTES-byte cap"
done

for path in "${files[@]}"; do
  [ "$path" = "$SELF" ] && continue
  while IFS= read -r line; do
    fail "$path:$line: suppression comment"
  done < <(grep -nIE "$BANNED_SUPPRESSIONS" "$path" | cut -d: -f1 || true)
done

# Lint configuration: each file holds only the settings on its tool's list
# below, so no setting can turn a rule off or down, known or not.
BIOME_KEYS="[\"\$schema\", \"vcs\", \"files\", \"formatter\", \"assist\", \"linter\"]"
# A TOML key line: a bare or quoted key, possibly dotted, then =.
TOML_KEY='^[[:space:]]*("[^"]*"|[A-Za-z0-9_-])[^=]*='
RUBOCOP_KEYS='plugins require AllCops'
RUBOCOP_ALLCOPS_KEYS='NewCops SuggestExtensions TargetRubyVersion'
RUFF_KEYS=' target-version line-length indent-width src '
RUFF_LINT_KEYS=' extend-select '
LINT_LEVELS=' warn deny forbid '
SHELLCHECKRC_KEYS='source-path|external-sources|enable'

biome_ok() {
  jq -e --argjson keys "$BIOME_KEYS" '
    (keys - $keys | length == 0)
    and ((.linter // {}) | (keys - ["enabled"] | length == 0)
      and ((has("enabled") | not) or .enabled == true))' "$1" >/dev/null 2>&1
}

eslint_ok() {
  ! grep -qE "(^|[^A-Za-z0-9_\$])[\"']?(rules|linterOptions)[\"']?[[:space:]]*:" "$1"
}

rubocop_ok() {
  ruby -ryaml -e '
    config = YAML.safe_load(File.read(ARGV[0])) || {}
    exit 1 unless config.is_a?(Hash) && (config.keys - ARGV[1].split).empty?
    all = config.fetch("AllCops", {}) || {}
    exit 1 unless all.is_a?(Hash) && (all.keys - ARGV[2].split).empty?
    exit 1 if all.key?("NewCops") && all["NewCops"] != "enable"
  ' "$1" "$RUBOCOP_KEYS" "$RUBOCOP_ALLCOPS_KEYS" 2>/dev/null
}

# Cargo.toml: every lint level under [lints] or [workspace.lints] is warn,
# deny or forbid; clippy runs with warnings as errors.
cargo_ok() {
  awk -v levels="$LINT_LEVELS" -v keyline="$TOML_KEY" '
    /^[[:space:]]*\[/ { section = $0; gsub(/[][[:space:]]/, "", section); next }
    $0 ~ keyline {
      key = $0; sub(/[[:space:]]*=.*/, "", key); gsub(/[[:space:]"]/, "", key)
      value = $0; sub(/^[^=]*=/, "", value)
      full = section == "" ? key : section "." key
      if (full !~ /^(workspace\.)?lints(\.|$)/) next
      if (full ~ /^lints\.workspace$/ && value ~ /true/) next
      if (!match(value, /"[a-z]+"/)) { bad = 1; next }
      level = substr(value, RSTART + 1, RLENGTH - 2)
      if (index(levels, " " level " ") == 0) bad = 1
    }
    END { exit bad }' "$1"
}

# Ruff, in pyproject.toml under [tool.ruff] or in ruff.toml: the top level
# holds only RUFF_KEYS, [lint] only RUFF_LINT_KEYS, and [format] anything.
ruff_ok() {
  awk -v prefix="$2" -v top="$RUFF_KEYS" -v lint="$RUFF_LINT_KEYS" -v keyline="$TOML_KEY" '
    /^[[:space:]]*\[/ { section = $0; gsub(/[][[:space:]]/, "", section); next }
    $0 ~ keyline {
      key = $0; sub(/[[:space:]]*=.*/, "", key); gsub(/[[:space:]"]/, "", key)
      full = section == "" ? key : section "." key
      if (prefix != "") {
        if (index(full, prefix ".") != 1) next
        full = substr(full, length(prefix) + 2)
      }
      if (full ~ /^format(\.|$)/) next
      if (full ~ /^lint\./) {
        rest = substr(full, 6)
        if (index(lint, " " rest " ") == 0) bad = 1
        next
      }
      if (index(top, " " full " ") == 0) bad = 1
    }
    END { exit bad }' "$1"
}

swift_format_ok() {
  jq -e '(.rules // {}) | to_entries | all(.value == true)' "$1" >/dev/null 2>&1
}

shellcheckrc_ok() {
  ! grep -vE "^[[:space:]]*(#|$)|^[[:space:]]*($SHELLCHECKRC_KEYS)=" "$1" | grep -q .
}

for path in "${files[@]}"; do
  case "$(basename "$path")" in
    biome.json | biome.jsonc)
      biome_ok "$path" ||
        fail "$path: Biome settings outside its list (\$schema, vcs, files, formatter, assist, linter.enabled true)"
      ;;
    eslint.config.js | eslint.config.mjs | eslint.config.cjs | eslint.config.ts | eslint.config.mts | eslint.config.cts)
      eslint_ok "$path" ||
        fail "$path: sets ESLint rules or linterOptions; rules come only from the shared configs it extends"
      ;;
    .rubocop.yml)
      if ! command -v ruby >/dev/null 2>&1; then
        fail "$path: ruby is not installed to read it"
      elif ! rubocop_ok "$path"; then
        fail "$path: RuboCop settings outside its list ($RUBOCOP_KEYS; AllCops: $RUBOCOP_ALLCOPS_KEYS, NewCops enable)"
      fi
      ;;
    Cargo.toml)
      cargo_ok "$path" || fail "$path: a lint level other than warn, deny or forbid"
      ;;
    pyproject.toml)
      ruff_ok "$path" tool.ruff ||
        fail "$path: Ruff settings outside its list (top:$RUFF_KEYS; lint:$RUFF_LINT_KEYS; format)"
      ;;
    ruff.toml | .ruff.toml)
      ruff_ok "$path" "" ||
        fail "$path: Ruff settings outside its list (top:$RUFF_KEYS; lint:$RUFF_LINT_KEYS; format)"
      ;;
    .swift-format)
      swift_format_ok "$path" || fail "$path: turns a swift-format rule off"
      ;;
    .shellcheckrc)
      shellcheckrc_ok "$path" ||
        fail "$path: holds a directive other than source-path, external-sources or enable"
      ;;
    .markdownlint.json | .markdownlint.jsonc | .markdownlint.yaml | .markdownlint.yml | .markdownlint.cjs | .markdownlint.mjs | .markdownlintrc | .markdownlint-cli2.jsonc | .markdownlint-cli2.yaml | .markdownlint-cli2.cjs | .markdownlint-cli2.mjs)
      fail "$path: markdownlint runs with its default rules, so it has no config file"
      ;;
    brakeman.ignore)
      fail "$path: Brakeman ignores no warning"
      ;;
  esac
done

is_sourced() {
  case "$1" in
    */lib/*.sh | tests/lib.sh | */_run_quiet) return 0 ;;
    *) return 1 ;;
  esac
}

first_command() {
  grep -vE '^[[:space:]]*(#|$)' "$1" | head -n 1
}

scripts=()
for path in "${files[@]}"; do
  if head -n 1 "$path" | grep -qE '^#!.*\bbash\b'; then
    scripts+=("$path")
  fi
done

if [ "${#scripts[@]}" -gt 0 ]; then
  if ! command -v shellcheck >/dev/null 2>&1; then
    fail "shellcheck is not installed (brew install shellcheck)"
  elif ! shellcheck -x -P SCRIPTDIR "${scripts[@]}" >&2; then
    fail "shellcheck reported findings (above)"
  fi
  if ! command -v shfmt >/dev/null 2>&1; then
    fail "shfmt is not installed (brew install shfmt)"
  elif ! shfmt -i 2 -ci -d "${scripts[@]}" >&2; then
    fail "shfmt would reformat the scripts above (run bin/format)"
  fi
fi

markdown=()
for path in "${files[@]}"; do
  case "$path" in
    *.md) markdown+=("$path") ;;
  esac
done

if [ "${#markdown[@]}" -gt 0 ]; then
  if ! command -v markdownlint-cli2 >/dev/null 2>&1; then
    fail "markdownlint-cli2 is not installed (brew install markdownlint-cli2)"
  elif ! markdownlint-cli2 "${markdown[@]}" >/dev/null 2>&1; then
    markdownlint-cli2 "${markdown[@]}" 2>&1 | grep -E ' (error|warning) ' >&2 || true
    fail "markdownlint reported findings (above; bin/format fixes what it can)"
  fi
fi

for path in "${scripts[@]+"${scripts[@]}"}"; do
  is_sourced "$path" && continue
  [ -x "$path" ] || fail "$path: entry point is not executable"
  [ "$(first_command "$path")" = "set -euo pipefail" ] ||
    fail "$path: first command is not set -euo pipefail"
done

# A file's text without its trailing audit stamp line.
unstamped() {
  perl -0777 -pe 's/\n<!-- audited: [0-9a-f]{12} -->\s*\z/\n/' "$1"
}

# The stamp bin/stamp-rules writes: the first 12 hex chars of sha256 over the
# body above the stamp, trailing whitespace normalized to one final newline.
stamp_of() {
  perl -0777 -pe 's/\n<!-- audited: [0-9a-f]{12} -->\s*\z/\n/; s/\s*\z/\n/' "$1" |
    shasum -a 256 | cut -c1-12
}

check_markdown() {
  local path="$1" max_lines="$2" max_chars="$3" lines chars h1s
  lines="$(unstamped "$path" | wc -l | tr -d ' ')"
  chars="$(unstamped "$path" | wc -c | tr -d ' ')"
  [ "$lines" -le "$max_lines" ] || fail "$path: $lines lines (cap $max_lines)"
  [ "$chars" -le "$max_chars" ] || fail "$path: $chars characters (cap $max_chars)"
  [ "$(grep -vE '^[[:space:]]*$' "$path" | head -n 1 | cut -c1-2)" = "# " ] ||
    fail "$path: does not lead with an H1"
  h1s="$(grep -cE '^# ' "$path" || true)"
  [ "$h1s" -eq 1 ] || fail "$path: $h1s H1 headings (want 1)"
  if grep -qiE "$BACKWARD_FACING" "$path"; then
    fail "$path: backward-facing wording"
  fi
}

rules=()
while IFS= read -r -d '' path; do
  rules+=("$path")
done < <(find .claude/rules -name '*.md' -type f -print0 2>/dev/null | sort -z)

[ "${#rules[@]}" -gt 0 ] || fail ".claude/rules holds no rules"

for path in "${rules[@]+"${rules[@]}"}"; do
  check_markdown "$path" "$MAX_RULE_LINES" "$MAX_RULE_CHARS"
  [ "$(head -n 1 "$path")" != "---" ] || fail "$path: frontmatter"
  if grep -qiE "$NARRATIVE_HEADING" "$path"; then
    fail "$path: narrative heading"
  fi
  stamp="$(grep -vE '^[[:space:]]*$' "$path" | tail -n 1 |
    sed -nE 's/^[[:space:]]*<!-- audited: ([0-9a-f]{12}) -->[[:space:]]*$/\1/p')"
  if [ -z "$stamp" ]; then
    fail "$path: no audit stamp (commit it through bin/commit)"
  elif [ "$stamp" != "$(stamp_of "$path")" ]; then
    fail "$path: audit stamp does not match its body (commit it through bin/commit)"
  fi
  while IFS= read -r ref; do
    [ -f ".claude/rules/$ref" ] || [ "$ref" = "CLAUDE.md" ] || [ "$ref" = "README.md" ] ||
      fail "$path: cites missing $ref"
  done < <(grep -oE "\`[a-z0-9/_-]+\.md\`" "$path" | tr -d "\`" || true)
done

if [ ! -f CLAUDE.md ]; then
  fail "CLAUDE.md is missing"
else
  check_markdown CLAUDE.md "$MAX_CLAUDE_LINES" "$MAX_CLAUDE_CHARS"
  if grep -q '\.claude/rules' CLAUDE.md; then
    fail "CLAUDE.md: points at the rules directory"
  fi
  for path in "${rules[@]+"${rules[@]}"}"; do
    if grep -qF "$(basename "$path")" CLAUDE.md; then
      fail "CLAUDE.md: names the rule $(basename "$path")"
    fi
  done
fi

SETTINGS=.claude/settings.json
REQUIRED_ALLOW=("Bash(bin/*)")
REQUIRED_DENY=(
  "Bash(git commit *)" "Bash(git rebase *)" "Bash(git checkout *)"
  "Bash(git reset *)" "Bash(git restore *)" "Bash(git stash *)"
  "Bash(git clean *)" "Bash(git push *--force*)" "Bash(git push -f *)"
  "Bash(git push * -f)" "Bash(git push * -f *)" "Bash(git push * +*)"
)
REQUIRED_HOOKS=(PreToolUse:require-bin SessionStart:session-start)

if [ ! -f "$SETTINGS" ]; then
  fail "$SETTINGS is missing"
elif ! command -v jq >/dev/null 2>&1; then
  fail "jq is not installed (brew install jq)"
elif ! jq empty "$SETTINGS" >/dev/null 2>&1; then
  fail "$SETTINGS is not valid JSON"
else
  for entry in "${REQUIRED_ALLOW[@]}"; do
    jq -e --arg e "$entry" ".permissions.allow // [] | index(\$e) != null" "$SETTINGS" >/dev/null ||
      fail "$SETTINGS: does not allow $entry"
  done
  # A leading wildcard also matches absolute paths such as /usr/bin/git.
  jq -e '[.permissions.allow // [] | .[] | select(startswith("Bash(*"))] | length == 0' "$SETTINGS" >/dev/null ||
    fail "$SETTINGS: allows a command pattern that starts with a wildcard"
  for entry in "${REQUIRED_DENY[@]}"; do
    jq -e --arg e "$entry" ".permissions.deny // [] | index(\$e) != null" "$SETTINGS" >/dev/null ||
      fail "$SETTINGS: does not deny $entry"
  done
  for pair in "${REQUIRED_HOOKS[@]}"; do
    event="${pair%%:*}"
    hook="${pair#*:}"
    jq -e --arg ev "$event" --arg h ".claude/hooks/$hook" \
      "[.hooks[\$ev][]?.hooks[]?.command | select(contains(\$h))] | length > 0" "$SETTINGS" >/dev/null ||
      fail "$SETTINGS: no $event hook runs .claude/hooks/$hook"
    [ -x ".claude/hooks/$hook" ] || fail ".claude/hooks/$hook is missing or not executable"
  done
fi

if [ "$failures" -gt 0 ]; then
  echo "guards: $failures failure(s)" >&2
  exit 1
fi
echo "guards: green"
