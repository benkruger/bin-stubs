#!/usr/bin/env bash
set -euo pipefail

TOOLS=" bun bunx biome tsc eslint prettier vitest jest c8 ruff pytest mypy rubocop brakeman rspec cargo swift swift-format xcodebuild shellcheck shfmt markdownlint-cli2 "
RUNNERS=" npx pnpm yarn npm bundle uv uvx xcrun "
RUNNER_VALUE_OPTS=" -p --package --with --from --python --project --directory --sdk -sdk --toolchain "
SHELLS=" sh bash zsh dash "
WRAPPERS=" env time command exec nohup nice builtin timeout stdbuf xargs "
WRAPPER_VALUE_OPTS=" -n -u -S -a -s -k --signal --kill-after -I -P -L -d -E "
KEYWORDS=" if then elif else do while until { ! "
PYTHONS=" python python3 "
GIT_OPTS_WITH_ARG=" -C -c --git-dir --work-tree --namespace "

if ! command -v jq >/dev/null 2>&1; then
  echo "require-bin hook: jq is not installed (brew install jq)" >&2
  exit 2
fi

command="$(jq -r '.tool_input.command // empty')"
[ -n "$command" ] || exit 0

segments() {
  perl -e '
    my ($text, $quote, $part) = ($ARGV[0], "", "");
    my $i = 0;
    while ($i < length $text) {
      my $c = substr($text, $i, 1);
      my $two = substr($text, $i, 2);
      if ($quote eq "\x27") {
        $quote = "" if $c eq "\x27";
        $part .= $c;
      } elsif ($two eq "\$(" || $c eq "`") {
        print "$part\n";
        $part = "";
        $i += $two eq "\$(" ? 2 : 1;
        next;
      } elsif ($quote eq "\"") {
        $quote = "" if $c eq "\"";
        $part .= $c;
      } elsif ($c eq "\x27" || $c eq "\"") {
        $quote = $c;
        $part .= $c;
      } elsif ($c =~ /[;&|()\n]/) {
        print "$part\n";
        $part = "";
      } else {
        $part .= $c;
      }
      $i++;
    }
    print "$part\n";
  ' "$1"
}

skip_assignments() {
  while [ "$i" -lt "${#words[@]}" ] && [[ "${words[$i]}" == [A-Za-z_]*=* ]]; do
    case "${words[$i]}" in
      CI=* | FLOW_CHECKED_APP=*) blocked="check-skip" ;;
    esac
    i=$((i + 1))
  done
}

skip_options() {
  while [ "$i" -lt "${#words[@]}" ] && [[ "${words[$i]}" == -* ]]; do
    if [[ "$1" == *" ${words[$i]} "* ]]; then
      i=$((i + 2))
    else
      i=$((i + 1))
    fi
  done
}

skip_wrappers() {
  local wrapper
  while [ "$i" -lt "${#words[@]}" ]; do
    skip_assignments
    [ "$i" -lt "${#words[@]}" ] || return 0
    case " ${words[$i]##*/} " in
      " export " | " declare " | " readonly " | " typeset " | " local ")
        i=$((i + 1))
        skip_options ""
        skip_assignments
        return 0
        ;;
    esac
    if [[ "$KEYWORDS" == *" ${words[$i]} "* ]]; then
      i=$((i + 1))
      continue
    fi
    wrapper="${words[$i]##*/}"
    if [ "$wrapper" = command ] && [[ "${words[$((i + 1))]:-}" == -[vV] ]]; then
      i="${#words[@]}"
      return 0
    fi
    [[ "$WRAPPERS" == *" $wrapper "* ]] || return 0
    i=$((i + 1))
    skip_options "$WRAPPER_VALUE_OPTS"
    if [ "$wrapper" = timeout ]; then
      i=$((i + 1))
    fi
  done
}

git_commits() {
  local j="$1" w
  while [ "$j" -lt "${#words[@]}" ]; do
    w="${words[$j]}"
    if [ "$w" = "--" ]; then
      return 1
    elif [[ "$GIT_OPTS_WITH_ARG" == *" $w "* ]]; then
      j=$((j + 2))
    elif [[ "$w" == -* ]]; then
      j=$((j + 1))
    else
      [ "$w" = "commit" ]
      return
    fi
  done
  return 1
}

shell_body() {
  local rest="$1" n="$2" quote
  while [ "$n" -gt 0 ]; do
    rest="${rest#"${rest%%[![:space:]]*}"}"
    rest="${rest#"${rest%%[[:space:]]*}"}"
    n=$((n - 1))
  done
  rest="${rest#"${rest%%[![:space:]]*}"}"
  quote="${rest:0:1}"
  case "$quote" in
    \" | \')
      rest="${rest:1}"
      rest="${rest%%"$quote"*}"
      ;;
  esac
  printf '%s\n' "$rest"
}

check_segment() {
  local segment="$1" words=() i=0 k word
  read -r -a words <<<"$segment" || true
  [ "${#words[@]}" -gt 0 ] || return 0
  for k in "${!words[@]}"; do
    words[k]="${words[k]//\"/}"
    words[k]="${words[k]//\'/}"
  done
  skip_wrappers
  [ -z "$blocked" ] || return 0
  [ "$i" -lt "${#words[@]}" ] || return 0
  case "/${words[$i]}/" in
    /bin/* | /./bin/*)
      if [[ "/${words[$i]}/" == */../* ]]; then
        blocked="climb"
        return 0
      fi
      ;;
  esac
  if [[ "$SHELLS" == *" ${words[$i]##*/} "* ]]; then
    i=$((i + 1))
    while [ "$i" -lt "${#words[@]}" ] && [[ "${words[$i]}" == -* ]]; do
      if [[ "${words[$i]}" == -c || "${words[$i]}" == -[!-]*c ]]; then
        check_text "$(shell_body "$segment" $((i + 1)))"
        return 0
      fi
      i=$((i + 1))
    done
  elif [ "${words[$i]}" = . ] || [ "${words[$i]}" = source ]; then
    i=$((i + 1))
  fi
  word="${words[$i]:-}"
  word="${word##*/}"
  if [ "$word" = "git" ] && git_commits $((i + 1)); then
    blocked="commit"
    return 0
  fi
  if [ "$word" = "stamp-rules" ]; then
    blocked="stamp-rules"
    return 0
  fi
  if [[ "$RUNNERS" == *" $word "* ]]; then
    i=$((i + 1))
    skip_options "$RUNNER_VALUE_OPTS"
    case "${words[$i]:-}" in
      exec | run | x | dlx)
        i=$((i + 1))
        skip_options "$RUNNER_VALUE_OPTS"
        ;;
    esac
    word="${words[$i]:-}"
    word="${word##*/}"
    word="${word%%@*}"
  fi
  if [[ "$PYTHONS" == *" ${word%%[0-9.]*} "* ]] || [[ "$PYTHONS" == *" $word "* ]]; then
    if [ "${words[$((i + 1))]:-}" = "-m" ]; then
      word="${words[$((i + 2))]:-}"
    fi
  fi
  if [[ "$TOOLS" == *" $word "* ]]; then
    blocked="$word"
    return 0
  fi
  if [ "$word" = "rails" ] && [ "${words[$((i + 1))]:-}" = "test" ]; then
    blocked="rails test"
  fi
}

check_text() {
  local segment
  while IFS= read -r segment; do
    check_segment "$segment"
    [ -z "$blocked" ] || return 0
  done < <(segments "$1")
}

blocked=""
check_text "$command"

if [ "$blocked" = "check-skip" ]; then
  echo "Blocked: CI and FLOW_CHECKED_APP make the bin/ scripts skip their toolchain and package checks; run the command without them." >&2
  exit 2
fi
if [ "$blocked" = "climb" ]; then
  echo "Blocked: a bin/ path with .. in it leaves bin/; run that program by its own name." >&2
  exit 2
fi
if [ "$blocked" = "stamp-rules" ]; then
  echo "Blocked: only bin/commit stamps rules, after its review passes; commit the rule with bin/commit." >&2
  exit 2
fi
if [ "$blocked" = "commit" ]; then
  echo "Blocked: commit with bin/commit <branch> <msgfile>, which runs bin/ci first, not git commit directly." >&2
  exit 2
fi
if [ -n "$blocked" ]; then
  echo "Blocked: call the bin/ script that wraps $blocked (bin/changed, bin/test <file>, bin/ci, bin/format, bin/lint, bin/build, bin/dependencies), not $blocked directly." >&2
  exit 2
fi
