#!/usr/bin/env bash
set -euo pipefail

TOOLS=" bun bunx biome tsc eslint prettier vitest jest c8 ruff pytest mypy rubocop brakeman rspec cargo swift swift-format xcodebuild shellcheck shfmt markdownlint-cli2 "
RUNNERS=" npx pnpm yarn npm bundle uv uvx xcrun "
RUNNER_VALUE_OPTS=" -p --package --with --from --python --project --directory --sdk -sdk --toolchain "
SHELLS=" sh bash zsh dash "
WRAPPERS=" env time command exec nohup nice builtin timeout stdbuf xargs arch caffeinate sudo script "
WRAPPER_VALUE_OPTS=" -n -u -S -a -s -k --signal --kill-after -I -P -L -d -E "
KEYWORDS=" if then elif else do while until { ! "
PYTHONS=" python python3 "
NODE_VALUE_OPTS=" -r --require --import --loader --experimental-loader -C --conditions --input-type --env-file --title "
GIT_OPTS_WITH_ARG=" -C -c --git-dir --work-tree --namespace "
FIND_EXECS=" -exec -execdir -ok -okdir "
REDIRECT='^[0-9]*(<<<|<<-|<<|&>>|&>|>>|>\||>&|<&|<>|>|<)(.*)$'

if ! command -v jq >/dev/null 2>&1; then
  echo "require-bin hook: jq is not installed (brew install jq)" >&2
  exit 2
fi

command="$(jq -r '.tool_input.command // empty')"
[ -n "$command" ] || exit 0

segments() {
  perl -e '
    my ($text, $quote, $part) = ($ARGV[0], "", "");
    my $i = 0;
    while ($i < length $text) {
      my $c = substr($text, $i, 1);
      my $two = substr($text, $i, 2);
      if ($quote eq "\x27") {
        $quote = "" if $c eq "\x27";
        $part .= $c;
      } elsif ($two eq "\$(" || $c eq "`") {
        print "$part\n";
        $part = "";
        $i += $two eq "\$(" ? 2 : 1;
        next;
      } elsif ($quote eq "\"") {
        $quote = "" if $c eq "\"";
        $part .= $c;
      } elsif ($c eq "\x27" || $c eq "\"") {
        $quote = $c;
        $part .= $c;
      } elsif ($c eq "&" && (($i > 0 && substr($text, $i - 1, 1) =~ /[<>]/) || substr($text, $i + 1, 1) eq ">")) {
        $part .= $c;
      } elsif ($c =~ /[;&|()\n]/) {
        print "$part\n";
        $part = "";
      } else {
        $part .= $c;
      }
      $i++;
    }
    print "$part\n";
  ' "$1"
}

skip_assignments() {
  while [ "$i" -lt "${#words[@]}" ]; do
    if [[ "${words[$i]}" == [A-Za-z_]*=* ]]; then
      name="${words[$i]%%=*}"
      case "${name%+}" in
        CI | FLOW_CHECKED_APP) blocked="check-skip" ;;
      esac
      i=$((i + 1))
    elif [[ "${words[$i]}" =~ $REDIRECT ]]; then
      if [ -n "${BASH_REMATCH[2]}" ]; then
        i=$((i + 1))
      else
        i=$((i + 2))
      fi
    else
      return 0
    fi
  done
}

skip_env_options() {
  local w
  while [ "$i" -lt "${#words[@]}" ] && [[ "${words[$i]}" == -* ]]; do
    w="${words[$i]}"
    case "$w" in
      -S | --split-string)
        i=$((i + 1))
        return 0
        ;;
      -S*)
        words[i]="${w#-S}"
        return 0
        ;;
      --split-string=*)
        words[i]="${w#--split-string=}"
        return 0
        ;;
      -u | -C | -P | --unset | --chdir) i=$((i + 2)) ;;
      *) i=$((i + 1)) ;;
    esac
  done
}

skip_options() {
  while [ "$i" -lt "${#words[@]}" ] && [[ "${words[$i]}" == -* ]]; do
    if [[ "$1" == *" ${words[$i]} "* ]]; then
      i=$((i + 2))
    else
      i=$((i + 1))
    fi
  done
}

script_command() {
  while [ "$i" -lt "${#words[@]}" ] && [[ "${words[$i]}" == -* ]]; do
    case "${words[$i]}" in
      -c | --command)
        check_text "${words[*]:$((i + 1))}"
        i="${#words[@]}"
        return 0
        ;;
      -t | -T | -I | -O | -B | -E | -m) i=$((i + 2)) ;;
      *) i=$((i + 1)) ;;
    esac
  done
  i=$((i + 1))
}

skip_wrappers() {
  local wrapper
  while [ "$i" -lt "${#words[@]}" ]; do
    skip_assignments
    [ "$i" -lt "${#words[@]}" ] || return 0
    case " ${words[$i]##*/} " in
      " export " | " declare " | " readonly " | " typeset " | " local ")
        i=$((i + 1))
        skip_options ""
        skip_assignments
        return 0
        ;;
    esac
    if [[ "$KEYWORDS" == *" ${words[$i]} "* ]]; then
      i=$((i + 1))
      continue
    fi
    wrapper="${words[$i]##*/}"
    if [ "$wrapper" = command ] && [[ "${words[$((i + 1))]:-}" == -[vV] ]]; then
      i="${#words[@]}"
      return 0
    fi
    [[ "$WRAPPERS" == *" $wrapper "* ]] || return 0
    i=$((i + 1))
    case "$wrapper" in
      env) skip_env_options ;;
      arch) skip_options " -arch -d -e " ;;
      caffeinate) skip_options " -t -w " ;;
      sudo) skip_options " -u -g -C -D -h -p -r -t -T -U " ;;
      script) script_command ;;
      *) skip_options "$WRAPPER_VALUE_OPTS" ;;
    esac
    [ -z "$blocked" ] || return 0
    if [ "$wrapper" = timeout ]; then
      i=$((i + 1))
    fi
  done
}

git_commits() {
  local j="$1" w
  while [ "$j" -lt "${#words[@]}" ]; do
    w="${words[$j]}"
    if [ "$w" = "--" ]; then
      return 1
    elif [[ "$GIT_OPTS_WITH_ARG" == *" $w "* ]]; then
      j=$((j + 2))
    elif [[ "$w" == -* ]]; then
      j=$((j + 1))
    else
      [ "$w" = "commit" ]
      return
    fi
  done
  return 1
}

git_force_pushes() {
  local j="$1" w cluster
  while [ "$j" -lt "${#words[@]}" ]; do
    w="${words[$j]}"
    if [[ "$GIT_OPTS_WITH_ARG" == *" $w "* ]]; then
      j=$((j + 2))
    elif [[ "$w" == -* ]]; then
      j=$((j + 1))
    else
      break
    fi
  done
  [ "${words[$j]:-}" = push ] || return 1
  for w in "${words[@]:$((j + 1))}"; do
    case "$w" in
      --) return 1 ;;
      --force* | +*) return 0 ;;
      --*) ;;
      -*)
        cluster="${w#-}"
        cluster="${cluster%%o*}"
        [[ "$cluster" != *f* ]] || return 0
        ;;
    esac
  done
  return 1
}

shell_body() {
  local rest="$1" n="$2" quote
  while [ "$n" -gt 0 ]; do
    rest="${rest#"${rest%%[![:space:]]*}"}"
    rest="${rest#"${rest%%[[:space:]]*}"}"
    n=$((n - 1))
  done
  rest="${rest#"${rest%%[![:space:]]*}"}"
  quote="${rest:0:1}"
  case "$quote" in
    \" | \')
      rest="${rest:1}"
      rest="${rest%%"$quote"*}"
      ;;
  esac
  printf '%s\n' "$rest"
}

find_execs() {
  local j=$((i + 1)) run=()
  while [ "$j" -lt "${#words[@]}" ]; do
    if [[ "$FIND_EXECS" == *" ${words[$j]} "* ]]; then
      run=()
      j=$((j + 1))
      while [ "$j" -lt "${#words[@]}" ]; do
        case "${words[$j]}" in
          ";" | "\\;" | "\\" | +) break ;;
        esac
        run+=("${words[$j]}")
        j=$((j + 1))
      done
      check_text "${run[*]-}"
      [ -z "$blocked" ] || return 0
    fi
    j=$((j + 1))
  done
}

check_segment() {
  local segment="$1" words=() i=0 k word n name
  read -r -a words <<<"$segment" || true
  [ "${#words[@]}" -gt 0 ] || return 0
  for k in "${!words[@]}"; do
    words[k]="${words[k]//\"/}"
    words[k]="${words[k]//\'/}"
  done
  skip_wrappers
  [ -z "$blocked" ] || return 0
  [ "$i" -lt "${#words[@]}" ] || return 0
  case "/${words[$i]}/" in
    /bin/* | /./bin/*)
      if [[ "/${words[$i]}/" == */../* ]]; then
        blocked="climb"
        return 0
      fi
      ;;
  esac
  if [[ "$SHELLS" == *" ${words[$i]##*/} "* ]]; then
    i=$((i + 1))
    while [ "$i" -lt "${#words[@]}" ] && [[ "${words[$i]}" == -* ]]; do
      if [[ "${words[$i]}" == -c || "${words[$i]}" == -[!-]*c ]]; then
        n=$((i + 1))
        [ "${words[$n]:-}" != "--" ] || n=$((n + 1))
        check_text "$(shell_body "$segment" "$n")"
        return 0
      fi
      i=$((i + 1))
    done
  elif [ "${words[$i]}" = . ] || [ "${words[$i]}" = source ]; then
    i=$((i + 1))
  fi
  word="${words[$i]:-}"
  word="${word##*/}"
  if [ "$word" = eval ]; then
    check_text "${words[*]:$((i + 1))}"
    return 0
  fi
  if [ "$word" = find ]; then
    find_execs
    return 0
  fi
  if [ "$word" = node ]; then
    i=$((i + 1))
    skip_options "$NODE_VALUE_OPTS"
    word="${words[$i]:-}"
    word="${word##*/}"
    word="${word%.*js}"
  fi
  if [ "$word" = "git" ] && git_commits $((i + 1)); then
    blocked="commit"
    return 0
  fi
  if [ "$word" = "git" ] && git_force_pushes $((i + 1)); then
    blocked="force-push"
    return 0
  fi
  if [ "$word" = "stamp-rules" ]; then
    blocked="stamp-rules"
    return 0
  fi
  if [[ "$RUNNERS" == *" $word "* ]]; then
    i=$((i + 1))
    skip_options "$RUNNER_VALUE_OPTS"
    case "${words[$i]:-}" in
      exec | run | x | dlx)
        i=$((i + 1))
        skip_options "$RUNNER_VALUE_OPTS"
        ;;
    esac
    word="${words[$i]:-}"
    word="${word##*/}"
    word="${word%%@*}"
  fi
  if [[ "$PYTHONS" == *" ${word%%[0-9.]*} "* ]] || [[ "$PYTHONS" == *" $word "* ]]; then
    if [ "${words[$((i + 1))]:-}" = "-m" ]; then
      word="${words[$((i + 2))]:-}"
    fi
  fi
  if [[ "$TOOLS" == *" $word "* ]]; then
    blocked="$word"
    return 0
  fi
  if [ "$word" = "rails" ] && [ "${words[$((i + 1))]:-}" = "test" ]; then
    blocked="rails test"
  fi
}

check_text() {
  local segment
  while IFS= read -r segment; do
    check_segment "$segment"
    [ -z "$blocked" ] || return 0
  done < <(segments "$1")
}

blocked=""
check_text "$command"

if [ "$blocked" = "check-skip" ]; then
  echo "Blocked: CI and FLOW_CHECKED_APP make the bin/ scripts skip their toolchain and package checks; run the command without them." >&2
  exit 2
fi
if [ "$blocked" = "climb" ]; then
  echo "Blocked: a bin/ path with .. in it leaves bin/; run that program by its own name." >&2
  exit 2
fi
if [ "$blocked" = "stamp-rules" ]; then
  echo "Blocked: only bin/commit stamps rules, after its review passes; commit the rule with bin/commit." >&2
  exit 2
fi
if [ "$blocked" = "force-push" ]; then
  echo "Blocked: a force push rewrites history others may have; push without forcing." >&2
  exit 2
fi
if [ "$blocked" = "commit" ]; then
  echo "Blocked: commit with bin/commit <branch> <msgfile>, which runs bin/ci first, not git commit directly." >&2
  exit 2
fi
if [ -n "$blocked" ]; then
  echo "Blocked: call the bin/ script that wraps $blocked (bin/changed, bin/test <file>, bin/ci, bin/format, bin/lint, bin/build, bin/dependencies), not $blocked directly." >&2
  exit 2
fi
