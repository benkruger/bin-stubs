{
  "permissions": {
    "allow": [
      "Bash(bin/*)",
      "Bash(tests/run)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git rebase *)",
      "Bash(git checkout *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git clean *)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git -C * commit *)",
      "Bash(git -C * rebase *)",
      "Bash(git -C * checkout *)",
      "Bash(git -C * reset *)",
      "Bash(git -C * restore *)",
      "Bash(git -C * stash *)",
      "Bash(git -C * clean *)",
      "Bash(git -C * push *--force*)",
      "Bash(git -C * push -f *)",
      "Bash(git -C * push * -f)",
      "Bash(git -C * push * -f *)",
      "Bash(git -C * push * +*)",
      "Edit(/bin/**)",
      "Edit(/tests/guards)",
      "Edit(/tests/run)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.githooks/**)",
      "Edit(/.worktrees/*/bin/**)",
      "Edit(/.worktrees/*/tests/guards)",
      "Edit(/.worktrees/*/tests/run)",
      "Edit(/.worktrees/*/.claude/settings.json)",
      "Edit(/.worktrees/*/.claude/settings.local.json)",
      "Edit(/.worktrees/*/.claude/hooks/**)",
      "Edit(/.worktrees/*/.githooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-bin"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start"
          }
        ]
      }
    ]
  }
}
