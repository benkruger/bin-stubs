#!/usr/bin/env bash
# bin/format — ruff format, then ruff's safe lint fixes, on the given
# files, or with no paths the files bin/changed --files lists. What ruff
# cannot fix fails in bin/lint. A sibling folder with its own bin/format is
# left alone.
#
# Usage: bin/format [paths...]
set -euo pipefail
export PATH="${HOME}/.local/bin:${PATH}"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$here")" = "_root" ]; then
  root="$(cd "$here/../.." && pwd)"
else
  root="$(cd "$here/.." && pwd)"
fi
cd "$root"

has_own_format() {
  local top="$1"
  [ -x "$root/$top/bin/format" ]
}

if [ "$#" -gt 0 ]; then
  listing="$(printf '%s\n' "$@")"
else
  listing="$("$here/changed" --files)"
fi

files=()
while IFS= read -r path; do
  [ -z "$path" ] && continue
  [ -f "$path" ] || continue
  case "$path" in
    node_modules/* | .venv/* | .flow-states/* | */node_modules/* | */.venv/* | */.flow-states/*)
      continue
      ;;
    *.py | *.pyi) ;;
    *) continue ;;
  esac
  top="${path%%/*}"
  if [ "$top" != "$path" ] && has_own_format "$top"; then
    continue
  fi
  files+=("$path")
done <<<"$listing"

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

uv run ruff format "${files[@]}"
exec uv run ruff check --fix --exit-zero "${files[@]}"
