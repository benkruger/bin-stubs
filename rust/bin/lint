#!/usr/bin/env bash
# Lint this package with clippy. --all is accepted; clippy always lints
# the package.
# Usage: bin/lint [--all]
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$here")" = "_root" ]; then
  root="$(cd "$here/../.." && pwd)"
else
  root="$(cd "$here/.." && pwd)"
fi
cd "$root"
for arg in "$@"; do
  case "$arg" in
    --all) ;;
    *)
      echo "bin/lint: unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done
cargo clippy --all-targets -- -D warnings
