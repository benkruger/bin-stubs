#!/usr/bin/env bash
# Dirty-tree gate for this folder. An empty diff exits green. A dirty
# tree runs format, lint, and test. No build and no sentinel.
# Usage: bin/changed
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$here")" = "_root" ]; then
  root="$(cd "$here/../.." && pwd)"
else
  root="$(cd "$here/.." && pwd)"
fi
cd "$root"
dirty="$(
  {
    if git rev-parse --verify HEAD >/dev/null 2>&1; then
      git diff --name-only --relative HEAD -- .
    fi
    git ls-files --others --exclude-standard -- .
  } | { grep -v '^\.flow-states/' || true; } | sort -u
)"
if [ -z "$dirty" ]; then
  exit 0
fi
if [ -x "$here/ensure-deps" ]; then
  "$here/ensure-deps"
fi
"$here/format"
"$here/lint"
"$here/test"
