#!/usr/bin/env bash
# bin/build — the package's own build script (`npm run build`) when
# package.json declares one; otherwise a type-check of this folder
# (tsc --noEmit). tsc is the project's node_modules/.bin.
#
# Usage: bin/build
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$here")" = "_root" ]; then
  root="$(cd "$here/../.." && pwd)"
else
  root="$(cd "$here/.." && pwd)"
fi
cd "$root"

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ]; then
  toolchain_check "$root"
fi

if node -e 'const p = require("./package.json"); process.exit(p.scripts && p.scripts.build ? 0 : 1)'; then
  exec npm run build
fi
exec "$root/node_modules/.bin/tsc" --noEmit
