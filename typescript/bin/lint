#!/usr/bin/env bash
# bin/lint — every rule, only files this folder changed. ESLint with zero
# warnings on everything but Markdown (a file its config does not cover is
# skipped), markdownlint on dirty *.md. A sibling folder with its own
# bin/lint is left alone. Not a formatter (bin/format owns writes). --all
# checks every file git sees instead of the dirty set — the one-time full
# pass an install runs so latent violations can't hide.
#
# Usage: bin/lint [--all]
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$here")" = "_root" ]; then
  root="$(cd "$here/../.." && pwd)"
else
  root="$(cd "$here/.." && pwd)"
fi
cd "$root"

all=0
for arg in "$@"; do
  case "$arg" in
    --all) all=1 ;;
  esac
done

has_own_lint() {
  local top="$1"
  [ -x "$root/$top/bin/lint" ]
}

files=()
while IFS= read -r path; do
  [ -z "$path" ] && continue
  [ -f "$path" ] || continue
  case "$path" in
    node_modules/* | .venv/* | .flow-states/* | flume/* | */node_modules/* | */.venv/* | */.flow-states/*)
      continue
      ;;
  esac
  top="${path%%/*}"
  if [ "$top" != "$path" ] && has_own_lint "$top"; then
    continue
  fi
  files+=("$path")
done < <(
  if [ "$all" -eq 1 ]; then
    git -C "$root" ls-files --cached --others --exclude-standard -- .
  else
    {
      git -C "$root" diff --name-only --relative HEAD -- .
      git -C "$root" ls-files --others --exclude-standard -- .
    } | sort -u
  fi
)

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

eslint_files=()
md_files=()
for path in "${files[@]}"; do
  case "$path" in
    *.md) md_files+=("$path") ;;
    *) eslint_files+=("$path") ;;
  esac
done

if [ "${#eslint_files[@]}" -gt 0 ]; then
  "$root/node_modules/.bin/eslint" --max-warnings=0 --no-warn-ignored "${eslint_files[@]}"
fi

if [ "${#md_files[@]}" -eq 0 ]; then
  echo "  ✓ markdownlint (no dirty Markdown files)"
else
  "$root/node_modules/.bin/markdownlint-cli2" "${md_files[@]}"
fi
