#!/usr/bin/env bash
# bin/lint — every rule, on the given files, or with no paths the files
# bin/changed --files lists. Each file needs a formatter and a linter:
# Prettier and ESLint rules, markdownlint for Markdown, or for a bash script
# shfmt and shellcheck (tests/guards). Then ESLint with zero warnings on the
# files it covers, and markdownlint on the *.md among them. A sibling
# folder with its own bin/lint is left alone. Not a formatter (bin/format
# owns writes). --all checks every file git sees instead — the one-time full
# pass an install runs so latent violations can't hide.
#
# Usage: bin/lint [--all | paths...]
set -euo pipefail

# Files no formatter or linter can check: by name anywhere, or by exact path.
UNGATED_NAMES=(.gitignore .prettierignore .nvmrc package-lock.json)
UNGATED_PATHS=()
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$here")" = "_root" ]; then
  root="$(cd "$here/../.." && pwd)"
else
  root="$(cd "$here/.." && pwd)"
fi
cd "$root"

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ]; then
  toolchain_check "$root"
fi

all=0
paths=()
for arg in "$@"; do
  case "$arg" in
    --all) all=1 ;;
    *) paths+=("$arg") ;;
  esac
done

if [ "$all" -eq 1 ]; then
  listing="$(git -C "$root" ls-files --cached --others --exclude-standard -- .)"
elif [ "${#paths[@]}" -gt 0 ]; then
  listing="$(printf '%s\n' "${paths[@]}")"
else
  listing="$("$here/changed" --files)"
fi

has_own_lint() {
  local top="$1"
  [ -x "$root/$top/bin/lint" ]
}

files=()
while IFS= read -r path; do
  [ -z "$path" ] && continue
  [ -f "$path" ] || continue
  case "$path" in
    node_modules/* | .venv/* | .flow-states/* | */node_modules/* | */.venv/* | */.flow-states/*)
      continue
      ;;
  esac
  top="${path%%/*}"
  if [ "$top" != "$path" ] && has_own_lint "$top"; then
    continue
  fi
  files+=("$path")
done <<<"$listing"

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

is_ungated() {
  local path="$1" name entry
  name="$(basename "$path")"
  for entry in "${UNGATED_NAMES[@]}"; do
    [ "$name" = "$entry" ] && return 0
  done
  for entry in "${UNGATED_PATHS[@]+"${UNGATED_PATHS[@]}"}"; do
    [ "$path" = "$entry" ] && return 0
  done
  return 1
}

gated=()
md_files=()
for path in "${files[@]}"; do
  case "$path" in
    *.md)
      md_files+=("$path")
      continue
      ;;
  esac
  if [ -L "$path" ] || is_ungated "$path" || head -n 1 "$path" | grep -qE '^#!.*\bbash\b'; then
    continue
  fi
  gated+=("$path")
done

if [ "${#gated[@]}" -gt 0 ]; then
  node --input-type=module -e '
    import { ESLint } from "eslint";
    import * as prettier from "prettier";
    const eslint = new ESLint();
    let failed = false;
    for (const file of process.argv.slice(1)) {
      const info = await prettier.getFileInfo(file, { resolveConfig: true });
      if (info.ignored || info.inferredParser === null) {
        console.error(file + ": no formatter (Prettier)");
        failed = true;
      }
      const ignored = await eslint.isPathIgnored(file);
      const config = ignored ? undefined : await eslint.calculateConfigForFile(file);
      if (Object.keys(config?.rules ?? {}).length === 0) {
        console.error(file + ": no linter (no ESLint rules apply)");
        failed = true;
      }
    }
    process.exit(failed ? 1 : 0);
  ' "${gated[@]}"
  "$root/node_modules/.bin/eslint" --max-warnings=0 "${gated[@]}"
fi

if [ "${#md_files[@]}" -eq 0 ]; then
  echo "  ✓ markdownlint (no dirty Markdown files)"
else
  "$root/node_modules/.bin/markdownlint-cli2" "${md_files[@]}"
fi
