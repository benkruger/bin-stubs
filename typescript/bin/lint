#!/usr/bin/env bash
# bin/lint — every rule, only files this folder changed. Each file needs a
# formatter and a linter: Prettier and ESLint rules, markdownlint for
# Markdown, or shfmt and shellcheck (tests/guards) for a bash script. Then
# ESLint with zero warnings on the files it covers, and markdownlint on
# dirty *.md. A sibling folder with its own bin/lint is left alone. Not a
# formatter (bin/format owns writes). --all checks every file git sees
# instead of the dirty set — the one-time full pass an install runs so
# latent violations can't hide.
#
# Usage: bin/lint [--all]
set -euo pipefail

# Files no formatter or linter can check: by name anywhere, or by exact path.
UNGATED_NAMES=(.gitignore .prettierignore .nvmrc package-lock.json)
UNGATED_PATHS=()
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$here")" = "_root" ]; then
  root="$(cd "$here/../.." && pwd)"
else
  root="$(cd "$here/.." && pwd)"
fi
cd "$root"

all=0
for arg in "$@"; do
  case "$arg" in
    --all) all=1 ;;
  esac
done

has_own_lint() {
  local top="$1"
  [ -x "$root/$top/bin/lint" ]
}

files=()
while IFS= read -r path; do
  [ -z "$path" ] && continue
  [ -f "$path" ] || continue
  case "$path" in
    node_modules/* | .venv/* | .flow-states/* | flume/* | */node_modules/* | */.venv/* | */.flow-states/*)
      continue
      ;;
  esac
  top="${path%%/*}"
  if [ "$top" != "$path" ] && has_own_lint "$top"; then
    continue
  fi
  files+=("$path")
done < <(
  if [ "$all" -eq 1 ]; then
    git -C "$root" ls-files --cached --others --exclude-standard -- .
  else
    {
      git -C "$root" diff --name-only --relative HEAD -- .
      git -C "$root" ls-files --others --exclude-standard -- .
    } | sort -u
  fi
)

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

is_ungated() {
  local path="$1" name entry
  name="$(basename "$path")"
  for entry in "${UNGATED_NAMES[@]}"; do
    [ "$name" = "$entry" ] && return 0
  done
  for entry in "${UNGATED_PATHS[@]+"${UNGATED_PATHS[@]}"}"; do
    [ "$path" = "$entry" ] && return 0
  done
  return 1
}

gated=()
md_files=()
for path in "${files[@]}"; do
  case "$path" in
    *.md)
      md_files+=("$path")
      continue
      ;;
  esac
  if [ -L "$path" ] || is_ungated "$path" || head -n 1 "$path" | grep -qE '^#!.*\bbash\b'; then
    continue
  fi
  gated+=("$path")
done

if [ "${#gated[@]}" -gt 0 ]; then
  node --input-type=module -e '
    import { ESLint } from "eslint";
    import * as prettier from "prettier";
    const eslint = new ESLint();
    let failed = false;
    for (const file of process.argv.slice(1)) {
      const info = await prettier.getFileInfo(file, { resolveConfig: true });
      if (info.ignored || info.inferredParser === null) {
        console.error(file + ": no formatter (Prettier)");
        failed = true;
      }
      const ignored = await eslint.isPathIgnored(file);
      const config = ignored ? undefined : await eslint.calculateConfigForFile(file);
      if (Object.keys(config?.rules ?? {}).length === 0) {
        console.error(file + ": no linter (no ESLint rules apply)");
        failed = true;
      }
    }
    process.exit(failed ? 1 : 0);
  ' "${gated[@]}"
  "$root/node_modules/.bin/eslint" --max-warnings=0 "${gated[@]}"
fi

if [ "${#md_files[@]}" -eq 0 ]; then
  echo "  ✓ markdownlint (no dirty Markdown files)"
else
  "$root/node_modules/.bin/markdownlint-cli2" "${md_files[@]}"
fi
