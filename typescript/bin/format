#!/usr/bin/env bash
# bin/format — format files this folder changed with Prettier. Git diff vs
# HEAD plus untracked, owned by this gate. Markdown is left to markdownlint;
# a file Prettier has no parser for is skipped. A sibling folder with its own
# bin/format is left alone. Not a linter (bin/lint owns lint).
#
# Usage: bin/format
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$here")" = "_root" ]; then
  root="$(cd "$here/../.." && pwd)"
else
  root="$(cd "$here/.." && pwd)"
fi
cd "$root"

has_own_format() {
  local top="$1"
  [ -x "$root/$top/bin/format" ]
}

files=()
while IFS= read -r path; do
  [ -z "$path" ] && continue
  [ -f "$path" ] || continue
  case "$path" in
    node_modules/* | .venv/* | .flow-states/* | flume/* | */node_modules/* | */.venv/* | */.flow-states/*)
      continue
      ;;
    *.md) continue ;;
  esac
  top="${path%%/*}"
  if [ "$top" != "$path" ] && has_own_format "$top"; then
    continue
  fi
  files+=("$path")
done < <(
  {
    git diff --name-only HEAD -- .
    git ls-files --others --exclude-standard -- .
  } | sort -u
)

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

exec "$root/node_modules/.bin/prettier" --write --ignore-unknown --log-level=warn "${files[@]}"
