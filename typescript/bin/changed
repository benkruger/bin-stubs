#!/usr/bin/env bash
# bin/changed — run after an edit. Lists the files this folder changed since
# the last commit, plus untracked ones, once; hands that list to bin/format
# (Prettier) and bin/lint (ESLint, markdownlint); then runs the tests for it,
# 100% coverage on every dirty source. No twin test → red. Empty diff →
# green. No build, no sentinel, not bin/ci. --files prints the list and
# exits; the other scripts here read it when given no paths.
#
# Usage: bin/changed [--files]
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$here")" = "_root" ]; then
  root="$(cd "$here/../.." && pwd)"
else
  root="$(cd "$here/.." && pwd)"
fi
cd "$root"

has_own() {
  local top="$1" leaf="$2"
  [ -x "$root/$top/bin/$leaf" ]
}

owned_change() {
  local path="$1" top
  [ -f "$path" ] || return 1
  top="${path%%/*}"
  if [ "$top" != "$path" ] && has_own "$top" changed; then
    return 1
  fi
  return 0
}

changed_files() {
  local path
  while IFS= read -r path; do
    [ -z "$path" ] && continue
    case "$path" in
      node_modules/* | .venv/* | .flow-states/* | */node_modules/* | */.venv/* | */.flow-states/*)
        continue
        ;;
    esac
    owned_change "$path" || continue
    printf '%s\n' "$path"
  done < <(
    {
      git -C "$root" diff --name-only --relative HEAD -- .
      git -C "$root" ls-files --others --exclude-standard -- .
    } | sort -u
  )
}

if [ "${1:-}" = "--files" ]; then
  changed_files
  exit 0
fi

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ]; then
  toolchain_check "$root"
fi

is_source() {
  local rest="${1#src/}"
  [ "$rest" != "$1" ] || return 1
  case "$1" in
    *.test.ts | *.test.tsx | *.test.mts | *.test.cts) return 1 ;;
    *.ts | *.tsx | *.mts | *.cts) return 0 ;;
    *) return 1 ;;
  esac
}

is_test() {
  local rest="${1#tests/}"
  [ "$rest" != "$1" ] || return 1
  case "$1" in
    *.test.ts | *.test.tsx | *.test.mts | *.test.cts) return 0 ;;
    *) return 1 ;;
  esac
}

test_for_source() {
  local rel="${1#src/}"
  rel="${rel%.*}"
  echo "tests/${rel}.test.ts"
}

already() {
  local n="$1" t
  for t in "${tests[@]+"${tests[@]}"}"; do
    [ "$t" = "$n" ] && return 0
  done
  return 1
}

files=()
while IFS= read -r path; do
  files+=("$path")
done < <(changed_files)

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

"$here/format" "${files[@]}"
"$here/lint" "${files[@]}"

tests=()
missing_mirror=()
for path in "${files[@]}"; do
  if is_source "$path"; then
    mirror="$(test_for_source "$path")"
    if [ ! -f "$mirror" ]; then
      missing_mirror+=("$path → $mirror")
    elif ! already "$mirror"; then
      tests+=("$mirror")
    fi
  elif is_test "$path"; then
    if ! already "$path"; then
      tests+=("$path")
    fi
  fi
done

if [ "${#missing_mirror[@]}" -gt 0 ]; then
  for msg in "${missing_mirror[@]}"; do
    echo "bin/changed: no mirrored test for $msg" >&2
  done
  exit 1
fi

if [ "${#tests[@]}" -gt 0 ]; then
  exec "$here/test" "${tests[@]}"
fi
exit 0
