#!/usr/bin/env bash
# bin/changed — run after an edit. Lists the files this folder changed since
# the last commit, plus untracked ones, once; hands that list to bin/format
# (RuboCop -A, markdownlint --fix) and bin/lint (RuboCop, Brakeman,
# markdownlint; leftover offenses stay red); then runs Minitest for the
# dirty twins, 100/100 on those dirty files.
# A source app/<path>.rb has its twin at test/<path>_test.rb; a source
# lib/<path>.rb has its twin at test/lib/<path>_test.rb.
# SimpleCov's 100% gate stays on; COVERAGE_DIRTY_FILES limits which files
# count. No twin → red. Empty diff → green. No build, no sentinel, not
# bin/ci. --files prints the list and exits; the other scripts here read it
# when given no paths.
#
# Usage: bin/changed [--files]
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$HERE")" = "_root" ]; then
  REPO_ROOT="$(cd "$HERE/../.." && pwd)"
else
  REPO_ROOT="$(cd "$HERE/.." && pwd)"
fi
cd "$REPO_ROOT"

changed_files() {
  local path
  while IFS= read -r path; do
    [ -z "$path" ] && continue
    [ -f "$path" ] || continue
    case "$path" in
      vendor/* | tmp/* | log/* | coverage/* | db/schema.rb | .flow-states/*) continue ;;
    esac
    printf '%s\n' "$path"
  done < <(
    {
      git diff --name-only --relative HEAD -- .
      git ls-files --others --exclude-standard -- .
    } | sort -u
  )
}

if [ "${1:-}" = "--files" ]; then
  changed_files
  exit 0
fi

quietly() {
  local log rc=0
  log="$(mktemp)"
  "$@" >"$log" 2>&1 || rc=$?
  if [ "$rc" -ne 0 ]; then
    cat "$log" >&2
    rm -f "$log"
    return "$rc"
  fi
  rm -f "$log"
  return 0
}

is_source() {
  case "$1" in
    app/*.rb | lib/*.rb) return 0 ;;
    *) return 1 ;;
  esac
}

is_test() {
  case "$1" in
    test/*_test.rb) return 0 ;;
    *) return 1 ;;
  esac
}

test_for_source() {
  case "$1" in
    app/*)
      local rel="${1#app/}"
      echo "test/${rel%.rb}_test.rb"
      ;;
    lib/*)
      echo "test/${1%.rb}_test.rb"
      ;;
  esac
}

already() {
  local n="$1" t
  for t in "${tests[@]+"${tests[@]}"}"; do
    [ "$t" = "$n" ] && return 0
  done
  return 1
}

files=()
while IFS= read -r path; do
  files+=("$path")
done < <(changed_files)

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

"$HERE/format" "${files[@]}"
"$HERE/lint" "${files[@]}"

tests=()
dirty_sources=()
missing_mirror=()
for path in "${files[@]}"; do
  if is_source "$path"; then
    dirty_sources+=("$path")
    mirror="$(test_for_source "$path")"
    if [ ! -f "$mirror" ]; then
      missing_mirror+=("$path → $mirror")
    elif ! already "$mirror"; then
      tests+=("$mirror")
    fi
  elif is_test "$path"; then
    if ! already "$path"; then
      tests+=("$path")
    fi
  fi
done

if [ "${#missing_mirror[@]}" -gt 0 ]; then
  for msg in "${missing_mirror[@]}"; do
    echo "bin/changed: no mirrored test for $msg" >&2
  done
  exit 1
fi

if [ "${#tests[@]}" -eq 0 ]; then
  exit 0
fi

list="$(mktemp)"
trap 'rm -f "$list"' EXIT
if [ "${#dirty_sources[@]}" -gt 0 ]; then
  printf '%s\n' "${dirty_sources[@]}" >"$list"
else
  : >"$list"
fi
export COVERAGE_DIRTY_FILES="$list"
quietly "$HERE/test" "${tests[@]}"
exit 0
