#!/usr/bin/env bash
# Build phase — Zeitwerk eager-load check. Rails runs from source.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$HERE")" = "_root" ]; then
  cd "$HERE/../.."
else
  cd "$HERE/.."
fi

# shellcheck source=_run_quiet
. "$HERE/_run_quiet"

run_quiet "rails (zeitwerk:check)" env RAILS_LOG_LEVEL=error bundle exec rails zeitwerk:check
