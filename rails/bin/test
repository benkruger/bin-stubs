#!/usr/bin/env bash
# Test phase — db:test:prepare then rspec. Full suite requires 100% line and
# branch coverage on app/. Path args run those specs; bin/changed scopes
# SimpleCov to dirty sources via COVERAGE_DIRTY_FILES.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$HERE/.." && pwd)"
cd "$REPO_ROOT"

# shellcheck source=bin/_run_quiet
. "$HERE/_run_quiet"

export RAILS_ENV=test
export RUBYOPT="-w -r${HERE}/warning_filter.rb${RUBYOPT:+:$RUBYOPT}"

run_quiet "rails (db:test:prepare)" bundle exec rails db:test:prepare
echo "  → rspec"
if [ "$#" -gt 0 ]; then
  exec bundle exec rspec "$@"
fi
exec bundle exec rspec
