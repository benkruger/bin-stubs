#!/usr/bin/env bash
# Test phase — db:test:prepare when the app has config/database.yml, then the
# Minitest suite through `rails test`. Ruby runs with warnings on, and a
# warning from the app's own code fails the run (bin/warning_filter.rb).
# The app's test/test_helper.rb starts SimpleCov at 100% line and branch
# coverage and, when COVERAGE_DIRTY_FILES names a file list, counts only those
# files; bin/changed sets it. Path args run those test files.
#
# Usage: bin/test [test files...]
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$here")" = "_root" ]; then
  root="$(cd "$here/../.." && pwd)"
else
  root="$(cd "$here/.." && pwd)"
fi
cd "$root"

# shellcheck source=_run_quiet
. "$here/_run_quiet"

export RAILS_ENV=test
export RUBYOPT="-w -r${here}/warning_filter.rb${RUBYOPT:+ $RUBYOPT}"

if [ -f config/database.yml ]; then
  run_quiet "rails (db:test:prepare)" bundle exec rails db:test:prepare
fi
echo "  → rails test"
exec bundle exec rails test "$@"
