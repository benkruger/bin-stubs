#!/usr/bin/env bash
# bin/lint — RuboCop and markdownlint check the given files, or with no
# paths the files bin/changed --files lists; Brakeman checks the app.
# --all (bin/ci passes it) has RuboCop check the whole app and markdownlint
# the tracked Markdown. Read-only: bin/format owns the autocorrect.
#
# Usage: bin/lint [--all | paths...]
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$HERE")" = "_root" ]; then
  REPO_ROOT="$(cd "$HERE/../.." && pwd)"
else
  REPO_ROOT="$(cd "$HERE/.." && pwd)"
fi
cd "$REPO_ROOT"

# shellcheck source=_run_quiet
. "$HERE/_run_quiet"

all=0
paths=()
for arg in "$@"; do
  case "$arg" in
    --all) all=1 ;;
    *) paths+=("$arg") ;;
  esac
done

if [ "$all" -eq 1 ]; then
  listing="$(git ls-files '*.md')"
elif [ "${#paths[@]}" -gt 0 ]; then
  listing="$(printf '%s\n' "${paths[@]}")"
else
  listing="$("$HERE/changed" --files)"
fi

rb_files=()
md_files=()
while IFS= read -r path; do
  [ -f "$path" ] || continue
  case "$path" in
    *.rb) rb_files+=("$path") ;;
    *.md) md_files+=("$path") ;;
  esac
done <<<"$listing"

if [ "$all" -eq 1 ]; then
  run_quiet "rails (rubocop)" bundle exec rubocop --format quiet --display-cop-names
elif [ "${#rb_files[@]}" -gt 0 ]; then
  run_quiet "rails (rubocop)" bundle exec rubocop --force-exclusion --format quiet --display-cop-names "${rb_files[@]}"
fi
run_quiet "rails (brakeman)" bundle exec brakeman --quiet --no-pager --exit-on-warn --exit-on-error

if [ "${#md_files[@]}" -eq 0 ]; then
  echo "  ✓ markdownlint (no Markdown files)"
else
  git_root="$(git rev-parse --show-toplevel)"
  run_quiet "markdownlint" pnpm --dir "$git_root" exec markdownlint-cli2 "${md_files[@]}"
fi
