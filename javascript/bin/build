#!/usr/bin/env bash
# bin/build — the folder's own build script (`<pm> run build`) when
# package.json declares one; otherwise a syntax check (node --check) of
# every JavaScript file bin/changed --files lists, or with --all (bin/ci
# passes it) every one git sees. The package manager is read
# from the lockfile (pnpm-lock.yaml → pnpm, yarn.lock → yarn, bun.lock →
# bun, else npm).
#
# Usage: bin/build [--all]
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$here")" = "_root" ]; then
  root="$(cd "$here/../.." && pwd)"
else
  root="$(cd "$here/.." && pwd)"
fi
cd "$root"

pm=npm
if [ -f pnpm-lock.yaml ]; then
  pm=pnpm
elif [ -f yarn.lock ]; then
  pm=yarn
elif [ -f bun.lock ] || [ -f bun.lockb ]; then
  pm=bun
  export PATH="${HOME}/.bun/bin:${PATH}"
fi

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ]; then
  toolchain_check "$root"
fi

if node -e 'const p = require("./package.json"); process.exit(p.scripts && p.scripts.build ? 0 : 1)'; then
  exec "$pm" run build
fi

if [ "${1:-}" = "--all" ]; then
  listing="$(git -C "$root" ls-files --cached --others --exclude-standard -- .)"
else
  listing="$("$here/changed" --files)"
fi
files=()
while IFS= read -r path; do
  [ -z "$path" ] && continue
  [ -f "$path" ] || continue
  case "$path" in
    node_modules/* | dist/* | .flow-states/* | */node_modules/* | */.flow-states/*) continue ;;
    *.js | *.mjs | *.cjs) files+=("$path") ;;
  esac
done <<<"$listing"

for f in "${files[@]+"${files[@]}"}"; do
  node --check "$f"
done
