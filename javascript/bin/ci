#!/usr/bin/env bash
# bin/ci — the gate conductor for this folder. Runs format → lint → build →
# test in order and is sentinel-aware: when this folder is byte-for-byte
# unchanged since the last green run, it skips and reports green. A changed
# tree always re-runs. The sentinel never weakens the gate.
#
# Quiet on green, full on red: the four tools' output is captured and surfaced
# only on failure. A green run shows per-step progress ([n/4]
# format/lint/build/test, a live spinner on a real terminal) plus a one-line
# test tally. Exit status, not output, is the gate.
#
# Sentinel scope: the sentinel lives under a BRANCH-SCOPED path
# (.flow-states/<branch>/ci-sentinel), never a repo-global fixed path — two
# concurrent worktrees must not share one sentinel.
#
# The package manager is the folder's own, read from its lockfile
# (pnpm-lock.yaml → pnpm, yarn.lock → yarn, bun.lock → bun, else npm).
#
# Usage: bin/ci [--force] [--clean]
#   --force  run the four even on a sentinel hit (still writes the sentinel)
#   --clean  delete the branch sentinel and exit
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$here")" = "_root" ]; then
  root="$(cd "$here/../.." && pwd)"
else
  root="$(cd "$here/.." && pwd)"
fi
cd "$root"

pm=npm
if [ -f pnpm-lock.yaml ]; then
  pm=pnpm
elif [ -f yarn.lock ]; then
  pm=yarn
elif [ -f bun.lock ] || [ -f bun.lockb ]; then
  pm=bun
  export PATH="${HOME}/.bun/bin:${PATH}"
fi

force=0
clean=0
for arg in "$@"; do
  case "$arg" in
    --force) force=1 ;;
    --clean) clean=1 ;;
    *)
      echo "bin/ci: unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

# Resolve and validate the branch before building any path under .flow-states/.
# Reject the traversal classes that would escape the per-branch scope (empty, '.',
# '..'). Legitimate '/' in a branch (feature/x) nests deterministically under the
# branch dir and is allowed.
branch="$(git rev-parse --abbrev-ref HEAD)"
case "$branch" in
  "" | "." | "..")
    echo "bin/ci: refusing to build a sentinel path for unsafe branch: '$branch'" >&2
    exit 2
    ;;
esac

sentinel="$root/.flow-states/$branch/ci-sentinel"

if [[ "$clean" -eq 1 ]]; then
  rm -f "$sentinel"
  echo "bin/ci: cleaned sentinel for $branch"
  exit 0
fi

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ] && ! toolchain_check "$root"; then
  echo "bin/ci: gate RED ($branch) — the toolchain does not match its pin (above)." >&2
  exit 1
fi

# Fingerprint through the shared lib (bin/lib/tree-sentinel.sh): one
# batched `git hash-object` over the untracked set, dependency trees
# excluded, non-regular files skipped.
if [ "$(basename "$here")" = "_root" ]; then
  ROOT_APP=1
fi
. "$root/bin/lib/tree-sentinel.sh"

pre_hash="$(tree_hash)"

if [[ "$force" -eq 0 && -f "$sentinel" && "$(cat "$sentinel")" == "$pre_hash" ]]; then
  exit 0
fi

label="$(basename "$root")"
echo ""
echo "═══ $label ════════════════════════════════════"
log="$(mktemp)"
trap 'rm -f "$log"' EXIT

# Provision before the four steps. A fresh worktree carries no node_modules
# (untracked, never mirrored by symlink). An already-provisioned tree no-ops.
# Install resolves only what package.json itself changed — versions never
# move here (that is bin/dependencies' update).
if ! "$pm" install >>"$log" 2>&1; then
  cat "$log" >&2
  echo "bin/ci: gate RED ($branch) — dependency provisioning failed (above)." >&2
  exit 1
fi

spin() {
  local spin_label="$1" i=0 frames="|/-\\"
  while :; do
    printf '\rbin/ci: %s %s ' "$spin_label" "${frames:i++%4:1}"
    sleep 0.1
  done
}

step=0
run_step() {
  local name="$1"
  shift
  step=$((step + 1))
  local step_label="[$step/4] $name"
  local rc=0
  if [ -t 1 ]; then
    spin "$step_label" &
    local sp=$!
    "$@" >>"$log" 2>&1 || rc=$?
    kill "$sp" 2>/dev/null || true
    wait "$sp" 2>/dev/null || true
    local mark="✓"
    [ "$rc" -eq 0 ] || mark="✗"
    printf '\rbin/ci: %s %s\033[K\n' "$step_label" "$mark"
  else
    "$@" >>"$log" 2>&1 || rc=$?
    local mark="✓"
    [ "$rc" -eq 0 ] || mark="✗"
    echo "bin/ci: $step_label $mark"
  fi
  if [ "$rc" -ne 0 ]; then
    grep -v '| *100.00 | *100.00 |' "$log" >&2 || true
    echo "bin/ci: gate RED ($branch) — step '$name' failed (above; 100%-covered rows elided)." >&2
    exit "$rc"
  fi
}

# Leaves live next to this script (folder/bin/… or bin/_root/…). Never
# $root/bin/format — at the repo root that is the dispatcher, which would
# re-enter every folder instead of gating this tree.
run_step format "$here/format"
run_step lint "$here/lint"
run_step build "$here/build"
run_step test "$here/test"

tally="$(grep -E '^# pass [0-9]+|Suites: [0-9]+' "$log" | tail -n1 || true)"

# Re-fingerprint after the run: bin/format mutates in place, so the durable
# sentinel must reflect the post-format tree.
mkdir -p "$(dirname "$sentinel")"
tree_hash >"$sentinel"
echo "bin/ci: gate green ($branch)${tally:+ — $tally} — sentinel written."
