#!/usr/bin/env bash
# bin/format — Biome writes its formatting and its safe lint fixes to the
# given files, or with no paths the files bin/changed --files lists. What it
# cannot fix fails in bin/lint. A sibling folder with its own bin/format is
# left alone.
#
# Usage: bin/format [paths...]
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$here")" = "_root" ]; then
  root="$(cd "$here/../.." && pwd)"
else
  root="$(cd "$here/.." && pwd)"
fi
cd "$root"

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ]; then
  toolchain_check "$root"
fi

has_own_format() {
  local top="$1"
  [ -x "$root/$top/bin/format" ]
}

if [ "$#" -gt 0 ]; then
  listing="$(printf '%s\n' "$@")"
else
  listing="$("$here/changed" --files)"
fi

files=()
while IFS= read -r path; do
  [ -z "$path" ] && continue
  [ -f "$path" ] || continue
  case "$path" in
    node_modules/* | dist/* | .flow-states/* | */node_modules/* | */.flow-states/*)
      continue
      ;;
    *.js | *.mjs | *.cjs | *.jsx | *.json | *.jsonc | *.css) ;;
    *) continue ;;
  esac
  top="${path%%/*}"
  if [ "$top" != "$path" ] && has_own_format "$top"; then
    continue
  fi
  files+=("$path")
done <<<"$listing"

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

# Biome exits non-zero while a finding it cannot fix remains; bin/lint
# reports that finding.
"$root/node_modules/.bin/biome" check --write "${files[@]}" || true
