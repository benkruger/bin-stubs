#!/usr/bin/env bash
# bin/changed — coding-time gate for files this folder changed. Biome
# --write (format and safe lint fixes), then lint (leftover stays red),
# tests for the dirty tree, 100/100 on every dirty source. No twin test
# → red. Empty diff → green. No build, no sentinel, not bin/ci. Source and
# twin rules are bin/test's.
#
# Usage: bin/changed
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$here")" = "_root" ]; then
  root="$(cd "$here/../.." && pwd)"
else
  root="$(cd "$here/.." && pwd)"
fi
cd "$root"

has_own() {
  local top="$1" leaf="$2"
  [ -x "$root/$top/bin/$leaf" ]
}

owned_change() {
  local path="$1" top
  [ -f "$path" ] || return 1
  top="${path%%/*}"
  if [ "$top" != "$path" ] && has_own "$top" changed; then
    return 1
  fi
  return 0
}

is_test() {
  case "$1" in
    tests/*.js | tests/*.mjs | tests/*.cjs | tests/*.jsx) return 0 ;;
    *.test.js | *.test.mjs | *.test.cjs | *.test.jsx | *.spec.js | *.spec.mjs) return 0 ;;
    test-*.mjs | */test-*.mjs | test-*.js | */test-*.js) return 0 ;;
    *) return 1 ;;
  esac
}

is_source() {
  case "$1" in
    */*) ;;
    *) return 1 ;;
  esac
  case "$1" in
    tests/* | node_modules/* | dist/* | public/* | coverage/* | */node_modules/*) return 1 ;;
  esac
  is_test "$1" && return 1
  case "$1" in
    *.js | *.mjs | *.cjs | *.jsx) return 0 ;;
    *) return 1 ;;
  esac
}

test_for_source() {
  local rel="$1" dir base stem strip c
  dir="$(dirname "$rel")"
  base="$(basename "$rel")"
  stem="${base%.*}"
  strip="${rel#src/}"
  strip="${strip%.*}"
  for c in "tests/${strip}.test.js" "tests/${strip}.test.mjs" "$dir/${stem}.test.js" "$dir/${stem}.test.mjs" "$dir/test-${stem}.mjs" "$dir/test-${stem}.js"; do
    if [ -f "$c" ]; then
      echo "$c"
      return
    fi
  done
  echo "tests/${strip}.test.js"
}

already() {
  local n="$1" t
  for t in "${tests[@]+"${tests[@]}"}"; do
    [ "$t" = "$n" ] && return 0
  done
  return 1
}

files=()
while IFS= read -r path; do
  [ -z "$path" ] && continue
  [ -f "$path" ] || continue
  case "$path" in
    node_modules/* | dist/* | .flow-states/* | flume/* | */node_modules/* | */.flow-states/*)
      continue
      ;;
  esac
  owned_change "$path" || continue
  files+=("$path")
done < <(
  {
    git -C "$root" diff --name-only --relative HEAD -- .
    git -C "$root" ls-files --others --exclude-standard -- .
  } | sort -u
)

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

biome_files=()
for path in "${files[@]}"; do
  case "$path" in
    *.js | *.mjs | *.cjs | *.jsx | *.json | *.jsonc | *.css) biome_files+=("$path") ;;
  esac
done

if [ "${#biome_files[@]}" -gt 0 ]; then
  "$root/node_modules/.bin/biome" check --write "${biome_files[@]}" || true
fi

"$here/lint"

tests=()
missing_mirror=()
for path in "${files[@]}"; do
  if is_source "$path"; then
    mirror="$(test_for_source "$path")"
    if [ ! -f "$mirror" ]; then
      missing_mirror+=("$path → $mirror")
    elif ! already "$mirror"; then
      tests+=("$mirror")
    fi
  elif is_test "$path"; then
    if ! already "$path"; then
      tests+=("$path")
    fi
  fi
done

if [ "${#missing_mirror[@]}" -gt 0 ]; then
  for msg in "${missing_mirror[@]}"; do
    echo "bin/changed: no mirrored test for $msg" >&2
  done
  exit 1
fi

if [ "${#tests[@]}" -gt 0 ]; then
  exec "$here/test" "${tests[@]}"
fi
exit 0
