#!/usr/bin/env bash
# bin/lint — every rule, only files this folder changed. Each file needs a
# formatter and a linter: Biome for JavaScript/JSON/CSS, markdownlint for
# Markdown, or shfmt and shellcheck (tests/guards) for a bash script. Then
# Biome read-only, and markdownlint on dirty *.md. A sibling folder with its
# own bin/lint is left alone. Not a formatter (bin/format owns writes).
# --all checks every file git sees instead of the dirty set — the one-time
# full pass an install runs so latent violations can't hide.
#
# Usage: bin/lint [--all]
set -euo pipefail

# Files no formatter or linter can check: by name anywhere, or by exact path.
UNGATED_NAMES=(.gitignore .nvmrc package-lock.json bun.lock bun.lockb yarn.lock pnpm-lock.yaml)
UNGATED_PATHS=()
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(basename "$here")" = "_root" ]; then
  root="$(cd "$here/../.." && pwd)"
else
  root="$(cd "$here/.." && pwd)"
fi
cd "$root"

# shellcheck source=lib/toolchain.sh
. "$here/lib/toolchain.sh"
if [ -z "${CI:-}" ]; then
  toolchain_check "$root"
fi

all=0
for arg in "$@"; do
  case "$arg" in
    --all) all=1 ;;
  esac
done

has_own_lint() {
  local top="$1"
  [ -x "$root/$top/bin/lint" ]
}

files=()
while IFS= read -r path; do
  [ -z "$path" ] && continue
  [ -f "$path" ] || continue
  case "$path" in
    node_modules/* | dist/* | .flow-states/* | flume/* | */node_modules/* | */.flow-states/*)
      continue
      ;;
  esac
  top="${path%%/*}"
  if [ "$top" != "$path" ] && has_own_lint "$top"; then
    continue
  fi
  files+=("$path")
done < <(
  if [ "$all" -eq 1 ]; then
    git -C "$root" ls-files --cached --others --exclude-standard -- .
  else
    {
      git -C "$root" diff --name-only --relative HEAD -- .
      git -C "$root" ls-files --others --exclude-standard -- .
    } | sort -u
  fi
)

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

is_ungated() {
  local path="$1" name entry
  name="$(basename "$path")"
  for entry in "${UNGATED_NAMES[@]}"; do
    [ "$name" = "$entry" ] && return 0
  done
  for entry in "${UNGATED_PATHS[@]+"${UNGATED_PATHS[@]}"}"; do
    [ "$path" = "$entry" ] && return 0
  done
  return 1
}

biome_files=()
md_files=()
ungated=0
for path in "${files[@]}"; do
  case "$path" in
    *.md) md_files+=("$path") ;;
    *.js | *.mjs | *.cjs | *.jsx | *.json | *.jsonc | *.css) biome_files+=("$path") ;;
    *)
      if [ -L "$path" ] || is_ungated "$path" || head -n 1 "$path" | grep -qE '^#!.*\bbash\b'; then
        continue
      fi
      echo "$path: no formatter or linter (Biome)" >&2
      ungated=1
      ;;
  esac
done
if [ "$ungated" -ne 0 ]; then
  exit 1
fi

if [ "${#biome_files[@]}" -gt 0 ]; then
  "$root/node_modules/.bin/biome" check "${biome_files[@]}"
fi

if [ "${#md_files[@]}" -eq 0 ]; then
  echo "  ✓ markdownlint (no dirty Markdown files)"
else
  "$root/node_modules/.bin/markdownlint-cli2" "${md_files[@]}"
fi
